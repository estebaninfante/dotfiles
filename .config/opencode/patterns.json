{
  "version": 1,
  "commands": {
    "abrir navegador": {
      "command": "hyprctl dispatch exec '[workspace 1 silent] firefox'",
      "uses": 0,
      "description": "Abrir Firefox en workspace 1"
    },
    "abrir terminal": {
      "command": "hyprctl dispatch exec kitty",
      "uses": 0,
      "description": "Abrir terminal Kitty"
    },
    "cerrar ventana": {
      "command": "hyprctl dispatch killactive",
      "uses": 0,
      "description": "Cerrar ventana activa"
    },
    "siguiente workspace": {
      "command": "hyprctl dispatch workspace +1",
      "uses": 0,
      "description": "Ir al siguiente workspace"
    },
    "anterior workspace": {
      "command": "hyprctl dispatch workspace -1",
      "uses": 0,
      "description": "Ir al workspace anterior"
    },
    "workspace uno": {
      "command": "hyprctl dispatch workspace 1",
      "uses": 0,
      "description": "Ir al workspace 1"
    },
    "workspace dos": {
      "command": "hyprctl dispatch workspace 2",
      "uses": 0,
      "description": "Ir al workspace 2"
    },
    "workspace tres": {
      "command": "hyprctl dispatch workspace 3",
      "uses": 0,
      "description": "Ir al workspace 3"
    },
    "workspace cuatro": {
      "command": "hyprctl dispatch workspace 4",
      "uses": 0,
      "description": "Ir al workspace 4"
    },
    "workspace cinco": {
      "command": "hyprctl dispatch workspace 5",
      "uses": 0,
      "description": "Ir al workspace 5"
    },
    "maximizar": {
      "command": "hyprctl dispatch fullscreen 0",
      "uses": 0,
      "description": "Maximizar ventana activa"
    },
    "pantalla completa": {
      "command": "hyprctl dispatch fullscreen 1",
      "uses": 0,
      "description": "Fullscreen verdadero"
    },
    "toggle flotante": {
      "command": "hyprctl dispatch togglefloating",
      "uses": 0,
      "description": "Toggle modo flotante"
    },
    "mover izquierda": {
      "command": "hyprctl dispatch movefocus l",
      "uses": 0,
      "description": "Mover foco a la izquierda"
    },
    "mover derecha": {
      "command": "hyprctl dispatch movefocus r",
      "uses": 0,
      "description": "Mover foco a la derecha"
    },
    "mover arriba": {
      "command": "hyprctl dispatch movefocus u",
      "uses": 0,
      "description": "Mover foco arriba"
    },
    "mover abajo": {
      "command": "hyprctl dispatch movefocus d",
      "uses": 0,
      "description": "Mover foco abajo"
    },
    "click izquierdo": {
      "command": "xdotool click 1",
      "uses": 0,
      "description": "Click izquierdo del mouse"
    },
    "click derecho": {
      "command": "xdotool click 3",
      "uses": 0,
      "description": "Click derecho del mouse"
    },
    "doble click": {
      "command": "xdotool doubleclick 1",
      "uses": 0,
      "description": "Doble click"
    },
    "escribir hola": {
      "command": "xdotool type 'hola'",
      "uses": 0,
      "description": "Escribir 'hola'"
    },
    "copiar": {
      "command": "xdotool key ctrl+c",
      "uses": 0,
      "description": "Copiar al clipboard"
    },
    "pegar": {
      "command": "xdotool key ctrl+v",
      "uses": 0,
      "description": "Pegar del clipboard"
    },
    "deshacer": {
      "command": "xdotool key ctrl+z",
      "uses": 0,
      "description": "Deshacer acción"
    },
    "guardar": {
      "command": "xdotool key ctrl+s",
      "uses": 0,
      "description": "Guardar archivo"
    },
    "cerrar pestaña": {
      "command": "xdotool key ctrl+w",
      "uses": 0,
      "description": "Cerrar pestaña actual"
    },
    "nueva pestaña": {
      "command": "xdotool key ctrl+t",
      "uses": 0,
      "description": "Abrir nueva pestaña"
    },
    "capturar pantalla": {
      "command": "grim /tmp/screenshot-$(date +%Y%m%d-%H%M%S).png",
      "uses": 0,
      "description": "Capturar pantalla completa"
    },
    "capturar selección": {
      "command": "grim -g \"$(slurp)\" /tmp/selection-$(date +%Y%m%d-%H%M%S).png",
      "uses": 0,
      "description": "Capturar área seleccionada"
    }
  },
  "aliases": {
    "navegador": "abrir navegador",
    "terminal": "abrir terminal",
    "cerrar": "cerrar ventana",
    "siguiente": "siguiente workspace",
    "anterior": "anterior workspace",
    "maxi": "maximizar",
    "pantalla completa": "pantalla completa",
    "flotante": "toggle flotante",
    "izq": "mover izquierda",
    "der": "mover derecha",
    "arriba": "mover arriba",
    "abajo": "mover abajo",
    "copy": "copiar",
    "paste": "pegar",
    "undo": "deshacer",
    "save": "guardar",
    "screenshot": "capturar pantalla",
    "selection": "capturar selección"
  },
  "shortcuts": {
    "ws1": "hyprctl dispatch workspace 1",
    "ws2": "hyprctl dispatch workspace 2",
    "ws3": "hyprctl dispatch workspace 3",
    "ws4": "hyprctl dispatch workspace 4",
    "ws5": "hyprctl dispatch workspace 5",
    "kill": "hyprctl dispatch killactive",
    "float": "hyprctl dispatch togglefloating",
    "full": "hyprctl dispatch fullscreen 1",
    "max": "hyprctl dispatch fullscreen 0"
  }
}