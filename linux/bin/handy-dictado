#!/usr/bin/env bash
# handy-dictado — alterna el dictado de Handy desde CUALQUIER disparador.
#
# Por qué existe:
#   Handy sólo acepta la orden de parada si viene del MISMO binding con el que
#   arrancó la grabación. Si llega otra (por ejemplo: arrancaste con el botón
#   "Dictado" del celular = --toggle-transcription y querés parar con Súper+I =
#   --toggle-post-process), Handy la ignora con el log "another binding is
#   recording" y el dictado queda prendido: sólo lo para el mismo botón que lo
#   arrancó.
#
#   Este wrapper recuerda con qué modo arrancó (un archivo de estado) y, cuando
#   toca parar, manda ese mismo modo. Si Handy no está grabando, arranca en el
#   modo pedido. Así cualquier disparador (teclado, celular/tablet, control de
#   presentaciones, gestos) sirve tanto para arrancar como para parar.
#
# Uso:
#   handy-dictado            arranca con post-procesado (igual que F7 / Súper+I)
#   handy-dictado plain      arranca sin post-procesado
#   handy-dictado pro        arranca con post-procesado
#   handy-dictado cancel     cancela y descarta la grabación en curso
#
# Variables (para tests): HANDY_BIN, HANDY_BUSY_OVERRIDE, HANDY_DATA_HOME.
set -uo pipefail

handy_bin="${HANDY_BIN:-handy}"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
archivo_modo="$runtime/handy-dictado.mode"

# Omar se pausa mientras Handy graba: bandera compartida que lee el loop de voz.
mic_busy="$runtime/omar/mic-busy"
mic_busy_on() { mkdir -p "$runtime/omar" 2>/dev/null || true; printf '%s' "$$" > "$mic_busy" 2>/dev/null || true; }
mic_busy_off() { rm -f "$mic_busy" 2>/dev/null || true; }

accion="${1:-pro}"
case "$accion" in
    --plain | plain) accion=plain ;;
    --pro | pro | "") accion=pro ;;
    --cancel | cancel) accion=cancel ;;
    *)
        printf 'handy-dictado: modo desconocido: %s\n' "$accion" >&2
        exit 2
        ;;
esac

if [ "$accion" = cancel ]; then
    rm -f "$archivo_modo" 2>/dev/null || true
    mic_busy_off
    exec "$handy_bin" --cancel
fi

# Por defecto, al entrar acá no hay grabación en curso (si la hubiera, el bloque
# de abajo la frena). Dejamos la bandera limpia salvo que arranquemos una.
mic_busy_off

# Asegura que la app de Handy esté VIVA antes de mandar el toggle. Si no hay
# instancia, `handy --toggle-*` arranca la GUI (ventana principal/ajustes) y la
# orden se pierde: nunca empieza el dictado. Con la app ya corriendo, la orden
# llega a la instancia única y sí alterna la grabación.
handy_corriendo() {
    if [ -n "${HANDY_RUNNING_OVERRIDE:-}" ]; then
        [ "$HANDY_RUNNING_OVERRIDE" = "1" ]
        return
    fi
    pgrep -x handy >/dev/null 2>&1
}

if ! handy_corriendo; then
    # Arrancarla oculta (sin GUI) y esperar a que registre la instancia única.
    setsid "$handy_bin" --start-hidden >/dev/null 2>&1 &
    for _ in $(seq 1 50); do
        handy_corriendo && break
        sleep 0.2
    done
    sleep 1
fi

# ¿Handy está grabando o transcribiendo? Su ventana "Recording" sólo existe en
# esos estados: no está cuando está quieto, ni cuando sólo tenés abierta la
# ventana principal de Handy (esa tiene clase handy pero título "Handy").
handy_ocupado() {
    if [ -n "${HANDY_BUSY_OVERRIDE:-}" ]; then
        [ "$HANDY_BUSY_OVERRIDE" = "1" ]
        return
    fi
    timeout 2 hyprctl clients 2>/dev/null | tr -d '\t' \
        | grep -A1 -x 'class: handy' | grep -qx 'title: Recording'
}

if handy_ocupado; then
    # Está ocupado: parar con el mismo modo con el que arrancó.
    modo="$(cat "$archivo_modo" 2>/dev/null || true)"
    case "$modo" in
        plain)
            rm -f "$archivo_modo" 2>/dev/null || true
            exec "$handy_bin" --toggle-transcription
            ;;
        pro)
            rm -f "$archivo_modo" 2>/dev/null || true
            exec "$handy_bin" --toggle-post-process
            ;;
    esac

    # No sabemos con qué arrancó (p. ej. con el atajo interno de Handy).
    # Última red de seguridad: mirar el log.
    log="${HANDY_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}}/com.pais.handy/logs/handy.log"
    if [ -r "$log" ]; then
        ultimo="$(grep -aE 'TranscribeAction::start called for binding: |TranscribeAction::stop called for binding: ' "$log" 2>/dev/null | tail -n1 || true)"
        if [[ "$ultimo" == *"start called for binding: transcribe_with_post_process"* ]]; then
            exec "$handy_bin" --toggle-post-process
        elif [[ "$ultimo" == *"start called for binding: transcribe"* ]]; then
            exec "$handy_bin" --toggle-transcription
        fi
    fi

    # No pudimos deducirlo: probamos con el modo pedido.
    case "$accion" in
        plain) exec "$handy_bin" --toggle-transcription ;;
        *) exec "$handy_bin" --toggle-post-process ;;
    esac
fi

# No está grabando: arrancar en el modo pedido y recordarlo para poder pararlo.
rm -f "$archivo_modo" 2>/dev/null || true
# Avisarle a Omar que el micrófono queda ocupado mientras dure el dictado.
mic_busy_on
case "$accion" in
    plain)
        printf 'plain' > "$archivo_modo"
        exec "$handy_bin" --toggle-transcription
        ;;
    *)
        printf 'pro' > "$archivo_modo"
        exec "$handy_bin" --toggle-post-process
        ;;
esac
