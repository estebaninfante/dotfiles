#!/usr/bin/env bash
# kokoro-speechd — cliente que speech-dispatcher invoca (módulo kokoro.conf):
# lee el texto de stdin, pide la síntesis al Kokoro del sistema y reproduce con
# aplay. Es un cliente fino (sólo stdlib): no necesita el venv de torch.
set -euo pipefail

SRC="${HOME}/dotfiles/linux/voice/reader/kokoro_speechd.py"

exec python3 "$SRC" "$@"
