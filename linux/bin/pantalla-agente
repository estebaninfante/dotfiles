#!/usr/bin/env bash
# pantalla-agente — monitor headless para pruebas de agentes.
#
# Monta una salida virtual en la sesión viva (invisible: no ocupa ninguna de las
# pantallas del usuario), con su propio espacio de trabajo, para que un agente
# pruebe apps y capture con `grim -o`. Se desmonta a mano o sola: un watchdog la
# descuelga cuando pasan N minutos sin uso.
#
# Aislamiento (v2): las ventanas de prueba se van solas al espacio propio por una
# window rule persistente que matchea la clase `agente-test-*`, así que no hay
# carrera contra el mapeo de la ventana. Si una app no acepta clase propia, un
# vigilante por PID mueve igual las que caigan en las pantallas del usuario.
# Montar, abrir y desmontar restauran el foco del usuario.
#
# Uso:
#   pantalla-agente montar [--tamano 1440x900] [--escala 1] [--transform 0]
#   pantalla-agente abrir [--clase <regex>] -- <comando...>
#   pantalla-agente capturar [archivo.png]
#   pantalla-agente mover <clase|title:regex|address:0x…>
#   pantalla-agente cerrar
#   pantalla-agente estado
#   pantalla-agente usar            (renueva el reloj de inactividad)
#   pantalla-agente desmontar [--conservar]
#
# Las apps de prueba abren su ventana con clase `agente-test-<algo>`:
#   foot -a agente-test-tui …           (foot)
#   kitty --class=agente-test-tui …     (kitty)
#   chromium --class=agente-test-web …  (chromium/brave/firefox)
#
# Variables: PANTALLA_AGENTE_TTL (segundos sin uso antes de desmontar, 600),
#            PANTALLA_AGENTE_NOMBRE (salida, AGENTE-1),
#            PANTALLA_AGENTE_CLASE (regex de clase, ^agente-test-),
#            PANTALLA_AGENTE_VIGILANCIA (segundos de red de seguridad, 3).
set -uo pipefail

STATE="${XDG_RUNTIME_DIR:-/tmp}/pantalla-agente"
OUT="${PANTALLA_AGENTE_NOMBRE:-AGENTE-1}"
TTL="${PANTALLA_AGENTE_TTL:-600}"
PATRON="${PANTALLA_AGENTE_CLASE:-^agente-test-}"
VIGILANCIA="${PANTALLA_AGENTE_VIGILANCIA:-3}"
WORKSPACE="${PANTALLA_AGENTE_WORKSPACE:-12}"
STAMP="$STATE/stamp"
ENVF="$STATE/env"

die() { printf '%s\n' "$*" >&2; exit 1; }

lua() { hyprctl eval "$1" >/dev/null 2>&1; }

stamped() { mkdir -p "$STATE"; touch "$STAMP"; }

cargar_env() {
    [ -f "$ENVF" ] || die "falta el estado de la pantalla: pantalla-agente montar"
    # shellcheck disable=SC1090
    . "$ENVF"
}

mounted() {
    hyprctl monitors -j 2>/dev/null | jq -e --arg o "$OUT" 'any(.[]; .name == $o)' >/dev/null 2>&1
}

output_workspace() {
    hyprctl monitors -j 2>/dev/null | jq -r --arg o "$OUT" '.[] | select(.name == $o) | .activeWorkspace.id // empty'
}

rightmost_x() {
    hyprctl monitors -j 2>/dev/null \
        | jq -r '[.[] | select(.name != $o) | .x + ((if (.transform % 2) == 1 then .height else .width end) / .scale | floor)] | max // 0' --arg o "$OUT"
}

focused_monitor() {
    hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' | head -1
}

focused_window() {
    hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty'
}

start_watchdog() {
    local pidfile="$STATE/watchdog.pid"
    [ -f "$pidfile" ] && kill "$(cat "$pidfile" 2>/dev/null)" >/dev/null 2>&1
    setsid "$0" _vigilar >/dev/null 2>&1 </dev/null &
    printf '%s\n' "$!" > "$pidfile"
}

limpiar_estado() {
    [ -f "$STATE/watchdog.pid" ] && kill "$(cat "$STATE/watchdog.pid" 2>/dev/null)" >/dev/null 2>&1
    rm -rf "$STATE"
}

# Foco del usuario: vuelve al monitor y a la ventana que tenía antes. Nunca falla.
restaurar_foco() {
    local mon="${MON:-}" win="${WIN:-}"
    [ -n "$mon" ] || return 0
    lua "hl.dispatch(hl.dsp.focus({ monitor = [[$mon]] }))"
    if [ -n "$win" ] && hyprctl clients -j 2>/dev/null | jq -e --arg a "$win" 'any(.[]; .address == $a)' >/dev/null 2>&1; then
        lua "hl.dispatch(hl.dsp.focus({ window = [[address:$win]] }))"
    fi
}

# Regla persistente: toda ventana con esa clase nace en el espacio propio, sin foco.
regla_para() {
    local clase="$1"
    cargar_env
    lua "_G.pantalla_agente_rules = _G.pantalla_agente_rules or {}; if _G.pantalla_agente_rules[[[$clase]]] then _G.pantalla_agente_rules[[[$clase]]]:set_enabled(true) else _G.pantalla_agente_rules[[[$clase]]] = hl.window_rule({ match = { class = [[$clase]] }, workspace = [[$WS silent]], no_initial_focus = true, focus_on_activate = false, render_unfocused = true, border_color = [[rgba(ff8800ee)]] }) end"
}

reglas_apagar() {
    lua "if _G.pantalla_agente_rules then for _, r in pairs(_G.pantalla_agente_rules) do pcall(function() r:set_enabled(false) end) end end; _G.pantalla_agente_rules = nil"
}

# pid + todos sus descendientes (hasta 6 niveles), separados por espacios.
descendientes() {
    local nivel="$1" salida="$1" hijos h out=""
    for _ in 1 2 3 4 5 6; do
        hijos=""
        for h in $nivel; do
            hijos="$hijos $(pgrep -P "$h" 2>/dev/null | tr '\n' ' ')"
        done
        [ -n "${hijos// /}" ] || break
        salida="$salida $hijos"
        nivel="$hijos"
    done
    for h in $salida; do case " $out " in *" $h "*) continue ;; esac; out="$out $h"; done
    printf '%s' "$out"
}

# Windows del espacio propio (para moverlas o cerrarlas sin tocar las del usuario).
ventanas_propias() {
    local match="$1"
    case "$match" in
        title:*)   lua "for _,w in ipairs(hl.get_windows()) do if tostring(w.title):match([[$match]]) then hl.dispatch(hl.dsp.window.move({ workspace = [[$WS]], window = [[address:]]..w.address })) end end" ;;
        address:*) lua "hl.dispatch(hl.dsp.window.move({ workspace = [[$WS]], window = [[address:${match#address:}]] }))" ;;
        class:*)   lua "for _,w in ipairs(hl.get_windows()) do if w.class == [[${match#class:}]] then hl.dispatch(hl.dsp.window.move({ workspace = [[$WS]], window = [[address:]]..w.address })) end end" ;;
        *)         lua "for _,w in ipairs(hl.get_windows()) do if w.class == [[$match]] then hl.dispatch(hl.dsp.window.move({ workspace = [[$WS]], window = [[address:]]..w.address })) end end" ;;
    esac
}

cmd_montar() {
    local tamano="1440x900" escala="1" transform="0"
    while [ $# -gt 0 ]; do
        case "$1" in
            --tamano)    tamano="$2"; shift 2 ;;
            --escala)    escala="$2"; shift 2 ;;
            --transform) transform="$2"; shift 2 ;;
            *) die "montar: opción desconocida $1" ;;
        esac
    done

    local mon_antes win_antes
    mon_antes="$(focused_monitor)"
    win_antes="$(focused_window)"
    stamped

    if ! mounted; then
        hyprctl output create headless "$OUT" >/dev/null 2>&1 || die "no pude crear la salida $OUT"
        local i
        for i in $(seq 1 40); do mounted && break; sleep 0.1; done
        mounted || die "la salida $OUT no apareció"
        local x
        x="$(rightmost_x)"
        lua "hl.monitor({ output = [[$OUT]], mode = [[$tamano@60]], position = [[${x}x0]], scale = $escala, transform = $transform })"
        sleep 0.3
    fi

    # Workspace fijo del agente: la regla estática de windowrules.lua manda las
    # ventanas `agente-test-*` acá, y este comando lo muestra en la salida
    # virtual. Así la ventana nace oculta, sin carrera contra el mapeo.
    WS="$WORKSPACE"
    if hyprctl workspaces -j 2>/dev/null | jq -e --arg ws "$WS" 'any(.[]; (.id|tostring) == $ws and .windows > 0)' >/dev/null 2>&1; then
        die "el workspace $WS ya tiene ventanas del usuario; elegí otro con PANTALLA_AGENTE_WORKSPACE"
    fi
    MON="$mon_antes"
    WIN="$win_antes"
    # El workspace no existe hasta que alguien lo enfoca: se enfoca el monitor
    # virtual y después el workspace, y se devuelve el foco al usuario.
    lua "hl.dispatch(hl.dsp.focus({ monitor = [[$OUT]] }))"
    lua "hl.dispatch(hl.dsp.focus({ workspace = [[$WS]] }))"
    sleep 0.2
    restaurar_foco
    printf 'OUT=%s\nWS=%s\nMON=%s\nWIN=%s\n' "$OUT" "$WS" "$MON" "$WIN" > "$ENVF"

    [ -n "$PATRON" ] && regla_para "$PATRON"
    start_watchdog

    printf 'pantalla-agente: montada %s\n' "$OUT"
    printf '  espacio:  %s (invisible)\n' "$WS"
    printf '  captura:  pantalla-agente capturar /tmp/prueba.png\n'
    printf '  abrir:    pantalla-agente abrir -- <comando>  (clase %s*)\n' "${PATRON#^}"
    printf '  desmonta: a los %ss sin uso, o pantalla-agente desmontar\n' "$TTL"
}

cmd_desmontar() {
    local conservar=0
    [ "${1:-}" = "--conservar" ] && conservar=1
    local mon="" win="" win_ahora="" cerradas=" "
    if [ -f "$ENVF" ]; then
        cargar_env
        mon="${MON:-}"; win="${WIN:-}"
        reglas_apagar
        win_ahora="$(focused_window)"
        if [ "$conservar" = 0 ] && [ -n "${WS:-}" ]; then
            # Las ventanas de prueba no deben saltar a las pantallas del usuario
            # cuando desaparece la salida: se cierran.
            local addr
            for addr in $(hyprctl clients -j 2>/dev/null | jq -r --arg ws "$WS" '.[] | select((.workspace.id|tostring) == $ws) | .address'); do
                lua "hl.dispatch(hl.dsp.window.close({ window = [[address:$addr]] }))"
                cerrradas="$cerradas$addr "
            done
            sleep 0.3
        fi
    fi
    mounted && hyprctl output remove "$OUT" >/dev/null 2>&1
    # Sólo devolvemos el foco si se lo había llevado una de las ventanas que
    # acabamos de cerrar; si el usuario ya está en otra cosa, no se toca.
    case "$cerradas" in
        *" $win_ahora "*) MON="$mon"; WIN="$win"; restaurar_foco ;;
    esac
    limpiar_estado
    printf 'pantalla-agente: desmontada %s\n' "$OUT"
}

cmd_estado() {
    if ! mounted; then
        printf 'pantalla-agente: no montada\n'
        return 0
    fi
    local idle="?"
    [ -f "$STAMP" ] && idle="$(( $(date +%s) - $(stat -c %Y "$STAMP") ))"
    printf 'pantalla-agente: montada %s (ttl %ss, inactiva %ss)\n' "$OUT" "$TTL" "$idle"
    hyprctl monitors -j | jq -r --arg o "$OUT" '.[] | select(.name == $o) | "  salida: \(.width)x\(.height) espacio \(.activeWorkspace.id) pos=\(.x),\(.y)"'
}

cmd_capturar() {
    local archivo="${1:-/tmp/pantalla-agente-$(date +%H%M%S).png}"
    mounted || die "no hay pantalla montada: pantalla-agente montar"
    stamped
    grim -o "$OUT" "$archivo" || die "grim falló al capturar $OUT"
    printf '%s\n' "$archivo"
}

cmd_abrir() {
    local clase=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --clase)  clase="$2"; shift 2 ;;
            --titulo) shift 2 ;;  # compatibilidad; ya no hace falta
            --)       shift; break ;;
            *) die "abrir: opción desconocida $1" ;;
        esac
    done
    [ $# -gt 0 ] || die "abrir: falta el comando"
    mounted || die "no hay pantalla montada: pantalla-agente montar"
    cargar_env
    [ -n "${WS:-}" ] || die "falta el espacio de la pantalla"

    [ -n "$clase" ] && regla_para "$clase"
    regla_para "$PATRON"

    # Instantánea para no confundir las ventanas del usuario con las del test.
    local antes; antes=" $(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | tr '\n' ' ') "
    setsid "$@" >/dev/null 2>&1 </dev/null &
    local pid=$!

    # Red de seguridad: si una ventana del test igual cae en las pantallas del
    # usuario (app sin clase propia, diálogo raro), se mueve al espacio propio y
    # se devuelve el foco. La regla persistente cubre el caso normal sin carrera.
    local pids; pids="$(descendientes "$pid")"
    local i addr lista ws wpid vistas=0
    for i in $(seq 1 $(( VIGILANCIA * 10 ))); do
        lista="$(hyprctl clients -j 2>/dev/null)"
        for addr in $(printf '%s' "$lista" | jq -r '.[].address' 2>/dev/null); do
            case "$antes" in *" $addr "*) continue ;; esac
            ws="$(printf '%s' "$lista" | jq -r --arg a "$addr" '.[] | select(.address == $a) | .workspace.id' 2>/dev/null)"
            wpid="$(printf '%s' "$lista" | jq -r --arg a "$addr" '.[] | select(.address == $a) | .pid' 2>/dev/null)"
            [ -n "$ws" ] || continue
            if [ "$ws" != "$WS" ]; then
                case " $pids " in *" $wpid "*) ;;
                    *) continue ;;
                esac
                lua "hl.dispatch(hl.dsp.window.move({ workspace = [[$WS]], window = [[address:$addr]] }))"
                restaurar_foco
            else
                vistas=$((vistas + 1))
            fi
        done
        [ "$vistas" -gt 0 ] && [ "$i" -gt 8 ] && break
        sleep 0.1
    done

    # Sólo si el foco quedó en una ventana nueva del test se devuelve al usuario;
    # si ya está en otra cosa, no se le toca el foco.
    local ahora; ahora="$(focused_window)"
    case "$antes" in
        *" $ahora "*) ;;
        *) [ -n "$ahora" ] && restaurar_foco ;;
    esac
    stamped
    printf 'pantalla-agente: lancé %s (pid %s) en el espacio %s\n' "$1" "$pid" "$WS"
}

main() {
    cd "$HOME" || exit 1
    [ $# -gt 0 ] || die "uso: pantalla-agente montar|desmontar|estado|capturar|abrir|mover|cerrar|usar"
    local cmd="$1"; shift
    case "$cmd" in
        montar)    cmd_montar "$@" ;;
        desmontar) cmd_desmontar "$@" ;;
        estado)    cmd_estado ;;
        capturar)  cmd_capturar "$@" ;;
        usar)      stamped; printf 'ok\n' ;;
        mover)
            mounted || die "no hay pantalla montada"
            cargar_env
            ventanas_propias "${1:?mover: falta selector}"
            stamped
            printf 'pantalla-agente: ventanas movidas al espacio %s\n' "$WS" ;;
        cerrar)
            mounted || die "no hay pantalla montada"
            cargar_env
            local addr
            for addr in $(hyprctl clients -j 2>/dev/null | jq -r --arg ws "$WS" '.[] | select((.workspace.id|tostring) == $ws) | .address'); do
                lua "hl.dispatch(hl.dsp.window.close({ window = [[address:$addr]] }))"
            done
            stamped
            printf 'pantalla-agente: ventanas cerradas en %s\n' "$WS" ;;
        abrir)     cmd_abrir "$@" ;;
        _vigilar)
            # Watchdog: descuelga la pantalla cuando nadie la usa.
            [ -f "$ENVF" ] || exit 0
            cargar_env
            local ttl="${PANTALLA_AGENTE_TTL:-600}"
            while [ -f "$ENVF" ]; do
                sleep 30
                [ -f "$ENVF" ] || exit 0
                if ! hyprctl monitors -j 2>/dev/null | jq -e --arg o "$OUT" 'any(.[]; .name == $o)' >/dev/null 2>&1; then
                    limpiar_estado; exit 0
                fi
                local idle=$(( $(date +%s) - $(stat -c %Y "$STAMP" 2>/dev/null || date +%s) ))
                if [ "$idle" -ge "$ttl" ]; then
                    "$0" desmontar >/dev/null 2>&1
                    exit 0
                fi
            done ;;
        *) die "uso: pantalla-agente montar|desmontar|estado|capturar|abrir|mover|cerrar|usar" ;;
    esac
}

main "$@"
