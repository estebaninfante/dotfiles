#!/usr/bin/env bash
# voice-kokoro — motor TTS Kokoro del sistema de voz.
#
# Corre linux/voice/kokoro.py con el venv del sistema de voz
# (~/.local/share/tts/venv-kokoro), el único que tiene Kokoro instalado: el
# servidor del sistema (kokoro-tts.service) y el lector usan ese mismo entorno.
# El daemon de voz y el CLI `voice` invocan este wrapper por nombre.
#
# El venv se crea/actualiza con scripts/setup-tts.sh.
exec "$HOME/.local/share/tts/venv-kokoro/bin/python" \
    "$HOME/dotfiles/linux/voice/kokoro.py" "$@"
