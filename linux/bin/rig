#!/usr/bin/env bash
# rig — nombre viejo de `agent-os-cli`. Se mantiene solo como compatibilidad:
# todo lo que llamaba `rig ...` sigue andando, pero el comando es agent-os-cli.
# Este archivo se puede borrar cuando no queden llamadas a `rig`.
set -uo pipefail

real="$(dirname "$(readlink -f "$0")")/agent-os-cli"
if [ ! -x "$real" ]; then
  printf 'rig: falta %s (¿corriste link-dotfiles?)\n' "$real" >&2
  exit 1
fi

# Aviso una sola vez por sesión de shell, y sin ensuciar pipes.
if [ -t 2 ] && [ "${RIG_ALIAS_AVISADO:-0}" != "1" ]; then
  printf 'rig pasó a llamarse agent-os-cli (este alias se va a quitar)\n' >&2
  export RIG_ALIAS_AVISADO=1
fi

exec "$real" "$@"
