#!/usr/bin/env bash
# sunshine-lan-mouse-guard — con un stream de Sunshine en marcha, lan-mouse no
# debe tener la captura armada: el puntero que inyecta Moonlight entra en la
# zona del borde, lan-mouse se lo queda y el ratón "desaparece" del stream (los
# clics siguen yendo a lan-mouse, no a la ventana).
#
# Sunshine crea sus sinks virtuales (sink-sunshine-stereo et al) y los deja por
# defecto SÓLO mientras dura la sesión; al desconectar el cliente los borra y
# vuelve el sink real. No sirve el prep-cmd de Sunshine: las apps de escritorio
# se "reanudan" (resume) sin volver a ejecutarlo.
#
# En el rol cliente la ventana de Moonlight no sirve como señal: el título
# "<equipo> - Moonlight" se queda pegado si la conexión se cae. moonlight-live
# mira el canal de control de Sunshine (47984/47989/48010) y sólo da vivo un
# stream real.
#
# No hay memo de lo aplicado: cada vuelta se compara el estado real con el
# deseado. Con memo, cualquier deactivate externo (script, GUI, este mismo
# guard al terminar un stream) dejaba la captura apagada para siempre.
set -uo pipefail

CAPTURE="${LAN_MOUSE_CAPTURE:-$HOME/.local/bin/lan-mouse-capture.sh}"
MOONLIGHT_LIVE="${MOONLIGHT_LIVE:-$HOME/.local/bin/moonlight-live}"
SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/lan-mouse-socket.sock"
REASSERT=10
VERIFY_EVERY=30
last_want=""
last_verify=0

# hyprctl necesita la firma de la instancia; el user manager casi siempre la
# tiene (UWSM), pero al arrancar la sesión puede no estar lista.
SIG="${HYPRLAND_INSTANCE_SIGNATURE:-}"
hypr() {
    HYPRLAND_INSTANCE_SIGNATURE="$SIG" hyprctl "$@" 2>/dev/null
}

hypr_init() {
    [ -n "$SIG" ] && hypr version >/dev/null && return 0
    local d
    for d in /run/user/"$(id -u)"/hypr/*/; do
        SIG="$(basename "$d")"
        hypr version >/dev/null && return 0
    done
    SIG=""
    return 1
}

sunshine_streaming() {
    pactl get-default-sink 2>/dev/null | grep -q '^sink-sunshine'
}

moonlight_streaming() {
    [ -x "$MOONLIGHT_LIVE" ] && "$MOONLIGHT_LIVE"
}

apply() {
    # Sin daemon no hay nada que reconciliar. El socket es la señal barata;
    # si está huérfano, lan-mouse-capture.sh responde "daemon: stopped" y no
    # toca nada. Evitamos un pgrep por vuelta (60 ms).
    [ -S "$SOCKET" ] || return 0
    local want want_state cur now
    if sunshine_streaming || moonlight_streaming; then
        want=off; want_state=released
    else
        want=on; want_state=active
    fi
    # `status` (cli list + pgrep) cuesta ~250 ms: con el estado estable se
    # verifica cada VERIFY_EVERY s. Un cambio de want se aplica al toque, y la
    # vuelta periódica repara cualquier deactivate externo.
    now=$(date +%s)
    if [ "$want" = "$last_want" ] && [ $((now - last_verify)) -lt "$VERIFY_EVERY" ]; then
        return 0
    fi
    last_want="$want"
    last_verify="$now"
    cur="$("$CAPTURE" status 2>/dev/null | sed -n 's/^capture: //p')"
    if [ "$want_state" != "$cur" ]; then
        "$CAPTURE" "$want" >/dev/null 2>&1 || true
        printf 'captura %s (antes %s; sink=%s, moonlight=%s)\n' \
            "$want" "${cur:-?}" "$(pactl get-default-sink 2>/dev/null)" \
            "$(moonlight_streaming && echo vivo || echo no)" >&2
    fi
}

hypr_init || true
apply

# Sólo importan los cambios que pueden cambiar el sink por defecto: cambio de
# default (server), alta/baja de un sink. Los "change" de sink/sink-input son
# volumen y streams de audio (uno por canción, por juego…): reevaluar en cada
# uno gastaba CPU sin aportar nada. La vuelta periódica cubre lo que se pierda.
while :; do
    while read -r line; do
        case "$line" in
            "Event 'change' on server"*|"Event 'new' on sink #"*|"Event 'remove' on sink #"*) apply ;;
        esac
    done < <(timeout "$REASSERT" pactl subscribe 2>/dev/null)
    hypr_init || true
    apply
done
