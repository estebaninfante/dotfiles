#!/usr/bin/env bash
# audio-jack-guard — mantiene la salida analógica sana y coherente con el jack.
#
# En las máquinas con este codec (ALC257 + WirePlumber) pasan tres cosas al
# cambiar de puerto o al arrancar:
#   1. el amplificador del puerto activo queda en mute (switch off), o
#   2. queda con el switch on pero volumen 0 (silencio igual), y
#   3. el sink nulo del micrófono del teléfono (phone_mic_sink) queda como
#      salida por defecto, así que todo el audio va a un sink que no va a
#      ningún lado.
# Este guardián deja, cada 1.5 s, el puerto correcto con su amplificador
# encendido AL 100% y el otro apagado y en 0, y devuelve el default a la placa
# real si quedó en un sink virtual. No maneja el volumen del sink (PipeWire lo
# aplica por software): el slider y el ducking de la voz siguen mandando. Solo
# repone ese volumen si WirePlumber lo salta al cambiar de puerto.
#
# Detecta sola la placa, el sink y los nombres de puerto, así el mismo script
# sirve en la laptop y en el desktop sin config por equipo. Se puede forzar
# todo con variables:
#   AUDIO_JACK_CARD      placa ALSA (default: la que tenga "Headphone Jack")
#   AUDIO_JACK_SINK      sink de PipeWire (default: el *analog-stereo*)
#   AUDIO_JACK_INTERVAL  segundos entre chequeos (default 1.5)
#   AUDIO_JACK_DEFAULT   sink default de PipeWire (default @DEFAULT_AUDIO_SINK@)
set -u

CARD="${AUDIO_JACK_CARD:-}"
SINK="${AUDIO_JACK_SINK:-}"
INTERVAL="${AUDIO_JACK_INTERVAL:-1.5}"
DEFAULT_SINK="${AUDIO_JACK_DEFAULT:-@DEFAULT_AUDIO_SINK@}"
HP_PORT="${AUDIO_JACK_HP_PORT:-}"
SPK_PORT="${AUDIO_JACK_SPK_PORT:-}"

# Placa ALSA con jack de auriculares (0..5).
detect_card() {
  local c
  for c in 0 1 2 3 4 5; do
    if amixer -c "$c" cget "iface=CARD,name=Headphone Jack" >/dev/null 2>&1; then
      printf '%s' "$c"
      return 0
    fi
  done
  return 1
}

# Sink analógico real (no el nulo del teléfono, que también es Audio/Sink).
detect_sink() {
  local s
  s="$(pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -m1 'analog-stereo' || true)"
  if [ -n "$s" ]; then
    printf '%s' "$s"
  else
    pactl get-default-sink 2>/dev/null || true
  fi
}

# Nombres de puerto del sink: el de auriculares y el de parlantes.
detect_ports() {
  local ports
  ports="$(pactl list sinks 2>/dev/null | grep -oE 'analog-output-[a-z]+' | sort -u || true)"
  [ -n "$HP_PORT" ] || HP_PORT="$(printf '%s\n' "$ports" | grep -i headphone | head -1)"
  [ -n "$SPK_PORT" ] || SPK_PORT="$(printf '%s\n' "$ports" | grep -i speaker | head -1)"
  HP_PORT="${HP_PORT:-analog-output-headphones}"
  SPK_PORT="${SPK_PORT:-analog-output-speaker}"
}

HAVE_JACK=1
if [ -z "$CARD" ]; then
  CARD="$(detect_card || true)"
  [ -n "$CARD" ] || HAVE_JACK=0
fi
if [ -z "$SINK" ]; then
  SINK="$(detect_sink)"
  [ -n "$SINK" ] || { echo "audio-jack-guard: no encuentro sink analógico" >&2; exit 0; }
fi
detect_ports

# ¿Hay algo enchufado en el jack de auriculares? on|off (vacío si no existe).
jack_state() {
  amixer -c "$CARD" cget "iface=CARD,name=Headphone Jack" 2>/dev/null \
    | sed -n 's/.*values=\(on\|off\).*/\1/p' | tail -1
}

current_port() {
  pactl list sinks 2>/dev/null \
    | sed -n '/Name: '"$SINK"'$/,/^$/p' \
    | sed -n 's/^[[:space:]]*Active Port: //p' | head -1
}

# Deja el puerto pedido, conservando el volumen del sink (WirePlumber lo salta
# al cambiar de puerto y enchufar auriculares podía saltar a 100%).
switch_port() {  # switch_port <puerto>
  local want_port="$1" cur_port vol
  cur_port="$(current_port)"
  [ "$cur_port" = "$want_port" ] && return 0
  vol="$(wpctl get-volume "$DEFAULT_SINK" 2>/dev/null | awk '{print $2}')"
  pactl set-sink-port "$SINK" "$want_port" >/dev/null 2>&1 || true
  [ -n "${vol:-}" ] && wpctl set-volume "$DEFAULT_SINK" "$vol" >/dev/null 2>&1 || true
}

# Enciende un amplificador al 100% o lo apaga y lo deja en 0.
amp() {  # amp <control> on|off
  if [ "$2" = on ]; then
    amixer -c "$CARD" sset "$1" 87 on >/dev/null 2>&1 || true
  else
    amixer -c "$CARD" sset "$1" 0 off >/dev/null 2>&1 || true
  fi
}

# Un sink virtual/nulo no es una salida real: si quedó como default, devolvemos
# el default a la placa. No tocamos HDMI/Bluetooth elegidos a propósito.
ensure_default_sink() {
  case "$(pactl get-default-sink 2>/dev/null)" in
    ""|"phone_mic_sink"|"phone-mic")
      pactl set-default-sink "$SINK" >/dev/null 2>&1 || true
      ;;
  esac
}

# Base sana una sola vez (solo si hay jack/placa).
if [ "$HAVE_JACK" = 1 ]; then
  amixer -c "$CARD" sset 'Master' 87 on >/dev/null 2>&1 || true
  amixer -c "$CARD" sset 'PCM' 255 >/dev/null 2>&1 || true
fi

while true; do
  ensure_default_sink
  if [ "$HAVE_JACK" = 1 ]; then
    case "$(jack_state)" in
      on)
        switch_port "$HP_PORT"
        amp Headphone on
        amp Speaker off
        ;;
      off)
        switch_port "$SPK_PORT"
        amp Speaker on
        amp Headphone off
        ;;
    esac
  fi
  sleep "$INTERVAL"
done
