#!/usr/bin/env bash
# tira — modo de scroll (tipo niri) por workspace, a demanda.
#
# No es permanente: se prende y se apaga en caliente, sin recargar Hyprland.
# Con el modo apagado el workspace es la grilla de siempre.
#
# Uso:
#   tira modo             prende/apaga el modo en el workspace activo
#   tira on | off         prender en el activo / apagar en todos
#   tira estado           que workspaces estan en modo y con que direccion
#   tira direccion down|right|up|left
#                         eje de la cinta (down = hacia abajo, right = estilo niri)
#   tira verificar        chequea que el layout del scroll este realmente aplicado
#
# El estado vive en ~/.local/state/tira.modo y lo lee ~/.config/hypr/tira.lua.
# No hay `hyprctl reload` en ningún lado: las reglas se aplican en caliente.

set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/tira.modo"

if ! hyprctl version >/dev/null 2>&1; then
    echo "Hyprland no está corriendo" >&2
    exit 1
fi

# Llama a la función TiraModo() que define la config de Hyprland.
tira_eval() {
    local expr="$1"
    local out
    if ! out="$(hyprctl eval "$expr" 2>&1)"; then
        echo "error hablando con Hyprland: $out" >&2
        return 1
    fi
    printf '%s' "$out"
}

direccion_actual() {
    sed -n 's/^direction=//p' "$STATE" 2>/dev/null | head -1
}

case "${1:-estado}" in
    modo)
        tira_eval 'TiraModo("toggle")'
        ;;
    on)
        tira_eval 'TiraModo("on")'
        ;;
    off)
        tira_eval 'TiraModo("off")'
        ;;
    estado)
        echo "workspaces en modo tira:"
        if [[ -r "$STATE" ]] && grep -q '^workspace=' "$STATE" 2>/dev/null; then
            grep '^workspace=' "$STATE" | sed 's/^workspace=/  workspace /'
        else
            echo "  (ninguno)"
        fi
        echo "dirección: $(direccion_actual || echo down)"
        ;;
    direccion)
        case "${2:-}" in
            down|right|up|left) ;;
            *) echo "uso: tira direccion down|right|up|left" >&2; exit 2 ;;
        esac
        tira_eval "TiraModo('direccion', '${2}')" >/dev/null
        echo "dirección de la cinta: $2"
        ;;
    verificar)
        fail=0
        errors="$(hyprctl configerrors 2>/dev/null | sed -e '/^ *$/d')"
        if [[ -n "$errors" ]]; then
            echo "✗ errores de config:"; echo "$errors"; fail=1
        else
            echo "✓ config sin errores"
        fi

        width="$(hyprctl getoption scrolling:column_width | sed -n 's/^float: //p')"
        if awk -v w="${width:-0}" 'BEGIN { exit !(w == 1.0) }'; then
            echo "✓ column_width = 1.0 (cada columna ocupa la pantalla)"
        else
            echo "✗ column_width = ${width:-?}, esperaba 1.0"; fail=1
        fi

        if [[ -r "$STATE" ]] && grep -q '^workspace=' "$STATE" 2>/dev/null; then
            hyprctl -j clients | python3 -c "
import json, sys, re
ids = [int(m) for m in re.findall(r'^workspace=(\d+)', open('$STATE').read(), re.M)]
clients = json.load(sys.stdin)
ok = True
for ws in ids:
    tiled = [c for c in clients
             if c['workspace']['id'] == ws and c['fullscreen'] == 0 and not c['floating']]
    if len(tiled) < 2:
        print('· workspace %d en modo, una sola ventana: nada que medir' % ws)
        continue
    ys = sorted(c['at'][1] for c in tiled)
    highs = {c['size'][1] for c in tiled}
    jumps = {b - a for a, b in zip(ys, ys[1:])}
    if len(highs) == 1 and jumps == highs:
        print('✓ workspace %d: cinta de %d pantallas completas' % (ws, len(tiled)))
    else:
        print('✗ workspace %d: no es una cinta (altos %s, saltos %s)' % (ws, highs, jumps))
        ok = False
sys.exit(0 if ok else 1)
" || fail=1
        else
            echo "· no hay ningún workspace en modo tira"
        fi
        exit "$fail"
        ;;
    *)
        sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
