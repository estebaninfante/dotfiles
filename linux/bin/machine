#!/usr/bin/env python3
"""machine — el computador como base de datos.

Una sola base SQLite (`~/.local/share/machine/machine.db`) que indexa las
entidades de la máquina: proyectos, tareas, ideas, servicios.

Dos capas, y la diferencia importa:

  - HECHOS: se leen del disco (git, systemd, archivos). `scan` los recalcula.
    Nadie los escribe a mano, así que no se pueden desactualizar.
  - DECISIONES: `state`, `kind` y `note`. Las escribe el humano. `scan` nunca
    las toca.

Comandos:
  machine init                       crea la base y el esquema
  machine scan                       recorre ~/Proyectos y refresca hechos
  machine ls [--kind K] [--state S]  lista entidades
  machine show <slug>                ficha con todos los hechos
  machine set <slug> [opciones]      cambia kind/state/note
  machine stats                      conteos por estado y kind
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import subprocess
import sqlite3
import sys
from pathlib import Path

DB = Path(os.environ.get("MACHINE_DB", Path.home() / ".local/share/machine/machine.db"))
ROOT = Path(os.environ.get("MACHINE_ROOT", Path.home() / "Proyectos"))
SKIP = {"_archivo", ".rig-worktrees"}
TICKETS = Path.home() / ".config/opencode/tickets.json"
RETENTION_DAYS = int(os.environ.get("MACHINE_TRASH_DAYS", "30"))
TRASH = Path(os.environ.get("MACHINE_TRASH", Path.home() / ".local/share/machine/trash"))
SYSTEMD = Path.home() / ".config/systemd/user"

KINDS = ("project", "product", "experiment", "service", "app", "idea", "task")
STATES = ("unclassified", "active", "paused", "done", "archived")

SCHEMA = """
CREATE TABLE IF NOT EXISTS schema_version (
    version    INTEGER NOT NULL,
    applied_at TEXT    NOT NULL
);

CREATE TABLE IF NOT EXISTS sources (
    name         TEXT PRIMARY KEY,
    path         TEXT NOT NULL,
    last_scan_at TEXT
);

CREATE TABLE IF NOT EXISTS entities (
    id         INTEGER PRIMARY KEY,
    kind       TEXT    NOT NULL,
    slug       TEXT    NOT NULL,
    title      TEXT,
    state      TEXT    NOT NULL DEFAULT 'active',
    note       TEXT,
    source     TEXT    NOT NULL DEFAULT 'scan',
    created_at TEXT    NOT NULL,
    updated_at TEXT    NOT NULL,
    UNIQUE (kind, slug)
);

CREATE TABLE IF NOT EXISTS facts (
    entity_id   INTEGER NOT NULL REFERENCES entities (id) ON DELETE CASCADE,
    key         TEXT    NOT NULL,
    value       TEXT,
    observed_at TEXT    NOT NULL,
    PRIMARY KEY (entity_id, key)
);

CREATE INDEX IF NOT EXISTS idx_entities_state ON entities (state);
CREATE INDEX IF NOT EXISTS idx_entities_kind  ON entities (kind);
CREATE INDEX IF NOT EXISTS idx_facts_key      ON facts (key);
"""

# Migraciones incrementales. Cada versión se aplica una vez y queda registrada
# en `schema_version`; nunca se edita una migración ya aplicada.
MIGRATIONS = {
    2: "ALTER TABLE entities ADD COLUMN parent_id INTEGER REFERENCES entities (id) ON DELETE CASCADE;",
    3: "ALTER TABLE entities ADD COLUMN title_manual INTEGER NOT NULL DEFAULT 0;",
}


def now() -> str:
    return dt.datetime.now().replace(microsecond=0).isoformat()


def connect() -> sqlite3.Connection:
    if not DB.exists():
        sys.exit(f"machine: no existe la base ({DB}). Corré: machine init")
    con = sqlite3.connect(DB)
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA foreign_keys=ON")
    return con


def cmd_init(args) -> None:
    DB.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(DB)
    con.execute("PRAGMA journal_mode=WAL")
    con.executescript(SCHEMA)
    row = con.execute("SELECT MAX(version) AS v FROM schema_version").fetchone()
    current = row[0] or 0
    if not current:
        con.execute("INSERT INTO schema_version (version, applied_at) VALUES (1, ?)", (now(),))
        current = 1
    for version in sorted(MIGRATIONS):
        if version > current:
            for stmt in [x for x in MIGRATIONS[version].split(";") if x.strip()]:
                con.execute(stmt)
            con.execute("INSERT INTO schema_version (version, applied_at) VALUES (?, ?)", (version, now()))
            current = version
    con.commit()
    print(f"base:   {DB}")
    print(f"esquema: version {con.execute('SELECT MAX(version) FROM schema_version').fetchone()[0]}")


def git(path: Path, *argv: str) -> str:
    try:
        r = subprocess.run(
            ["git", "-C", str(path), *argv],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def title_of(path: Path) -> str:
    for name in ("README.md", "AGENTS.md", "readme.md"):
        f = path / name
        if not f.is_file():
            continue
        try:
            for line in f.read_text(encoding="utf-8", errors="replace").splitlines()[:20]:
                if line.startswith("# "):
                    return line[2:].strip()
        except OSError:
            pass
    return path.name


def tickets_by_project() -> dict[str, tuple[int, int]]:
    """(total, abiertos) por proyecto. Lee el archivo viejo sin modificarlo."""
    if not TICKETS.is_file():
        return {}
    try:
        raw = json.loads(TICKETS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    data = raw.get("tickets", []) if isinstance(raw, dict) else raw
    if not isinstance(data, list):
        return {}
    out: dict[str, list[int]] = {}
    for t in data:
        if not isinstance(t, dict):
            continue
        p = (t.get("project") or "").strip()
        if not p:
            continue
        acc = out.setdefault(p, [0, 0])
        acc[0] += 1
        if t.get("status") != "done":
            acc[1] += 1
    return {k: (v[0], v[1]) for k, v in out.items()}


def systemd_live(units: list[tuple[str, str]]) -> set[str]:
    """Nombres de units habilitadas o corriendo ahora."""
    live: set[str] = set()
    for name, _ in units:
        try:
            r = subprocess.run(
                ["systemctl", "--user", "is-enabled", name],
                capture_output=True, text=True, timeout=5,
            )
            enabled = r.stdout.strip() in ("enabled", "enabled-runtime", "static", "indirect")
            r2 = subprocess.run(
                ["systemctl", "--user", "is-active", name],
                capture_output=True, text=True, timeout=5,
            )
            active = r2.stdout.strip() == "active"
            if enabled or active:
                live.add(name)
        except (OSError, subprocess.TimeoutExpired):
            continue
    return live


def systemd_units() -> list[tuple[str, str]]:
    """[(nombre, contenido)] de las units de usuario.

    El nombre es lo que necesita `systemctl --user` (sin el `.service` se
    acepta igual, pero se devuelve completo para poder mostrarlo).
    """
    out: list[tuple[str, str]] = []
    try:
        for f in sorted(SYSTEMD.glob("*.service")):
            try:
                out.append((f.stem, f.read_text(encoding="utf-8", errors="replace")))
            except OSError:
                continue
    except OSError:
        pass
    return out


def readme_excerpt(path: Path, limit: int = 160) -> str:
    """Primer párrafo útil del README (sin título, badges ni HTML)."""
    for name in ("README.md", "readme.md", "README"):
        f = path / name
        if not f.is_file():
            continue
        try:
            lines = f.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            return ""
        buf: list[str] = []
        for raw in lines[:60]:
            line = raw.strip()
            if not line or line.startswith(("#", "!", "[!", "<", "|", "```", "---", "===")):
                if buf:
                    break
                continue
            buf.append(line)
            if sum(len(x) for x in buf) > limit:
                break
        text = " ".join(buf)
        text = " ".join(text.replace("**", "").replace("`", "").split())
        return text[:limit]
    return ""


def dir_stats(path: Path) -> tuple[int, float]:
    """(archivos, MB) sin entrar en .git ni node_modules."""
    files = 0
    size = 0
    for root, dirs, names in os.walk(path):
        dirs[:] = [d for d in dirs if d not in (".git", "node_modules", ".venv", "__pycache__", ".next")]
        for name in names:
            fp = Path(root) / name
            try:
                size += fp.stat().st_size
            except OSError:
                continue
            files += 1
    return files, round(size / (1024 * 1024), 1)


def collect(path: Path, units, live: set[str], tickets: dict[str, tuple[int, int]]) -> dict[str, str]:
    slug = path.name
    is_git = bool(git(path, "rev-parse", "--git-dir"))
    facts: dict[str, str] = {"path": str(path)}

    if is_git:
        last = git(path, "log", "-1", "--format=%cs")
        facts["git"] = "true"
        facts["branch"] = git(path, "rev-parse", "--abbrev-ref", "HEAD") or "?"
        facts["last_commit"] = last or "?"
        status = git(path, "status", "--porcelain")
        facts["dirty"] = str(len(status.splitlines())) if status else "0"
        ahead = git(path, "rev-list", "--count", "@{u}..HEAD")
        facts["ahead"] = ahead if ahead else "?"
        facts["last_commit_subject"] = git(path, "log", "-1", "--format=%s")[:200]
        remote = git(path, "remote", "get-url", "origin")
        facts["remote_url"] = remote
        host = ""
        if "github.com" in remote:
            host = "github"
        elif "gitlab" in remote:
            host = "gitlab"
        elif remote:
            host = "other"
        facts["remote_host"] = host or "none"
    else:
        facts["git"] = "false"
        facts["last_commit"] = dt.date.fromtimestamp(path.stat().st_mtime).isoformat()

    files, size_mb = dir_stats(path)
    facts["files"] = str(files)
    facts["size_mb"] = str(size_mb)
    facts["readme_excerpt"] = readme_excerpt(path)
    facts["has_readme"] = "true" if (path / "README.md").is_file() else "false"
    facts["has_agents"] = "true" if (path / "AGENTS.md").is_file() else "false"
    facts["has_webapp"] = "true" if (path / ".webapp.json").is_file() else "false"
    names = []
    for name, block in units:
        if f"Proyectos/{slug}" in block:
            names.append(name)
    facts["systemd"] = "true" if names else "false"
    facts["systemd_units"] = ",".join(names)
    facts["systemd_active"] = ",".join(n for n in names if n in live)
    total, opened = tickets.get(slug, (0, 0))
    facts["tickets_total"] = str(total)
    facts["tickets_open"] = str(opened)
    return facts


def cmd_scan(args) -> None:
    con = connect()
    units = systemd_units()
    live = systemd_live(units)
    tickets = tickets_by_project()
    stamp = now()
    seen = 0

    for path in sorted(ROOT.iterdir()):
        if not path.is_dir() or path.name in SKIP or path.name.startswith("."):
            continue
        seen += 1
        facts = collect(path, units, live, tickets)
        row = con.execute(
            "SELECT id, title, title_manual FROM entities WHERE kind='project' AND slug=?",
            (path.name,),
        ).fetchone()
        title = title_of(path)
        if row:
            entity_id = row["id"]
            if row["title_manual"]:
                con.execute("UPDATE entities SET updated_at=? WHERE id=?", (stamp, entity_id))
            else:
                con.execute("UPDATE entities SET title=?, updated_at=? WHERE id=?",
                            (title, stamp, entity_id))
        else:
            cur = con.execute(
                "INSERT INTO entities (kind, slug, title, state, source, created_at, updated_at)"
                " VALUES ('project', ?, ?, 'unclassified', 'scan', ?, ?)",
                (path.name, title, stamp, stamp),
            )
            entity_id = cur.lastrowid
        con.executemany(
            "INSERT INTO facts (entity_id, key, value, observed_at) VALUES (?,?,?,?)"
            " ON CONFLICT (entity_id, key) DO UPDATE SET value=excluded.value,"
            " observed_at=excluded.observed_at",
            [(entity_id, k, v, stamp) for k, v in facts.items()],
        )

    con.execute(
        "INSERT INTO sources (name, path, last_scan_at) VALUES ('projects', ?, ?)"
        " ON CONFLICT (name) DO UPDATE SET last_scan_at=excluded.last_scan_at",
        (str(ROOT), stamp),
    )
    con.commit()

    # Entidades cuyo proyecto desapareció del disco: la base es un espejo.
    ghost = []
    for row in con.execute("SELECT id, slug FROM entities WHERE kind = 'project'").fetchall():
        path = con.execute(
            "SELECT value FROM facts WHERE entity_id = ? AND key = 'path'", (row["id"],)
        ).fetchone()
        if path and not Path(path["value"]).is_dir():
            ghost.append(row)
    for row in ghost:
        con.execute("DELETE FROM entities WHERE id = ?", (row["id"],))
    if ghost:
        con.commit()  # sin esto los DELETE se pierden al cerrar la conexión
    if ghost:
        print(f"{len(ghost)} proyecto(s) ya no estaban en el disco: {', '.join(r['slug'] for r in ghost)}")

    loose = [
        f for f in ROOT.iterdir()
        if f.is_file() and f.name != ".stignore"
    ]
    if loose:
        mb = round(sum(f.stat().st_size for f in loose if f.exists()) / (1024 * 1024), 1)
        print(f"AVISO: {len(loose)} archivo(s) suelto(s) en {ROOT} ({mb} MB). "
              f"~/Proyectos es solo para carpetas de proyecto.")

    with_remote = con.execute(
        "SELECT COUNT(*) FROM facts WHERE key='remote_host' AND value IN ('github','gitlab')"
    ).fetchone()[0]
    print(f"{seen} proyectos escaneados · {with_remote} con remoto git · {stamp}")


def fmt_age(last: str) -> str:
    try:
        d = dt.date.fromisoformat(last[:10])
    except (ValueError, TypeError):
        return "?"
    return f"{(dt.date.today() - d).days}d"


def cmd_ls(args) -> None:
    con = connect()
    where, params = [], []
    if args.kind:
        where.append("e.kind = ?")
        params.append(args.kind)
    if args.state:
        where.append("e.state = ?")
        params.append(args.state)
    if not args.kind and not getattr(args, "all", False):
        where.append("e.kind != 'task'")
    sql = (
        "SELECT e.slug, e.kind, e.state, e.title,"
        "       MAX(CASE WHEN f.key='last_commit' THEN f.value END) AS last_commit,"
        "       MAX(CASE WHEN f.key='remote_host' THEN f.value END) AS remote_host,"
        "       MAX(CASE WHEN f.key='tickets_open' THEN f.value END) AS tickets_open,"
        "       MAX(CASE WHEN f.key='dirty' THEN f.value END) AS dirty"
        "  FROM entities e LEFT JOIN facts f ON f.entity_id = e.id"
        + (" WHERE " + " AND ".join(where) if where else "")
        + " GROUP BY e.id ORDER BY e.state, last_commit DESC"
    )
    rows = con.execute(sql, params).fetchall()
    if args.json:
        full = [con.execute("SELECT * FROM entities WHERE slug = ?", (r["slug"],)).fetchone()
                for r in rows]
        return to_json([entity_json(con, r) for r in full])
    if not rows:
        print("(vacío)")
        return
    print(f"{'SLUG':20} {'KIND':9} {'STATE':9} {'AGE':>5} {'REMOTE':8} {'DIRTY':>5} {'TK':>3}")
    for r in rows:
        print(f"{r['slug'][:20]:20} {r['kind']:9} {r['state']:9} "
              f"{fmt_age(r['last_commit'] or ''):>5} {r['remote_host'] or '-':8} "
              f"{r['dirty'] or '-':>5} {r['tickets_open'] or '-':>3}")


def cmd_show(args) -> None:
    con = connect()
    row = con.execute("SELECT * FROM entities WHERE slug=?", (args.slug,)).fetchone()
    if not row:
        sys.exit(f"machine: no existe el proyecto '{args.slug}'")
    if args.json:
        out = entity_json(con, row)
        out["tasks"] = tasks_of(con, row["id"])
        return to_json(out)
    print(f"{row['slug']}  [{row['kind']} · {row['state']}]")
    print(f"  title:  {row['title']}")
    if row["note"]:
        print(f"  note:   {row['note']}")
    facts = con.execute(
        "SELECT key, value FROM facts WHERE entity_id=? ORDER BY key", (row["id"],)
    ).fetchall()
    for f in facts:
        print(f"  {f['key']:14} {f['value']}")


def cmd_set(args) -> None:
    con = connect()
    row = con.execute("SELECT id FROM entities WHERE slug=?", (args.slug,)).fetchone()
    if not row:
        sys.exit(f"machine: no existe el proyecto '{args.slug}'")
    sets, params = [], []
    if args.state:
        if args.state not in STATES:
            sys.exit(f"machine: state inválido. Opciones: {', '.join(STATES)}")
        sets.append("state = ?")
        params.append(args.state)
    if args.kind:
        if args.kind not in KINDS:
            sys.exit(f"machine: kind inválido. Opciones: {', '.join(KINDS)}")
        sets.append("kind = ?")
        params.append(args.kind)
    if args.note is not None:
        sets.append("note = ?")
        params.append(args.note)
    if getattr(args, "goal", None) is not None or getattr(args, "check", None) is not None:
        for key, value in (("goal", getattr(args, "goal", None)), ("check", getattr(args, "check", None))):
            if value is None:
                continue
            con.execute(
                "INSERT INTO facts (entity_id, key, value, observed_at) VALUES (?, ?, ?, ?)"
                " ON CONFLICT (entity_id, key) DO UPDATE SET value=excluded.value, observed_at=excluded.observed_at",
                (row["id"], key, value, now()),
            )
    if not sets and getattr(args, "goal", None) is None and getattr(args, "check", None) is None:
        sys.exit("machine: nada que cambiar (usá --state, --kind, --note, --goal o --check)")
    sets.append("updated_at = ?")
    params.append(now())
    params.append(row["id"])
    con.execute(f"UPDATE entities SET {', '.join(sets)} WHERE id = ?", params)
    con.commit()
    after = con.execute("SELECT kind, state, note FROM entities WHERE id=?", (row["id"],)).fetchone()
    print(f"{args.slug}: {after['kind']} · {after['state']}"
          + (f" · {after['note']}" if after["note"] else ""))


def cmd_rename(args) -> None:
    con = connect()
    row = project_row(con, args.slug)
    if args.auto:
        title = title_of(Path(facts_of(con, row["id"]).get("path", "")))
        con.execute(
            "UPDATE entities SET title=?, title_manual=0, updated_at=? WHERE id=?",
            (title, now(), row["id"]),
        )
        con.commit()
        print(f"{args.slug}: vuelve al nombre automático ({title})")
        return
    name = " ".join(args.name).strip()
    if not name:
        sys.exit("machine: falta el nombre nuevo")
    if len(name) > 80:
        sys.exit("machine: el nombre no puede pasar de 80 caracteres")
    con.execute(
        "UPDATE entities SET title=?, title_manual=1, updated_at=? WHERE id=?",
        (name, now(), row["id"]),
    )
    con.commit()
    print(f"{args.slug}: ahora se llama «{name}»")


def cmd_idea(args) -> None:
    """Captura una idea en texto libre. No la convierte en proyecto todavía."""
    con = connect()
    if not args.text:
        rows = con.execute(
            "SELECT slug, title, state, created_at FROM entities WHERE kind='idea'"
            " ORDER BY created_at DESC"
        ).fetchall()
        if not rows:
            print("sin ideas capturadas")
            return
        for r in rows:
            print(f"{r['slug']:14} {r['state']:13} {r['created_at'][:10]}  {r['title']}")
        return

    text = " ".join(args.text).strip()
    if not text:
        sys.exit("machine: la idea está vacía")
    title = (args.title or "").strip()
    if not title:
        # Sin nombre explícito: primera frase corta, cortada en palabra.
        first = text.split(".")[0]
        title = first if len(first) <= 42 else first[:42].rsplit(" ", 1)[0] + "…"
    n = 1
    while con.execute("SELECT 1 FROM entities WHERE kind='idea' AND slug=?",
                      (f"idea-{n}",)).fetchone():
        n += 1
    slug = f"idea-{n}"
    stamp = now()
    con.execute(
        "INSERT INTO entities (kind, slug, title, state, note, source, created_at, updated_at)"
        " VALUES ('idea', ?, ?, 'unclassified', ?, 'human', ?, ?)",
        (slug, title, text, stamp, stamp),
    )
    con.commit()
    print(f"idea: {slug} · {title}")
    print("para convertirla en proyecto: decime en el chat y armamos la DoD")


def cmd_promote(args) -> None:
    """Convierte una idea en proyecto: cambia kind, state y slug."""
    con = connect()
    row = project_row(con, args.slug)
    if row["kind"] == "project":
        sys.exit(f"machine: '{args.slug}' ya es un proyecto")
    target = (args.to or "").strip()
    if target:
        if not target.replace("-", "").replace("_", "").isalnum():
            sys.exit("machine: el slug nuevo solo lleva letras, números, guion y guion bajo")
        if con.execute("SELECT 1 FROM entities WHERE slug = ? AND id != ?", (target, row["id"])).fetchone():
            sys.exit(f"machine: ya existe '{target}'")
    slug = target or row["slug"]
    con.execute(
        "UPDATE entities SET kind='project', state='active', slug=?, title_manual=1, updated_at=? WHERE id=?",
        (slug, now(), row["id"]),
    )
    for key, value in (("goal", args.goal), ("check", args.check)):
        if not value:
            continue
        con.execute(
            "INSERT INTO facts (entity_id, key, value, observed_at) VALUES (?, ?, ?, ?)"
            " ON CONFLICT (entity_id, key) DO UPDATE SET value=excluded.value, observed_at=excluded.observed_at",
            (row["id"], key, value, now()),
        )
    if args.dod:
        dod = Path(args.dod).read_text(encoding="utf-8")
        prev = facts_of(con, row["id"]).get("dod", "")
        con.execute(
            "INSERT INTO facts (entity_id, key, value, observed_at) VALUES (?, 'dod', ?, ?)"
            " ON CONFLICT (entity_id, key) DO UPDATE SET value=excluded.value, observed_at=excluded.observed_at",
            (row["id"], (prev + "\n\n" if prev else "") + dod, now()),
        )
    con.commit()
    print(f"proyecto: {slug} (kind=project, state=active)" + (f" · DoD guardada" if args.dod else ""))


def cmd_stats(args) -> None:
    con = connect()
    print("por estado:")
    for r in con.execute("SELECT state, COUNT(*) n FROM entities GROUP BY state ORDER BY n DESC"):
        print(f"  {r['state']:9} {r['n']}")
    print("por kind:")
    for r in con.execute("SELECT kind, COUNT(*) n FROM entities GROUP BY kind ORDER BY n DESC"):
        print(f"  {r['kind']:9} {r['n']}")
    src = con.execute("SELECT name, last_scan_at FROM sources").fetchall()
    for r in src:
        print(f"último scan {r['name']}: {r['last_scan_at']}")


def to_json(obj) -> None:
    print(json.dumps(obj, ensure_ascii=False))


def facts_of(con, entity_id: int) -> dict[str, str]:
    rows = con.execute("SELECT key, value FROM facts WHERE entity_id = ?", (entity_id,))
    return {r["key"]: r["value"] for r in rows}


def age_days(last: str) -> int | None:
    try:
        d = dt.date.fromisoformat((last or "")[:10])
    except (ValueError, TypeError):
        return None
    return (dt.date.today() - d).days


def entity_json(con, row) -> dict:
    facts = facts_of(con, row["id"])
    out = {
        "slug": row["slug"], "kind": row["kind"], "state": row["state"],
        "title": row["title"], "note": row["note"], "source": row["source"],
        "title_manual": row["title_manual"] if "title_manual" in row.keys() else 0,
        "created_at": row["created_at"], "updated_at": row["updated_at"],
        "facts": facts,
    }
    out["age_days"] = age_days(facts.get("last_commit", ""))
    return out


def tasks_of(con, parent_id: int) -> list[dict]:
    rows = con.execute(
        "SELECT * FROM entities WHERE parent_id = ? AND kind = 'task'"
        " ORDER BY CASE state WHEN 'active' THEN 0 WHEN 'done' THEN 1 ELSE 2 END, id",
        (parent_id,),
    ).fetchall()
    return [{"slug": r["slug"], "title": r["title"], "state": r["state"],
             "note": r["note"], "created_at": r["created_at"]} for r in rows]


def project_row(con, slug: str):
    row = con.execute("SELECT * FROM entities WHERE slug = ?", (slug,)).fetchone()
    if not row:
        sys.exit(f"machine: no existe '{slug}'")
    return row


def cmd_task_add(args) -> None:
    con = connect()
    parent = project_row(con, args.slug)
    n = 1
    while con.execute("SELECT 1 FROM entities WHERE kind='task' AND slug=?",
                      (f"{parent['slug']}-t{n}",)).fetchone():
        n += 1
    slug = f"{parent['slug']}-t{n}"
    stamp = now()
    con.execute(
        "INSERT INTO entities (kind, slug, title, state, note, source, created_at,"
        " updated_at, parent_id) VALUES ('task', ?, ?, 'active', ?, 'human', ?, ?, ?)",
        (slug, args.title, args.note, stamp, stamp, parent["id"]),
    )
    con.commit()
    print(f"task: {slug} · {args.title}")


def cmd_task_done(args) -> None:
    con = connect()
    row = project_row(con, args.task)
    if row["kind"] != "task":
        sys.exit(f"machine: '{args.task}' no es una tarea")
    con.execute("UPDATE entities SET state='done', updated_at=? WHERE id=?", (now(), row["id"]))
    con.commit()
    print(f"task: {args.task} → done")


def cmd_task_ls(args) -> None:
    con = connect()
    parent = project_row(con, args.slug)
    rows = tasks_of(con, parent["id"])
    if args.json:
        return to_json(rows)
    if not rows:
        print(f"{parent['slug']}: sin tareas")
        return
    for t in rows:
        mark = "x" if t["state"] == "done" else " "
        print(f"[{mark}] {t['slug']:24} {t['title']}")


def gh_login() -> str:
    try:
        r = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    blob = (r.stdout or "") + (r.stderr or "")
    for line in blob.splitlines():
        if "account" in line and "Logged in" in line:
            parts = line.split()
            for token in parts:
                if token and token[0].isalnum() and "." not in token and "/" not in token:
                    continue
            # "Logged in to github.com account estebaninfante (keyring)"
            if "account" in parts:
                idx = parts.index("account")
                if idx + 1 < len(parts):
                    return parts[idx + 1]
    return ""


def gh_can_delete() -> bool:
    """True si el token de gh tiene el permiso delete_repo."""
    try:
        r = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    blob = (r.stdout or "") + (r.stderr or "")
    return "delete_repo" in blob


def gh_repo_slug(url: str) -> str:
    """https://github.com/owner/name.git -> owner/name"""
    if "github.com" not in url:
        return ""
    tail = url.split("github.com", 1)[1].lstrip(":/")
    tail = tail[:-4] if tail.endswith(".git") else tail
    tail = tail.strip("/")
    return tail if tail.count("/") == 1 else ""


def cmd_gh_status(args) -> None:
    info = {"login": gh_login(), "can_delete": gh_can_delete()}
    if args.json:
        return to_json(info)
    print(f"cuenta: {info['login'] or '(sin sesión)'}")
    print(f"borrar repos: {'sí' if info['can_delete'] else 'NO (falta el permiso delete_repo)'}")


def cmd_service_disable(args) -> None:
    """Para y deshabilita las units que apuntan al proyecto."""
    con = connect()
    row = project_row(con, args.slug)
    facts = facts_of(con, row["id"])
    names = [n for n in (facts.get("systemd_units") or "").split(",") if n]
    if not names:
        sys.exit(f"machine: '{args.slug}' no tiene ninguna unit apuntando a su carpeta")
    for name in names:
        for action in ("disable", "stop"):
            r = subprocess.run(
                ["systemctl", "--user", action, name],
                capture_output=True, text=True, timeout=20,
            )
            if r.returncode != 0 and action == "disable":
                print(f"  {name}: {action} dijo ({(r.stderr or r.stdout).strip()[:120]})")
        print(f"  {name}: parada y deshabilitada")
    print("corré machine scan para que el guard se actualice")


def cmd_trash(args) -> None:
    """Manda la carpeta a la papelera y borra la fila.

    No usa `rm -rf`: mueve el directorio a ~/.local/share/machine/trash/<fecha>/.
    Se puede recuperar a mano. Se niega si hay un servicio systemd apuntando al
    proyecto: borrarlo dejaría la unit rota y el servicio en bucle de reinicio.
    """
    con = connect()
    row = project_row(con, args.slug)
    facts = facts_of(con, row["id"])
    path = Path(facts.get("path", ""))
    if not path.is_dir():
        sys.exit(f"machine: la carpeta no existe ({path})")
    if path.parent.resolve() != ROOT.resolve():
        sys.exit(f"machine: me niego a mover {path}: no está directamente en {ROOT}")
    if facts.get("systemd_active"):
        units = facts["systemd_active"].split(",")
        sys.exit(
            f"machine: '{args.slug}' tiene un servicio corriendo ({', '.join(units)}); "
            f"corré: machine service-disable {args.slug}"
        )
    if not args.yes:
        sys.exit("machine: falta --yes (el movimiento es reversible pero borra la fila)")

    if args.github:
        if facts.get("remote_host") != "github":
            sys.exit(f"machine: '{args.slug}' no tiene remoto de GitHub")
        repo = gh_repo_slug(facts.get("remote_url", ""))
        if not repo:
            sys.exit(f"machine: no pude leer owner/nombre del remoto ({facts.get('remote_url')})")
        if not gh_can_delete():
            sys.exit("machine: falta el permiso delete_repo en gh (corré: gh auth refresh -s delete_repo)")
        # Primero GitHub: si falla, no se toca nada local.
        r = subprocess.run(["gh", "repo", "delete", repo, "--yes"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"machine: gh no pudo borrar {repo}: {(r.stderr or r.stdout).strip()[:300]}")
        print(f"github: {repo} borrado")

    stamp = dt.datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
    dest_dir = TRASH / stamp
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / path.name
    path.rename(dest)
    con.execute("DELETE FROM entities WHERE id = ?", (row["id"],))
    con.commit()
    print(f"trash: {path.name} → {dest}")
    print("restaurar: moverla de vuelta a ~/Proyectos y correr machine scan")


def trash_entries() -> list[tuple[dt.datetime, Path, list[str]]]:
    """(fecha, ruta, proyectos) por cada lote de la papelera."""
    out = []
    if not TRASH.is_dir():
        return out
    for entry in sorted(TRASH.iterdir()):
        if not entry.is_dir():
            continue
        try:
            when = dt.datetime.strptime(entry.name, "%Y-%m-%dT%H-%M-%S")
        except ValueError:
            when = dt.datetime.fromtimestamp(entry.stat().st_mtime)
        projects = sorted(p.name for p in entry.iterdir() if p.is_dir())
        out.append((when, entry, projects))
    return out


def trash_json() -> list[dict]:
    now = dt.datetime.now()
    out = []
    for when, entry, projects in trash_entries():
        for name in projects:
            folder = entry / name
            size = sum(
                f.stat().st_size for f in folder.rglob("*") if f.is_file()
            ) / (1024 * 1024)
            days = (now - when).days
            out.append({
                "slug": name,
                "batch": entry.name,
                "at": when.replace(microsecond=0).isoformat(),
                "days": days,
                "expires_in": max(0, RETENTION_DAYS - days),
                "size_mb": round(size, 1),
            })
    return out


def cmd_trash_list(args) -> None:
    if getattr(args, "json", False):
        return to_json(trash_json())
    entries = trash_entries()
    if not entries:
        print("papelera vacía")
        return
    now = dt.datetime.now()
    total = 0.0
    print(f"papelera: {TRASH} (retención {RETENTION_DAYS} días)")
    print(f"{'entró':17} {'días':>5} {'tamaño':>8}  proyecto")
    for when, entry, projects in entries:
        days = (now - when).days
        size = sum(
            f.stat().st_size for f in entry.rglob("*") if f.is_file()
        ) / (1024 * 1024)
        total += size
        for name in projects:
            print(f"{when:%Y-%m-%d %H:%M} {days:5} {size:7.1f}M  {name}")
    print(f"total: {total:.1f} MB en {len(entries)} lote(s)")


def cmd_restore(args) -> None:
    for when, entry, projects in reversed(trash_entries()):
        if args.slug not in projects:
            continue
        src = entry / args.slug
        dest = ROOT / args.slug
        if dest.exists():
            sys.exit(f"machine: ya existe {dest}; movelo o renombralo primero")
        src.rename(dest)
        try:
            entry.rmdir()
        except OSError:
            pass
        print(f"restaurado: {args.slug} → {dest}")
        print("corré machine scan para que vuelva a la lista")
        return
    sys.exit(f"machine: '{args.slug}' no está en la papelera")


def cmd_purge(args) -> None:
    if getattr(args, "slug", None) or getattr(args, "everything", False):
        targets = []
        for when, entry, projects in trash_entries():
            for name in projects:
                if getattr(args, "everything", False) or name == args.slug:
                    targets.append((entry, name))
        if not targets:
            where = "la papelera está vacía" if args.everything else f"'{args.slug}' no está en la papelera"
            sys.exit(f"machine: {where}")
        for entry, name in targets:
            if args.yes:
                shutil.rmtree(entry / name, ignore_errors=True)
                try:
                    entry.rmdir()
                except OSError:
                    pass
                print(f"borrado definitivo: {name}")
            else:
                print(f"borraría: {name} ({entry.name})")
        if not args.yes:
            print("repetí con --yes para borrar de verdad")
        return
    if args.days < 1:
        sys.exit("machine: --days tiene que ser >= 1")
    now = dt.datetime.now()
    doomed = [(w, e, p) for w, e, p in trash_entries() if (now - w).days >= args.days]
    if not doomed:
        print(f"nada con más de {args.days} días")
        return
    total = 0.0
    for when, entry, projects in doomed:
        size = sum(f.stat().st_size for f in entry.rglob("*") if f.is_file()) / (1024 * 1024)
        total += size
        print(f"{'borraría' if not args.yes else 'borrando'} {entry.name}  {', '.join(projects)}  {size:.1f}M")
        if args.yes:
            shutil.rmtree(entry, ignore_errors=True)
    print(f"{'borrado' if args.yes else 'pendiente'}: {total:.1f} MB")
    if not args.yes:
        print("repetí con --yes para borrar de verdad")


def main() -> None:
    p = argparse.ArgumentParser(prog="machine", description="el computador como base de datos")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("init", help="crea la base").set_defaults(func=cmd_init)
    sub.add_parser("scan", help="refresca hechos desde el disco").set_defaults(func=cmd_scan)

    ls = sub.add_parser("ls", help="lista entidades")
    ls.add_argument("--json", action="store_true")
    ls.add_argument("--kind")
    ls.add_argument("--state")
    ls.add_argument("--all", action="store_true", help="incluye tareas y todo")
    ls.set_defaults(func=cmd_ls)

    show = sub.add_parser("show", help="ficha de una entidad")
    show.add_argument("slug")
    show.add_argument("--json", action="store_true")
    show.set_defaults(func=cmd_show)

    s = sub.add_parser("set", help="cambia una decisión")
    s.add_argument("slug")
    s.add_argument("--state")
    s.add_argument("--kind")
    s.add_argument("--note")
    s.add_argument("--goal", help="objetivo en una frase")
    s.add_argument("--check", help="cómo se comprueba que funcionó")
    s.set_defaults(func=cmd_set)

    sub.add_parser("stats", help="conteos").set_defaults(func=cmd_stats)

    promo = sub.add_parser("promote", help="convierte una idea en proyecto")
    promo.add_argument("slug")
    promo.add_argument("--to", help="slug nuevo (el nombre de la carpeta futura)")
    promo.add_argument("--goal", help="objetivo en una frase")
    promo.add_argument("--check", help="cómo se comprueba que funcionó")
    promo.add_argument("--dod", help="(viejo) archivo markdown; se guarda como nota")
    promo.set_defaults(func=cmd_promote)

    idea = sub.add_parser("idea", help="captura una idea en texto libre (sin texto: lista)")
    idea.add_argument("text", nargs="*")
    idea.add_argument("--title", help="nombre corto (2-4 palabras)")
    idea.set_defaults(func=cmd_idea)

    ren = sub.add_parser("rename", help="cambia el nombre visible de un proyecto")
    ren.add_argument("slug")
    ren.add_argument("name", nargs="*")
    ren.add_argument("--auto", action="store_true", help="volver al nombre del README")
    ren.set_defaults(func=cmd_rename)

    svc = sub.add_parser("service-disable", help="para y deshabilita las units del proyecto")
    svc.add_argument("slug")
    svc.set_defaults(func=cmd_service_disable)

    trash = sub.add_parser("trash", help="manda la carpeta a la papelera (sin slug: lista la papelera)")
    trash.add_argument("slug", nargs="?")
    trash.add_argument("--yes", action="store_true")
    trash.add_argument("--github", action="store_true", help="borrar también el repo en GitHub")
    trash.add_argument("--json", action="store_true", help="lista la papelera en JSON")
    trash.set_defaults(func=cmd_trash)

    restore = sub.add_parser("restore", help="devuelve un proyecto de la papelera")
    restore.add_argument("slug")
    restore.set_defaults(func=cmd_restore)

    purge = sub.add_parser("purge", help="borra de la papelera lo más viejo que N días")
    purge.add_argument("--days", type=int, default=RETENTION_DAYS)
    purge.add_argument("--slug", help="borra un proyecto puntual de la papelera")
    purge.add_argument("--all", dest="everything", action="store_true", help="vacía la papelera")
    purge.add_argument("--yes", action="store_true")
    purge.set_defaults(func=cmd_purge)

    ghst = sub.add_parser("gh-status", help="si gh puede borrar repos")
    ghst.add_argument("--json", action="store_true")
    ghst.set_defaults(func=cmd_gh_status)

    task = sub.add_parser("task", help="tareas de un proyecto")
    task_sub = task.add_subparsers(dest="task_cmd", required=True)
    t_add = task_sub.add_parser("add")
    t_add.add_argument("slug")
    t_add.add_argument("title")
    t_add.add_argument("--note")
    t_add.set_defaults(func=cmd_task_add)
    t_done = task_sub.add_parser("done")
    t_done.add_argument("task")
    t_done.set_defaults(func=cmd_task_done)
    t_ls = task_sub.add_parser("ls")
    t_ls.add_argument("slug")
    t_ls.add_argument("--json", action="store_true")
    t_ls.set_defaults(func=cmd_task_ls)

    args = p.parse_args()
    if args.cmd == "trash" and args.slug is None:
        return cmd_trash_list(args)
    args.func(args)


if __name__ == "__main__":
    main()
