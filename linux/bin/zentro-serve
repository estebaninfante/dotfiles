#!/usr/bin/env bash
set -euo pipefail

export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin"

main_tree="${HOME}/developing/zentr0"

target="${1:-developing}"

case "$target" in
    developing|dev)
        tree="$main_tree"
        port="${ZENTRO_DEV_PORT:-3050}"
        ;;
    *)
        echo "uso: zentro-serve <developing>" >&2
        exit 2
        ;;
esac

if [ ! -d "$tree" ]; then
    echo "zentro-serve: no existe el arbol $tree" >&2
    exit 3
fi

cd "$tree"

if [ ! -e .env.local ] && [ -e "$main_tree/.env.local" ]; then
    ln -sfn "$main_tree/.env.local" .env.local
fi

if [ ! -d node_modules ]; then
    echo "zentro-serve: instalando dependencias en $tree" >&2
    pnpm install --frozen-lockfile || true
    if [ ! -d node_modules ]; then
        echo "zentro-serve: no se pudieron instalar las dependencias" >&2
        exit 4
    fi
fi

# Se sirve un BUILD de la rama activa (no `next dev`): Clerk no carga su UI
# fuera de `localhost` en modo dev (su handshake de desarrollo falla y el modal
# de login queda en blanco). En modo producción funciona en cualquier host.
# Rebuild automático si falta o si hay fuentes más nuevas que el build.
needs_build=0
if [ ! -f .next/BUILD_ID ]; then
    needs_build=1
elif [ -n "$(find app components lib modules hooks i18n messages proxy.ts next.config.mjs package.json \
    -newer .next/BUILD_ID -print -quit 2>/dev/null)" ]; then
    needs_build=1
fi

if [ "$needs_build" = "1" ]; then
    echo "zentro-serve: construyendo $tree" >&2
    pnpm build
fi

exec pnpm exec next start -p "$port"
