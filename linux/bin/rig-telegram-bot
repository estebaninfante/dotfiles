#!/usr/bin/env python3
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Optional

STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
RIG_STATE = STATE_HOME / "rig"
DEFAULT_EVENTS = RIG_STATE / "events.jsonl"
DEFAULT_STATE_DIR = RIG_STATE / "telegram"
TELEGRAM_MAX_CHARS = 3900
POLL_SECONDS = 25
FORWARD_INTERVAL = 1.0


def log(message: str) -> None:
    print("[rig-telegram-bot] " + message, file=sys.stderr, flush=True)


class Config:
    def __init__(self) -> None:
        self.token: str = os.environ.get("TELEGRAM_BOT_TOKEN", "").strip()
        self.api: str = os.environ.get("RIG_TELEGRAM_API", "https://api.telegram.org").rstrip("/")
        raw_allowed = os.environ.get("TELEGRAM_ALLOWED_CHAT_IDS", "")
        self.allowed: tuple[str, ...] = tuple(x.strip() for x in raw_allowed.split(",") if x.strip())
        self.seat: str = os.environ.get("RIG_SEAT", "main-seat")
        self.rig: str = os.environ.get("RIG_BIN") or shutil.which("rig") or str(Path.home() / ".local" / "bin" / "rig")
        self.prefix: str = os.environ.get("RIG_TELEGRAM_PREFIX", "[tg]")
        self.state_dir: Path = Path(os.environ.get("RIG_TELEGRAM_STATE_DIR") or DEFAULT_STATE_DIR)
        self.events_file: Path = Path(os.environ.get("RIG_EVENTS_FILE") or DEFAULT_EVENTS)
        self.stt_cmd: str = os.environ.get("RIG_STT_CMD", "").strip()

    def ready(self) -> Optional[str]:
        if not self.token:
            return "falta TELEGRAM_BOT_TOKEN (EnvironmentFile ~/.config/rig/telegram.env)"
        if not self.allowed:
            return "falta TELEGRAM_ALLOWED_CHAT_IDS (allowlist de tu chat)"
        return None


def api_call(cfg: Config, method: str, payload: dict[str, Any], timeout: float = 40.0) -> dict[str, Any]:
    url = f"{cfg.api}/bot{cfg.token}/{method}"
    body = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        parsed = json.loads(resp.read().decode("utf-8"))
    if not isinstance(parsed, dict):
        raise RuntimeError(f"{method}: respuesta no-objeto")
    if not parsed.get("ok", False):
        raise RuntimeError(f"{method}: {parsed.get('description', 'error')}")
    return parsed


def send_message(cfg: Config, chat_id: str, text: str) -> None:
    for chunk in split_chunks(text):
        api_call(cfg, "sendMessage", {"chat_id": chat_id, "text": chunk, "disable_web_page_preview": True})


def split_chunks(text: str) -> list[str]:
    if len(text) <= TELEGRAM_MAX_CHARS:
        return [text]
    out: list[str] = []
    rest = text
    while len(rest) > TELEGRAM_MAX_CHARS:
        cut = rest.rfind("\n", 0, TELEGRAM_MAX_CHARS)
        if cut <= 0:
            cut = TELEGRAM_MAX_CHARS
        out.append(rest[:cut])
        rest = rest[cut:].lstrip("\n")
    if rest:
        out.append(rest)
    return out


def emit(cfg: Config, kind: str, message: str) -> None:
    env = dict(os.environ)
    env["RIG_ACTOR"] = "telegram-bridge"
    try:
        subprocess.run([cfg.rig, "log", message, "--kind", kind], env=env,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except Exception as exc:
        log(f"emit {kind} fallo: {exc}")


def inject(cfg: Config, text: str) -> tuple[bool, str]:
    payload = f"{cfg.prefix} {text}"
    try:
        proc = subprocess.run([cfg.rig, "send", cfg.seat, payload],
                              capture_output=True, text=True, timeout=20)
    except Exception as exc:
        return False, str(exc)
    if proc.returncode != 0:
        return False, (proc.stderr or proc.stdout or "rig send fallo").strip()
    return True, ""


def transcribe(cfg: Config, file_id: str) -> Optional[str]:
    if not cfg.stt_cmd:
        return None
    try:
        info = api_call(cfg, "getFile", {"file_id": file_id})
        file_path = info["result"]["file_path"]
        url = f"{cfg.api}/file/bot{cfg.token}/{file_path}"
        with urllib.request.urlopen(url, timeout=60) as resp:
            data = resp.read()
        with tempfile.NamedTemporaryFile(suffix=Path(file_path).suffix or ".oga", delete=False) as tmp:
            tmp.write(data)
            tmp_path = tmp.name
        parts = cfg.stt_cmd.split() + [tmp_path]
        proc = subprocess.run(parts, capture_output=True, text=True, timeout=300)
        os.unlink(tmp_path)
        text = (proc.stdout or "").strip()
        return text or None
    except Exception as exc:
        log(f"transcribe fallo: {exc}")
        return None


def handle_update(cfg: Config, update: dict[str, Any]) -> None:
    msg = update.get("message") or update.get("edited_message") or {}
    chat = msg.get("chat") or {}
    chat_id = str(chat.get("id", ""))
    if chat_id not in cfg.allowed:
        emit(cfg, "telegram-reject", f"chat no autorizado: {chat_id}")
        return
    text = msg.get("text")
    if text is None:
        audio = msg.get("voice") or msg.get("audio")
        if audio:
            handle_voice(cfg, chat_id, audio)
        return
    if text.strip() in ("/start", "/help"):
        send_message(cfg, chat_id, "Bridge activo. Escribi y lo inyecto en main; su respuesta vuelve aca.")
        return
    ok, err = inject(cfg, text)
    emit(cfg, "telegram-in", f"{chat_id}: {text}")
    if not ok:
        emit(cfg, "telegram-error", f"inject fallo: {err}")
        send_message(cfg, chat_id, f"No pude hablar con main ({cfg.seat}): {err}")


def handle_voice(cfg: Config, chat_id: str, audio: dict[str, Any]) -> None:
    emit(cfg, "telegram-voice", f"{chat_id}: audio {audio.get('file_id', '')}")
    if not cfg.stt_cmd:
        send_message(cfg, chat_id, "Voz aun no soportada (fase 2: falta STT local). Escribi texto.")
        return
    text = transcribe(cfg, audio.get("file_id", ""))
    if not text:
        send_message(cfg, chat_id, "No pude transcribir el audio.")
        return
    send_message(cfg, chat_id, f"Transcrito: {text}")
    ok, err = inject(cfg, text)
    if not ok:
        emit(cfg, "telegram-error", f"inject voz fallo: {err}")


def load_cursor(cfg: Config) -> dict[str, int]:
    path = cfg.state_dir / "events.cursor.json"
    try:
        data = json.loads(path.read_text())
        return {"inode": int(data.get("inode", -1)), "offset": int(data.get("offset", 0))}
    except Exception:
        return {"inode": -1, "offset": 0}


def save_cursor(cfg: Config, inode: int, offset: int) -> None:
    cfg.state_dir.mkdir(parents=True, exist_ok=True)
    path = cfg.state_dir / "events.cursor.json"
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"inode": inode, "offset": offset}))
    tmp.replace(path)


def forward_replies(cfg: Config) -> int:
    path = cfg.events_file
    if not path.exists():
        return 0
    st = path.stat()
    cur = load_cursor(cfg)
    offset = cur["offset"] if cur["inode"] == st.st_ino and st.st_size >= cur["offset"] else 0
    with path.open("rb") as fh:
        fh.seek(offset)
        data = fh.read()
    if not data:
        save_cursor(cfg, st.st_ino, offset)
        return 0
    if data.endswith(b"\n"):
        complete = data
        consumed = len(data)
    else:
        idx = data.rfind(b"\n")
        if idx == -1:
            save_cursor(cfg, st.st_ino, offset)
            return 0
        complete = data[: idx + 1]
        consumed = idx + 1
    count = 0
    for line in complete.decode("utf-8", "replace").splitlines():
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except Exception:
            continue
        if event.get("kind") != "reply" or event.get("actor") != "main":
            continue
        data_obj = event.get("data") or {}
        if data_obj.get("to") != "telegram":
            continue
        text = data_obj.get("message") or event.get("summary") or ""
        if not text or not cfg.allowed:
            continue
        send_message(cfg, cfg.allowed[0], text)
        emit(cfg, "telegram-out", text)
        count += 1
    save_cursor(cfg, st.st_ino, offset + consumed)
    return count


def load_offset(cfg: Config) -> int:
    try:
        return int((cfg.state_dir / "offset").read_text().strip())
    except Exception:
        return 0


def save_offset(cfg: Config, offset: int) -> None:
    cfg.state_dir.mkdir(parents=True, exist_ok=True)
    (cfg.state_dir / "offset").write_text(str(offset))


def forward_loop(cfg: Config, stop: threading.Event) -> None:
    while not stop.is_set():
        try:
            forward_replies(cfg)
        except Exception as exc:
            log(f"forward fallo: {exc}")
        stop.wait(FORWARD_INTERVAL)


def poll_forever(cfg: Config, stop: threading.Event) -> None:
    offset = load_offset(cfg)
    while not stop.is_set():
        try:
            result = api_call(cfg, "getUpdates",
                              {"offset": offset, "timeout": POLL_SECONDS, "allowed_updates": ["message"]},
                              timeout=POLL_SECONDS + 15)
        except urllib.error.HTTPError as exc:
            log(f"getUpdates HTTP {exc.code}; reintento")
            stop.wait(5)
            continue
        except Exception as exc:
            log(f"getUpdates fallo: {exc}; reintento")
            stop.wait(5)
            continue
        for update in result.get("result", []):
            offset = int(update.get("update_id", offset)) + 1
            save_offset(cfg, offset)
            try:
                handle_update(cfg, update)
            except Exception as exc:
                log(f"update fallo: {exc}")


def run(cfg: Config) -> int:
    problem = cfg.ready()
    if problem:
        log("no arranco: " + problem)
        return 1
    log(f"escuchando; silla={cfg.seat} allowlist={cfg.allowed} events={cfg.events_file}")
    stop = threading.Event()

    def shutdown(signum: int, frame: Any) -> None:
        log(f"senal {signum}; saliendo")
        stop.set()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    worker = threading.Thread(target=forward_loop, args=(cfg, stop), daemon=True)
    worker.start()
    try:
        poll_forever(cfg, stop)
    finally:
        stop.set()
        worker.join(timeout=3)
    return 0


def selftest() -> int:
    import http.server

    tmp = Path(tempfile.mkdtemp(prefix="rig-tg-selftest."))
    events = tmp / "events.jsonl"
    events.write_text("")
    send_log = tmp / "sends.jsonl"
    send_log.write_text("")
    rig = tmp / "rig"
    rig.write_text(
        "#!/usr/bin/env python3\n"
        "import json, os, sys\n"
        "args = sys.argv[1:]\n"
        "open(os.environ['FAKE_SEND_LOG'], 'a').write(json.dumps(args) + '\\n')\n"
        "if args[:1] == ['send']:\n"
        "    ev = os.environ['RIG_EVENTS_FILE']\n"
        "    line = {'ts': '2026-01-01T00:00:00-05:00', 'kind': 'reply', 'actor': 'main',\n"
        "            'ticket': '', 'seat': 'main-seat', 'area': '', 'summary': 'respuesta de prueba',\n"
        "            'data': {'message': 'respuesta de prueba', 'to': 'telegram', 'len': 19}}\n"
        "    open(ev, 'a').write(json.dumps(line) + '\\n')\n"
        "sys.exit(0)\n"
    )
    rig.chmod(0o755)

    state: dict[str, Any] = {"sends": [], "updates": [
        {"update_id": 1, "message": {"message_id": 10, "chat": {"id": 123}, "text": "hola main"}}
    ]}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args: Any) -> None:
            return

        def _reply(self, payload: dict[str, Any]) -> None:
            body = json.dumps(payload).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self) -> None:
            length = int(self.headers.get("Content-Length", "0"))
            payload = json.loads(self.rfile.read(length) or b"{}")
            method = self.path.rsplit("/", 1)[-1]
            if method == "getUpdates":
                updates = state["updates"]
                state["updates"] = []
                self._reply({"ok": True, "result": updates})
            elif method == "sendMessage":
                state["sends"].append(payload.get("text", ""))
                self._reply({"ok": True, "result": {"message_id": 1}})
            else:
                self._reply({"ok": True, "result": {}})

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    port = server.server_address[1]
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()

    os.environ.update({
        "TELEGRAM_BOT_TOKEN": "selftest",
        "RIG_TELEGRAM_API": f"http://127.0.0.1:{port}",
        "TELEGRAM_ALLOWED_CHAT_IDS": "123",
        "RIG_SEAT": "main-seat",
        "RIG_BIN": str(rig),
        "RIG_EVENTS_FILE": str(events),
        "RIG_TELEGRAM_STATE_DIR": str(tmp / "state"),
        "FAKE_SEND_LOG": str(send_log),
    })

    failures: list[str] = []
    try:
        cfg = Config()
        problem = cfg.ready()
        if problem:
            failures.append(f"config no lista: {problem}")
        handle_update(cfg, state["updates"][0])
        sent = [json.loads(x) for x in send_log.read_text().splitlines() if x.strip()]
        if not any(a[:3] == ["send", "main-seat", "[tg] hola main"] for a in sent):
            failures.append(f"no inyecto en la silla: {sent}")
        forwarded = forward_replies(cfg)
        if forwarded != 1:
            failures.append(f"forward conto {forwarded}, esperaba 1")
        if "respuesta de prueba" not in state["sends"]:
            failures.append(f"respuesta no llego al chat: {state['sends']}")
        again = forward_replies(cfg)
        if again != 0:
            failures.append(f"reenvio duplicado: {again}")
    except Exception as exc:
        failures.append(f"excepcion: {exc}")
    finally:
        server.shutdown()
        shutil.rmtree(tmp, ignore_errors=True)

    if failures:
        for item in failures:
            print("rig-telegram-bot selftest FAIL: " + item, file=sys.stderr)
        return 1
    print("rig-telegram-bot selftest OK")
    return 0


def main(argv: list[str]) -> int:
    if "--selftest" in argv:
        return selftest()
    if "--help" in argv or "-h" in argv:
        print("rig-telegram-bot [--selftest] [--once]\n"
              "  puente Telegram <-> main: mensajes entran a la silla (rig send),\n"
              "  las respuestas (rig say, kind=reply) vuelven al chat.\n"
              "  Config por EnvironmentFile: TELEGRAM_BOT_TOKEN, TELEGRAM_ALLOWED_CHAT_IDS,\n"
              "  RIG_SEAT, RIG_EVENTS_FILE, RIG_BIN, RIG_STT_CMD (opcional).")
        return 0
    cfg = Config()
    if "--once" in argv:
        problem = cfg.ready()
        if problem:
            log("no arranco: " + problem)
            return 1
        forward_replies(cfg)
        return 0
    return run(cfg)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
