#!/usr/bin/env bash
# PrintScreen: un solo overlay para elegir entre capturar imagen o grabar.
# Si ya hay una grabación en curso, la primera fila pasa a "Detener grabación".
# Usa el menú de Omarchy (Quickshell), el mismo que Súper+Espacio.

set -uo pipefail

recording() { pgrep -f '^gpu-screen-recorder' >/dev/null; }

rows=()
if recording; then
    rows+=("󰓛	Detener grabación")
else
    rows+=("󰻂	Grabar pantalla")
fi
rows+=("󰹑	Captura de imagen")
rows+=("󰖲	Captura de ventana")
rows+=("󰹹	Captura de pantalla completa")

selection=$(omarchy-menu-select "Capturar" "${rows[@]}" -- --width 460) || exit 0
label=${selection##*$'\t'}

case "$label" in
    "Detener grabación"|"Grabar pantalla") exec ~/.local/bin/screenrecord-toggle ;;
    "Captura de imagen")                   exec ~/.local/bin/shot ;;
    "Captura de ventana")                  exec ~/.local/bin/shot active ;;
    "Captura de pantalla completa")        exec ~/.local/bin/shot full ;;
esac
