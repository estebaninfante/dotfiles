#!/usr/bin/env bash
# PrintScreen y Shift+Print congelan la pantalla y entran directo a la zona:
# Print captura, Shift+Print graba. Arrastrar toma esa área; un clic toma la
# ventana bajo el puntero. La barra cambia entre capturar y grabar y ofrece la
# pantalla completa; la ventana es un clic dentro de la zona, no una opción
# aparte.
#
# La imagen congelada es un PNG que saca este script ANTES de mostrar el
# overlay, así que ni la barra ni el resaltado entran en la captura: las
# imágenes se recortan del PNG original. Para grabar se oculta el overlay y
# se espera a que el compositor lo saque de pantalla antes de arrancar.

set -uo pipefail

# Opción preseleccionada: "image" (Print) o "record" (Shift+Print).
default_action="${1:-image}"
case "$default_action" in
    image|record) ;;
    *) default_action=image ;;
esac

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/capture-menu"
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/lock"
flock -n 9 || exit 0

# Las capturas se guardan para que el aviso pueda abrirlas en el explorador.
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
SHOTS_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"

# wl-copy/notify daemonizan y heredarían fd 9: sin esto el lock queda tomado
# para siempre y la próxima captura sale muda.
nofd() { "$@" 9>&-; }

frame="$STATE_DIR/frame.png"
selection_file="$STATE_DIR/selection"
done_file="$STATE_DIR/done"
rm -f "$frame" "$selection_file" "$done_file"

# Detener una grabación en curso sin abrir el overlay: si no, la barra
# quedaría filmada en el video.
if pgrep -f '^gpu-screen-recorder' >/dev/null; then
    exec 9>&-
    exec ~/.local/bin/screenrecord-toggle
fi

# Congelar primero: el PNG queda sin overlay.
if ! grim "$frame" 2>/dev/null || [[ ! -s $frame ]]; then
    nofd notify -u critical -g "󰅚" --app-name capture-menu \
        "No se pudo congelar la pantalla" "grim no devolvió imagen" 2>/dev/null || true
    exit 1
fi

payload=$(jq -cn \
    --arg selectionFile "$selection_file" \
    --arg doneFile "$done_file" \
    --arg imagePath "$frame" \
    --arg defaultAction "$default_action" \
    '{selectionFile: $selectionFile, doneFile: $doneFile, imagePath: $imagePath, defaultAction: $defaultAction}')

if ! omarchy-shell shell summon eztvn.capture-menu "$payload" >/dev/null 2>&1; then
    nofd notify -u critical -g "󰅚" --app-name capture-menu \
        "Overlay no disponible" "Revisar: omarchy plugin enable eztvn.capture-menu" 2>/dev/null || true
    exit 1
fi

# Espera la tecla (o la cancelación) desde el plugin. Si el overlay desaparece
# sin dejar `done` (recarga o reinicio del shell), se aborta: si no, el lock
# quedaría tomado 90 s y la próxima captura saldría muda.
overlay_seen=0
tick=0
for _ in $(seq 1 1800); do
    [[ -e $done_file ]] && break
    tick=$((tick + 1))
    if (( tick % 5 == 0 )); then
        if hyprctl layers -j 2>/dev/null | grep -q '"namespace": *"capture-menu"'; then
            overlay_seen=1
        elif ((overlay_seen)); then
            exit 0
        fi
    fi
    sleep 0.05
done
[[ -e $done_file ]] || exit 0

# Escape / clic fuera: el plugin deja el archivo de selección vacío.
[[ -s $selection_file ]] || exit 0
key=$(<"$selection_file")

wait_overlay_gone() {
    for _ in $(seq 1 100); do
        hyprctl layers -j 2>/dev/null | grep -q '"namespace": *"capture-menu"' || return 0
        sleep 0.02
    done
}

copy_png() {
    local file="$1" label="$2" dest n=1
    [[ -s $file ]] || return 1
    mkdir -p "$SHOTS_DIR"
    dest="$SHOTS_DIR/captura-$(date +%F_%H-%M-%S).png"
    while [[ -e $dest ]]; do
        dest="$SHOTS_DIR/captura-$(date +%F_%H-%M-%S)-$n.png"
        n=$((n + 1))
    done
    cp -f "$file" "$dest" || return 1
    nofd wl-copy --type image/png <"$dest"
    if command -v omarchy-notification-send >/dev/null 2>&1; then
        nofd omarchy-notification-send --app-name shot -g "󰹑" -t 6000 \
            --image "$dest" \
            "Captura copiada" "$label · Clic: copiar y abrir" \
            --exec ~/.local/bin/capture-open image "$dest"
    else
        nofd notify -g "󰹑" -t 3000 --app-name shot --image "$dest" \
            "Captura copiada" "$label"
    fi
}

# Coordenadas del PNG congelado → recorte a clipboard.
copy_region() {
    local x=$1 y=$2 w=$3 h=$4
    local dims iw ih
    dims=$(magick identify -format '%w %h' "$frame" 2>/dev/null) || return 1
    read -r iw ih <<<"$dims"

    # Clamp: las coordenadas del mouse pueden redondear un píxel de más.
    (( x < 0 )) && { w=$((w + x)); x=0; }
    (( y < 0 )) && { h=$((h + y)); y=0; }
    (( x + w > iw )) && w=$((iw - x))
    (( y + h > ih )) && h=$((ih - y))
    (( w > 0 && h > 0 )) || return 1

    magick "$frame" -crop "${w}x${h}+${x}+${y}" +repage "png:$STATE_DIR/crop.png" || return 1
    copy_png "$STATE_DIR/crop.png" "${w}×${h}"
}

# Ventana visible bajo un punto lógico global. Devuelve "WxH+X+Y|monitor" con
# la ventana más reciente en foco (proxy del z-order de Hyprland, que no
# expone el orden de apilado). Vacío si el clic cayó en el escritorio.
window_at() {
    local x=$1 y=$2 ws
    ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 0')
    hyprctl clients -j 2>/dev/null | jq -r --argjson x "$x" --argjson y "$y" --argjson ws "$ws" '
        [ .[] | select(.mapped and (.hidden | not) and (.workspace.id == $ws))
          | select(.at != null and .size != null)
          | select(.at[0] <= $x and $x < (.at[0] + .size[0]) and
                   .at[1] <= $y and $y < (.at[1] + .size[1]))
          | { g: "\(.size[0])x\(.size[1])+\(.at[0])+\(.at[1])",
              m: .monitor,
              f: (.focusHistoryID // 999) } ]
        | sort_by(.f) | if length > 0 then "\(.[0].g)|\(.[0].m)" else empty end'
}

monitor_scale() {
    hyprctl monitors -j 2>/dev/null |
        jq -r --argjson id "${1:-0}" '.[] | select(.id == $id) | .scale' | head -1
}

# Geometría lógica de ventana → píxeles del PNG congelado.
logical_to_crop() {
    local geom=$1 scale=$2 w h x y
    IFS=x+ read -r w h x y <<<"$geom"
    awk -v s="$scale" -v x="$x" -v y="$y" -v w="$w" -v h="$h" \
        'BEGIN { printf "%d,%d,%d,%d", x*s, y*s, w*s, h*s }'
}

case "$key" in
    record)
        # Ocultar el overlay antes de arrancar: no debe quedar filmado.
        wait_overlay_gone
        sleep 0.12
        exec 9>&-
        exec ~/.local/bin/screenrecord-toggle
        ;;
    region:*)
        IFS=, read -r rx ry rw rh <<<"${key#region:}"
        copy_region "$rx" "$ry" "$rw" "$rh"
        ;;
    videoregion:*)
        # Coordenadas lógicas (las mismas que slurp): gpu-screen-recorder graba
        # sólo esa zona. El overlay debe salir del compositor antes de arrancar.
        IFS=, read -r gx gy gw gh <<<"${key#videoregion:}"
        if [[ ! $gx =~ ^[0-9]+$ || ! $gy =~ ^[0-9]+$ || ! $gw =~ ^[0-9]+$ || ! $gh =~ ^[0-9]+$ ]] ||
            ((gw < 4 || gh < 4)); then
            nofd notify -u critical -g "󰅚" --app-name shot \
                "Grabación cancelada" "La zona elegida es demasiado pequeña." 2>/dev/null || true
            exit 1
        fi
        wait_overlay_gone
        sleep 0.12
        exec 9>&-
        exec ~/.local/bin/screenrecord-toggle --region "${gw}x${gh}+${gx}+${gy}"
        ;;
    windowat:*)
        IFS=, read -r cx cy <<<"${key#windowat:}"
        hit=$(window_at "$cx" "$cy")
        # Clic en el escritorio: cancela (el overlay ya se está cerrando).
        [[ -n $hit ]] || exit 0
        geom=${hit%|*}
        scale=$(monitor_scale "${hit##*|}")
        [[ -n $scale && $scale != null ]] || scale=1
        IFS=, read -r px py pw ph < <(logical_to_crop "$geom" "$scale")
        copy_region "$px" "$py" "$pw" "$ph"
        ;;
    recordwindowat:*)
        IFS=, read -r cx cy <<<"${key#recordwindowat:}"
        hit=$(window_at "$cx" "$cy")
        # Clic en el escritorio: cancela (el overlay ya se está cerrando).
        [[ -n $hit ]] || exit 0
        geom=${hit%|*}
        wait_overlay_gone
        sleep 0.12
        exec 9>&-
        exec ~/.local/bin/screenrecord-toggle --region "$geom"
        ;;
    full)
        magick "$frame" +repage "png:$STATE_DIR/full.png" 2>/dev/null || cp "$frame" "$STATE_DIR/full.png"
        copy_png "$STATE_DIR/full.png" "Pantalla completa"
        ;;
esac
