#!/usr/bin/env bash
# lan-mouse-streaming on|off — suelta el KVM mientras se streamea.
#
# on:  deactiva toda captura activa y para el daemon. Con Moonlight abierto la
#      captura del borde manda el puntero a la otra máquina; adentro del stream
#      eso se realimenta y el mouse "desaparece" sin forma de volver.
# off: vuelve a levantar el daemon (idempotente).
#
# Lo llama moonlight.lua (sync cada 3 s, con memo del último estado).
set -uo pipefail

case "${1:-}" in
    on | off) ;;
    *)
        printf 'usage: %s on|off\n' "$(basename "$0")" >&2
        exit 2
        ;;
esac

if [ "$1" = on ]; then
    if /usr/bin/pgrep -x lan-mouse >/dev/null 2>&1; then
        lan-mouse cli list 2>/dev/null |
            sed -n 's/^id \([0-9][0-9]*\):.*active: true.*/\1/p' |
            while read -r id; do
                lan-mouse cli deactivate "$id" >/dev/null 2>&1 || true
            done
    fi
    systemctl --user stop lan-mouse.service >/dev/null 2>&1 || true
    echo "lan-mouse: off (streaming)"
else
    systemctl --user start lan-mouse.service >/dev/null 2>&1 || true
    echo "lan-mouse: on"
fi
