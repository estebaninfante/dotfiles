#!/usr/bin/env python3
"""mic-bt-fx: micrófono del audífono Bluetooth -> efectos -> fuente "mic-bt-fx".

Por qué existe: los audífonos Bluetooth baratos entregan el micrófono por HFP
(16 kHz mono, con el AGC del chip). Eso da picos, bombeo y ruido. Acá se limpia
la señal antes de que la use cualquier app, y se expone como una fuente normal
que pueden elegir Zoom, Meet, el navegador o mic-lab.

Se activa solo cuando alguna app está leyendo "mic-bt-fx": mientras nadie lo
usa, suelta el audífono para que vuelva a sonar en alta calidad (A2DP).

Ojo con el perfil: cambiarlo destruye y recrea los nodos de sonido del
audífono, y eso corta lo que se esté escuchando. Por eso, al dejar de usar el
micrófono, se espera MIC_BT_HOLD segundos (12 por defecto) antes de volver a
A2DP: si la app vuelve a abrir el micrófono en ese rato, no se cambia nada.
Sin esa espera, una app que abre y cierra el micrófono (WhatsApp Web al
contestar, por ejemplo) hacía que el perfil oscilara y la llamada quedara muda.

Ajustar los parámetros -> ~/.config/mic-lab/fx.json (o desde mic-lab) y
reiniciar: systemctl --user restart mic-bt-fx
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

RATE = 48000
MAC = os.environ.get("MIC_BT_MAC", "50:C0:F0:00:00:D1")
SRC = os.environ.get("MIC_BT_TARGET", f"bluez_input.{MAC}")
OUT_SINK = os.environ.get("MIC_BT_SINK", "mic_bt_fx_sink")
MUSIC_PROFILE = os.environ.get("MIC_BT_MUSIC_PROFILE", "a2dp-sink")
VIRTUAL = "mic-bt-fx"
CALL_PROFILE = os.environ.get("MIC_BT_CALL_PROFILE", "headset-head-unit")
HOLD_S = float(os.environ.get("MIC_BT_HOLD", "12"))
CARD = "bluez_card." + MAC.replace(":", "_")

CONF_DIR = Path(os.environ.get("MIC_LAB_CONF", Path.home() / ".config" / "mic-lab"))
CONF = CONF_DIR / "fx.json"

DEFAULTS = {
    "hp_freq": 90.0,
    "denoise": False,
    "eq_mud_gain": -3.0,
    "eq_presence_gain": 2.0,
    "gate_threshold_db": -70.0,  # -70 = puerta apagada
    "gate_range_db": -25.0,
    "comp_threshold_db": -32.0,
    "comp_ratio": 2.5,
    "makeup_db": 12.0,
    "limiter_ceiling_db": -3.0,
}


def lin(db: float) -> float:
    return 10 ** (db / 20.0)


def load_conf() -> dict:
    cfg = dict(DEFAULTS)
    try:
        cfg.update(json.loads(CONF.read_text()))
    except Exception:
        pass
    return cfg


def build_filter(cfg: dict) -> str:
    p = []
    if cfg["hp_freq"] > 20:
        p.append(f"highpass=f={cfg['hp_freq']:.0f},highpass=f={cfg['hp_freq']:.0f}")
    if cfg["denoise"]:
        p.append("afftdn=nr=10:nf=-55:tn=1")
    if abs(cfg["eq_mud_gain"]) >= 0.5:
        p.append(f"equalizer=f=250:width_type=q:w=1.2:g={cfg['eq_mud_gain']:.1f}")
    if abs(cfg["eq_presence_gain"]) >= 0.5:
        p.append(f"equalizer=f=3500:width_type=q:w=1:g={cfg['eq_presence_gain']:.1f}")
    if cfg["gate_threshold_db"] > -70:
        p.append(
            "agate="
            f"threshold={lin(cfg['gate_threshold_db']):.6f}:"
            f"range={lin(cfg['gate_range_db']):.6f}:ratio=2:attack=5:release=250"
        )
    if cfg["comp_ratio"] >= 1.2:
        p.append(
            "acompressor="
            f"threshold={lin(cfg['comp_threshold_db']):.6f}:"
            f"ratio={cfg['comp_ratio']:.1f}:attack=12:release=180:"
            f"makeup={lin(cfg['makeup_db']):.3f}"
        )
    p.append(f"alimiter=limit={lin(cfg['limiter_ceiling_db']):.4f}:level=0")
    return ",".join(p)


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def virtual_in_use() -> bool:
    out = run(["pactl", "list", "short", "sources"]).stdout
    idx = None
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) > 1 and parts[1] == VIRTUAL:
            idx = parts[0]
    if idx is None:
        return False
    outs = run(["pactl", "list", "short", "source-outputs"]).stdout
    for line in outs.splitlines():
        parts = line.split("\t")
        if len(parts) > 1 and parts[1] == idx:
            return True
    return False


def device_connected() -> bool:
    out = run(["bluetoothctl", "info", MAC], timeout=5).stdout
    return "Connected: yes" in out


def card_profile() -> str:
    """Perfil activo de la placa Bluetooth ("" si no está)."""
    out = run(["pactl", "list", "cards"]).stdout
    in_card = False
    for line in out.splitlines():
        if line.startswith("Card #"):
            in_card = False
        elif line.strip() == f"Name: {CARD}":
            in_card = True
        elif in_card and line.strip().startswith("Active Profile:"):
            return line.split(":", 1)[1].strip()
    return ""


def source_ready() -> bool:
    out = run(["pactl", "list", "short", "sources"]).stdout
    return any(SRC in line for line in out.splitlines())


def ensure_headset_profile() -> None:
    if card_profile() == CALL_PROFILE:
        return
    run(["pactl", "set-card-profile", CARD, CALL_PROFILE])


def bluez_sink() -> str:
    """Nombre de la salida Bluetooth actual ("" si no hay)."""
    out = run(["pactl", "list", "short", "sinks"]).stdout
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) > 1 and parts[1].startswith("bluez_output."):
            return parts[1]
    return ""


def sink_inputs_on(sink: str) -> list[str]:
    """IDs de los streams que están sonando en `sink`."""
    if not sink:
        return []
    ids = []
    out = run(["pactl", "list", "short", "sink-inputs"]).stdout
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) > 2 and parts[2] == sink:
            ids.append(parts[0])
    return ids


def follow_sink(old_sink: str) -> None:
    """Recolgar en la salida nueva lo que sonaba en la salida vieja.

    Al cambiar de perfil el nodo del audífono se recrea y los links viejos
    quedan en error. Si el nombre cambió, movemos los streams a mano: es lo
    que evita que una llamada en curso se quede sin audio.
    """
    for _ in range(20):
        new = bluez_sink()
        if new and new != old_sink:
            for idx in sink_inputs_on(old_sink):
                run(["pactl", "move-sink-input", idx, new])
            return
        if new == old_sink:
            return
        time.sleep(0.15)


def restore_profile(prev: str) -> None:
    """Devuelve el auricular a música cuando ya nadie usa el micrófono.

    HFP y A2DP son excluyentes: al usar el micrófono la placa queda en modo
    llamada y WirePlumber no lo revierte solo. Si no lo devolviéramos, todo
    lo que suene después (música, videos) saldría mono a 16 kHz, como una
    llamada, hasta desconectar el auricular.
    """
    target = prev if prev.startswith("a2dp") else MUSIC_PROFILE
    cur = card_profile()
    if not cur or cur == target:
        return
    if cur.startswith("headset"):
        run(["pactl", "set-card-profile", CARD, target])


def pipeline() -> subprocess.Popen:
    fx = build_filter(load_conf())
    cap = (
        f"pw-record --target {SRC} --rate {RATE} --channels 1 --raw "
        f"--format f32 --latency 20ms -"
    )
    ff = (
        f"ffmpeg -hide_banner -loglevel error -fflags nobuffer "
        f"-f f32le -ar {RATE} -ac 1 -i pipe:0 -af '{fx}' "
        f"-f f32le -ar {RATE} -ac 1 pipe:1"
    )
    play = (
        f"pw-cat --playback --raw --target {OUT_SINK} --rate {RATE} "
        f"--channels 1 --format f32 --latency 20ms -"
    )
    # Un solo sh para poder cerrar toda la tubería de una.
    return subprocess.Popen(
        ["/bin/sh", "-c", f"{cap} | {ff} | {play}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def stop(proc: subprocess.Popen | None) -> None:
    if proc is None:
        return
    try:
        os.killpg(proc.pid, 15)
    except Exception:
        try:
            proc.terminate()
        except Exception:
            pass
    try:
        proc.wait(timeout=2)
    except Exception:
        pass


def main() -> int:
    if not CONF.exists():
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        CONF.write_text(json.dumps(DEFAULTS, indent=2))
    proc = None
    active = False
    prev_profile = ""
    idle_since: float | None = None
    while True:
        want = virtual_in_use()
        if want and not active:
            if not device_connected():
                time.sleep(3)
                continue
            # Recordar si venía en A2DP para devolverlo igual al terminar.
            if not prev_profile:
                prev_profile = card_profile()
            idle_since = None
            old_sink = bluez_sink()
            ensure_headset_profile()
            # El nodo de captura tarda en aparecer tras el cambio de perfil:
            # si arrancamos antes, pw-record no engancha y el mic queda mudo.
            for _ in range(20):
                if source_ready():
                    break
                time.sleep(0.15)
            proc = pipeline()
            active = True
            follow_sink(old_sink)
        elif not want and active:
            # Esperar a que la app realmente suelte el micrófono: si vuelve a
            # abrirlo enseguida, no tocamos el perfil (ver docstring).
            if idle_since is None:
                idle_since = time.monotonic()
            elif time.monotonic() - idle_since >= HOLD_S:
                stop(proc)
                proc, active = None, False
                idle_since = None
                time.sleep(0.3)  # soltar el transporte antes de cambiar de perfil
                restore_profile(prev_profile)
                prev_profile = ""
        elif active and proc and proc.poll() is not None:
            # Se cortó el audífono o cambió el perfil: reintentar.
            stop(proc)
            proc, active = None, False
            idle_since = None
            time.sleep(1.5)
        else:
            idle_since = None
        time.sleep(1.0)


if __name__ == "__main__":
    sys.exit(main())
