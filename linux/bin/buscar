#!/usr/bin/env node
/**
 * buscar — búsqueda en internet desde la terminal (DuckDuckGo).
 *
 * Uso:
 *   buscar "consulta"            # 6 resultados en texto
 *   buscar "consulta" -n 10      # más resultados
 *   buscar "consulta" --json     # salida JSON
 *   buscar --leer <url>          # abrir una URL y devolver su texto
 *
 * Es el mismo motor que usa la tool `buscar_web` de pi, para tener un respaldo
 * desde el shell. Sin dependencias: fetch + regex.
 */
const UA =
  process.env.PI_BUSCAR_UA ??
  "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36";

const decode = (s) =>
  s
    .replace(/&amp;/g, "&").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"').replace(/&#x27;|&#39;/g, "'").replace(/&nbsp;/g, " ")
    .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
    .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(Number.parseInt(h, 16)));
const strip = (s) => decode(s.replace(/<[^>]*>/g, " ")).replace(/\s+/g, " ").trim();
const urlReal = (h) => {
  const m = h.match(/[?&]uddg=([^&]+)/);
  if (m) { try { return decodeURIComponent(m[1]); } catch { return h; } }
  return h.startsWith("//") ? "https:" + h : h;
};

async function buscar(consulta, limite) {
  const url = `https://html.duckduckgo.com/html/?q=${encodeURIComponent(consulta)}&kl=ar-es`;
  const res = await fetch(url, {
    headers: { "User-Agent": UA, "Accept-Language": "es-AR,es;q=0.9,en;q=0.8" },
    signal: AbortSignal.timeout(20000),
  });
  if (!res.ok) throw new Error(`DuckDuckGo respondió HTTP ${res.status}`);
  const html = await res.text();
  const links = [];
  let m;
  const linkRe = /<a[^>]*class="result__a"[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/g;
  while ((m = linkRe.exec(html))) links.push({ url: urlReal(m[1]), title: strip(m[2]), at: m.index });
  const snips = [];
  const snipRe = /<a[^>]*class="result__snippet"[^>]*>([\s\S]*?)<\/a>/g;
  while ((m = snipRe.exec(html))) snips.push({ text: strip(m[1]), at: m.index });
  return links.slice(0, limite).map((l) => ({
    title: l.title,
    url: l.url,
    snippet: (snips.find((s) => s.at > l.at) || {}).text || "",
  }));
}

function htmlATexto(html) {
  return decode(
    html
      .replace(/<script[\s\S]*?<\/script>/gi, " ")
      .replace(/<style[\s\S]*?<\/style>/gi, " ")
      .replace(/<noscript[\s\S]*?<\/noscript>/gi, " ")
      .replace(/<(nav|header|footer|aside|form|svg|template)[\s\S]*?<\/\1>/gi, " ")
      .replace(/<\/(p|div|li|h[1-6]|tr|section|article|blockquote)>/gi, "\n")
      .replace(/<br\s*\/?>/gi, "\n"),
  ).replace(/[ \t]+/g, " ").replace(/\n[ \t]+/g, "\n").replace(/\n{3,}/g, "\n\n").trim();
}

async function leer(url, max) {
  const res = await fetch(url, {
    headers: { "User-Agent": UA, "Accept-Language": "es,en;q=0.8" },
    redirect: "follow",
    signal: AbortSignal.timeout(25000),
  });
  if (!res.ok) throw new Error(`la página respondió HTTP ${res.status}`);
  const ct = res.headers.get("content-type") ?? "";
  const cuerpo = await res.text();
  const texto = ct.includes("html") || cuerpo.trimStart().startsWith("<") ? htmlATexto(cuerpo) : cuerpo;
  return texto.length > max ? texto.slice(0, max) + `\n\n[…recortado a ${max} caracteres]` : texto;
}

async function main() {
  const args = process.argv.slice(2);
  let limite = 6;
  let json = false;
  let leerUrl = null;
  const resto = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "-n" || a === "--n") limite = Number(args[++i]) || 6;
    else if (a === "--json") json = true;
    else if (a === "--leer") leerUrl = args[++i];
    else resto.push(a);
  }

  if (leerUrl) {
    process.stdout.write((await leer(leerUrl, 12000)) + "\n");
    return;
  }
  const consulta = resto.join(" ").trim();
  if (!consulta) {
    console.error('Uso: buscar "consulta" [-n N] [--json]  ·  buscar --leer <url>');
    process.exit(2);
  }
  const resultados = await buscar(consulta, limite);
  if (json) {
    process.stdout.write(JSON.stringify({ consulta, resultados }, null, 2) + "\n");
    return;
  }
  if (!resultados.length) {
    process.stdout.write(`Sin resultados para «${consulta}».\n`);
    return;
  }
  for (const [i, r] of resultados.entries()) {
    process.stdout.write(`${i + 1}. ${r.title}\n   ${r.url}\n   ${r.snippet || "(sin resumen)"}\n\n`);
  }
}

main().catch((err) => {
  console.error(`buscar: ${err.message}`);
  process.exit(1);
});
