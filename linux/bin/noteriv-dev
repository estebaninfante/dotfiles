#!/usr/bin/env bash
set -euo pipefail

readonly PROJECT_DIR="${HOME}/Projects/noteriv/desktop"
readonly CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/noteriv-dev"
readonly LOG_FILE="${CACHE_DIR}/dev.log"
readonly PID_FILE="${CACHE_DIR}/dev.pid"
readonly DEV_PORT=3456
readonly DEV_URL="http://localhost:${DEV_PORT}"
readonly WM_CLASS="noteriv"
readonly LOG_MAX_BYTES=$((5 * 1024 * 1024))
readonly STOP_STEPS=40
readonly STOP_STEP_SECONDS=0.25

MODE=background

usage() {
  cat >&2 <<'EOF'
uso: noteriv-dev [opcion]

  (sin opcion)   lanza Noteriv en modo desarrollo (background + hot-reload)
  --foreground   ejecuta el stack en primer plano (debug)
  --stop         detiene el stack de desarrollo de este proyecto
  -h, --help     muestra esta ayuda
EOF
}

log() { printf 'noteriv-dev: %s\n' "$*"; }
die() { printf 'noteriv-dev: %s\n' "$*" >&2; exit 1; }
ensure_cache() { mkdir -p "$CACHE_DIR"; }
read_pid() { if [ -f "$PID_FILE" ]; then cat "$PID_FILE" 2>/dev/null || true; fi; }
alive() { local pid="$1"; [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }
port_busy() { ss -ltnH "sport = :${DEV_PORT}" 2>/dev/null | grep -q .; }

project_pids() {
  local dir pid cwd cmd
  for dir in /proc/[0-9]*; do
    pid="${dir##*/}"
    [ "$pid" = "$$" ] && continue
    cwd="$(readlink "${dir}/cwd" 2>/dev/null || true)"
    case "$cwd" in
      "$PROJECT_DIR"|"$PROJECT_DIR"/*) ;;
      *) continue ;;
    esac
    cmd="$(tr '\0' ' ' < "${dir}/cmdline" 2>/dev/null || true)"
    case "$cmd" in
      *concurrently*|*tauri*dev*|*next*dev*|*noteriv*) printf '%s\n' "$pid" ;;
    esac
  done
}

stack_running() {
  local pid
  pid="$(read_pid)"
  if alive "$pid"; then return 0; fi
  if port_busy; then return 0; fi
  if [ -n "$(project_pids)" ]; then return 0; fi
  return 1
}

focus_window() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  hyprctl dispatch focuswindow "class:^(${WM_CLASS})$" >/dev/null 2>&1 || true
}

rotate_log() {
  ensure_cache
  local size
  size="$(stat -c%s "$LOG_FILE" 2>/dev/null || printf '0')"
  if [ "${size:-0}" -gt "$LOG_MAX_BYTES" ]; then mv -f "$LOG_FILE" "${LOG_FILE}.1"; fi
}

require_project() {
  [ -d "$PROJECT_DIR" ] || die "no existe ${PROJECT_DIR}"
  [ -f "${PROJECT_DIR}/package.json" ] || die "falta ${PROJECT_DIR}/package.json"
}

ensure_deps() {
  if [ ! -d "${PROJECT_DIR}/node_modules" ]; then
    log "node_modules ausente, ejecutando npm install"
    ( cd "$PROJECT_DIR" && npm install )
  fi
}

stop_stack() {
  local pid pids
  if ! stack_running; then
    log "no hay stack de desarrollo corriendo"
    rm -f "$PID_FILE"
    return 0
  fi
  log "deteniendo stack de desarrollo..."
  pid="$(read_pid)"
  if alive "$pid"; then
    kill -TERM -- "-${pid}" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    local _
    for _ in $(seq 1 "$STOP_STEPS"); do
      if ! alive "$pid"; then break; fi
      sleep "$STOP_STEP_SECONDS"
    done
    if alive "$pid"; then kill -KILL -- "-${pid}" 2>/dev/null || true; fi
  fi
  rm -f "$PID_FILE"
  pids="$(project_pids)"
  if [ -n "$pids" ]; then
    printf '%s\n' "$pids" | xargs -r kill -TERM 2>/dev/null || true
    sleep 1
    pids="$(project_pids)"
    if [ -n "$pids" ]; then
      printf '%s\n' "$pids" | xargs -r kill -KILL 2>/dev/null || true
    fi
  fi
  log "stack detenido"
}

launch_background() {
  rotate_log
  log "lanzando en background (log: ${LOG_FILE})"
  ( cd "$PROJECT_DIR" && exec setsid npm run dev ) >>"$LOG_FILE" 2>&1 </dev/null &
  local pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"
  sleep 1
  if ! alive "$pid"; then
    log "el proceso no arranco; revisa ${LOG_FILE}"
    return 1
  fi
  log "pid ${pid}; devUrl ${DEV_URL}; logs en ${LOG_FILE}"
}

launch_foreground() {
  log "ejecutando en primer plano (Ctrl-C para detener)"
  cd "$PROJECT_DIR"
  exec npm run dev
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --foreground) MODE=foreground ;;
    --stop) MODE=stop ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'noteriv-dev: opcion desconocida: %s\n' "$1" >&2; usage; exit 2 ;;
  esac
  shift
done

case "$MODE" in
  stop)
    stop_stack
    ;;
  foreground)
    require_project
    ensure_deps
    launch_foreground
    ;;
  background)
    require_project
    if stack_running; then
      log "ya hay un stack de desarrollo corriendo; no lanzo otro"
      focus_window
      exit 0
    fi
    ensure_deps
    launch_background
    ;;
esac
