#!/usr/bin/env bash
# pi-new — abre una terminal nueva (kitty) con pi ya cargado y la enfoca.
#
# Abre un panel tmux nuevo corriendo pi, dentro de una ventana kitty nueva.
# Con tmux, pi se registra solo en `agente-pane`, así después lo podés
# enfocar/hablarle por voz como a cualquier otro agente.
#
# Uso:
#   pi-new [carpeta] [nombre-de-sesión]
#
# Pensado para el control remoto: doble flecha derecha -> pi-new.
set -uo pipefail

# Si esto corre desde dentro de tmux (o desde un servicio que heredó $TMUX),
# "tmux new-session" se niega a anidar y la ventana se cierra sola: por eso
# "abre pi" no abría nada. Acá siempre queremos una terminal nueva afuera.
unset TMUX TMUX_PANE

dir="${1:-$HOME}"
sess="${2:-}"
term="${TERMINAL:-kitty}"

# Si no hay tmux, igual abrimos pi en la terminal (sin panel).
# El terminal puede ser kitty, foot, alacritty, ghostty o xdg-terminal-exec:
# no todos entienden el mismo flag de "directorio". Por eso siempre se arranca
# un sh que hace cd y después ejecuta lo pedido.
run_in_term() {
    setsid "$term" sh -c 'cd "$1" || exit 1; shift; exec "$@"' sh "$dir" "$@" \
        >/dev/null 2>&1 &
}

if ! command -v tmux >/dev/null 2>&1; then
    run_in_term pi
    exit 0
fi

if [ -n "$sess" ]; then
    tmux_args=(tmux new-session -s "$sess" pi)
else
    tmux_args=(tmux new-session pi)
fi

run_in_term "${tmux_args[@]}"
pid=$!

# Enfocar la ventana nueva (Hyprland ya suele hacerlo al abrir; esto lo asegura).
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    for _ in $(seq 1 40); do
        addr="$(hyprctl clients -j 2>/dev/null \
            | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .address' \
            2>/dev/null | head -1)"
        if [ -n "$addr" ] && [ "$addr" != "null" ]; then
            hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
            break
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            break  # la terminal ya se cerró: no hay nada que enfocar
        fi
        sleep 0.05
    done
fi
