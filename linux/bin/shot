#!/usr/bin/env bash

SAVE_DIR="$HOME/Pictures/screenshots"
TIMESTAMP=$(date +%Y-%m-%d_%H:%M:%S)
MODE="area"
ACTION="copy"

cleanup() {
    [ -n "$HYPRPICKER_PID" ] && kill "$HYPRPICKER_PID" 2>/dev/null
    wait "$HYPRPICKER_PID" 2>/dev/null
}
trap cleanup EXIT

usage() {
    cat <<EOF
Uso: shot [opciones] [full|active|area]

Pantalla congelada al capturar. Sin captures superpuestas.

Opciones:
  -s, --save      Guardar en archivo (además de clipboard)
  -e, --edit      Abrir en swappy para editar/guardar
  -h, --help      Mostrar ayuda

Modos:
  full            Pantalla completa
  active          Ventana activa
  area            Selección manual (default)

Ejemplos:
  shot              area → clipboard (congelado)
  shot full         full → clipboard
  shot active       ventana activa → clipboard
  shot -s           area → archivo + clipboard
  shot -s full      full → archivo + clipboard
  shot -e           area → swappy
EOF
    exit 0
}

freeze_screen() {
    if command -v hyprpicker &>/dev/null; then
        hyprpicker -r -z &
        HYPRPICKER_PID=$!
        sleep 0.15
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--save) ACTION="save"; shift ;;
        -e|--edit) ACTION="edit"; shift ;;
        -h|--help) usage ;;
        full|active|area) MODE="$1"; shift ;;
        *) echo "Opción desconocida: $1"; usage ;;
    esac
done

case "$MODE" in
    active)
        freeze_screen
        GEOMETRY=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        [ -z "$GEOMETRY" ] && { notify-send -u critical "shot" "No se pudo obtener ventana activa"; exit 1; }
        grim -g "$GEOMETRY" - > /tmp/shot.png
        ;;
    full)
        freeze_screen
        grim - > /tmp/shot.png
        ;;
    area)
        grim - > /tmp/shot_full.png
        GEOMETRY=$(slurp)
        [ -z "$GEOMETRY" ] && { rm -f /tmp/shot_full.png; exit 1; }
        POS=$(echo "$GEOMETRY" | cut -d' ' -f1)
        SIZE=$(echo "$GEOMETRY" | cut -d' ' -f2)
        X=$(echo "$POS" | cut -d',' -f1)
        Y=$(echo "$POS" | cut -d',' -f2)
        convert /tmp/shot_full.png -crop "${SIZE}+${X}+${Y}" +repage /tmp/shot.png
        rm -f /tmp/shot_full.png
        ;;
esac

case "$ACTION" in
    copy)
        wl-copy --type image/png < /tmp/shot.png
        notify-send "shot" "Captura copiada al portapapeles"
        ;;
    save)
        mkdir -p "$SAVE_DIR"
        FILE="$SAVE_DIR/shot_$TIMESTAMP.png"
        cp /tmp/shot.png "$FILE"
        wl-copy --type image/png < "$FILE"
        notify-send "shot" "Guardada: $FILE"
        ;;
    edit)
        swappy -f /tmp/shot.png
        ;;
esac
