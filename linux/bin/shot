#!/usr/bin/env bash

SAVE_DIR="$HOME/Pictures/screenshots"
OUT="/tmp/shot.png"
MODE="area"
ACTION="copy"

# Una sola captura a la vez: pulsar Print sobre una selección ya abierta
# apilaba wayfreeze+slurp (y un swappy por pulsación). El lock se libera al
# terminar el script (incluye la espera de swappy).
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/shot"
mkdir -p "$STATE_DIR" 2>/dev/null
exec 9>"$STATE_DIR/lock"
flock -n 9 || exit 0

# Marca de "captura en curso" para el hot corner de hyprexpo
# (navigation.lua): mientras exista, acercar el mouse a la esquina superior
# izquierda no abre la grilla. Lleva el PID para que un flag huérfano (script
# matado con SIGKILL) se detecte como viejo y se ignore.
ACTIVE="$STATE_DIR/active"
printf '%s\n' "$$" > "$ACTIVE"
trap 'rm -f "$ACTIVE"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

usage() {
    cat <<EOF
Uso: shot [opciones] [full|active|area]

Pantalla congelada al capturar. Sin captures superpuestas.

Opciones:
  -s, --save      Guardar en archivo (además de clipboard)
  -e, --edit      Abrir en swappy para editar/guardar
  -h, --help      Mostrar ayuda

Modos:
  full            Pantalla completa
  active          Ventana activa
  area            Selección manual (default)

Ejemplos:
  shot              area → clipboard (congelado)
  shot full         full → clipboard
  shot active       ventana activa → clipboard
  shot -s           area → archivo + clipboard
  shot -s full      full → archivo + clipboard
  shot -e           area → swappy
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--save) ACTION="save"; shift ;;
        -e|--edit) ACTION="edit"; shift ;;
        -h|--help) usage ;;
        full|active|area) MODE="$1"; shift ;;
        *) echo "Opción desconocida: $1"; usage ;;
    esac
done

rm -f "$OUT"

# Los hijos que pueden sobrevivir al script (wl-copy daemoniza un servidor que
# sirve el portapapeles) NO deben heredar el fd 9 del lock: si lo heredan, el
# daemon retiene el lock para siempre y las capturas siguientes salen mudas.
nofd() { "$@" 9>&-; }

case "$MODE" in
    active)
        GEOMETRY=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        if [ -z "$GEOMETRY" ] || [[ "$GEOMETRY" == null* ]]; then
            notify -u critical -g "󰅚" --app-name shot \
                "Captura fallida" "No se pudo obtener la ventana activa."
            exit 1
        fi
        CAPTURE="grim -g '$GEOMETRY' - > $OUT"
        ;;
    full)
        CAPTURE="grim - > $OUT"
        ;;
    area)
        # timeout: si slurp no recibe input (p. ej. otra capa retiene el
        # teclado), no dejamos wayfreeze congelando la pantalla para siempre.
        CAPTURE="g=\$(timeout 120 slurp); [ -n \"\$g\" ] && grim -g \"\$g\" - > $OUT"
        ;;
esac

WAYFREEZE=$(command -v /usr/local/bin/wayfreeze || command -v wayfreeze)
if [ -n "$WAYFREEZE" ]; then
    "$WAYFREEZE" --hide-cursor --after-freeze-cmd "$CAPTURE; killall wayfreeze"
else
    eval "$CAPTURE"
fi

[ -s "$OUT" ] || exit 1

case "$ACTION" in
    copy)
        wl-copy --type image/png < "$OUT"
        notify -g "󰹑" -t 3000 --app-name shot \
            "Captura copiada" "Al portapapeles"
        ;;
    save)
        TIMESTAMP=$(date +%Y-%m-%d_%H:%M:%S)
        mkdir -p "$SAVE_DIR"
        FILE="$SAVE_DIR/shot_$TIMESTAMP.png"
        cp "$OUT" "$FILE"
        wl-copy --type image/png < "$FILE"
        notify -g "󰉉" -t 4000 --app-name shot \
            "Captura guardada" "$FILE"
        ;;
    edit)
        swappy -f "$OUT"
        ;;
esac
