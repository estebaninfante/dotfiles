#!/usr/bin/env bash
set -uo pipefail

LAN_ADDR=192.168.1.241
LAN_PORT=22
PROBE_SECONDS=2
TS_CONNECT_TIMEOUT=10

# Sin esto, cualquier fallo de conexión terminaba el proceso y la terminal se
# cerraba al instante sin mostrar el error (parecía que "no abría").
report_failure() {
  local status=$1 target=$2
  printf '\n[ssh-desktop] No se pudo conectar a %s (código %s).\n' "$target" "$status" >&2
  printf '[ssh-desktop] Revisá ~/.ssh/config (host %s) y la red. Enter para cerrar.\n' "$target" >&2
  read -r _ || true
  exit "$status"
}

if timeout "$PROBE_SECONDS" bash -c "exec 3<>/dev/tcp/${LAN_ADDR}/${LAN_PORT}" 2>/dev/null; then
  ssh desktop-lan
  status=$?
  [ "$status" -eq 0 ] && exit 0
  report_failure "$status" desktop-lan
fi

ssh -o ConnectTimeout="$TS_CONNECT_TIMEOUT" desktop-ts
status=$?
[ "$status" -eq 0 ] && exit 0
report_failure "$status" desktop-ts
