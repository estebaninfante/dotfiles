#!/usr/bin/env python3
"""mic-gain — ganancia del micrófono POR DISPOSITIVO.

En vez de un único valor global (que solo vale para el micrófono activo en ese
momento), mantiene una regla por dispositivo en `~/.config/mic-gain/gains.conf`
y aplica a cada fuente de PipeWire la ganancia que le corresponde según su
nombre o descripción. Así, al cambiar de micrófono (interno, del celular, USB,
cámara…) cada uno vuelve a su valor correcto.

Uso:
  mic-gain apply             aplica las reglas a todas las fuentes ahora
  mic-gain status            muestra cada fuente, su ganancia actual y la objetivo
  mic-gain watch             demonio: aplica al iniciar y cuando aparece una fuente
  mic-gain set <regex> <val> agrega/actualiza una regla (val: 0..1.5 o 80%)
  mic-gain list              muestra las reglas
  mic-gain monitor           medidor en vivo en la terminal (nivel + ganancia)
  mic-gain open              abre el mezclador gráfico si está instalado

Control de hardware (ALSA) opcional: si `AMIXER_CARD` está definido en el
entorno o en el archivo, `mic-gain hw` ajusta 'Internal Mic Boost' y 'Capture';
muchos equipos arrancan con +60 dB de ganancia fija que satura la señal.
"""
import argparse
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("MIC_GAIN_CONFIG", os.path.join(HOME, ".config/mic-gain/gains.conf"))

DEFAULT_RULES = """\
# Ganancia del micrófono POR DISPOSITIVO.
# El patrón es una expresión regular (sin distinguir mayúsculas) que se busca
# en el NOMBRE y en la DESCRIPCIÓN de la fuente. La primera regla que coincide
# gana, así que poné las más específicas arriba y el fallback al final.
# Valor: fracción 0.0-1.5 (1.0 = 100%) o porcentaje (p. ej. 80%).
#
# Ajustá con el widget de la barra o:  mic-gain set "Ryzen" 0.55

Ryzen HD Audio Controller = 0.80
phone-mic                 = 0.55
Integrated Camera         = 0.70
USB2.0 Device             = 0.80
.*                        = 0.80
"""

# Nombre de la tarjeta ALSA con el micrófono interno y controles a fijar.
# Se resuelve por nombre de tarjeta, no por índice, para que no baile.
HW_CARD_MATCH = "HD-Audio Generic"
HW_CONTROLS = {
    "Internal Mic Boost": "0",   # 0 dB (antes estaba al máximo, +30 dB)
    "Capture": "100%",
}


def run(cmd, **kw):
    return subprocess.run(cmd, text=True, capture_output=True, **kw)


def load_rules():
    if not os.path.exists(CONFIG):
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w", encoding="utf-8") as f:
            f.write(DEFAULT_RULES)
    rules = []
    with open(CONFIG, encoding="utf-8") as f:
        for raw in f:
            line = raw.split("#", 1)[0].strip()
            if not line or "=" not in line:
                continue
            pat, val = line.split("=", 1)
            pat = pat.strip()
            val = val.strip()
            if val.endswith("%"):
                val = str(float(val[:-1]) / 100.0)
            try:
                gain = float(val)
            except ValueError:
                continue
            try:
                rx = re.compile(pat, re.IGNORECASE)
            except re.error:
                continue
            rules.append((pat, rx, gain))
    return rules


def sources():
    """Lista de fuentes reales (sin monitores) con nombre, descripción, ganancia."""
    try:
        out = run(["pactl", "-f", "json", "list", "sources"]).stdout
        arr = json.loads(out)
    except Exception:
        return []
    default = run(["pactl", "get-default-source"]).stdout.strip()
    result = []
    for s in arr:
        name = s.get("name", "")
        if name.endswith(".monitor"):
            continue
        pct = s.get("volume", {}).get("front-left", {}).get("value_percent", "0%")
        try:
            gain = int(str(pct).rstrip("%")) / 100.0
        except ValueError:
            gain = 0.0
        result.append({
            "name": name,
            "desc": s.get("description") or name,
            "gain": gain,
            "mute": bool(s.get("mute")),
            "default": name == default,
        })
    return result


def target_for(src, rules):
    hay = (src["name"] + " " + src["desc"]).lower()
    for _pat, rx, gain in rules:
        if rx.search(hay):
            return gain
    return None


def apply(dry=False, only=None):
    rules = load_rules()
    changed = []
    for src in sources():
        if only and only not in (src["name"], src["desc"]):
            continue
        target = target_for(src, rules)
        if target is None:
            continue
        if abs(src["gain"] - target) < 0.02:
            continue
        pct = "%d%%" % round(target * 100)
        if dry:
            changed.append((src, target, "dry"))
            continue
        r = run(["pactl", "set-source-volume", src["name"], pct])
        if r.returncode == 0:
            changed.append((src, target, "ok"))
        else:
            changed.append((src, target, r.stderr.strip() or "error"))
    return changed


def cmd_status():
    rules = load_rules()
    for src in sources():
        target = target_for(src, rules)
        mark = "→" if src["default"] else " "
        tgt = "%3d%%" % round((target or 0) * 100) if target is not None else "  --"
        mute = " (mute)" if src["mute"] else ""
        print("%s %-45s actual=%3d%%  objetivo=%s%s" % (
            mark, src["desc"][:45], round(src["gain"] * 100), tgt, mute))


def cmd_apply(dry):
    changed = apply(dry=dry)
    if not changed:
        print("mic-gain: todo ya estaba en su valor")
        return
    for src, target, how in changed:
        print("mic-gain: %-45s -> %3d%%  [%s]" % (src["desc"][:45], round(target * 100), how))


def cmd_set(pattern, value):
    if value.endswith("%"):
        value = str(float(value[:-1]) / 100.0)
    gain = float(value)
    lines = []
    if os.path.exists(CONFIG):
        with open(CONFIG, encoding="utf-8") as f:
            lines = f.read().splitlines()
    found = False
    for i, line in enumerate(lines):
        body = line.split("#", 1)[0].strip()
        if body and "=" in body and body.split("=", 1)[0].strip() == pattern:
            lines[i] = "%s = %s" % (pattern, gain)
            found = True
            break
    if not found:
        lines.append("%s = %s" % (pattern, gain))
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    print("mic-gain: regla guardada: %s = %s" % (pattern, gain))


def cmd_list():
    for pat, _rx, gain in load_rules():
        print("%-42s = %.2f" % (pat, gain))


def cmd_watch():
    apply()
    proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True, bufsize=1)
    assert proc.stdout
    for line in proc.stdout:
        if "on source" in line or "on server" in line:
            apply()
    return 0


def cmd_monitor():
    here = os.path.dirname(os.path.abspath(__file__))
    monitor = os.path.join(here, "..", "..", "omarchy", "plugins", "eztvn.mic", "mic-monitor.py")
    if not os.path.exists(monitor):
        print("mic-gain: no encuentro mic-monitor.py", file=sys.stderr)
        return 1
    os.execvp("python3", ["python3", monitor])


def cmd_open():
    for tool in ("pwvucontrol", "pavucontrol", "pulsemixer"):
        if subprocess.run(["which", tool], capture_output=True).returncode == 0:
            os.execvp(tool, [tool])
    print("mic-gain: no hay mezclador gráfico instalado (pwvucontrol/pavucontrol)", file=sys.stderr)
    return 1


def cmd_hw():
    """Baja la ganancia de hardware del micrófono interno (evita saturación)."""
    out = run(["cat", "/proc/asound/cards"]).stdout
    applied = 0
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s*\[.*?\]\s*:\s*.*?-", line)
        if not m or HW_CARD_MATCH.lower() not in line.lower():
            continue
        card = m.group(1)
        # Solo las tarjetas que realmente tienen el control del micrófono interno.
        if run(["amixer", "-c", card, "sget", "Internal Mic Boost"]).returncode != 0:
            continue
        for ctl, val in HW_CONTROLS.items():
            r = run(["amixer", "-c", card, "sset", ctl, val])
            state = "ok" if r.returncode == 0 else r.stderr.strip()
            print("mic-gain: hw card %s · %s = %s [%s]" % (card, ctl, val, state))
        applied += 1
    if not applied:
        print("mic-gain: no encontré una tarjeta '%s' con micrófono interno" % HW_CARD_MATCH)
        return 1
    return 0


def main():
    ap = argparse.ArgumentParser(prog="mic-gain", add_help=True)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("apply").add_argument("--dry", action="store_true")
    sub.add_parser("status")
    sub.add_parser("watch")
    sub.add_parser("list")
    sub.add_parser("monitor")
    sub.add_parser("open")
    sub.add_parser("hw")
    s = sub.add_parser("set")
    s.add_argument("pattern")
    s.add_argument("value")
    args = ap.parse_args()

    if args.cmd in (None, "status"):
        cmd_status()
    elif args.cmd == "apply":
        cmd_apply(args.dry)
    elif args.cmd == "watch":
        return cmd_watch()
    elif args.cmd == "list":
        cmd_list()
    elif args.cmd == "set":
        cmd_set(args.pattern, args.value)
    elif args.cmd == "monitor":
        return cmd_monitor()
    elif args.cmd == "open":
        return cmd_open()
    elif args.cmd == "hw":
        return cmd_hw()
    return 0


if __name__ == "__main__":
    sys.exit(main())
