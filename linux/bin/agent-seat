#!/usr/bin/env bash
# agent-seat — lanzar y manejar apps en el Agent Seat.
#
# El Agent Seat es el PR omacom/omarchy#15087: apps que maneja un agente corren en
# un sandbox (bubblewrap) contra un broker Wayland propio, con puntero y teclado
# del agente, en su propio workspace (acá el 20) y con borde naranja. No te roba
# el foco, no te cambia de workspace y no te mueve el cursor.
#
# Instalado desde la rama `agent-seat` de KewkLW/omarchy-fork en
# ~/.local/share/agent-seat (el PR todavía no está mergeado).
#
# Uso (como el `omarchy agent seat` del PR):
#   agent-seat run --cdp chromium https://example.com   # app sandboxeada, imprime N
#   agent-seat run --tarea "probar el login" chromium URL  # la tarea sale en la pestaña
#   agent-seat tarea N "revisar el checkout"            # cambia la tarea de la ventana N
#   agent-seat etiqueta N                               # texto de la pestaña del overview
#   agent-seat state N                                  # tamaño, foco, popups, workspace
#   agent-seat ui N                                     # controles por rol y nombre
#   agent-seat click-ui N "link:Manual"                 # click por nombre, puntero del agente
#   agent-seat type N "hola" --key enter                # teclea en tu layout
#   agent-seat screenshot N --output /tmp/x.png         # PNG, popups incluidos
#   agent-seat windows                                  # ventanas del asiento
#   agent-seat status                                   # ¿corriendo?
#   agent-seat stop                                      # mata broker y sandboxes
#
# El asiento no queda abierto después de trabajar: agent-seat-watch lo cierra
# entero cuando pasan AGENT_SEAT_IDLE_CIERRE segundos (300) sin ninguna acción
# de un agente. Un agente que termina igual corre `agent-seat stop` enseguida.
set -uo pipefail

RAIZ="${AGENT_SEAT_HOME:-$HOME/.local/share/agent-seat}"

if [ ! -x "$RAIZ/bin/omarchy-agent-seat-run" ]; then
    echo "falta el checkout del Agent Seat en $RAIZ" >&2
    exit 1
fi

export OMARCHY_PATH="$RAIZ"
export PATH="$RAIZ/bin:$PATH"

# Aviso visible para el usuario: el asiento vive en un workspace oculto, así que
# al lanzar la primera app arrancamos un vigía que notifica aperturas y cierres.
arrancar_vigia() {
    # Si ya corre uno, el nuevo sale solo (flock en el script).
    setsid -f agent-seat-watch >/dev/null 2>&1 </dev/null
}

# Cada sandbox tiene hostname propio, así que chromium deja SingletonLock de
# "otra máquina" y el próximo lanzamiento falla con "Profile error occurred".
# Si el asiento no tiene ventanas, esos locks son de corridas muertas.
limpiar_locks() {
    local base="$HOME/.local/state/omarchy/agent-seat/home/.config"
    [ -d "$base" ] || return 0
    if omarchy-agent-seat-windows 2>/dev/null | grep -q '"window"'; then
        return 0
    fi
    rm -f "$base"/chromium/Singleton* 2>/dev/null
    rm -f "$base"/google-chrome/Singleton* 2>/dev/null
    rm -f "$base"/BraveSoftware/*/Singleton* 2>/dev/null
    return 0
}

# Cada ventana del asiento en su propio workspace (slot) con nombre, para que
# hyprexpo la muestre como tile con etiqueta en la grilla dinámica.
arrancar_slots() {
    # Si ya corre uno, el nuevo sale solo (flock en el script).
    setsid -f agent-seat-slots >/dev/null 2>&1 </dev/null
}

# Imprime el programa de un `run` (lo que va después de las opciones del seat).
programa_de() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --share|--share-ro) shift 2 ;;
            --*) shift ;;
            *) printf '%s\n' "$1"; return 0 ;;
        esac
    done
    return 1
}

es_navegador() {
    case "${1##*/}" in
        chromium|chromium-browser|google-chrome*|chrome|brave|brave-browser*) return 0 ;;
    esac
    return 1
}

# Todos los navegadores del asiento comparten un home, así que un segundo
# chromium choca con el perfil del primero ("Profile error occurred" en
# cascada). Si ya hay uno vivo con CDP, las URLs se abren como pestañas en él y
# se devuelve su ventana. Imprime el número de ventana si reusó.
reusar_navegador() {
    local prog
    prog=$(programa_de "$@") || return 1
    es_navegador "$prog" || return 1
    # Con --share hace falta otro sandbox; con perfil propio no hay choque.
    local a pasado=0 urls=()
    for a in "$@"; do
        case "$a" in
            --share|--share-ro) return 1 ;;
            --user-data-dir*|--profile-directory*) return 1 ;;
        esac
        if [ "$pasado" = 1 ]; then
            case "$a" in -*) ;; *) urls+=("$a") ;; esac
        fi
        [ "$a" = "$prog" ] && pasado=1
    done

    local dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy/agent-seat/sandboxes"
    local estado
    estado=$(timeout 10 omarchy-agent-seat-broker call '{"command":"state"}' 2>/dev/null) || return 1
    local rec sup puerto cmdline
    for rec in "$dir"/sandbox.*; do
        [ -f "$rec" ] || continue
        read -r sup _ _ _ _ <"$rec" 2>/dev/null || continue
        [ -r "/proc/$sup/cmdline" ] || continue
        # El comando del sandbox va después del último "--" del supervisor.
        cmdline=$(tr '\0' '\n' <"/proc/$sup/cmdline" | awk 'f{print; exit} $0=="--"{f=1}')
        [ "${cmdline##*/}" = "${prog##*/}" ] || continue
        puerto=$(cat "$dir/${rec##*.}.d/cdp-port" 2>/dev/null) || continue
        curl -sf -m 2 "http://127.0.0.1:$puerto/json/version" >/dev/null || continue

        # Ventana del asiento cuyo proceso desciende de este supervisor.
        local ventana="" w pid p st
        while read -r w pid; do
            p=$pid
            while [ "${p:-0}" -gt 1 ]; do
                [ "$p" = "$sup" ] && { ventana=$w; break 2; }
                st=$(cat "/proc/$p/status" 2>/dev/null) || break
                p=$(printf '%s\n' "$st" | awk '/^PPid:/{print $2}')
            done
        done < <(printf '%s' "$estado" | jq -r '.windows | sort_by(.window)[] | "\(.window) \(.pid // 0)"')
        [ -n "$ventana" ] || continue

        for a in "${urls[@]}"; do
            curl -sf -m 5 -X PUT "http://127.0.0.1:$puerto/json/new?$a" >/dev/null ||
                echo "agent-seat: no pude abrir $a en la ventana $ventana" >&2
        done
        echo "agent-seat: reusando el navegador de la ventana $ventana (pestaña nueva)" >&2
        echo "$ventana"
        return 0
    done
    return 1
}

# Quién y qué, por ventana, para la pestaña del overview (agent-seat-slots la
# arma con `agent-seat etiqueta N`). Vive en el runtime: se borra con la sesión
# y agent-seat-slots lo vacía cuando el asiento se cierra.
META="${XDG_RUNTIME_DIR:-/tmp}/agent-seat-meta"

# Nombre del agente que llama: AGENT_SEAT_AGENTE si lo fija, si no el primer
# agente conocido entre los procesos padre (dsh corre sus comandos vía
# systemd-run, pero el runner lleva @deepseek-ai/dsh en la línea de comando).
quien_llama() {
    if [ -n "${AGENT_SEAT_AGENTE:-}" ]; then printf '%s\n' "$AGENT_SEAT_AGENTE"; return; fi
    local pid=$PPID linea st
    while [ "${pid:-0}" -gt 1 ]; do
        linea=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) || break
        case "$linea" in
            *@deepseek-ai/dsh*|*/bin/dsh\ *|dsh\ *) echo dsh; return ;;
            *opencode*) echo opencode; return ;;
            *codex*) echo codex; return ;;
            *hermes*) echo hermes; return ;;
            *kimi*) echo kimi; return ;;
            *gemini*) echo gemini; return ;;
            *grok*) echo grok; return ;;
            *cursor-agent*) echo cursor; return ;;
            */claude/*/claude*|claude\ *|*/bin/claude*) echo claude; return ;;
        esac
        st=$(cat "/proc/$pid/status" 2>/dev/null) || break
        pid=$(printf '%s\n' "$st" | awk '/^PPid:/{print $2}')
    done
    [ -n "${CLAUDECODE:-}" ] && { echo claude; return; }
    echo agente
}

# meta_poner <ventana> <clave> <valor>: una línea clave=valor por dato.
meta_poner() {
    local n=$1 k=$2 v=$3 f
    case "$n" in ''|*[!0-9]*) return 0 ;; esac
    mkdir -p "$META"
    f="$META/$n"
    v=$(printf '%s' "$v" | tr '\n\t' '  ' | tr -d '[]')
    { grep -v "^$k=" "$f" 2>/dev/null; printf '%s=%s\n' "$k" "$v"; } >"$f.tmp" && mv "$f.tmp" "$f"
}

meta_leer() { sed -n "s/^$2=//p" "$META/$1" 2>/dev/null | tail -1; }

# Sesión del harness que llama (dsh la pasa en DSH_SESSION_ID). Con esto el
# plugin seat-cierre sabe qué ventanas cerrar cuando el agente termina el turno.
sesion_llama() { printf '%s\n' "${AGENT_SEAT_SESION:-${DSH_SESSION_ID:-}}"; }

# Sello de uso, para que el asiento no quede abierto cuando los agentes
# terminan: cada acción de un agente lo actualiza y agent-seat-watch cierra el
# asiento si pasan AGENT_SEAT_IDLE_CIERRE segundos sin sellos nuevos.
USO="${XDG_RUNTIME_DIR:-/tmp}/agent-seat-uso"

# marcar_uso <ventana>: sella ahora en el asiento y, si hay ventana, en ella.
marcar_uso() {
    local ahora
    ahora=$(date +%s)
    mkdir -p "$USO" || return 0
    printf '%s\n' "$ahora" >"$USO/global"
    case "${1:-}" in
        ''|*[!0-9]*) ;;
        *) printf '%s\n' "$ahora" >"$USO/$1" ;;
    esac
}

# Anota quién actuó y qué hizo sobre una ventana. Con "lectura" (ui,
# screenshot) solo cuenta si es el mismo agente: mirar no le quita la pestaña
# al que trabaja ahí.
anotar() {
    local yo dueno sesion
    yo=$(quien_llama)
    if [ "${3:-}" = lectura ]; then
        dueno=$(meta_leer "$1" agente)
        [ -z "$dueno" ] || [ "$dueno" = "$yo" ] || return 0
    fi
    meta_poner "$1" agente "$yo"
    meta_poner "$1" accion "$2"
    sesion=$(sesion_llama)
    [ -n "$sesion" ] && meta_poner "$1" sesion "$sesion"
    marcar_uso "$1"
}

# Texto de la pestaña: "▸ <agente> · <tarea | última acción | app>".
etiqueta() {
    local n=$1 agente tarea accion app texto
    agente=$(meta_leer "$n" agente)
    tarea=$(meta_leer "$n" tarea)
    accion=$(meta_leer "$n" accion)
    app=$(omarchy-agent-seat-windows 2>/dev/null | jq -r --argjson n "$n" '.[]? | select(.window == $n) | .app_id // empty' 2>/dev/null | head -1)
    texto="${tarea:-${accion:-${app:-ventana $n}}}"
    [ ${#texto} -gt 48 ] && texto="${texto:0:47}…"
    printf '▸ %s · %s\n' "${agente:-agente}" "$texto"
}

cmd="${1:-}"
shift || true
case "$cmd" in
    run)
        arrancar_vigia
        arrancar_slots
        # --tarea "…": lo que el agente viene a hacer, para la pestaña.
        tarea=""
        args=()
        while [ $# -gt 0 ]; do
            case "$1" in
                --tarea) tarea="${2:-}"; shift 2 ;;
                --tarea=*) tarea="${1#--tarea=}"; shift ;;
                *) args+=("$1"); shift ;;
            esac
        done
        set -- "${args[@]}"
        # Un lanzamiento a la vez: si dos agentes piden navegador juntos, el
        # segundo tiene que ver al primero para reusarlo. El candado se suelta
        # cuando omarchy-agent-seat-run termina (ya apareció la ventana).
        exec 7>"${XDG_RUNTIME_DIR:-/tmp}/agent-seat-run.lock"
        flock -w 30 7 || { echo "agent-seat: otro lanzamiento no terminó en 30 s" >&2; exit 1; }
        # Un navegador siempre con CDP, así el siguiente puede reusarlo.
        if prog=$(programa_de "$@") && es_navegador "$prog"; then
            case " $* " in *" --cdp "*) ;; *) set -- --cdp "$@" ;; esac
        fi
        if ventana=$(reusar_navegador "$@"); then
            estado=0
        else
            limpiar_locks
            ventana=$(omarchy-agent-seat-run "$@")
            estado=$?
        fi
        if [ "$estado" = 0 ]; then
            ventana=$(printf '%s\n' "$ventana" | tail -1)
            destino=$(printf '%s\n' "${@: -1}")
            case "$destino" in
                http*://*) destino=${destino#*://}; destino=${destino%%/*} ;;
                *) destino=$(programa_de "$@"); destino=${destino##*/} ;;
            esac
            anotar "$ventana" "abrió $destino"
            meta_poner "$ventana" tarea "$tarea"
            printf '%s\n' "$ventana"
        fi
        exit "$estado" ;;
    tarea)
        # agent-seat tarea N "texto": fija o cambia la tarea de la ventana N.
        [ -n "${1:-}" ] || { echo "uso: agent-seat tarea <ventana> \"texto\"" >&2; exit 1; }
        meta_poner "$1" agente "$(quien_llama)"
        meta_poner "$1" tarea "${2:-}"
        [ -n "$(sesion_llama)" ] && meta_poner "$1" sesion "$(sesion_llama)"
        marcar_uso "$1"
        exit 0 ;;
    cerrar-sesion)
        # agent-seat cerrar-sesion <sesión>: cierra las ventanas que esa sesión
        # del harness abrió y, si no queda ninguna, baja el asiento entero.
        # Lo llama el plugin seat-cierre al terminar el turno.
        sesion="${1:-}"
        [ -n "$sesion" ] || { echo "uso: agent-seat cerrar-sesion <sesión>" >&2; exit 1; }
        cerradas=0
        while IFS=$'\t' read -r n dir; do
            [ -n "$dir" ] && [ "$dir" != null ] || continue
            [ "$(meta_leer "$n" sesion)" = "$sesion" ] || continue
            if [ "$(hyprctl dispatch "hl.dsp.window.close({ window = 'address:$dir' })" 2>/dev/null)" = ok ]; then
                rm -rf "${META:?}/$n"
                rm -f "${USO:?}/$n"
                cerradas=$((cerradas + 1))
            fi
        done < <(omarchy-agent-seat-windows 2>/dev/null | jq -r '.[]? | "\(.window)\t\(.address)"')
        restantes=$(omarchy-agent-seat-windows 2>/dev/null | jq -r 'if type == "array" then length else 0 end')
        if [ "$cerradas" -gt 0 ] && [ "${restantes:-0}" -eq 0 ]; then
            echo "agent-seat: cerradas $cerradas ventana(s) de $sesion, asiento abajo" >&2
            timeout 20 omarchy-agent-seat-stop >/dev/null 2>&1 || true
        fi
        printf '%s\n' "$cerradas"
        exit 0 ;;
    etiqueta)
        etiqueta "${1:?uso: agent-seat etiqueta <ventana>}"
        exit 0 ;;
    click-ui)
        anotar "${1:-}" "clic en «${2#*:}»"
        exec omarchy-agent-seat-click-ui "$@" ;;
    type)
        anotar "${1:-}" "escribiendo"
        exec omarchy-agent-seat-type "$@" ;;
    ui)
        anotar "${1:-}" "leyendo la página" lectura
        exec omarchy-agent-seat-ui "$@" ;;
    screenshot)
        anotar "${1:-}" "mirando la pantalla" lectura
        exec omarchy-agent-seat-screenshot "$@" ;;
    pointer)
        anotar "${1:-}" "moviendo el puntero"
        exec omarchy-agent-seat-pointer "$@" ;;
    state|windows|status|stop|show)
        exec "omarchy-agent-seat-$cmd" "$@" ;;
    show-or-start)
        # Salta al asiento si ya hay ventanas; si está vacío, abre chromium ahí.
        # El navegador por defecto de esta máquina está roto (/usr/bin/brave ->
        # /opt/brave-bin, que no existe), así que no se usa `show --start`.
        if omarchy-agent-seat-windows 2>/dev/null | grep -q '"window"'; then
            exec omarchy-agent-seat-show "$@"
        fi
        omarchy-agent-seat-run chromium about:blank >/dev/null || exit 1
        exec omarchy-agent-seat-show ;;
    *)
        echo "uso: agent-seat run [--tarea \"…\"]|tarea|cerrar-sesion|etiqueta|state|ui|click-ui|type|screenshot|pointer|windows|status|stop|show|show-or-start" >&2
        exit 1 ;;
esac
