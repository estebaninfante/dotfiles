#!/usr/bin/env bash
# agent-seat-watch — avisa cuando un agente abre o cierra ventanas en el asiento.
#
# El asiento vive en un workspace oculto: sin esto el usuario no se entera de
# que hay un agente trabajando ahí. Manda una notificación al abrir la primera
# ventana (con títulos) y al cerrarse la última. Se apaga solo cuando el broker
# se detiene o cuando pasan AGENT_SEAT_WATCH_IDLE segundos sin ventanas.
#
# También limpia: cierra solo los diálogos basura que dejan las apps del
# asiento (hoy "Profile error occurred", de un chromium que chocó con el perfil
# de otro), avisa una vez y lo anota en ~/.local/state/agent-seat/limpieza.log.
# `agent-seat run` ya evita ese choque reusando el navegador; esto es la red
# para lo que se escape.
#
# Uso: agent-seat-watch [-v]     (-v: además imprime cada cambio, para probar)
set -uo pipefail

INTERVALO="${AGENT_SEAT_WATCH_INTERVALO:-2}"
IDLE="${AGENT_SEAT_WATCH_IDLE:-900}"
GRACIA="${AGENT_SEAT_WATCH_GRACIA:-60}"
VERBOSO=0
[ "${1:-}" = "-v" ] && VERBOSO=1

RUTA="${XDG_RUNTIME_DIR:-/tmp}/agent-seat-watch.pid"
ULTIMO=-1
SIN_VENTANAS=0
VIO_CORRER=0
ESPERANDO=0

aviso() {
    omarchy-notification-send -u normal "$*" >/dev/null 2>&1 \
        || notify-send "$*" >/dev/null 2>&1 || true
}
decir() { [ "$VERBOSO" = 1 ] && echo "$*"; return 0; }

# Uno solo por sesión: `agent-seat run` lo arranca en cada lanzamiento y el pid
# de `setsid ... &` no sirve para saber si ya corre (setsid hace fork).
exec 9>"$RUTA.lock"
flock -n 9 || { decir "ya hay uno corriendo, salgo"; exit 0; }
printf '%s\n' "$$" > "$RUTA"

BASURA='^(Profile error occurred)$'
REGISTRO="${XDG_STATE_HOME:-$HOME/.local/state}/agent-seat/limpieza.log"

# Cierra (cierre normal, no kill) cada ventana del asiento con título basura.
limpiar_basura() {
    local lista n=0 w dir titulo
    lista="$(agent-seat windows 2>/dev/null | jq -r --arg re "$BASURA" \
        '.[]? | select(.title | test($re)) | "\(.window)\t\(.address)\t\(.title)"' 2>/dev/null)" || return 0
    [ -n "$lista" ] || return 0
    mkdir -p "${REGISTRO%/*}"
    while IFS=$'\t' read -r w dir titulo; do
        [ -n "$dir" ] && [ "$dir" != null ] || continue
        if [ "$(hyprctl dispatch "hl.dsp.window.close({ window = 'address:$dir' })" 2>/dev/null)" = ok ]; then
            n=$((n + 1))
            printf '%s cerrada ventana %s (%s) "%s"\n' "$(date '+%F %T')" "$w" "$dir" "$titulo" >>"$REGISTRO"
        fi
    done <<<"$lista"
    if [ "$n" -gt 0 ]; then
        aviso "Agent Seat: cerré $n diálogo(s) de error de un agente (ver $REGISTRO)"
        decir "vigía: cerradas $n ventanas basura"
    fi
}

decir "vigía del asiento: arrancando"
while :; do
    estado="$(agent-seat status 2>/dev/null || true)"
    case "$estado" in
        *running*)
            VIO_CORRER=1
            ESPERANDO=0
            ;;
        *)
            # Al arrancar desde `agent-seat run`, el broker todavía no está: se
            # espera un rato. Si ya lo vimos correr, se cerró de verdad.
            if [ "$VIO_CORRER" = 1 ]; then
                rm -f "$RUTA"
                [ "$ULTIMO" -gt 0 ] && aviso "Agent Seat cerrado (las apps del agente terminaron)"
                decir "vigía: broker detenido, salgo"
                exit 0
            fi
            ESPERANDO=$((ESPERANDO + INTERVALO))
            if [ "$ESPERANDO" -ge "$GRACIA" ]; then
                rm -f "$RUTA"
                decir "vigía: el broker no arrancó en ${GRACIA}s, salgo"
                exit 0
            fi
            sleep "$INTERVALO"
            continue
            ;;
    esac

    limpiar_basura

    n="$(agent-seat windows 2>/dev/null | jq -r 'if type == "array" then length else 0 end' 2>/dev/null || echo 0)"
    n="${n:-0}"

    if [ "$n" != "$ULTIMO" ]; then
        if [ "$n" -gt 0 ]; then
            titulos="$(agent-seat windows 2>/dev/null \
                | jq -r '[.[] | "\(.app_id): \(.title)"] | join(" · ")' 2>/dev/null || true)"
            aviso "Agente trabajando en el asiento (${n} ventana): ${titulos} — Super+Ctrl+Alt+X para ver"
            decir "vigía: ${n} ventana(s) — ${titulos}"
        else
            aviso "Agent Seat libre (el agente ya no tiene ventanas abiertas)"
            decir "vigía: 0 ventanas"
        fi
        ULTIMO="$n"
    fi

    if [ "$n" -eq 0 ]; then
        SIN_VENTANAS=$((SIN_VENTANAS + INTERVALO))
        if [ "$SIN_VENTANAS" -ge "$IDLE" ]; then
            decir "vigía: ${IDLE}s sin ventanas, salgo"
            rm -f "$RUTA"
            exit 0
        fi
    else
        SIN_VENTANAS=0
    fi

    sleep "$INTERVALO"
done
