#!/usr/bin/env bash
# Toggle de grabación de pantalla completa (pantalla completa + audio del escritorio).
#
# Primera pulsada: arranca la grabación y muestra un aviso breve para que se
# note que está grabando. Segunda pulsada: frena, deja que Omarchy muestre la
# notificación de "grabación guardada" con la miniatura y copia la ruta del
# video al portapapeles.
#
# Se usa desde los atajos Súper+Mayús+K y F10 (sólo desktop) — ver hypr/bindings.lua.

set -u

# Ruta del binario de Omarchy (por si cambia de nombre en el futuro).
REC="omarchy-capture-screenrecording"

# Deja la ruta absoluta del video como texto plano. wl-copy sólo puede ofrecer
# un MIME a la vez, así que se copia la ruta (se pega en cualquier lado) en vez
# del archivo (que sólo entienden apps que aceptan text/uri-list).
copy_path() {
    local file="$1"
    [[ -n $file && -f $file ]] || return 0
    printf '%s' "$file" | wl-copy --type text/plain || return 0
    omarchy-notification-send --app-name omarchy-screenrecord -g "󰻂" -u normal -t 5000 \
        "Ruta copiada al portapapeles" "$file"
}

if pgrep -f "^gpu-screen-recorder" >/dev/null; then
    # --stop-recording imprime la ruta final (ya reencodeada) en stdout cuando
    # termina de guardar; nos quedamos con la última línea no vacía.
    saved=$("$REC" --stop-recording)
    saved=$(printf '%s\n' "$saved" | awk 'NF { last = $0 } END { print last }')
    copy_path "$saved"
    exit 0
fi

# Arrancar en primer plano: la función vuelve cuando el archivo ya existe, así
# el primer cuadro (la miniatura) no incluye el aviso.
"$REC" --fullscreen --with-desktop-audio

# Aviso sólo si de verdad quedó grabando.
if pgrep -f "^gpu-screen-recorder" >/dev/null; then
    omarchy-notification-send --app-name omarchy-screenrecord -g "󰻂" -u normal -t 5000 \
        "Grabando pantalla" \
        "Pantalla completa + audio del escritorio.
Detener: PrintScreen o Súper + Mayús + K."
fi
