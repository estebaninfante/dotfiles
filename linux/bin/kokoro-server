#!/usr/bin/env bash
# kokoro-server — el Kokoro del sistema (un proceso, un modelo) para Orión,
# Read Aloud de Zotero y LearnHarness. Lo mantiene kokoro-tts.service.
set -euo pipefail

PY="${HOME}/.local/share/tts/venv-kokoro/bin/python"
SRC="${HOME}/dotfiles/linux/voice/kokoro_server.py"

if [[ ! -x "$PY" ]]; then
    echo "kokoro-server: falta el entorno (~/.local/share/tts/venv-kokoro)" >&2
    echo "               corré: ~/dotfiles/scripts/setup-kokoro-reader.sh" >&2
    exit 1
fi

exec "$PY" "$SRC" "$@"
