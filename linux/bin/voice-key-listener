#!/usr/bin/env bash
# voice-key-listener — dispara Omar cuando se presiona la tecla física de
# Windows, que keyd remapea a F13.
#
# Acción por defecto: toggle de Omar (`present-remote toggle`): un toque prende,
# otro apaga. Se engancha a la salida de `keyd monitor` (no depende de un bind de
# Hyprland, que resultó caprichoso). Corre como servicio de usuario. Una sola
# acción por pulsación: se ignora la repetición "down" mientras la tecla sigue
# apretada (keyd reemite "down" al mantener). No hay antirrebote por tiempo:
# el de 800 ms se comía la segunda pulsación rápida, así que "cerrar y ya
# quiero que se calle" no hacía nada hasta apretar de nuevo.
#
# Variables: VOICE_KEY_BIN (acción; default present-remote toggle), VOICE_KEY_DISABLE=1.
set -u

[ "${VOICE_KEY_DISABLE:-0}" = "1" ] && exit 0
# Se acepta comando con argumentos (ej. "present-remote toggle"): se parte por
# espacios y se ejecuta como lista, no como un unico nombre con espacios.
read -r -a TOGGLE_CMD <<< "${VOICE_KEY_BIN:-$HOME/.local/bin/present-remote toggle}"
down=0

# `keyd monitor` muere si keyd se reinicia (reload/restart) y con él el
# listener. Se reconecta solo para que la tecla siga viva tras un reinicio de
# keyd, sin quedar el servicio muerto en silencio.
while true; do
  keyd monitor 2>/dev/null | while IFS= read -r line; do
    case "$line" in
      *"f13 down"*)
        # Sólo la primera pulsación: si la tecla se mantiene, keyd reemite
        # "down" y un segundo toggle apagaba a Omar medio segundo después.
        if [ "$down" = 0 ]; then
          down=1
          "${TOGGLE_CMD[@]}"
        fi
        ;;
      *"f13 up"*)
        down=0
        ;;
    esac
  done
  sleep 1
done
