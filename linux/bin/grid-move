#!/usr/bin/env python3
# Movimiento entre workspaces con viaje animado hop-a-hop.
# Grid 3x3:
#   7 8 9
#   4 5 6
#   1 2 3
# Recorre los intermedios saltando de uno en uno; cada viaje tarda lo mismo
# salvo que el presupuesto por paso baje del minimo (suavidad primero).
# Uso: grid-move <destino 1-9>
# Tuning via env: GRID_TOTAL_MS (default 450), GRID_MIN_STEP_MS (default 160)
import json
import os
import select
import socket
import subprocess
import sys
import time

TOTAL_MS = float(os.environ.get("GRID_TOTAL_MS", "450"))
MIN_STEP_MS = float(os.environ.get("GRID_MIN_STEP_MS", "160"))


def hyprctl(args):
    out = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True)
    return out.stdout if out.returncode == 0 else None


def socket_dir():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    base = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    hypr = os.path.join(base, "hypr")
    try:
        if sig:
            d = os.path.join(hypr, sig)
        else:
            d = os.path.join(hypr, os.listdir(hypr)[0])
        if os.path.exists(os.path.join(d, ".socket.sock")):
            return d
    except OSError:
        pass
    return None


def dispatch(ws_id, sock_dir):
    cmd = "dispatch workspace %d" % ws_id
    if sock_dir:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(os.path.join(sock_dir, ".socket.sock"))
                s.sendall(cmd.encode() + b"\n")
                return True
        except OSError:
            pass
    subprocess.run(["hyprctl", "dispatch", "workspace", str(ws_id)], check=False)
    return True


def pos(ws):
    row = (9 - ws) // 3
    col = (ws - 1) % 3
    return row, col


def manhattan(a, b):
    (r1, c1), (r2, c2) = pos(a), pos(b)
    return abs(r1 - r2) + abs(c1 - c2)


def gen_paths(a, b):
    (r1, c1), (r2, c2) = pos(a), pos(b)
    dr = 1 if r2 > r1 else -1
    dc = 1 if c2 > c1 else -1
    vr = abs(r2 - r1)
    vc = abs(c2 - c1)
    n = vr + vc
    paths = []
    for mask in range(1 << n):
        if bin(mask).count("1") != vr:
            continue
        path = [a]
        ws = a
        for i in range(n):
            ws += 3 * dr if (mask & (1 << i)) else dc
            path.append(ws)
        paths.append(path)
    return paths


def best_path(a, b, occupied):
    paths = gen_paths(a, b)
    best, best_score = paths[0], -1
    for p in paths:
        score = sum(1 for w in p if w in occupied)
        if score > best_score:
            best, best_score = p, score
    return best


class EventReader:
    def __init__(self, sock):
        self.sock = sock
        self.buf = ""

    def next_line(self, timeout):
        deadline = time.monotonic() + timeout
        while True:
            nl = self.buf.find("\n")
            if nl >= 0:
                line, self.buf = self.buf[:nl], self.buf[nl + 1:]
                return line
            rem = deadline - time.monotonic()
            if rem <= 0:
                return None
            r, _, _ = select.select([self.sock], [], [], rem)
            if not r:
                return None
            data = self.sock.recv(4096)
            if not data:
                return None
            self.buf += data.decode(errors="replace")


def event_matches(line, ws):
    if line.startswith("workspace>>"):
        return line[len("workspace>>"):] == str(ws)
    if line.startswith("workspacev2>>"):
        return line.split(">>")[1].split(":")[0] == str(ws)
    return False


def main():
    if len(sys.argv) != 2:
        print("Uso: grid-move <destino 1-9>", file=sys.stderr)
        return 1
    try:
        target = int(sys.argv[1])
    except ValueError:
        print("destino invalido: %s" % sys.argv[1], file=sys.stderr)
        return 1
    if not 1 <= target <= 10:
        print("destino fuera de rango: %d" % target, file=sys.stderr)
        return 1

    sock_dir = socket_dir()
    if not sock_dir:
        print("Hyprland no encontrado", file=sys.stderr)
        return 2

    out = hyprctl(["activeworkspace"])
    if out is None:
        print("hyprctl no responde", file=sys.stderr)
        return 2
    current = json.loads(out)["id"]

    if current == target:
        return 0

    if target == 10 or not 1 <= current <= 9:
        dispatch(target, sock_dir)
        return 0

    ws_out = hyprctl(["workspaces"])
    occupied = set()
    if ws_out:
        try:
            occupied = {w["id"] for w in json.loads(ws_out)}
        except ValueError:
            pass

    path = best_path(current, target, occupied)
    steps = len(path) - 1
    per_step = max(TOTAL_MS / steps, MIN_STEP_MS) / 1000.0
    t0 = time.monotonic()

    ev_sock = None
    reader = None
    if sock_dir:
        try:
            ev_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            ev_sock.connect(os.path.join(sock_dir, ".socket2.sock"))
            reader = EventReader(ev_sock)
        except OSError:
            ev_sock = None

    try:
        for i, w in enumerate(path[1:]):
            dispatch(w, sock_dir)
            deadline = t0 + per_step * (i + 1)
            if reader:
                while time.monotonic() < deadline:
                    line = reader.next_line(deadline - time.monotonic())
                    if line is None or event_matches(line, w):
                        break
            rem = deadline - time.monotonic()
            if rem > 0:
                time.sleep(rem)
    finally:
        if ev_sock:
            ev_sock.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
