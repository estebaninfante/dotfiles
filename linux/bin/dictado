#!/usr/bin/env python3
"""dictado — dictado por voz del escritorio: hablás y el texto aparece donde está el cursor.

No depende de Omar ni de una app con GUI: graba con PipeWire (`parec`),
transcribe contra el servidor local `dictado` (faster-whisper) y escribe el
texto en la ventana enfocada por portapapeles (`wl-copy` + Ctrl+V / Ctrl+Shift+V),
que es byte-exacto.
Teclear con `wtype` (`DICTADO_ENTREGA=teclear`) está roto en Chromium/Electron:
wtype 0.4 le asigna un keycode a cada carácter distinto en orden de aparición, y
los keycodes 1/14/15/28/29 son Escape/Backspace/Tab/Enter/Ctrl físicos. Chromium
se queda con el significado físico de esos keycodes, así que se come el carácter
(todas las `a` si la `a` es el 1.º distinto), o actúa: `estás` → `ess` (á en el
slot 14 = Backspace) o el punto final perdido (slot 29 = Ctrl). Ver
https://github.com/atx/wtype/issues/71; wtype 0.5 lo arregla.
Todo lo dictado queda en el historial.

Uso:
    dictado                 alterna: abre la grabación; si ya hay una, la cierra y pega
    dictado --cancel        corta y descarta lo grabado
    dictado --enter         si hay dictado abierto: cierra, pega y presiona Enter;
                            si no hay: presiona Enter normal (lo llama el submap de Hyprland)
    dictado --estado        "grabando" o "libre"
    dictado --archivo WAV   transcribe un audio y lo escribe (pruebas, sin micrófono)
    dictado --no-escribir   transcribe e imprime, sin teclear

El gesto arranca un grabador en segundo plano (`dictado --grabar`) que dura
todo el dictado: él escribe su PID en $XDG_RUNTIME_DIR/dictado/mic-busy (lo que
lee `linux/voice/micguard.py` para que el TTS no hable encima) y el mismo PID
en grabando.pid (lo que usa este comando para alternar). Al cerrar, transcribe
y teclea; el texto nunca queda a medias porque el grabador sigue vivo hasta
terminar de pegar.

Variables:
  DICTADO_PUERTO     puerto del servidor (default 8091)
  DICTADO_IDIOMA     idioma (default es)
  DICTADO_MAX_S      tope de grabación en segundos (default 180)
  DICTADO_ENTREGA    "auto" (default: portapapeles y si falla teclear), "pegar" o "teclear"
"""

from __future__ import annotations

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
# `ydotool` busca su socket en /tmp por defecto. Cuando `dictado` lo lanza el
# motor de visión (servicio systemd), el entorno no trae YDOTOOL_SOCKET y la
# inyección fallaba en silencio: el texto se pegaba pero Enter no llegaba.
os.environ.setdefault("YDOTOOL_SOCKET", os.path.join(RUNTIME, ".ydotool_socket"))
CARPETA = os.path.join(RUNTIME, "dictado")
PID = os.path.join(CARPETA, "grabando.pid")
CRUDO = os.path.join(CARPETA, "grabando.f32")
MIC_BUSY = os.path.join(CARPETA, "mic-busy")
ESTADO_JSON = os.path.join(CARPETA, "estado.json")
ENVIAR = os.path.join(CARPETA, "enviar")
CANCELAR = os.path.join(CARPETA, "cancelar")
ESTADO = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state")
HISTORIAL = os.path.join(ESTADO, "dictado", "historial.jsonl")
PUERTO = int(os.environ.get("DICTADO_PUERTO", "8091"))
IDIOMA = os.environ.get("DICTADO_IDIOMA", "es")
MAX_S = int(os.environ.get("DICTADO_MAX_S", "180"))
ENTREGA = os.environ.get("DICTADO_ENTREGA", "auto").lower()
SAMPLE_RATE = 16000
MIN_BYTES = SAMPLE_RATE * 4 // 4  # un cuarto de segundo

# --- órdenes habladas de cierre -------------------------------------------
# El asistente siempre-escuchando (~/Proyectos/asistente) corta el dictado
# cuando oye "enter"/"envíalo"/"pausa" al final. Esa palabra ya está dentro del
# audio grabado, así que Whisper la transcribe y se pegaba con el texto ("... y
# listo, enter"): la orden quedaba escrita. Acá, que es donde se produce el
# texto final, se recorta. Mismas reglas que
# asistente/src/asistente/comandos.py: sólo al final de lo dicho, y las
# palabras sueltas ("pausa") sólo como frase aparte, para que "hagamos una
# pausa" no corte nada.
_FIN = r"[\s.!?¡¿]*$"
_APARTE = r"(?:^|(?<=[.,;:!?]))\s*"
_ENVIAR = (r"[eé]nter|env[ií]a(?:lo)?(?: ya)?|enviar|m[aá]nda(?:lo)?(?: ya)?")
ORDEN_ENVIAR_RX = re.compile(
    r"(?:^|(?<=[\s,;:.!?]))(?:" + _ENVIAR + r")" + _FIN,
    re.I)
# Sin ancla al final: se usa cuando el dictado se cerró con Enter (tecla o voz),
# porque Whisper a veces agrega una coletilla después ("… enter. ¿Ahí está?").
ORDEN_ENVIAR_SUELTA_RX = re.compile(
    r"(?:^|(?<=[\s,;:.!?]))(?:" + _ENVIAR + r")\b", re.I)
ORDEN_PAUSAR_RX = re.compile(
    r"(?:^|(?<=[\s,;:.!?]))(?:(?:deja|para|termina) de (?:transcribir|dictar)"
    r"|pausa (?:la transcripci[oó]n|el dictado)"
    r"|(?:termina|terminar|cierra|cerrar|acaba|fin del?|det[eé]n|para) (?:el |la )?(?:dictado|transcripci[oó]n)"
    r"|ya no (?:transcribas|dictes))" + _FIN
    # "dicta" otra vez (o "dicta, dicta, dicta") como frase aparte: la misma palabra que lo abrió lo cierra
    + "|" + _APARTE + r"(?:pausa|stop|(?:dicta(?:do)?[\s.,!]*){1,4})" + _FIN,
    re.I)


# --- utilidades -----------------------------------------------------------

def log(msg: str) -> None:
    print(f"dictado: {msg}", file=sys.stderr, flush=True)


def avisar(titulo: str, cuerpo: str, ms: int = 1800) -> None:
    for cmd in (["notify", "-a", "Dictado", "-t", str(ms), titulo, cuerpo],
                ["notify-send", "-a", "Dictado", "-t", str(ms), titulo, cuerpo]):
        try:
            subprocess.run(cmd, check=False, timeout=2,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except (OSError, subprocess.SubprocessError):
            continue


def hyprctl(*args: str) -> None:
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    try:
        subprocess.run(["hyprctl", *args], check=False, timeout=2,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def submap(activo: bool) -> None:
    """Entra/sale del submap "dictado" (Enter cierra y pega mientras dictás).

    El CLI de Hyprland de esta versión evalúa el dispatcher como Lua, así que
    se manda la expresión, no `submap dictado`.
    """
    hyprctl("dispatch", f'hl.dsp.submap("{"dictado" if activo else "reset"}")')


def viva(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def pid_grabador() -> int | None:
    """PID del grabador en curso, si sigue vivo."""
    try:
        pid = int(open(PID, encoding="utf-8").read().strip())
    except (OSError, ValueError):
        return None
    if pid > 0 and viva(pid):
        return pid
    limpiar()
    return None


def microfono_actual() -> str:
    """Nombre legible del micrófono por defecto (el que abre `parec`).

    Se resuelve una sola vez al empezar a grabar: el overlay lo muestra chiquito
    al pie y así no se lanza `pactl` en cada refresco (cada 100 ms).
    """
    try:
        nombre = subprocess.run(
            ["pactl", "get-default-source"], check=True, capture_output=True,
            text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""
    if not nombre:
        return ""
    try:
        salida = subprocess.run(
            ["pactl", "list", "sources"], check=True, capture_output=True,
            text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return nombre
    es_el_bueno = False
    for linea in salida.splitlines():
        limpia = linea.strip()
        if limpia.startswith("Name:"):
            es_el_bueno = limpia[len("Name:"):].strip() == nombre
        elif es_el_bueno and limpia.startswith("Description:"):
            return limpia[len("Description:"):].strip() or nombre
    return nombre


def publicar(estado: str, nivel: float = 0.0, desde: float = 0,
             microfono: str = "") -> None:
    """Estado para el overlay de quickshell (`dictado-overlay.qml`).

    Archivo y no IPC: el overlay lo lee cada ~120 ms y así no hay carreras ni
    un socket más que mantener. `actualizado` permite que el overlay se apague
    solo si el grabador muere de golpe. `microfono` es la descripción del source
    de PipeWire que está escuchando (vacío si no se pudo resolver).
    """
    datos = {
        "estado": estado,
        "nivel": round(max(0.0, min(1.0, nivel)), 3),
        "desde": int(desde * 1000) if desde else 0,
        "actualizado": int(time.time() * 1000),
    }
    if microfono:
        datos["microfono"] = microfono
    try:
        with open(ESTADO_JSON, "w", encoding="utf-8") as fh:
            json.dump(datos, fh)
    except OSError:
        pass


def nivel_del_audio(ruta: str, desde: int) -> float:
    """RMS del último ~0.15 s grabado, normalizado para el overlay (0..1)."""
    try:
        with open(ruta, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            largo = fh.tell()
            tramo = SAMPLE_RATE * 4 * 15 // 100  # 0.15 s
            fh.seek(max(desde, largo - tramo))
            crudo = fh.read()
    except OSError:
        return 0.0
    if len(crudo) < 16:
        return 0.0
    import array
    import math

    muestras = array.array("f")
    muestras.frombytes(crudo[: len(crudo) - (len(crudo) % 4)])
    if not muestras:
        return 0.0
    suma = sum(m * m for m in muestras) / len(muestras)
    rms = math.sqrt(max(0.0, suma))
    return min(1.0, rms * 6.0)


def limpiar() -> None:
    for ruta in (PID, MIC_BUSY, ENVIAR, CANCELAR, ESTADO_JSON):
        try:
            os.unlink(ruta)
        except OSError:
            pass


# Lo que Whisper inventa con silencio o ruido. Misma lista que asistente/src/asistente/comandos.py.
ALUCINACIONES = {"gracias", "muchas gracias", "gracias por ver el video", "gracias por ver", "suscribete",
                 "hasta la proxima", "subtitulos realizados por la comunidad de amara org", "ok", "mmm", "mm",
                 "ah", "eh", "uh", "musica"}


def es_alucinacion(texto: str) -> bool:
    import unicodedata
    t = "".join(c for c in unicodedata.normalize("NFD", texto.lower()) if unicodedata.category(c) != "Mn")
    t = re.sub(r"[^a-z0-9ñ ]+", " ", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t in ALUCINACIONES


def separar_orden(texto: str, cerrado_con_enter: bool = False) -> tuple[str, str | None]:
    """Recorta la orden hablada del final: "... y listo, enter" -> ("... y listo,", "enviar").

    Devuelve también la acción ("enviar" o "pausar") para que el cierre haga lo
    mismo que pedía la voz aunque el asistente no esté corriendo.

    `cerrado_con_enter` (la tecla Enter o el cierre por voz del asistente) quita
    además la última aparición de la orden aunque Whisper haya dejado una
    coletilla detrás: "... enter. ¿Ahí está?".
    """
    accion = None
    seguir = True
    while seguir:  # "… Dicta, dicta. Termina dictado." -> quita todas las órdenes del final
        seguir = False
        for nombre, rx in (("enviar", ORDEN_ENVIAR_RX), ("pausar", ORDEN_PAUSAR_RX)):
            if m := rx.search(texto):
                texto, accion, seguir = texto[: m.start()].rstrip(" ,;:\t"), accion or nombre, True
                break
    if accion:
        return texto.strip(), accion
    if cerrado_con_enter:
        ultimo = None
        for m in ORDEN_ENVIAR_SUELTA_RX.finditer(texto):
            ultimo = m
        if ultimo:
            # Sólo si detrás arranca otra frase (la coletilla que inventa
            # Whisper). Con "apretá enter para continuar" no se toca nada: no
            # hay puntuación después de la palabra.
            cola = texto[ultimo.end():]
            if re.match(r"\s*[.,;:!?¡¿]", cola) and len(cola) <= 40:
                resto = texto[: ultimo.start()] + texto[ultimo.end():]
                # "casa enter. ¿Ahí está?" -> "casa. ¿Ahí está?": sin huecos dobles
                resto = re.sub(r"\s+", " ", resto)
                resto = re.sub(r"\s+([,.;:!?])", r"\1", resto)
                return resto.strip(" ,;:\t"), "enviar"
    return texto.strip(), None


def escribir_flag(ruta: str) -> None:
    try:
        with open(ruta, "w", encoding="utf-8") as fh:
            fh.write("1")
    except OSError:
        pass


def leer_flag(ruta: str) -> bool:
    existe = os.path.exists(ruta)
    if existe:
        try:
            os.unlink(ruta)
        except OSError:
            pass
    return existe


# --- servidor STT ---------------------------------------------------------

def servidor_url(ruta: str) -> str:
    return f"http://127.0.0.1:{PUERTO}{ruta}"


def salud(espera: float = 0.0) -> dict | None:
    fin = time.time() + espera
    while True:
        try:
            with urllib.request.urlopen(servidor_url("/salud"), timeout=1.5) as r:
                return json.load(r)
        except (OSError, urllib.error.URLError, json.JSONDecodeError):
            if time.time() >= fin:
                return None
            time.sleep(0.25)


def asegurar_servidor(espera: float = 45.0) -> dict:
    """El servidor tiene que estar arriba para transcribir; si no, se arranca."""
    datos = salud()
    if datos is not None:
        return datos
    try:
        subprocess.run(["systemctl", "--user", "start", "dictado.service"],
                       check=False, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass
    datos = salud(espera)
    if datos is None:
        raise RuntimeError("el servidor STT no responde (systemctl --user status dictado.service)")
    return datos


def transcribir(crudo: bytes) -> str:
    asegurar_servidor()
    pedido = urllib.request.Request(
        servidor_url(f"/transcribir?idioma={IDIOMA}"), data=crudo, method="POST",
        headers={"Content-Type": "application/octet-stream"})
    with urllib.request.urlopen(pedido, timeout=180) as r:
        datos = json.load(r)
    if "error" in datos:
        raise RuntimeError(str(datos["error"]))
    return str(datos.get("texto") or "").strip()


# --- salida ---------------------------------------------------------------

def guardar_historial(texto: str, modo: str) -> None:
    try:
        os.makedirs(os.path.dirname(HISTORIAL), exist_ok=True)
        linea = {"fecha": time.strftime("%Y-%m-%dT%H:%M:%S"), "texto": texto, "modo": modo}
        with open(HISTORIAL, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(linea, ensure_ascii=False) + "\n")
    except OSError:
        pass


# Ventanas donde pegar es Ctrl+Shift+V (terminales y Warp).
TERMINALES = {
    "kitty", "foot", "alacritty", "xterm", "urxvt", "st", "konsole",
    "gnome-terminal", "gnome-terminal-server", "org.wezfurlong.wezterm",
    "wezterm", "com.mitchellh.ghostty", "dev.warp.warp", "warp", "terminator",
    "tilix", "xfce4-terminal", "io.elementary.terminal",
    "com.raggesilver.blackbox", "blackbox",
}

# ydotool usa códigos evdev, que son FÍSICOS. Con un layout Dvorak (acá
# `dvk_prog`) la tecla física de la `v` escribe `k`: mandar 47 (KEY_V) pegaba
# Ctrl+K —en Chromium eso enfoca la barra de direcciones— y el texto nunca
# aparecía. Por eso la tecla se resuelve contra el layout activo; ver
# `clave_v_evdev`.
EVDEV_CTRL = 29
EVDEV_SHIFT = 42
_XKB_A_EVDEV = 8  # los keycodes de xkbcommon van 8 arriba de los evdev


def teclado_activo() -> tuple[str, str, int]:
    """(layout, variante, grupo activo) del teclado que mueve el seat.

    `dvk_prog,es,us` son tres layouts; el índice dice cuál está puesto ahora,
    porque la tecla que escribe `v` cambia con el grupo.
    """
    try:
        salida = subprocess.run(["hyprctl", "-j", "devices"], check=False,
                                capture_output=True, text=True, timeout=2).stdout
        teclados = json.loads(salida or "{}").get("keyboards") or []
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return "", "", 0
    if not teclados:
        return "", "", 0
    teclado = next((t for t in teclados if t.get("main")), teclados[0])
    try:
        grupo = int(teclado.get("active_layout_index") or 0)
    except (TypeError, ValueError):
        grupo = 0
    return (str(teclado.get("layout") or ""), str(teclado.get("variant") or ""), grupo)


def clave_v_evdev() -> int | None:
    """Keycode evdev de la tecla que escribe `v` en el layout activo.

    Le pregunta al mismo xkbcommon que usa Hyprland (`xkbcli how-to-type`), así
    funciona igual con Dvorak, Colemak o QWERTY. Devuelve None si no se pudo
    resolver: en ese caso NO hay que mandar la tecla física, porque en otro
    layout (Dvorak, por ejemplo) escribiría otra letra.
    """
    layout, variante, grupo = teclado_activo()
    if not layout:
        return None
    orden = ["xkbcli", "how-to-type", "--layout", layout]
    if variante.strip(", "):
        orden += ["--variant", variante]
    orden.append("v")
    try:
        salida = subprocess.run(orden, check=False, capture_output=True, text=True,
                                timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    # `xkbcli how-to-type` imprime varias tablas; la que sirve es
    #   === Direct access ===
    #   KEYCODE  KEY NAME  LAYOUT  LAYOUT NAME          LEVEL#  MODIFIERS
    #   60       AB09      1       Dvorak Programador…  1       [ ]
    # (LAYOUT es 1-based). Nos quedamos con la fila del grupo activo; si no
    # aparece, la primera.
    dentro = False
    primera = None
    for fila in salida.splitlines():
        if fila.startswith("==="):
            dentro = "Direct access" in fila
            continue
        if not dentro:
            continue
        partes = fila.split()
        if len(partes) < 3 or not partes[0].isdigit() or not partes[2].isdigit():
            continue
        clave = int(partes[0]) - _XKB_A_EVDEV
        if int(partes[2]) == grupo + 1:
            return clave
        if primera is None:
            primera = clave
    return primera


def secuencia_pegar(terminal: bool) -> tuple[str, ...]:
    """Eventos `ydotool key` de Ctrl+V (Ctrl+Shift+V en terminales)."""
    clave = clave_v_evdev()
    if clave is None:
        return ()
    mods = [EVDEV_CTRL] + ([EVDEV_SHIFT] if terminal else [])
    seq = [f"{m}:1" for m in mods]
    seq += [f"{clave}:1", f"{clave}:0"]
    seq += [f"{m}:0" for m in reversed(mods)]
    return tuple(seq)


def clase_activa() -> str:
    """Clase de la ventana con foco según Hyprland ("" si no se sabe)."""
    try:
        salida = subprocess.run(["hyprctl", "-j", "activewindow"], check=False,
                                capture_output=True, text=True, timeout=2).stdout
        return str(json.loads(salida or "{}").get("class") or "").strip().lower()
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return ""


def pegar_hyprland(terminal: bool) -> bool:
    """Ctrl+V (o Ctrl+Shift+V) con el inyector del compositor.

    No pasa por el keymap sintético de `wtype` y no necesita `ydotoold`.
    `hyprctl dispatch` sí devuelve error cuando el dispatcher no existe o falla
    (verificado con uno inexistente), así que el código de salida alcanza.
    """
    mods = "CTRL SHIFT" if terminal else "CTRL"
    expr = f'hl.dsp.send_shortcut({{ mods = "{mods}", key = "v" }})'
    try:
        hecho = subprocess.run(["hyprctl", "dispatch", expr], check=False,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    return hecho.returncode == 0


def atajo_pegar(terminal: bool) -> bool:
    """Manda Ctrl+V (o Ctrl+Shift+V) a la ventana con foco.

    ydotoold primero (evdev real, con la tecla resuelta al layout activo); si no
    está vivo o no se pudo resolver la tecla, el inyector del compositor
    (keysym: ya es agnóstico del layout).
    `wtype` queda último: con su keymap sintético el Ctrl cae en el keycode 1
    (= Escape), no llega como modificador y la app escribe una `v` en vez de
    pegar.
    """
    seq = secuencia_pegar(terminal)
    if seq:
        try:
            # -d 20: sin pausa entre eventos Hyprland/libinput agrupa el Ctrl y la
            # `v` en el mismo frame y la app recibe una `v` suelta.
            hecho = subprocess.run(["ydotool", "key", "-d", "20", *seq], check=False,
                                   timeout=5, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
            if hecho.returncode == 0:
                log_entrega(f"pegado con ydotool ({' '.join(seq)})")
                return True
        except (OSError, subprocess.SubprocessError):
            pass
    if pegar_hyprland(terminal):
        return True
    orden = ["wtype"]
    if terminal:
        orden += ["-M", "ctrl", "-M", "shift", "-k", "v", "-m", "shift", "-m", "ctrl"]
    else:
        orden += ["-M", "ctrl", "-k", "v", "-m", "ctrl"]
    try:
        return subprocess.run(orden, check=False, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def leer_portapapeles() -> str:
    try:
        salida = subprocess.run(["wl-paste", "--no-newline", "--type", "text"],
                                check=False, capture_output=True, timeout=5).stdout
        return salida.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError):
        return ""


def log_entrega(msg: str) -> None:
    """Diagnóstico de entrega en archivo: el grabador corre con stderr mudo."""
    try:
        os.makedirs(os.path.dirname(HISTORIAL), exist_ok=True)
        with open(os.path.join(os.path.dirname(HISTORIAL), "entrega.log"), "a",
                  encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}\n")
    except OSError:
        pass


def esperar_portapapeles(texto: str, espera: float = 2.0) -> bool:
    """`wl-copy` bifurca: confirmar que la selección ya sirve el texto."""
    fin = time.time() + espera
    while time.time() < fin:
        if leer_portapapeles() == texto:
            return True
        time.sleep(0.05)
    return False


def escribir_portapapeles(texto: str) -> bool:
    """Copia el texto y lo pega: byte-exacto, sin keymap sintético de por medio.

    Teclear con `wtype` arma un keymap temporal con un keycode por carácter
    distinto; si alguno cae en 1/14/15/28/29 (Escape/Backspace/Tab/Enter/Ctrl),
    Chromium/Electron usa el significado físico y se come o corrompe ese
    carácter. El portapapeles no tiene ese problema.
    """
    if not (shutil.which("wl-copy") and shutil.which("wl-paste")):
        log_entrega("sin wl-copy/wl-paste")
        return False
    anterior = leer_portapapeles()
    try:
        copiado = subprocess.run(["wl-copy", "-n"], input=texto.encode("utf-8"),
                                 check=False, timeout=5,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if copiado.returncode != 0:
            log_entrega(f"wl-copy falló (rc={copiado.returncode})")
            return False
        if not esperar_portapapeles(texto):
            log_entrega("el portapapeles no quedó listo")
            return False
        clase = clase_activa()
        if not atajo_pegar(clase in TERMINALES):
            log_entrega(f"no pude mandar el atajo de pegado (clase={clase!r})")
            return False
        log_entrega(f"pegado enviado (clase={clase!r}, {len(texto)} car.)")
        # Dar tiempo a que la app lea la selección antes de devolver la anterior.
        time.sleep(0.6)
        return True
    finally:
        if anterior:
            try:
                subprocess.run(["wl-copy", "-n"], input=anterior.encode("utf-8"),
                               check=False, timeout=5,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                pass


def teclear(texto: str) -> bool:
    try:
        hecho = subprocess.run(["wtype", "--", texto], check=False, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return False
    return hecho.returncode == 0


def escribir(texto: str) -> bool:
    """Escribe en la ventana enfocada. False si no pudo (sin foco, etc)."""
    limpio = texto.replace("\n", " ").strip()
    if not limpio:
        return True
    if ENTREGA in ("pegar", "auto") and escribir_portapapeles(limpio):
        return True
    if ENTREGA in ("pegar", "auto"):
        log_entrega("cayó a teclear: el portapapeles no sirvió")
    return teclear(limpio)


def pulsar_enter() -> bool:
    """Enter en la ventana con foco.

    `wtype -k Return` asigna Return al keycode 1 (= Escape físico) y Chromium lo
    interpreta como Escape: el mensaje no se envía. Primero evdev real y el
    inyector del compositor; wtype queda como último recurso.
    """
    try:
        if subprocess.run(["ydotool", "key", "28:1", "28:0"], check=False, timeout=5,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            return True
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        if subprocess.run(["hyprctl", "dispatch",
                           'hl.dsp.send_shortcut({ mods = "", key = "Return" })'],
                          check=False, timeout=5,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
            return True
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        return subprocess.run(["wtype", "-k", "Return"], check=False, timeout=10,
                              stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def cerrar_dictado(pedido: str, enviar: bool = False) -> int:
    """Transcribe lo grabado (o lo descarta) y lo escribe. Corre en el grabador."""
    if pedido == "cancelar":
        avisar("Dictado", "Cancelado", 1200)
        return 0
    try:
        with open(CRUDO, "rb") as fh:
            crudo = fh.read()
    except OSError:
        crudo = b""
    if len(crudo) < MIN_BYTES:
        avisar("Dictado", "No se entendió nada", 1500)
        return 1
    try:
        texto = transcribir(crudo)
    except (RuntimeError, OSError, urllib.error.URLError) as exc:
        avisar("Dictado", str(exc), 3000)
        log(str(exc))
        return 1
    if not texto:
        avisar("Dictado", "No se entendió nada", 1500)
        return 1
    if es_alucinacion(texto):
        # Con silencio o ruido Whisper inventa cierres de video ("¡Gracias por ver el video!",
        # "Hasta la próxima"): eso no lo dijiste, no se pega.
        log(f"descarto alucinación: {texto!r}")
        avisar("Dictado", "Solo oí ruido; no pegué nada", 1800)
        return 1
    # La orden de cierre ("enter", "envíalo", "pausa") está dentro del audio
    # grabado: Whisper la transcribe y antes quedaba pegada al texto.
    texto, orden = separar_orden(texto, cerrado_con_enter=enviar)
    if orden == "enviar":
        enviar = True
    if not texto:
        # Dijiste sólo la orden ("enter"): no hay nada que pegar, sólo enviar.
        if enviar:
            time.sleep(0.15)
            pulsar_enter()
        return 0
    guardar_historial(texto, "dictado")
    if pedido == "no-escribir":
        print(texto)
        return 0
    if not escribir(texto):
        avisar("Dictado", "No pude escribir (¿ventana con foco?)", 2500)
        print(texto, flush=True)
        return 1
    if enviar:
        # Esperar a que la app procese lo tecleado: si el Enter llega pegado,
        # algunas apps lo toman como salto de línea en vez de "enviar".
        time.sleep(min(1.5, 0.25 + len(texto) * 0.003))
        if pulsar_enter():
            log_entrega("Enter enviado")
        else:
            log_entrega("no pude presionar Enter (ni ydotool, ni hyprctl, ni wtype)")
    return 0


# --- grabador -------------------------------------------------------------

def grabar(no_escribir: bool = False) -> int:
    """Proceso que dura todo el dictado: graba, espera el corte y transcribe."""
    os.makedirs(CARPETA, exist_ok=True)
    limpiar()
    pedido = {"valor": ""}

    def cortar(_signum, _frame) -> None:
        pedido["valor"] = "cancelar" if leer_flag(CANCELAR) else "corte"

    signal.signal(signal.SIGINT, cortar)
    signal.signal(signal.SIGTERM, cortar)

    with open(PID, "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))
    with open(MIC_BUSY, "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))
    submap(True)
    if salud() is None:
        # El servidor tarda en cargar el modelo: se calienta mientras hablás.
        try:
            subprocess.run(["systemctl", "--user", "start", "--no-block", "dictado.service"],
                           check=False, timeout=5, stdout=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            pass
    arranque = time.time()
    microfono = microfono_actual()
    publicar("grabando", 0.0, arranque, microfono)

    try:
        grabador = subprocess.Popen(
            ["parec", "--format=float32le", "--rate", str(SAMPLE_RATE),
             "--channels=1", "--raw", "--latency-msec=50"],
            stdout=open(CRUDO, "wb"), stderr=subprocess.DEVNULL)
    except OSError as exc:
        limpiar()
        submap(False)
        avisar("Dictado", f"No pude abrir el micrófono: {exc}", 3000)
        return 1

    tope = time.time() + MAX_S
    while pedido["valor"] == "" and grabador.poll() is None and time.time() < tope:
        publicar("grabando", nivel_del_audio(CRUDO, 0), arranque, microfono)
        time.sleep(0.1)
    if grabador.poll() is None:
        grabador.terminate()
        for _ in range(20):
            if grabador.poll() is not None:
                break
            time.sleep(0.1)
        else:
            grabador.kill()
    try:
        grabador.wait(timeout=5)
    except subprocess.SubprocessError:
        pass

    if pedido["valor"] == "":
        pedido["valor"] = "cancelar" if leer_flag(CANCELAR) else "corte"
    enviar = leer_flag(ENVIAR)
    submap(False)
    # El micrófono ya está libre; el overlay pasa a "pensando…" mientras llega
    # la transcripción final.
    publicar("transcribiendo", 0.0, arranque)
    try:
        os.unlink(MIC_BUSY)
    except OSError:
        pass
    try:
        resultado = cerrar_dictado("no-escribir" if no_escribir else pedido["valor"], enviar)
    finally:
        publicar("idle", 0.0, 0)
        try:
            os.unlink(PID)
        except OSError:
            pass
    return resultado


# --- comandos -------------------------------------------------------------

def empezar(no_escribir: bool = False) -> int:
    if pid_grabador():
        log("ya está grabando")
        return 0
    os.makedirs(CARPETA, exist_ok=True)
    limpiar()
    try:
        with open(CRUDO, "wb"):
            pass
    except OSError:
        pass
    orden = [sys.executable, os.path.realpath(__file__), "--grabar"]
    if no_escribir:
        orden.append("--no-escribir")
    try:
        subprocess.Popen(orden, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError as exc:
        log(f"no pude arrancar el grabador: {exc}")
        return 1
    for _ in range(30):
        if pid_grabador():
            return 0
        time.sleep(0.1)
    log("el grabador no arrancó")
    return 1


def terminar(enviar: bool = False, cancelar: bool = False) -> int:
    pid = pid_grabador()
    if not pid:
        if enviar:  # Enter sin dictado abierto: que la tecla siga haciendo lo suyo
            pulsar_enter()
            return 0
        log("no hay grabación en curso")
        return 1
    if cancelar:
        escribir_flag(CANCELAR)
    if enviar:
        escribir_flag(ENVIAR)
    try:
        os.kill(pid, signal.SIGINT)
    except OSError:
        pass
    fin = time.time() + 150
    while viva(pid) and time.time() < fin:
        time.sleep(0.1)
    if viva(pid):
        log("el grabador no terminó a tiempo")
        return 1
    return 0


def archivo(ruta: str, no_escribir: bool = False) -> int:
    """Transcribe un audio cualquiera (se normaliza a float32 mono 16 kHz)."""
    try:
        crudo = subprocess.run(
            ["ffmpeg", "-v", "error", "-i", ruta, "-ac", "1", "-ar", str(SAMPLE_RATE),
             "-f", "f32le", "-"],
            check=True, capture_output=True, timeout=180).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"no pude convertir {ruta}: {exc}")
        return 1
    if not crudo:
        log(f"{ruta} no tiene audio")
        return 1
    texto = transcribir(crudo)
    # Misma limpieza que el dictado en vivo (la orden hablada no se escribe).
    texto, _ = separar_orden(texto)
    if texto:
        guardar_historial(texto, "archivo")
    if no_escribir:
        print(texto)
        return 0 if texto else 1
    if texto and not escribir(texto):
        print(texto)
        return 1
    return 0 if texto else 1


def main(argv: list[str]) -> int:
    no_escribir = "--no-escribir" in argv
    args = [a for a in argv if a != "--no-escribir"]
    if "--grabar" in args:
        return grabar(no_escribir)
    if "--estado" in args:
        print("grabando" if pid_grabador() else "libre")
        return 0
    if "--cancel" in args or "--cancelar" in args:
        return terminar(cancelar=True)
    if "--archivo" in args:
        i = args.index("--archivo")
        if i + 1 >= len(args):
            log("falta la ruta del audio")
            return 2
        return archivo(args[i + 1], no_escribir)
    if "--enter" in args:
        return terminar(enviar=True)
    if pid_grabador():
        return terminar()
    return empezar(no_escribir)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
