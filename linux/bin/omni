#!/usr/bin/env python3
# omni — el agente de voz nuevo: oído, boca y puente de la flota.
#
# Rol (definido con el usuario, 2026-10-28): el cerebro duro está en la nube.
# Omni NO razona: escucha, traduce a acciones, habla, y es el buzón por donde
# los agentes te avisan. Prueba en curso: reemplaza a Omar mientras dure.
#
# Este corte es el buzón hablado, lo que hoy no existe: un agente deja un aviso
# y Omni te lo cuenta, siempre diciendo de quién viene y sin parafrasear.
#
#   omni avisar --agente puma --texto "terminé el ticket"   # lo dice ya
#   omni avisar --agente puma --texto "..." --urgente        # lo dice primero
#   omni avisar --agente puma --texto "..." --callar         # solo al buzón
#   omni dime                                                # junta los pendientes en una frase
#   omni buzon [--json]                                      # qué quedó sin escuchar
#   omni decir "texto"                                       # boca (con limpieza para el oído)
#   omni perfil                                              # identidad y voz
#
# Contrato de salida: --json imprime {dicho, avisos[], pendientes, accion}.
# Reglas: nunca inventa; si no hay pendientes lo dice; el texto del agente va
# literal (limpio para el oído), con su nombre y su prioridad.
#
# Entorno: OMNI_ESTADO (dir de estado), OMNI_VOICE (binario de voz).
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
ESTADO = Path(os.environ.get("OMNI_ESTADO") or HOME / ".local/state/omni")
BUZON = ESTADO / "buzon.jsonl"
LEIDOS = ESTADO / "leidos.txt"
VOICE = os.environ.get("OMNI_VOICE") or str(HOME / ".local/bin/voice")
VOZ = "Omni"
SPOKEN_PY = HOME / "dotfiles/linux/voice/spoken.py"
CEREBRO = Path(os.environ.get("OMNI_CEREBRO") or HOME / ".local/share/omni/cerebro")
CONTEXTO = ESTADO / "contexto.txt"
WHISPER = os.environ.get("OMNI_WHISPER") or "http://127.0.0.1:8090"
# Un solo modelo para casi todo: el Omni escucha y habla. El servidor local
# (llama-server) expone /v1/chat/completions (audio entra) y /tts (audio sale).
MODELO_URL = os.environ.get("OMNI_MODELO") or "http://127.0.0.1:9931"
CONFIG = ESTADO / "config.json"
VOCES = {"es": "female", "en": "female"}
VOICE_PI = str(HOME / ".local/bin/voice-pi")


# ── limpieza para el oído (misma que usa el resto de la voz) ─────────────
def limpiar(texto: str) -> str:
    try:
        sys.path.insert(0, str(SPOKEN_PY.parent))
        from spoken import clean  # type: ignore

        return clean(texto)
    except Exception:
        t = re.sub(r"```[\s\S]*?```", " ", texto or "")
        t = re.sub(r"<[^>]+>", " ", t)
        t = re.sub(r"[*_>#`]+", "", t)
        return re.sub(r"\s+", " ", t).strip()


# ── buzón ────────────────────────────────────────────────────────────────
def ahora() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def leer_buzon() -> list[dict]:
    if not BUZON.is_file():
        return []
    avisos = []
    for linea in BUZON.read_text(encoding="utf-8", errors="replace").splitlines():
        linea = linea.strip()
        if not linea:
            continue
        try:
            avisos.append(json.loads(linea))
        except Exception:
            continue
    return avisos


def leer_leidos() -> set[str]:
    if not LEIDOS.is_file():
        return set()
    return {l.strip() for l in LEIDOS.read_text(encoding="utf-8").splitlines() if l.strip()}


def marcar_leidos(ids: list[str]) -> None:
    if not ids:
        return
    ESTADO.mkdir(parents=True, exist_ok=True)
    with LEIDOS.open("a", encoding="utf-8") as f:
        for i in ids:
            f.write(i + "\n")


def pendientes() -> list[dict]:
    leidos = leer_leidos()
    sin_leer = [a for a in leer_buzon() if a.get("id") not in leidos]
    # Urgentes primero, después por orden de llegada (estable).
    return sorted(sin_leer, key=lambda a: (0 if a.get("urgente") else 1, a.get("t", "")))


def guardar(agente: str, texto: str, urgente: bool) -> dict:
    ESTADO.mkdir(parents=True, exist_ok=True)
    aviso = {
        "id": f"{int(datetime.now(timezone.utc).timestamp() * 1000)}-{os.getpid()}",
        "t": ahora(),
        "agente": (agente or "sistema").strip(),
        "texto": texto.strip(),
        "urgente": bool(urgente),
    }
    with BUZON.open("a", encoding="utf-8") as f:
        f.write(json.dumps(aviso, ensure_ascii=False) + "\n")
    return aviso


# ── frases ───────────────────────────────────────────────────────────────
NUM = {1: "Uno", 2: "Dos", 3: "Tres", 4: "Cuatro", 5: "Cinco", 6: "Seis"}


def con_punto(texto: str) -> str:
    """Una sola frase terminada: evita el «suite..» de encadenar signos."""
    t = (texto or "").strip().rstrip(".")
    return t + "." if t else ""


def frase_uno(a: dict) -> str:
    quien = a["agente"][:1].upper() + a["agente"][1:]
    cuerpo = con_punto(limpiar(a["texto"]))
    if a.get("urgente"):
        return f"Urgente, de {quien}: {cuerpo}"
    return f"Aviso de {quien}: {cuerpo}"


def frase_lote(avisos: list[dict]) -> str:
    n = len(avisos)
    cuantos = NUM.get(n, str(n))
    cabeza = f"{cuantos} avisos" if n > 1 else "Un aviso"
    urgentes = sum(1 for a in avisos if a.get("urgente"))
    if urgentes:
        cabeza += f", {urgentes} urgente{'s' if urgentes > 1 else ''}"
    partes = []
    for a in avisos:
        quien = a["agente"][:1].upper() + a["agente"][1:]
        partes.append(f"{quien}: {con_punto(limpiar(a['texto']))}")
    return f"{cabeza}. " + " ".join(partes)


def motor() -> str:
    """`omni` (un solo modelo) o `kokoro`/`whisper` (los viejos, de respaldo)."""
    env = os.environ.get("OMNI_MOTOR")
    if env:
        return env
    try:
        return json.loads(CONFIG.read_text(encoding="utf-8")).get("motor", "omni")
    except Exception:
        return "omni"


def _post_json(url: str, payload: dict, timeout: int = 120) -> bytes:
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def hablar_omni(texto: str) -> bool:
    """Pide el audio al mismo modelo que escucha y lo reproduce."""
    try:
        wav = _post_json(
            f"{MODELO_URL}/tts",
            {"input": texto, "voice": VOCES.get("es", "female"), "language": "es"},
        )
    except Exception as exc:
        print(f"omni: el modelo no generó voz: {exc}", file=sys.stderr)
        return False
    if not wav.startswith(b"RIFF"):
        print("omni: el modelo no devolvió audio", file=sys.stderr)
        return False
    ESTADO.mkdir(parents=True, exist_ok=True)
    destino = ESTADO / "ultima-voz.wav"
    try:
        destino.write_bytes(wav)
    except Exception:
        pass
    # El nombre del stream lleva "Voice TTS" para que `voice stop` (la tecla de
    # Windows) corte esta reproducción igual que las demás.
    try:
        subprocess.Popen(
            ["pw-play", "-P", '{ application.name = "Voice TTS" }', str(destino)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except Exception as exc:
        print(f"omni: no pude reproducir: {exc}", file=sys.stderr)
        return False


def decir(texto: str, dry: bool = False) -> None:
    if not texto:
        return
    if dry:
        return
    if motor() == "omni" and hablar_omni(texto):
        return
    try:
        subprocess.Popen(
            [VOICE, "say", "--source", VOZ, "--", texto],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as exc:
        print(f"omni: no pude hablar: {exc}", file=sys.stderr)


# ── despertador (palabra clave) ──────────────────────────────────────────
# El oído abierto no manda todo al cerebro: primero decide si te están
# hablando. Se usa ASR (el mismo modelo) y una comparación tolerante, porque
# "Omni" transcrito puede salir como "oni", "omni" o "homni".
DESPIERTAN = {"omni", "oni", "omnni", "omny", "homni", "omni.", "om ni", "onmi"}
SEGUIMIENTO_S = float(os.environ.get("OMNI_SEGUIMIENTO_S") or 20)
ULTIMA = ESTADO / "ultima-conversacion"


def normalizar(texto: str) -> str:
    t = (texto or "").lower()
    t = re.sub(r"[^\wáéíóúüñ\s]", " ", t)
    return re.sub(r"\s+", " ", t).strip()


def despertar(texto: str) -> tuple[bool, str]:
    """¿Me hablaron? Devuelve (despierta, pedido sin la palabra clave)."""
    t = normalizar(texto)
    if not t:
        return False, ""
    palabras = t.split(" ")
    for i, w in enumerate(palabras[:3]):
        if w in DESPIERTAN:
            return True, " ".join(palabras[i + 1 :]).strip()
    return False, ""


def en_seguimiento() -> bool:
    """Ventana corta después de una respuesta: no hace falta repetir 'Omni'."""
    try:
        return (time.time() - float(ULTIMA.read_text(encoding="utf-8"))) <= SEGUIMIENTO_S
    except Exception:
        return False


def marcar_conversacion() -> None:
    try:
        ESTADO.mkdir(parents=True, exist_ok=True)
        ULTIMA.write_text(str(time.time()), encoding="utf-8")
    except Exception:
        pass


# ── oído ─────────────────────────────────────────────────────────────────
def grabar(destino: str, maxseg: int = 25) -> bool:
    """Una frase: corta por silencio (sox), no hace falta apretar nada más."""
    if not shutil.which("rec"):
        print("omni: falta sox (rec) para escuchar", file=sys.stderr)
        return False
    cmd = [
        "rec", "-q", "-r", "16000", "-c", "1", "-b", "16", "-e", "signed-integer",
        destino,
        # arranca al primer ruido y corta cuando hay silencio sostenido
        "silence", "1", "0.25", "2%", "1", "1.0", "2%",
        "trim", "0", str(maxseg),
    ]
    try:
        subprocess.run(cmd, check=True, timeout=maxseg + 10,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return os.path.getsize(destino) > 2000
    except Exception:
        return False


def transcribir_omni(wav: str) -> str:
    """ASR con el mismo modelo que habla: audio entra, texto sale. Sin nube."""
    try:
        import base64

        datos = base64.b64encode(open(wav, "rb").read()).decode()
        out = json.loads(
            _post_json(
                f"{MODELO_URL}/v1/chat/completions",
                {
                    "messages": [
                        {"role": "system", "content": "Perform ASR in Spanish."},
                        {
                            "role": "user",
                            "content": [
                                {"type": "input_audio", "input_audio": {"data": datos, "format": "wav"}}
                            ],
                        },
                    ],
                    "temperature": 0,
                    "max_tokens": 300,
                    "stream": False,
                },
            )
        )
        return ((out.get("choices") or [{}])[0].get("message") or {}).get("content", "").strip()
    except Exception as exc:
        print(f"omni: el modelo no transcribió: {exc}", file=sys.stderr)
        return ""


def transcribir(wav: str) -> str:
    """Oído local: el modelo único; si no está, el whisper de siempre."""
    if motor() == "omni":
        texto = transcribir_omni(wav)
        if texto:
            return texto
    try:
        with open(wav, "rb") as f:
            datos = f.read()
        req = urllib.request.Request(
            f"{WHISPER}/transcribe?language=es&format=wav",
            data=datos,
            headers={"Content-Type": "application/octet-stream"},
        )
        with urllib.request.urlopen(req, timeout=60) as r:
            out = json.loads(r.read().decode("utf-8", "replace"))
        for clave in ("text", "transcript", "result"):
            if isinstance(out.get(clave), str):
                return out[clave].strip()
        return str(out).strip()
    except Exception as exc:
        print(f"omni: no pude transcribir: {exc}", file=sys.stderr)
        return ""


# ── contexto (memoria corta, sin sesión) ─────────────────────────────────
def leer_contexto(n: int = 2) -> str:
    try:
        intercambios = CONTEXTO.read_text(encoding="utf-8").strip().split("\n---\n")
        return "\n---\n".join(intercambios[-n:])
    except Exception:
        return ""


def guardar_contexto(yo: str, omni_dijo: str) -> None:
    try:
        ESTADO.mkdir(parents=True, exist_ok=True)
        previo = leer_contexto(3)
        with CONTEXTO.open("w", encoding="utf-8") as f:
            f.write((previo + "\n---\n" if previo else "") + f"vos: {yo}\nomni: {omni_dijo}\n")
    except Exception:
        pass


# ── cerebro (nube, con manos) ───────────────────────────────────────────
PARA_EL_OIDO = (
    "Te van a leer en voz alta. Contestá en UNA sola frase de hasta 25 palabras, sin markdown. "
    "Si el pedido necesita más, hacé lo mínimo y decí a quién se lo pasás."
)


def pensar(texto: str, timeout: int = 120) -> str:
    """Manda el pedido al cerebro en la nube (Pi headless con bash)."""
    contexto = leer_contexto()
    prompt = (
        f"{PARA_EL_OIDO}\n\n"
        + (f"Contexto reciente:\n{contexto}\n\n" if contexto else "")
        + f"Pedido: {texto}"
    )
    env = dict(os.environ)
    env.setdefault("VOICE_PI_BRAIN_DIR", str(CEREBRO))
    env.setdefault("VOICE_PI_TIMEOUT", str(timeout))
    try:
        r = subprocess.run(
            [VOICE_PI, prompt], env=env, capture_output=True, text=True, timeout=timeout + 10
        )
        salida = (r.stdout or "").strip()
        if salida:
            return salida
    except Exception as exc:
        print(f"omni: el cerebro no respondió: {exc}", file=sys.stderr)
    return ""


def dos_frases(texto: str) -> str:
    """Lo que se dice: como mucho dos frases (el resto queda en el registro)."""
    t = limpiar(texto)
    if not t:
        return ""
    partes = re.split(r"(?<=[.!?])\s+", t)
    return " ".join(partes[:2]).strip()


def asegurar_modelo() -> bool:
    """El oído necesita el modelo arriba: si no está, lo levanta (sin interfaz)."""
    try:
        urllib.request.urlopen(f"{MODELO_URL}/health", timeout=3).read()
        return True
    except Exception:
        pass
    try:
        env = dict(os.environ)
        env["PROBAR_SIN_UI"] = "1"
        subprocess.Popen(
            [str(HOME / ".local/bin/probar"), "omni"],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        return False
    for _ in range(90):
        time.sleep(1)
        try:
            urllib.request.urlopen(f"{MODELO_URL}/health", timeout=3).read()
            return True
        except Exception:
            continue
    return False


def hablar_y_esperar(texto: str) -> None:
    """Dice y espera a que termine (para no escucharse a sí mismo)."""
    decir(texto)
    time.sleep(0.2)
    for _ in range(600):  # hasta 30 s
        try:
            vivo = subprocess.run(
                ["pgrep", "-f", "^pw-play .*Voice TTS"], capture_output=True, text=True
            ).stdout.strip()
        except Exception:
            vivo = ""
        if not vivo:
            return
        time.sleep(0.1)


def cmd_oido(opts: dict) -> dict:
    """Oído abierto: escucha, despierta con la palabra clave y responde."""
    if not asegurar_modelo():
        return {"accion": "oido", "dicho": "No pude levantar el modelo.", "error": "modelo"}
    log = ESTADO / "oido.log"
    ESTADO.mkdir(parents=True, exist_ok=True)

    def anotar(linea: str) -> None:
        try:
            with log.open("a", encoding="utf-8") as f:
                f.write(f"{ahora()} {linea}\n")
        except Exception:
            pass

    anotar("oido abierto")
    while True:
        wav = tempfile.mktemp(prefix="omni-oido-", suffix=".wav")
        try:
            if not grabar(wav):
                continue
            texto = transcribir(wav)
            os.unlink(wav)
            if not texto:
                continue
            despierta, pedido = despertar(texto)
            if not despierta:
                if en_seguimiento():
                    pedido = texto  # seguimiento: no hace falta repetir "Omni"
                else:
                    anotar(f"ignorado: {texto}")
                    continue
            anotar(f"pedido: {pedido or '(vacío)'}  ← {texto}")
            if not pedido:
                hablar_y_esperar("Decime.")
                continue
            # Barge-in: si estaba sonando algo mío, se corta antes de responder.
            subprocess.run([VOICE, "stop"], capture_output=True, timeout=15)
            respuesta = pensar(pedido)
            if not respuesta:
                hablar_y_esperar("No supe qué contestar.")
                continue
            dicho = dos_frases(respuesta)
            marcar_conversacion()
            guardar_contexto(pedido, dicho)
            hablar_y_esperar(dicho)
        except KeyboardInterrupt:
            anotar("oido cerrado")
            return {"accion": "oido", "dicho": "Oído cerrado."}
        except Exception as exc:
            anotar(f"error: {exc}")
            time.sleep(1)


def cmd_gate(opts: dict) -> dict:
    """Solo la compuerta: texto → (despierta, pedido). Para verificar sin mic."""
    despierta, pedido = despertar(opts["texto"])
    return {"accion": "gate", "despierta": despierta, "pedido": pedido}


# ── comandos ─────────────────────────────────────────────────────────────
def cmd_avisar(opts: dict) -> dict:
    if not opts["texto"]:
        print("omni avisar: falta --texto", file=sys.stderr)
        return {"error": "falta --texto"}
    aviso = guardar(opts["agente"], opts["texto"], opts["urgente"])
    dicho = ""
    if not opts["callar"]:
        # Si ya había pendientes, se cuentan todos juntos (nada de ráfagas).
        lote = pendientes()
        if len(lote) > 1:
            dicho = frase_lote(lote)
            marcar_leidos([a["id"] for a in lote])
        else:
            dicho = frase_uno(aviso)
            marcar_leidos([aviso["id"]])
        decir(dicho, opts["dry"])
    return {"accion": "avisar", "dicho": dicho, "aviso": aviso}


def cmd_dime(opts: dict) -> dict:
    lote = pendientes()
    if not lote:
        dicho = "No hay avisos pendientes."
        return {"accion": "dime", "dicho": dicho, "avisos": [], "pendientes": 0}
    dicho = frase_lote(lote) if len(lote) > 1 else frase_uno(lote[0])
    marcar_leidos([a["id"] for a in lote])
    decir(dicho, opts["dry"])
    return {"accion": "dime", "dicho": dicho, "avisos": lote, "pendientes": 0}


def cmd_buzon(opts: dict) -> dict:
    lote = pendientes()
    dicho = (
        "No hay avisos pendientes."
        if not lote
        else (frase_lote(lote) if len(lote) > 1 else frase_uno(lote[0]))
    )
    return {"accion": "buzon", "dicho": dicho, "avisos": lote, "pendientes": len(lote)}


def cmd_decir(opts: dict) -> dict:
    texto = limpiar(opts["texto"])
    decir(texto, opts["dry"])
    return {"accion": "decir", "dicho": texto}


def cmd_escuchar(opts: dict) -> dict:
    """Habla y te responde: oído local, cerebro en la nube, boca local."""
    wav = tempfile.mktemp(prefix="omni-", suffix=".wav")
    try:
        if opts.get("archivo"):
            shutil.copy(opts["archivo"], wav)
        elif not grabar(wav):
            dicho = "No te escuché. Probá de nuevo."
            decir(dicho, opts["dry"])
            return {"accion": "escuchar", "dicho": dicho, "texto": "", "respuesta": ""}
        texto = transcribir(wav)
    finally:
        try:
            os.unlink(wav)
        except Exception:
            pass
    if not texto:
        dicho = "No te entendí. Probá de nuevo."
        decir(dicho, opts["dry"])
        return {"accion": "escuchar", "dicho": dicho, "texto": "", "respuesta": ""}
    return _responder(texto, opts, accion="escuchar")


def cmd_pedir(opts: dict) -> dict:
    if not opts["texto"]:
        print("omni pedir: falta el texto", file=sys.stderr)
        return {"accion": "pedir", "dicho": "", "texto": ""}
    return _responder(opts["texto"], opts, accion="pedir")


def _responder(texto: str, opts: dict, accion: str) -> dict:
    respuesta = pensar(texto)
    if not respuesta:
        # Segundo intento, más corto y explícito: el cerebro a veces se queda
        # escribiendo y se lo corta el tiempo.
        respuesta = pensar(f"En una sola frase: {texto}", timeout=90)
    dicho = dos_frases(respuesta) if respuesta else "No supe qué contestar."
    decir(dicho, opts["dry"])
    if not opts["dry"]:
        guardar_contexto(texto, dicho)
    return {"accion": accion, "texto": texto, "respuesta": respuesta, "dicho": dicho}


def cmd_perfil(opts: dict) -> dict:
    r = subprocess.run(
        [VOICE, "profile", "show", VOZ], capture_output=True, text=True, timeout=20
    )
    return {"accion": "perfil", "dicho": (r.stdout or "").strip(), "pendientes": len(pendientes())}


def main(argv: list[str]) -> int:
    args = argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0

    opts = {
        "agente": "sistema",
        "texto": "",
        "urgente": False,
        "callar": False,
        "dry": False,
        "json": False,
    }
    i = 1
    while i < len(args):
        a = args[i]
        if a in ("--urgente", "-u"):
            opts["urgente"] = True
        elif a in ("--callar", "-c"):
            opts["callar"] = True
        elif a in ("--dry-run", "--no-say"):
            opts["dry"] = True
        elif a == "--json":
            opts["json"] = True
        elif a in ("--archivo", "-f"):
            opts["archivo"] = args[i + 1] if i + 1 < len(args) else ""
            i += 1
        elif a in ("--agente", "-a"):
            opts["agente"] = args[i + 1] if i + 1 < len(args) else "sistema"
            i += 1
        elif a in ("--texto", "-t"):
            opts["texto"] = args[i + 1] if i + 1 < len(args) else ""
            i += 1
        elif a.startswith("--"):
            pass
        else:
            opts["texto"] = (opts["texto"] + " " + a).strip()
        i += 1

    if not opts["texto"] and not sys.stdin.isatty() and args[0] in ("avisar", "decir", "pedir"):
        opts["texto"] = sys.stdin.read().strip()

    cmd = args[0]
    salida = {
        "avisar": cmd_avisar,
        "dime": cmd_dime,
        "buzon": cmd_buzon,
        "decir": cmd_decir,
        "escuchar": cmd_escuchar,
        "oido": cmd_oido,
        "gate": cmd_gate,
        "pedir": cmd_pedir,
        "perfil": cmd_perfil,
    }.get(cmd)
    if not salida:
        print(f"omni: no conozco «{cmd}»", file=sys.stderr)
        return 2
    out = salida(opts)
    if opts["json"]:
        print(json.dumps(out, ensure_ascii=False, indent=1))
    elif out.get("dicho"):
        print(out["dicho"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
