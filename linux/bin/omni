#!/usr/bin/env python3
# omni — el agente de voz nuevo: oído, boca y puente de la flota.
#
# Rol (definido con el usuario, 2026-10-28): el cerebro duro está en la nube.
# Omni NO razona: escucha, traduce a acciones, habla, y es el buzón por donde
# los agentes te avisan. Prueba en curso: reemplaza a Omar mientras dure.
#
# Este corte es el buzón hablado, lo que hoy no existe: un agente deja un aviso
# y Omni te lo cuenta, siempre diciendo de quién viene y sin parafrasear.
#
#   omni avisar --agente puma --texto "terminé el ticket"   # lo dice ya
#   omni avisar --agente puma --texto "..." --urgente        # lo dice primero
#   omni avisar --agente puma --texto "..." --callar         # solo al buzón
#   omni dime                                                # junta los pendientes en una frase
#   omni buzon [--json]                                      # qué quedó sin escuchar
#   omni decir "texto"                                       # boca (con limpieza para el oído)
#   omni perfil                                              # identidad y voz
#   omni web [--puerto 9932]                                 # página local: hablar o escribir
#   omni memoria [texto] [--fijar "algo"]                    # qué recuerda y qué no
#
# Contrato de salida: --json imprime {dicho, avisos[], pendientes, accion}.
# Reglas: nunca inventa; si no hay pendientes lo dice; el texto del agente va
# literal (limpio para el oído), con su nombre y su prioridad.
#
# Entorno: OMNI_ESTADO (dir de estado), OMNI_VOICE (binario de voz).
import json
import os
import re
import shutil
import subprocess
import sys
import time
import tempfile
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
ESTADO = Path(os.environ.get("OMNI_ESTADO") or HOME / ".local/state/omni")
BUZON = ESTADO / "buzon.jsonl"
LEIDOS = ESTADO / "leidos.txt"
VOICE = os.environ.get("OMNI_VOICE") or str(HOME / ".local/bin/voice")
VOZ = "Omni"
SPOKEN_PY = HOME / "dotfiles/linux/voice/spoken.py"
CEREBRO = Path(os.environ.get("OMNI_CEREBRO") or HOME / ".local/share/omni/cerebro")
CONTEXTO = ESTADO / "contexto.txt"
MEMORIA = ESTADO / "memoria.jsonl"
NOTAS = ESTADO / "notas.md"
CONTEXTO_TURNOS = int(os.environ.get("OMNI_CONTEXTO_TURNOS") or 6)
WHISPER = os.environ.get("OMNI_WHISPER") or "http://127.0.0.1:8090"
# Un solo modelo para casi todo: el Omni escucha y habla. El servidor local
# (llama-server) expone /v1/chat/completions (audio entra) y /tts (audio sale).
MODELO_URL = os.environ.get("OMNI_MODELO") or "http://127.0.0.1:9931"
CONFIG = ESTADO / "config.json"
VOCES = {"es": "female", "en": "female"}
VOICE_PI = str(HOME / ".local/bin/voice-pi")


# ── limpieza para el oído (misma que usa el resto de la voz) ─────────────
def limpiar(texto: str) -> str:
    try:
        sys.path.insert(0, str(SPOKEN_PY.parent))
        from spoken import clean  # type: ignore

        return clean(texto)
    except Exception:
        t = re.sub(r"```[\s\S]*?```", " ", texto or "")
        t = re.sub(r"<[^>]+>", " ", t)
        t = re.sub(r"[*_>#`]+", "", t)
        return re.sub(r"\s+", " ", t).strip()


# ── buzón ────────────────────────────────────────────────────────────────
def ahora() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def leer_buzon() -> list[dict]:
    if not BUZON.is_file():
        return []
    avisos = []
    for linea in BUZON.read_text(encoding="utf-8", errors="replace").splitlines():
        linea = linea.strip()
        if not linea:
            continue
        try:
            avisos.append(json.loads(linea))
        except Exception:
            continue
    return avisos


def leer_leidos() -> set[str]:
    if not LEIDOS.is_file():
        return set()
    return {l.strip() for l in LEIDOS.read_text(encoding="utf-8").splitlines() if l.strip()}


def marcar_leidos(ids: list[str]) -> None:
    if not ids:
        return
    ESTADO.mkdir(parents=True, exist_ok=True)
    with LEIDOS.open("a", encoding="utf-8") as f:
        for i in ids:
            f.write(i + "\n")


def pendientes() -> list[dict]:
    leidos = leer_leidos()
    sin_leer = [a for a in leer_buzon() if a.get("id") not in leidos]
    # Urgentes primero, después por orden de llegada (estable).
    return sorted(sin_leer, key=lambda a: (0 if a.get("urgente") else 1, a.get("t", "")))


def guardar(agente: str, texto: str, urgente: bool) -> dict:
    ESTADO.mkdir(parents=True, exist_ok=True)
    aviso = {
        "id": f"{int(datetime.now(timezone.utc).timestamp() * 1000)}-{os.getpid()}",
        "t": ahora(),
        "agente": (agente or "sistema").strip(),
        "texto": texto.strip(),
        "urgente": bool(urgente),
    }
    with BUZON.open("a", encoding="utf-8") as f:
        f.write(json.dumps(aviso, ensure_ascii=False) + "\n")
    return aviso


# ── frases ───────────────────────────────────────────────────────────────
NUM = {1: "Uno", 2: "Dos", 3: "Tres", 4: "Cuatro", 5: "Cinco", 6: "Seis"}


def con_punto(texto: str) -> str:
    """Una sola frase terminada: evita el «suite..» de encadenar signos."""
    t = (texto or "").strip().rstrip(".")
    return t + "." if t else ""


def frase_uno(a: dict) -> str:
    quien = a["agente"][:1].upper() + a["agente"][1:]
    cuerpo = con_punto(limpiar(a["texto"]))
    if a.get("urgente"):
        return f"Urgente, de {quien}: {cuerpo}"
    return f"Aviso de {quien}: {cuerpo}"


def frase_lote(avisos: list[dict]) -> str:
    n = len(avisos)
    cuantos = NUM.get(n, str(n))
    cabeza = f"{cuantos} avisos" if n > 1 else "Un aviso"
    urgentes = sum(1 for a in avisos if a.get("urgente"))
    if urgentes:
        cabeza += f", {urgentes} urgente{'s' if urgentes > 1 else ''}"
    partes = []
    for a in avisos:
        quien = a["agente"][:1].upper() + a["agente"][1:]
        partes.append(f"{quien}: {con_punto(limpiar(a['texto']))}")
    return f"{cabeza}. " + " ".join(partes)


def motor() -> str:
    """`omni` (un solo modelo) o `kokoro`/`whisper` (los viejos, de respaldo)."""
    env = os.environ.get("OMNI_MOTOR")
    if env:
        return env
    try:
        return json.loads(CONFIG.read_text(encoding="utf-8")).get("motor", "omni")
    except Exception:
        return "omni"


def _post_json(url: str, payload: dict, timeout: int = 120) -> bytes:
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def hablar_omni(texto: str) -> bool:
    """Pide el audio al mismo modelo que escucha y lo reproduce."""
    try:
        wav = _post_json(
            f"{MODELO_URL}/tts",
            {"input": texto, "voice": VOCES.get("es", "female"), "language": "es"},
        )
    except Exception as exc:
        print(f"omni: el modelo no generó voz: {exc}", file=sys.stderr)
        return False
    if not wav.startswith(b"RIFF"):
        print("omni: el modelo no devolvió audio", file=sys.stderr)
        return False
    ESTADO.mkdir(parents=True, exist_ok=True)
    destino = ESTADO / "ultima-voz.wav"
    try:
        destino.write_bytes(wav)
    except Exception:
        pass
    # El nombre del stream lleva "Voice TTS" para que `voice stop` (la tecla de
    # Windows) corte esta reproducción igual que las demás.
    try:
        subprocess.Popen(
            ["pw-play", "-P", '{ application.name = "Voice TTS" }', str(destino)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except Exception as exc:
        print(f"omni: no pude reproducir: {exc}", file=sys.stderr)
        return False


def tts_motor() -> str:
    """Quién pone la voz: `voice` (Kokoro, español parejo) o `omni` (el modelo).

    El modelo escucha bien, pero su español suena a extranjero leyendo: queda
    como opción, no como defecto. `OMNI_TTS=omni` o {"tts": "omni"} en config.
    """
    env = os.environ.get("OMNI_TTS")
    if env:
        return env
    try:
        return json.loads(CONFIG.read_text(encoding="utf-8")).get("tts", "voice")
    except Exception:
        return "voice"


def decir(texto: str, dry: bool = False) -> None:
    if not texto:
        return
    if dry:
        return
    if tts_motor() == "omni" and hablar_omni(texto):
        return
    try:
        subprocess.Popen(
            [VOICE, "say", "--source", VOZ, "--", texto],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as exc:
        print(f"omni: no pude hablar: {exc}", file=sys.stderr)


# ── estado en pantalla (para la página y el HUD viejo) ───────────────────
STATUS = ESTADO / "status.json"


def _cargar_status() -> dict:
    try:
        return json.loads(STATUS.read_text(encoding="utf-8"))
    except Exception:
        return {}


def publicar(estado: str, **actividad) -> None:
    """Escribe el estado que leen la página web y cualquier superficie.

    Estados: idle, listening, thinking, acting, done, error.
    """
    try:
        ESTADO.mkdir(parents=True, exist_ok=True)
        previo = _cargar_status()
        prev_act = previo.get("activity") or {}
        act = {k: v for k, v in prev_act.items() if v}
        act.update({k: v for k, v in actividad.items() if v is not None and v != ""})
        act.setdefault("engine", "LFM3-Omni-2B")
        feed = previo.get("feed") if isinstance(previo.get("feed"), list) else []
        if actividad.get("say") or actividad.get("result"):
            feed.insert(0, {
                "ts": int(time.time() * 1000),
                "state": estado,
                "transcript": act.get("transcript", ""),
                "result": act.get("result", "") or act.get("say", ""),
            })
            feed = feed[:8]
        nuevo = {
            "state": estado,
            "level": float(actividad.get("level") or 0),
            "updatedAt": int(time.time() * 1000),
            "activity": act,
            "feed": feed,
            "context": previo.get("context") or {"active": "omni"},
        }
        tmp = STATUS.with_suffix(".tmp")
        tmp.write_text(json.dumps(nuevo, ensure_ascii=False), encoding="utf-8")
        tmp.replace(STATUS)
    except Exception:
        pass


# ── despertador (palabra clave) ──────────────────────────────────────────
# El oído abierto no manda todo al cerebro: primero decide si te están
# hablando. Se usa ASR (el mismo modelo) y una comparación tolerante, porque
# "Omni" transcrito puede salir como "oni", "omni" o "homni".
DESPIERTAN = {
    "omni", "oni", "omnni", "omny", "homni", "onmi", "omni.", "om ni", "omni,",
    # transcripciones que el ASR produce seguido con nombres propios:
    "onu", "onni", "omn", "amni", "hom ni", "hombres", "ombre", "honni", "on mi",
    "ohmi", "omi", "homi", "oh my", "omni", "om ne", "onme",
}
SEGUIMIENTO_S = float(os.environ.get("OMNI_SEGUIMIENTO_S") or 20)
ULTIMA = ESTADO / "ultima-conversacion"
OIDO_PID = ESTADO / "oido.pid"


def normalizar(texto: str) -> str:
    """Minúsculas y sin acentos: "Oh, mí" tiene que poder compararse con "omni"."""
    import unicodedata

    t = unicodedata.normalize("NFKD", (texto or "").lower())
    t = "".join(c for c in t if not unicodedata.combining(c))
    t = re.sub(r"[^\w\s]", " ", t)
    return re.sub(r"\s+", " ", t).strip()


def parecido(a: str, b: str) -> float:
    import difflib

    return difflib.SequenceMatcher(None, a, b).ratio()


CLAVE = "omni"


def _clave_desde(palabras: list[str], i: int) -> int:
    """¿Arranca acá la palabra clave? Devuelve cuántas palabras ocupa (0 = no).

    El ASR parte "Omni" en dos ("Oh, mí") o lo pega al pedido ("Omnivolumen"),
    así que se prueban una, dos y tres palabras seguidas contra la clave.
    """
    for n in (1, 2, 3):
        trozo = palabras[i : i + n]
        if len(trozo) < n:
            break
        junto = "".join(trozo)
        if not junto:
            continue
        if junto in DESPIERTAN or (len(junto) >= 3 and parecido(junto, CLAVE) >= 0.7):
            return n
    return 0


def despertar(texto: str) -> tuple[bool, str]:
    """¿Me hablaron? Devuelve (despierta, pedido sin la palabra clave)."""
    t = normalizar(texto)
    if not t:
        return False, ""
    palabras = t.split(" ")
    for i in range(min(3, len(palabras))):
        n = _clave_desde(palabras, i)
        if not n:
            continue
        resto = palabras[i + n :]
        # Si repitió la clave ("Omni, omni, …"), se saltea el resto de claves.
        while resto:
            m = _clave_desde(resto, 0)
            if not m:
                break
            resto = resto[m:]
        return True, " ".join(resto).strip()
    return False, ""


def _despertar_viejo(texto: str) -> tuple[bool, str]:
    """¿Me hablaron? Devuelve (despierta, pedido sin la palabra clave).

    Tolera dos cosas: que el ASR escriba el nombre distinto ("oni", "onu",
    "hombre") y que la frase viniera pegada ("omnivolumen"). Por eso compara
    cada una de las primeras palabras contra la palabra clave y también contra
    el comienzo de la frase.
    """
    t = normalizar(texto)
    if not t:
        return False, ""
    palabras = t.split(" ")
    for i, w in enumerate(palabras[:3]):
        if w in DESPIERTAN or (len(w) >= 3 and parecido(w, "omni") >= 0.72):
            return True, " ".join(palabras[i + 1 :]).strip()
        # "omnivolumen", "onicomo": la clave pegada al pedido
        if w.startswith(("omni", "oni", "onu")) and len(w) > 4:
            resto = re.sub(r"^(omni|oni|onu)", "", w).strip()
            return True, (" ".join([resto] + palabras[i + 1 :])).strip()
    # Frase entera pegada: "omnicomovanlosagentes"
    if len(t) > 5 and parecido(t[:4], "omni") >= 0.72:
        return True, t[4:].strip()
    return False, ""


def en_seguimiento() -> bool:
    """Ventana corta después de una respuesta: no hace falta repetir 'Omni'."""
    try:
        return (time.time() - float(ULTIMA.read_text(encoding="utf-8"))) <= SEGUIMIENTO_S
    except Exception:
        return False


def marcar_conversacion() -> None:
    try:
        ESTADO.mkdir(parents=True, exist_ok=True)
        ULTIMA.write_text(str(time.time()), encoding="utf-8")
    except Exception:
        pass


# ── oído ─────────────────────────────────────────────────────────────────
def grabar(destino: str, maxseg: int = 25) -> bool:
    """Una frase: corta por silencio (sox), no hace falta apretar nada más."""
    if not shutil.which("rec"):
        print("omni: falta sox (rec) para escuchar", file=sys.stderr)
        return False
    cmd = [
        "rec", "-q", "-r", "16000", "-c", "1", "-b", "16", "-e", "signed-integer",
        destino,
        # arranca al primer ruido y corta cuando hay silencio sostenido
        "silence", "1", "0.18", "2%", "1", "0.9", "2%",
        "trim", "0", str(maxseg),
    ]
    rec_pid = ESTADO / "rec.pid"
    espera = float(os.environ.get("OMNI_ESPERA_S") or (maxseg + 10))
    proc = None
    try:
        ESTADO.mkdir(parents=True, exist_ok=True)
        # Grupo propio: si la frase no llega, se puede matar a `rec` entero.
        proc = subprocess.Popen(
            cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        rec_pid.write_text(str(proc.pid), encoding="utf-8")
        try:
            proc.wait(timeout=espera)
        except subprocess.TimeoutExpired:
            return False  # lo corta el finally
        return os.path.getsize(destino) > 2000
    except Exception:
        return False
    finally:
        # Sin esto, en una habitación en silencio `rec` se quedaba esperando
        # sonido para siempre: cada 35 s se apilaba otro y entre todos dejaban
        # de entender al usuario. Un grabador vivo por vez, siempre.
        if proc is not None and proc.poll() is None:
            try:
                os.killpg(os.getpgid(proc.pid), 15)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
            try:
                proc.wait(timeout=3)
            except Exception:
                pass
        try:
            rec_pid.unlink()
        except Exception:
            pass


def transcribir_omni(wav: str) -> str:
    """ASR con el mismo modelo que habla: audio entra, texto sale. Sin nube."""
    try:
        import base64

        datos = base64.b64encode(open(wav, "rb").read()).decode()
        out = json.loads(
            _post_json(
                f"{MODELO_URL}/v1/chat/completions",
                {
                    "messages": [
                        {"role": "system", "content": "Perform ASR in Spanish."},
                        {
                            "role": "user",
                            "content": [
                                {"type": "input_audio", "input_audio": {"data": datos, "format": "wav"}}
                            ],
                        },
                    ],
                    "temperature": 0,
                    "max_tokens": 300,
                    "stream": False,
                },
            )
        )
        return ((out.get("choices") or [{}])[0].get("message") or {}).get("content", "").strip()
    except Exception as exc:
        print(f"omni: el modelo no transcribió: {exc}", file=sys.stderr)
        return ""


def transcribir(wav: str) -> str:
    """Oído local: el modelo único; si no está, el whisper de siempre."""
    if motor() == "omni":
        texto = transcribir_omni(wav)
        if texto:
            return texto
    try:
        with open(wav, "rb") as f:
            datos = f.read()
        req = urllib.request.Request(
            f"{WHISPER}/transcribe?language=es&format=wav",
            data=datos,
            headers={"Content-Type": "application/octet-stream"},
        )
        with urllib.request.urlopen(req, timeout=60) as r:
            out = json.loads(r.read().decode("utf-8", "replace"))
        for clave in ("text", "transcript", "result"):
            if isinstance(out.get(clave), str):
                return out[clave].strip()
        return str(out).strip()
    except Exception as exc:
        print(f"omni: no pude transcribir: {exc}", file=sys.stderr)
        return ""


# ── contexto (memoria corta, sin sesión) ─────────────────────────────────
def leer_memoria(n: int = 0) -> list[dict]:
    """Lo hablado, de lo más viejo a lo más nuevo. `n=0` devuelve todo."""
    turnos = []
    try:
        for linea in MEMORIA.read_text(encoding="utf-8", errors="replace").splitlines():
            linea = linea.strip()
            if not linea:
                continue
            try:
                turnos.append(json.loads(linea))
            except Exception:
                continue
    except Exception:
        return []
    return turnos[-n:] if n else turnos


def leer_notas() -> str:
    """Lo que el usuario pidió recordar siempre (no se olvida al cerrar)."""
    try:
        return NOTAS.read_text(encoding="utf-8").strip()
    except Exception:
        return ""


def leer_contexto(n: int = 0) -> str:
    """Memoria para el cerebro: las notas fijas primero, después lo último dicho."""
    n = n or CONTEXTO_TURNOS
    partes = []
    notas = leer_notas()
    if notas:
        partes.append("Lo que el usuario pidió recordar:\n" + notas)
    turnos = leer_memoria(n)
    if turnos:
        partes.append(
            "\n---\n".join(f"vos: {t.get('vos','')}\nomni: {t.get('omni','')}" for t in turnos)
        )
    if not partes:  # memoria vieja (antes de memoria.jsonl)
        try:
            partes = [CONTEXTO.read_text(encoding="utf-8").strip()][-1:] if CONTEXTO.is_file() else []
        except Exception:
            partes = []
    return "\n\n".join(p for p in partes if p)


def guardar_contexto(yo: str, omni_dijo: str) -> None:
    """Cada intercambio queda en disco: es la memoria que se puede leer y buscar."""
    try:
        ESTADO.mkdir(parents=True, exist_ok=True)
        linea = {"t": ahora(), "vos": yo, "omni": omni_dijo}
        with MEMORIA.open("a", encoding="utf-8") as f:
            f.write(json.dumps(linea, ensure_ascii=False) + "\n")
    except Exception:
        pass


def cmd_memoria(opts: dict) -> dict:
    """Ver, buscar o fijar lo que Omni tiene que recordar."""
    if opts.get("fijar"):
        nota = str(opts["fijar"]).strip()
        if nota:
            ESTADO.mkdir(parents=True, exist_ok=True)
            with NOTAS.open("a", encoding="utf-8") as f:
                f.write(f"- {nota}\n")
        return {"accion": "memoria", "dicho": f"Anotado: {nota}", "fijado": nota}
    turnos = leer_memoria(0)
    if opts.get("texto"):
        aguja = opts["texto"].lower()
        turnos = [
            t for t in turnos
            if aguja in f"{t.get('vos','')} {t.get('omni','')}".lower()
        ]
    ultimos = turnos[-20:]
    if not ultimos:
        dicho = "No hay nada guardado todavía."
    else:
        dicho = "\n".join(
            f"{t.get('t','')[:16]}  vos: {t.get('vos','')}\n"
            f"                  omni: {t.get('omni','')}"
            for t in ultimos
        )
    return {"accion": "memoria", "dicho": dicho, "turnos": ultimos, "notas": leer_notas()}


# ── cerebro (nube, con manos) ───────────────────────────────────────────
PARA_EL_OIDO = (
    "Te van a leer en voz alta. Contestá en UNA sola frase de hasta 25 palabras, sin markdown. "
    "Si el pedido necesita más, hacé lo mínimo y decí a quién se lo pasás."
)


def pensar(texto: str, timeout: int = 120) -> str:
    """Manda el pedido al cerebro en la nube (Pi headless con bash)."""
    contexto = leer_contexto(CONTEXTO_TURNOS)
    prompt = (
        f"{PARA_EL_OIDO}\n\n"
        + (f"Contexto reciente:\n{contexto}\n\n" if contexto else "")
        + f"Pedido: {texto}"
    )
    env = dict(os.environ)
    env.setdefault("VOICE_PI_BRAIN_DIR", str(CEREBRO))
    env.setdefault("VOICE_PI_TIMEOUT", str(timeout))
    try:
        r = subprocess.run(
            [VOICE_PI, prompt], env=env, capture_output=True, text=True, timeout=timeout + 10
        )
        salida = (r.stdout or "").strip()
        if salida:
            return salida
    except Exception as exc:
        print(f"omni: el cerebro no respondió: {exc}", file=sys.stderr)
    return ""


def dos_frases(texto: str) -> str:
    """Lo que se dice: como mucho dos frases (el resto queda en el registro)."""
    t = limpiar(texto)
    if not t:
        return ""
    partes = re.split(r"(?<=[.!?])\s+", t)
    return " ".join(partes[:2]).strip()


def eco_reciente(texto: str) -> bool:
    """¿Esto es lo que acabamos de decir por los parlantes? (no despertar por eco)."""
    import time as _t

    ruta = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "omar/spoken.log"
    if not ruta.is_file():
        return False
    try:
        lineas = ruta.read_text(encoding="utf-8", errors="replace").splitlines()[-12:]
    except Exception:
        return False
    ahora_ms = _t.time() * 1000
    for linea in reversed(lineas):
        try:
            cuando, dicho = linea.split("\t", 1)
            if ahora_ms - float(cuando) > 45_000:
                continue
        except Exception:
            continue
        if parecido(normalizar(texto), normalizar(dicho)) >= 0.68:
            return True
    return False


def asegurar_modelo() -> bool:
    """El oído necesita el modelo arriba: si no está, lo levanta (sin interfaz)."""
    try:
        urllib.request.urlopen(f"{MODELO_URL}/health", timeout=3).read()
        return True
    except Exception:
        pass
    try:
        env = dict(os.environ)
        env["PROBAR_SIN_UI"] = "1"
        subprocess.Popen(
            [str(HOME / ".local/bin/probar"), "omni"],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        return False
    for _ in range(90):
        time.sleep(1)
        try:
            urllib.request.urlopen(f"{MODELO_URL}/health", timeout=3).read()
            return True
        except Exception:
            continue
    return False


def hablar_y_esperar(texto: str) -> None:
    """Dice y espera a que termine (para no escucharse a sí mismo)."""
    decir(texto)
    time.sleep(0.2)
    for _ in range(600):  # hasta 30 s
        try:
            vivo = subprocess.run(
                ["pgrep", "-f", "^pw-play .*Voice TTS"], capture_output=True, text=True
            ).stdout.strip()
        except Exception:
            vivo = ""
        if not vivo:
            return
        time.sleep(0.1)


def _oido_unico() -> bool:
    """Toma el micrófono para este proceso. Si ya hay un oído vivo, se aparta."""
    try:
        pid = int(OIDO_PID.read_text(encoding="utf-8").strip())
    except Exception:
        pid = 0
    if pid and pid != os.getpid():
        try:
            os.kill(pid, 0)
            return False
        except Exception:
            pass  # quedó de un cierre a la fuerza: se toma
    try:
        ESTADO.mkdir(parents=True, exist_ok=True)
        OIDO_PID.write_text(str(os.getpid()), encoding="utf-8")
    except Exception:
        pass
    return True


def _soltar_oido() -> None:
    try:
        if OIDO_PID.read_text(encoding="utf-8").strip() == str(os.getpid()):
            OIDO_PID.unlink()
    except Exception:
        pass


def cmd_oido(opts: dict) -> dict:
    """Oído abierto: escucha, despierta con la palabra clave y responde."""
    log = ESTADO / "oido.log"
    ESTADO.mkdir(parents=True, exist_ok=True)

    def anotar(linea: str) -> None:
        try:
            with log.open("a", encoding="utf-8") as f:
                f.write(f"{ahora()} {linea}\n")
        except Exception:
            pass

    # Una pasada sobre un WAV: sirve para verificar el oído sin micrófono.
    if opts.get("archivo"):
        if not asegurar_modelo():
            return {"accion": "oido", "dicho": "No pude levantar el modelo.", "error": "modelo"}
        texto = transcribir(opts["archivo"])
        if not texto:
            return {"accion": "oido", "dicho": "", "texto": "", "despierta": False}
        despierta, pedido = despertar(texto)
        if not despierta:
            return {"accion": "oido", "dicho": "", "texto": texto, "despierta": False}
        respuesta = pensar(pedido) if pedido else ""
        dicho = dos_frases(respuesta) if respuesta else ""
        if dicho:
            decir(dicho, opts["dry"])
        return {
            "accion": "oido", "texto": texto, "despierta": True,
            "pedido": pedido, "dicho": dicho,
        }

    # Un solo oído por vez: dos se roban el micrófono y no entiende ninguno.
    if not _oido_unico():
        return {"accion": "oido", "dicho": "Ya hay un oído abierto.", "error": "ocupado"}

    # Al cerrarlo (Ctrl+C o systemctl stop) suelta el micrófono y el pidfile.
    import atexit
    import signal

    atexit.register(_soltar_oido)

    def _cortar(*_):
        raise KeyboardInterrupt  # systemctl stop se atiende como Ctrl+C

    signal.signal(signal.SIGTERM, _cortar)

    if not asegurar_modelo():
        _soltar_oido()
        return {"accion": "oido", "dicho": "No pude levantar el modelo.", "error": "modelo"}

    anotar("oido abierto")
    while True:
        # Si el walkie-talkie está grabando, el oído se aparta: un solo dueño
        # del micrófono a la vez (si no, se pisan y no entiende ninguno).
        if (ESTADO / "ptt.pid").is_file():
            time.sleep(0.3)
            continue
        wav = tempfile.mktemp(prefix="omni-oido-", suffix=".wav")
        try:
            if not grabar(wav):
                continue
            texto = transcribir(wav)
            os.unlink(wav)
            if not texto:
                anotar("no escuché nada (audio muy corto o silencio)")
                continue
            if eco_reciente(texto):
                anotar(f"eco (mi propia voz): {texto[:80]}")
                continue
            despierta, pedido = despertar(texto)
            if not despierta:
                if en_seguimiento():
                    pedido = texto  # seguimiento: no hace falta repetir "Omni"
                else:
                    anotar(f"ignorado (sin palabra clave): {texto}")
                    continue
            anotar(f"pedido: {pedido or '(vacío)'}  ← {texto}")
            publicar("thinking", transcript=texto, understood=pedido)
            if not pedido:
                hablar_y_esperar("Decime.")
                continue
            # Barge-in: si estaba sonando algo mío, se corta antes de responder.
            subprocess.run([VOICE, "stop"], capture_output=True, timeout=15)
            respuesta = pensar(pedido)
            if not respuesta:
                hablar_y_esperar("No supe qué contestar.")
                continue
            dicho = dos_frases(respuesta)
            publicar("done", result=dicho, say=dicho, transcript=texto)
            marcar_conversacion()
            guardar_contexto(pedido, dicho)
            hablar_y_esperar(dicho)
        except KeyboardInterrupt:
            anotar("oido cerrado")
            return {"accion": "oido", "dicho": "Oído cerrado."}
        except Exception as exc:
            anotar(f"error: {exc}")
            time.sleep(1)


def cmd_ptt(opts: dict) -> dict:
    """Walkie-talkie: primer toque graba, segundo toque procesa.

    Nada de detección de silencio: el usuario decide cuándo empieza y cuándo
    termina, así no hay forma de que un ruido corte la frase ni de que el
    micrófono del sistema se coma el inicio. La página muestra que graba.
    """
    ESTADO.mkdir(parents=True, exist_ok=True)
    pidfile = ESTADO / "ptt.pid"
    wavfile = ESTADO / "ptt.wav"

    if pidfile.is_file():
        # Segundo toque: cerrar la grabación y procesar.
        rpid = None
        try:
            rpid = int((ESTADO / "rec.pid").read_text(encoding="utf-8").strip())
        except Exception:
            pass
        if rpid:
            try:
                os.kill(rpid, 15)   # sox cierra y escribe el WAV
            except Exception:
                pass
        if rpid:
            for _ in range(30):
                time.sleep(0.1)
                try:
                    os.kill(rpid, 0)   # sigue vivo?
                except Exception:
                    break
        try:
            pidfile.unlink()
        except Exception:
            pass
        try:
            (ESTADO / "rec.pid").unlink()
        except Exception:
            pass
        if not wavfile.is_file() or wavfile.stat().st_size < 8000:
            publicar("error", transcript="(no se grabó nada)")
            return {"accion": "ptt", "dicho": "", "texto": "", "error": "sin audio"}
        publicar("thinking", transcript="…")
        texto = transcribir(str(wavfile))
        if not texto:
            publicar("error", transcript="(no se entendió)")
            return {"accion": "ptt", "dicho": "", "texto": "", "error": "sin transcripción"}
        return _responder(texto, opts, accion="ptt")

    # Primer toque: empezar a grabar (sin VAD: graba hasta que lo cortes).
    try:
        os.setsid()
    except Exception:
        pass
    subprocess.run([VOICE, "stop"], capture_output=True, timeout=15)
    cmd = [
        "rec", "-q", "-r", "16000", "-c", "1", "-b", "16", "-e", "signed-integer",
        str(wavfile), "trim", "0", "120",
    ]
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (ESTADO / "rec.pid").write_text(str(proc.pid), encoding="utf-8")
    pidfile.write_text(str(os.getpid()), encoding="utf-8")
    publicar("listening", transcript="", understood="", result="", say="")
    return {"accion": "ptt", "grabando": True, "dicho": ""}


def cmd_gate(opts: dict) -> dict:
    """Solo la compuerta: texto → (despierta, pedido). Para verificar sin mic."""
    despierta, pedido = despertar(opts["texto"])
    return {"accion": "gate", "despierta": despierta, "pedido": pedido}


# ── comandos ─────────────────────────────────────────────────────────────
def cmd_avisar(opts: dict) -> dict:
    if not opts["texto"]:
        print("omni avisar: falta --texto", file=sys.stderr)
        return {"error": "falta --texto"}
    aviso = guardar(opts["agente"], opts["texto"], opts["urgente"])
    dicho = ""
    if not opts["callar"]:
        # Si ya había pendientes, se cuentan todos juntos (nada de ráfagas).
        lote = pendientes()
        if len(lote) > 1:
            dicho = frase_lote(lote)
            marcar_leidos([a["id"] for a in lote])
        else:
            dicho = frase_uno(aviso)
            marcar_leidos([aviso["id"]])
        decir(dicho, opts["dry"])
    return {"accion": "avisar", "dicho": dicho, "aviso": aviso}


def cmd_dime(opts: dict) -> dict:
    lote = pendientes()
    if not lote:
        dicho = "No hay avisos pendientes."
        return {"accion": "dime", "dicho": dicho, "avisos": [], "pendientes": 0}
    dicho = frase_lote(lote) if len(lote) > 1 else frase_uno(lote[0])
    marcar_leidos([a["id"] for a in lote])
    decir(dicho, opts["dry"])
    return {"accion": "dime", "dicho": dicho, "avisos": lote, "pendientes": 0}


def cmd_buzon(opts: dict) -> dict:
    lote = pendientes()
    dicho = (
        "No hay avisos pendientes."
        if not lote
        else (frase_lote(lote) if len(lote) > 1 else frase_uno(lote[0]))
    )
    return {"accion": "buzon", "dicho": dicho, "avisos": lote, "pendientes": len(lote)}


def cmd_decir(opts: dict) -> dict:
    texto = limpiar(opts["texto"])
    decir(texto, opts["dry"])
    return {"accion": "decir", "dicho": texto}


def cmd_escuchar(opts: dict) -> dict:
    """Habla y te responde: oído local, cerebro en la nube, boca local."""
    wav = tempfile.mktemp(prefix="omni-", suffix=".wav")
    publicar("listening", transcript="", understood="", result="", say="")
    try:
        if opts.get("archivo"):
            shutil.copy(opts["archivo"], wav)
        elif not grabar(wav):
            dicho = "No te escuché. Probá de nuevo."
            decir(dicho, opts["dry"])
            return {"accion": "escuchar", "dicho": dicho, "texto": "", "respuesta": ""}
        texto = transcribir(wav)
    finally:
        try:
            os.unlink(wav)
        except Exception:
            pass
    if not texto:
        dicho = "No te entendí. Probá de nuevo."
        publicar("error", transcript="(no se entendió nada)")
        decir(dicho, opts["dry"])
        return {"accion": "escuchar", "dicho": dicho, "texto": "", "respuesta": ""}
    return _responder(texto, opts, accion="escuchar")


def cmd_pedir(opts: dict) -> dict:
    if not opts["texto"]:
        print("omni pedir: falta el texto", file=sys.stderr)
        return {"accion": "pedir", "dicho": "", "texto": ""}
    return _responder(opts["texto"], opts, accion="pedir")


def _responder(texto: str, opts: dict, accion: str) -> dict:
    publicar("thinking", transcript=texto, understood=texto)
    respuesta = pensar(texto)
    if not respuesta:
        # Segundo intento, más corto y explícito: el cerebro a veces se queda
        # escribiendo y se lo corta el tiempo.
        respuesta = pensar(f"En una sola frase: {texto}", timeout=90)
    dicho = dos_frases(respuesta) if respuesta else "No supe qué contestar."
    publicar("done", result=dicho, say=dicho, transcript=texto)
    decir(dicho, opts["dry"])
    if not opts["dry"]:
        guardar_contexto(texto, dicho)
    return {"accion": accion, "texto": texto, "respuesta": respuesta, "dicho": dicho}


def cmd_perfil(opts: dict) -> dict:
    r = subprocess.run(
        [VOICE, "profile", "show", VOZ], capture_output=True, text=True, timeout=20
    )
    return {"accion": "perfil", "dicho": (r.stdout or "").strip(), "pendientes": len(pendientes())}


# ── página local (la cara de Omni en el navegador) ──────────────────────
# Una página en 127.0.0.1 para hablarle con un botón o escribirle, sin abrir
# ventanas. El estado sale del mismo status.json que comparten todas las
# superficies, así nunca se contradicen.
WEB_PAGINA = HOME / "dotfiles/linux/config/omni/omni-web.html"
_CACHE_WEB = {"t": 0.0, "modelo": False, "oido": False}


def _modelo_arriba() -> bool:
    try:
        urllib.request.urlopen(f"{MODELO_URL}/health", timeout=2).read()
        return True
    except Exception:
        return False


def _servicio(nombre: str) -> bool:
    try:
        r = subprocess.run(
            ["systemctl", "--user", "is-active", nombre],
            capture_output=True, text=True, timeout=3,
        )
        return r.stdout.strip() == "active"
    except Exception:
        return False


def _grabando() -> bool:
    """¿El botón está grabando? (ptt.pid vivo y su `rec` también)."""
    if not (ESTADO / "ptt.pid").is_file():
        return False
    try:
        pid = int((ESTADO / "rec.pid").read_text(encoding="utf-8").strip())
        os.kill(pid, 0)
        return True
    except Exception:
        return False


def _foto_web() -> dict:
    """Lo que ve la página. Lo caro (modelo, oído) se refresca cada 3 s."""
    ahora_t = time.time()
    if ahora_t - _CACHE_WEB["t"] > 3:
        _CACHE_WEB.update(
            t=ahora_t, modelo=_modelo_arriba(), oido=_servicio("omni-oido.service")
        )
    return {
        "estado": _cargar_status(),
        "grabando": _grabando(),
        "modelo": _CACHE_WEB["modelo"],
        "oido": _CACHE_WEB["oido"],
        "pendientes": len(pendientes()),
    }


def cmd_web(opts: dict) -> dict:
    """Sirve la página local: un botón para hablar y un campo para escribir."""
    import threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    from urllib.parse import urlparse

    puerto = int(opts.get("puerto") or os.environ.get("OMNI_WEB_PORT") or 9932)
    verboso = bool(opts.get("verboso"))
    turno = threading.Lock()  # una grabación o un pedido a la vez
    nosotros = str(Path(__file__).resolve())

    def correr(*args, timeout: int = 180) -> dict:
        try:
            r = subprocess.run(
                [sys.executable, nosotros, *args],
                capture_output=True, text=True, timeout=timeout,
            )
        except subprocess.TimeoutExpired:
            return {"error": "se quedó pensando demasiado"}
        except Exception as exc:
            return {"error": str(exc)[:200]}
        try:
            return json.loads(r.stdout or "{}")
        except Exception:
            return {"error": (r.stderr or r.stdout or "sin respuesta").strip()[:300]}

    class Manejador(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, formato, *args):
            if verboso:
                sys.stderr.write("omni web: " + (formato % args) + "\n")

        # ── respuestas ──
        def _bytes(self, cuerpo: bytes, tipo: str, codigo: int = 200) -> None:
            self.send_response(codigo)
            self.send_header("Content-Type", tipo)
            self.send_header("Content-Length", str(len(cuerpo)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(cuerpo)

        def _json(self, objeto, codigo: int = 200) -> None:
            self._bytes(
                json.dumps(objeto, ensure_ascii=False).encode("utf-8"),
                "application/json; charset=utf-8",
                codigo,
            )

        def _cuerpo(self) -> dict:
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except Exception:
                n = 0
            if n <= 0:
                return {}
            try:
                return json.loads(self.rfile.read(min(n, 1_000_000)).decode("utf-8", "replace") or "{}")
            except Exception:
                return {}

        # ── lo que se pide ──
        def do_POST(self):
            ruta = urlparse(self.path).path.rstrip("/") or "/"
            if ruta == "/api/ptt":
                if not _modelo_arriba():
                    publicar("thinking", transcript="Levantando el modelo…", understood="")
                    if not asegurar_modelo():
                        return self._json({"error": "el modelo no levantó"}, 503)
                with turno:
                    salida = correr("ptt", "--json")
                return self._json(salida)
            if ruta == "/api/texto":
                pedido = str(self._cuerpo().get("texto") or "").strip()
                if not pedido:
                    return self._json({"error": "falta el texto"}, 400)
                with turno:
                    salida = correr("pedir", pedido, "--json")
                return self._json(salida)
            if ruta == "/api/oido":
                cuerpo = self._cuerpo()
                if "on" not in cuerpo:
                    return self._json({"error": "falta «on»"}, 400)
                accion = "start" if cuerpo.get("on") else "stop"
                try:
                    subprocess.run(
                        ["systemctl", "--user", accion, "omni-oido.service"],
                        capture_output=True, timeout=30,
                    )
                except Exception as exc:
                    return self._json({"error": str(exc)[:200]}, 500)
                _CACHE_WEB["t"] = 0.0
                return self._json({"oido": _servicio("omni-oido.service")})
            return self._json({"error": "no conozco ese pedido"}, 404)

        def do_GET(self):
            ruta = urlparse(self.path).path.rstrip("/") or "/"
            if ruta == "/":
                try:
                    cuerpo = WEB_PAGINA.read_bytes()
                except Exception:
                    return self._json({"error": "falta omni-web.html"}, 500)
                return self._bytes(cuerpo, "text/html; charset=utf-8")
            if ruta == "/api/estado":
                return self._json(_foto_web())
            if ruta == "/api/eventos":
                return self._eventos()
            return self._json({"error": "no conozco esa dirección"}, 404)

        def _eventos(self) -> None:
            """Server-Sent Events: un «data:» cada vez que cambia el estado."""
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "close")
            self.end_headers()
            previo, latido = None, 0.0
            try:
                while True:
                    actual = json.dumps(_foto_web(), ensure_ascii=False)
                    if actual != previo:
                        self.wfile.write(f"data: {actual}\n\n".encode("utf-8"))
                        self.wfile.flush()
                        previo = actual
                    if time.time() - latido > 15:
                        self.wfile.write(b": sigo\n\n")
                        self.wfile.flush()
                        latido = time.time()
                    time.sleep(0.25)
            except (BrokenPipeError, ConnectionResetError, OSError):
                return

    try:
        servidor = ThreadingHTTPServer(("127.0.0.1", puerto), Manejador)
    except OSError as exc:
        print(f"omni web: el puerto {puerto} no está libre ({exc})", file=sys.stderr)
        return {"accion": "web", "error": "puerto ocupado"}
    servidor.daemon_threads = True
    print(f"Omni en http://127.0.0.1:{puerto}  (Ctrl+C para cerrar)")
    try:
        servidor.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        print("")
    finally:
        servidor.shutdown()
        servidor.server_close()
    return {"accion": "web", "dicho": "Omni web cerrado."}


def main(argv: list[str]) -> int:
    args = argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0

    opts = {
        "agente": "sistema",
        "texto": "",
        "urgente": False,
        "callar": False,
        "dry": False,
        "json": False,
        "puerto": "",
        "verboso": False,
        "fijar": "",
    }
    i = 1
    while i < len(args):
        a = args[i]
        if a in ("--urgente", "-u"):
            opts["urgente"] = True
        elif a in ("--callar", "-c"):
            opts["callar"] = True
        elif a in ("--dry-run", "--no-say"):
            opts["dry"] = True
        elif a in ("--puerto", "-p"):
            opts["puerto"] = args[i + 1] if i + 1 < len(args) else ""
            i += 1
        elif a in ("--verboso", "-v"):
            opts["verboso"] = True
        elif a == "--fijar":
            opts["fijar"] = args[i + 1] if i + 1 < len(args) else ""
            i += 1
        elif a == "--json":
            opts["json"] = True
        elif a in ("--archivo", "-f"):
            opts["archivo"] = args[i + 1] if i + 1 < len(args) else ""
            i += 1
        elif a in ("--agente", "-a"):
            opts["agente"] = args[i + 1] if i + 1 < len(args) else "sistema"
            i += 1
        elif a in ("--texto", "-t"):
            opts["texto"] = args[i + 1] if i + 1 < len(args) else ""
            i += 1
        elif a.startswith("--"):
            pass
        else:
            opts["texto"] = (opts["texto"] + " " + a).strip()
        i += 1

    if not opts["texto"] and not sys.stdin.isatty() and args[0] in ("avisar", "decir", "pedir"):
        opts["texto"] = sys.stdin.read().strip()

    cmd = args[0]
    salida = {
        "avisar": cmd_avisar,
        "dime": cmd_dime,
        "buzon": cmd_buzon,
        "decir": cmd_decir,
        "escuchar": cmd_escuchar,
        "oido": cmd_oido,
        "ptt": cmd_ptt,
        "gate": cmd_gate,
        "pedir": cmd_pedir,
        "perfil": cmd_perfil,
        "web": cmd_web,
        "memoria": cmd_memoria,
    }.get(cmd)
    if not salida:
        print(f"omni: no conozco «{cmd}»", file=sys.stderr)
        return 2
    out = salida(opts)
    if opts["json"]:
        print(json.dumps(out, ensure_ascii=False, indent=1))
    elif out.get("dicho"):
        print(out["dicho"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
