#!/usr/bin/env python3
"""present-remote — mapeo de gestos del control de presentaciones.

Lee `keyd monitor` y traduce las pulsaciones del control (remapeadas en
present.conf a teclas dedicadas) en **gestos**, y cada gesto ejecuta el
comando que diga la config.

Gestos por botón:
    tap     1 toque
    double  2 toques seguidos
    triple  3 toques seguidos
    hold    mantener apretado (umbral hold_ms)

Los comandos se ejecutan con `sh -c`. Los que empiezan con `@` son acciones
internas de present-remote:

    @arrow prev    flecha contextual (terminal->tmux prev | otro->scroll arriba)
    @arrow next    flecha contextual (terminal->tmux next | otro->scroll abajo)
    @cancel        cancela la sesión de voz activa

Config: ~/.config/present-remote/config.toml (o $PRESENT_CONFIG).

Uso:
    present-remote                 demonio (lo levanta present-remote.service)
    present-remote --check         valida la config y sale
    present-remote --learn         imprime los eventos crudos de keyd (sin actuar)
    present-remote --replay        procesa eventos keyd por stdin (para test)
    present-remote cancel          cancela la sesión de voz activa
    present-remote arrow prev|next acción contextual de las flechas

Notas de implementación:
  - Se ignoran los "down" repetidos mientras la tecla sigue apretada: el control
    (y keyd) reemiten "down" al mantener, y eso rompía la detección de `hold`.
  - Si un botón no define `hold`, mantener no dispara nada (y tampoco cae en tap).
"""
import json
import os
import select
import signal
import subprocess
import sys
import time
import tomllib

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get(
    "PRESENT_CONFIG", os.path.join(HOME, ".config/present-remote/config.toml")
)
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PTT_PIDFILE = os.path.join(RUNTIME, "omar-ptt.pid")
LISTEN_UNIT = "omar-listen.service"
STATUS_FILE = os.path.join(RUNTIME, "omar", "status.json")
# La píldora publica su estado en este archivo (lo mismo que lee el glow):
# leerlo es instantáneo, sin arrancar un cliente de Quickshell.
PILL_OPEN = os.path.join(RUNTIME, "omar", "pill-open")
# Lo escribe `linux/voice/daemon.py` mientras reproduce y lo borra al terminar.
SPEAKING_FILE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"),
    "voice", "speaking.json",
)
PILL = os.path.join(HOME, "developing/omar/packaging/quickshell/omar-pill.qml")
GLOW = os.path.join(os.path.dirname(PILL), "omar-glow.qml")
LOG = open(os.devnull, "w")

ENV = dict(os.environ)
ENV["PATH"] = os.path.join(HOME, ".local/bin") + ":" + ENV.get("PATH", "/usr/bin:/bin")
# Los cambios de modo disparados por el botón no deben llenar de notificaciones.
ENV["OMAR_NOTIFY"] = "0"

DEFAULT_SETTINGS = {
    "hold_ms": 600,
    "multi_gap_ms": 320,
    "combo_ms": 600,
    "cancel_key": "esc",
}

GESTURES = ("tap", "double", "triple", "hold")
TAP_GESTURE = {1: "tap", 2: "double", 3: "triple"}

# Clases de ventana que tratamos como terminal.
TERMINALES = {
    "kitty", "foot", "footclient", "alacritty", "ghostty", "wezterm",
    "konsole", "gnome-terminal", "xterm", "st", "urxvt", "terminator",
    "tilix", "org.wezfurlong.wezterm",
}

# Keycodes (linux/input-event-codes.h): Ctrl(29), PgUp(104), PgDn(109).
CTRL, PGUP, PGDN = 29, 104, 109


def log(msg):
    print(f"[present-remote] {msg}", file=sys.stderr, flush=True)


def _spawn(*cmd):
    try:
        subprocess.Popen(
            cmd, stdout=LOG, stderr=LOG, stdin=subprocess.DEVNULL,
            start_new_session=True, env=ENV,
        )
    except FileNotFoundError as e:
        log(f"no encontré {cmd[0]}: {e}")


def _run_cmd(cmd):
    """Ejecuta un comando de shell en segundo plano (fire-and-forget)."""
    try:
        subprocess.Popen(
            ["sh", "-c", cmd], stdout=LOG, stderr=LOG, stdin=subprocess.DEVNULL,
            start_new_session=True, env=ENV,
        )
    except Exception as e:  # noqa: BLE001
        log(f"no pude ejecutar «{cmd}»: {e}")


# ── acciones internas ────────────────────────────────────────────────────
def _ctrl(codes):
    seq = [f"{CTRL}:1"]
    for k in codes:
        seq += [f"{k}:1", f"{k}:0"]
    seq.append(f"{CTRL}:0")
    _spawn("ydotool", "key", *seq)


def _scroll(direction):
    _spawn("ydotool", "click", "4" if direction == "up" else "5")


def active_class():
    try:
        out = subprocess.check_output(
            ["hyprctl", "activewindow", "-j"], text=True,
            stderr=subprocess.DEVNULL, timeout=1,
        )
        return ((json.loads(out) or {}).get("class") or "").lower()
    except Exception:  # noqa: BLE001
        return ""


def active_submap():
    try:
        return subprocess.check_output(
            ["hyprctl", "submap"], text=True,
            stderr=subprocess.DEVNULL, timeout=1,
        ).strip()
    except Exception:  # noqa: BLE001
        return ""


def arrow(action):
    """action: 'prev' (izquierda) | 'next' (derecha)."""
    # En el overview de hyprexpo, las flechas alternan de workspace. Ojo: no
    # sirve mandar Left/Right sinteticos (el catchall del submap cierra el
    # overview); hay que despertar el workspace directo.
    if active_submap() == "hyprexpo":
        delta = "-1" if action == "prev" else "+1"
        log(f"flecha {action}: overview hyprexpo -> workspace {delta}")
        _spawn("hyprctl", "dispatch", f'hl.dsp.focus({{workspace="{delta}"}})')
        return
    cls = active_class()
    if cls in TERMINALES:
        log(f"flecha {action}: terminal ({cls}) -> ventana tmux")
        _ctrl([PGUP] if action == "prev" else [PGDN])
    else:
        log(f"flecha {action}: {cls or 'app'} -> scroll")
        _scroll("up" if action == "prev" else "down")


def _is_voice_session(pid):
    """¿El PID es de verdad una sesión `node …/dist/index.js listen --no-wake`?

    No alcanza con buscar el texto en la línea de comandos: un shell o un
    editor que mencionen el patrón también matchean, y matarlos es peligroso
    (llegó a matar al propio toggle). Se valida el ejecutable y los argumentos.
    """
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return False
    if len(argv) < 3 or "node" not in os.path.basename(argv[0]):
        return False
    try:
        i = next(idx for idx, a in enumerate(argv) if a.endswith("dist/index.js"))
    except StopIteration:
        return False
    rest = argv[i + 1:]
    return "listen" in rest and "--no-wake" in rest


def _ptt_pids():
    """PIDs de sesiones de voz activas (push-to-talk)."""
    pids = []
    try:
        with open(PTT_PIDFILE) as f:
            pid = int(f.read().strip())
        if pid > 0 and _is_voice_session(pid):
            pids.append(pid)
    except (FileNotFoundError, ValueError):
        pass
    try:
        out = subprocess.check_output(
            ["pgrep", "-f", r"dist/index\.js listen --no-wake"],
            text=True, stderr=subprocess.DEVNULL,
        )
        for tok in out.split():
            pid = int(tok)
            if pid not in pids and _is_voice_session(pid):
                pids.append(pid)
    except Exception:  # noqa: BLE001
        pass
    return pids


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _wait_dead(pids, timeout):
    """Espera hasta `timeout` segundos a que mueran todos los pids."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not any(_alive(pid) for pid in pids):
            return True
        time.sleep(0.1)
    return not any(_alive(pid) for pid in pids)


def ptt_active():
    return bool(_ptt_pids())




def service_awake():
    """¿El servicio siempre-vivo tiene una conversación abierta?

    `status.json` lo publican tanto el loop como el dictado, así que sólo vale
    si su `pid` es el del oído (que se anota en `listen.pid`). `idle` significa
    que está esperando la palabra clave.
    """
    try:
        with open(os.path.join(RUNTIME, "omar", "listen.pid"), encoding="utf-8") as f:
            listen_pid = int(f.read().strip())
        with open(STATUS_FILE, encoding="utf-8") as f:
            snap = json.load(f)
        if int(snap.get("pid") or 0) != listen_pid:
            return False  # lo publicó otro (p. ej. el dictado)
        if time.time() * 1000 - float(snap.get("updatedAt") or 0) > 45_000:
            return False
        return snap.get("state") not in (None, "idle")
    except Exception:  # noqa: BLE001
        return False


def pill_is_open():
    """¿La píldora está abierta?

    La píldora publica `pill-open` ("1"/"0") en el runtime cada vez que abre o
    cierra —el mismo archivo que lee el glow—, así que el caso normal se
    resuelve leyendo un byte, sin arrancar Quickshell. El IPC queda de respaldo
    para cuando el archivo todavía no existe (arranque, píldora nunca abierta).
    """
    try:
        with open(PILL_OPEN, encoding="utf-8") as f:
            return f.read(1) == "1"
    except OSError:
        pass
    for _ in range(2):
        try:
            out = subprocess.check_output(
                ["qs", "ipc", "-p", PILL, "call", "omar-pill", "isOpen"],
                text=True, stderr=subprocess.DEVNULL, timeout=2.5,
            ).strip().lower()
            return out == "true"
        except Exception:  # noqa: BLE001
            time.sleep(0.15)
    return False


def voice_is_speaking():
    """¿El daemon de voz está reproduciendo algo AHORA?

    `speaking.json` lo escribe el daemon mientras suena y lo borra al terminar;
    la ventana de tiempo evita creerle a un archivo que quedó de un daemon
    caído. Sirve para que la tecla calle también el TTS de otro agente.
    """
    try:
        with open(SPEAKING_FILE, encoding="utf-8") as f:
            snap = json.load(f)
        started = int(snap.get("startedAt") or 0)
        dur = int(snap.get("durationMs") or 0)
    except (OSError, ValueError, TypeError):
        return False
    if started <= 0 or dur <= 0:
        return False
    now = time.time() * 1000
    return started - 500 <= now <= started + dur + 500


def cut_speaking():
    """Corta el TTS que esté sonando, sea de Omar o de otro agente."""
    if not voice_is_speaking():
        return False
    log("voice: corto el TTS que estaba sonando")
    _spawn("voice", "stop")
    return True


def omar_active():
    """Omar está encendido si hay conversación, píldora abierta o voz viva."""
    return pill_is_open() or service_awake() or ptt_active()


# Clientes que capturan el micrófono sin ser una conversación de voz con el
# usuario: cava (visualizador), los `parec` del propio Omar y los nodos del
# grafo de PipeWire. Cualquier OTRA captura es alguien hablando por su cuenta.
MIC_BENIGN = {"parec", "pacat", "cava", "node", "ee_soe_plugins", "easyeffects"}


def external_mic_owner():
    """Qué app está capturando el micrófono, si no es de Omar (o None).

    Sirve para no pisar una conversación speech-to-speech (STS) abierta en otra
    app —el navegador, la plataforma de agentes—: al prender Omar, Omar abre
    su propio `parec` y habla, y la sesión ajena se corta o se queda muda.
    """
    if os.environ.get("PRESENT_MIC_GUARD", "1") == "0":
        return None
    try:
        out = subprocess.check_output(
            ["pw-dump"], text=True, stderr=subprocess.DEVNULL, timeout=3,
        )
        nodes = json.loads(out)
    except Exception:  # noqa: BLE001
        return None
    for node in nodes:
        info = node.get("info") or {}
        props = info.get("props") or {}
        if props.get("media.class") != "Stream/Input/Audio":
            continue
        # Sólo cuenta una captura que está FLUYENDO. Los nodos del grafo propio
        # de PipeWire (`input.mic-bt-fx`, `input.phone-mic`) existen siempre y
        # quedan "idle" cuando nadie los usa; tomarlos por "otra app hablando"
        # trababa la tecla ("no prendo Omar — el micrófono lo usa input.mic-bt-fx").
        if (props.get("node.state") or info.get("state")) in (
            "suspended", "idle", "error",
        ):
            continue
        names = {
            str(props.get(key) or "").lower()
            for key in (
                "application.name", "application.process.binary", "node.name",
            )
        }
        if names & MIC_BENIGN:
            continue
        # Nodos virtuales de la cadena de micrófono propia (mic-bt-fx/mic-gain):
        # son fuente de Omar, no una conversación ajena.
        if any(name.startswith("input.") for name in names):
            continue
        return (
            props.get("application.name")
            or props.get("application.process.binary")
            or props.get("node.name")
            or "otra app"
        )
    return None


def _systemctl(*args, timeout=6):
    """systemctl --user best-effort: si no está, no rompe el gesto."""
    try:
        subprocess.run(
            ["systemctl", "--user", *args],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout,
        )
        return True
    except Exception:  # noqa: BLE001
        return False


def _is_listen_service(pid):
    """¿Ese PID es el `node … dist/index.js listen` del servicio?

    `listen.pid` puede quedar de un proceso muerto y el número reasignarse a
    otra cosa: antes de mandarle una señal se mira la línea de comandos.
    """
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return False
    if not argv or "node" not in os.path.basename(argv[0]):
        return False
    joined = " ".join(argv)
    return "dist/index.js" in joined and " listen" in joined


def _signal_service(sig):
    """Manda una señal de control ("SIGUSR1"/"SIGUSR2") al único oído.

    SIGUSR1 = abrir la conversación sin palabra clave; SIGUSR2 = cerrarla. El
    servicio siempre corre (Restart=always) y el loop registra las señales antes
    de cargar modelos, así que no hay que esperar a que esté "listo".

    Se lee `listen.pid` y se usa kill(2): `systemctl kill` arrancaba un cliente
    de systemd (~10-20 ms) y `start` podía esperar a que la unidad quedara
    activa, justo en el camino que tiene que ser instantáneo.
    """
    try:
        with open(os.path.join(RUNTIME, "omar", "listen.pid"), encoding="utf-8") as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        pid = 0
    signum = getattr(signal, str(sig), None)
    if pid > 0 and signum is not None and _is_listen_service(pid):
        try:
            os.kill(pid, signum)
            return
        except OSError:
            pass
    _systemctl("start", LISTEN_UNIT)
    # --kill-whom=main: `systemctl kill` manda a TODO el cgroup por defecto y
    # así le llegaba también a `parec` (el micrófono se cortaba y reiniciaba).
    _systemctl("kill", "--kill-whom=main", "-s", sig, LISTEN_UNIT)


def start_voice():
    """Prende Omar: abre la conversación en el servicio que ya está corriendo.

    No arranca otro proceso: el servicio omar-listen es el único oído y
    SIGUSR1 le dice "escuchá directo, sin la palabra clave". La píldora se abre
    ya para que el toque no se sienta muerto. Y le avisamos al glow que la
    píldora está abierta para que no dibuje su franja encima del campo de texto.
    """
    log("voice: prendo Omar (conversación directa)")
    _spawn("qs", "ipc", "-p", PILL, "call", "omar-pill", "open")
    _signal_service("SIGUSR1")


def cancel_voice():
    """Apaga Omar: cierra la conversación y la píldora.

    El proceso NUNCA se mata: el servicio siempre vivo vuelve solo a esperar la
    palabra clave (SIGUSR2). Primero se calla el audio y se cierra la
    conversación, porque es lo que el usuario está esperando; la UI y la
    limpieza de procesos viejos van después.
    """
    # 1) Callar YA, por los dos caminos a la vez: la señal cierra la
    #    conversación en el oído y `voice stop` corta el audio sin esperar a que
    #    el loop de Omar procese la señal (medido: ~80 ms). El daemon vacía la
    #    cola, así que no queda nada encolado para después.
    _signal_service("SIGUSR2")
    _spawn("voice", "stop")

    # 2) Cerrar la pildora YA: la UI no espera al proceso.
    _spawn("qs", "ipc", "-p", PILL, "call", "omar-pill", "close")
    # 2b) Apagar el glow ya tambien: si no, la franja negra y el subrayado se
    #     quedan visibles unos segundos vacios (el "poso" tras el ultimo texto).
    _spawn("qs", "ipc", "-p", GLOW, "call", "omar-glow", "hide")
    try:
        os.remove(PTT_PIDFILE)
    except FileNotFoundError:
        pass

    # 3) Cortar cualquier proceso de voz que haya quedado suelto. Es limpieza:
    #    la voz ya se cortó, así que los topes son cortos para no trabar la
    #    próxima pulsación de la tecla.
    pids = _ptt_pids()
    if pids:
        log(f"cancel: corto {pids}")
        for pid in pids:
            try:
                os.kill(pid, signal.SIGINT)
            except OSError:
                pass
        if not _wait_dead(pids, 1.0):
            for pid in pids:
                if _alive(pid):
                    try:
                        os.kill(pid, signal.SIGTERM)
                    except OSError:
                        pass
            if not _wait_dead(pids, 0.6):
                for pid in pids:
                    if _alive(pid):
                        try:
                            os.kill(pid, signal.SIGKILL)
                        except OSError:
                            pass
                _wait_dead(pids, 0.3)
    else:
        log("cancel: sin PTT suelto")


def toggle_voice():
    """Prende o apaga LA MISMA Omar, sin importar cómo se abrió.

    La dirección la decide el estado real de la conversación (el único loop),
    no la píldora: si la abrió la palabra clave, la píldora puede no estar
    abierta y aun así hay que cerrarla. La píldora es sólo la superficie; ahora
    la abre igual la tecla que la palabra clave.
    """
    if omar_active():
        cancel_voice()
        return
    # Aunque Omar no tenga la conversación abierta, si hay TTS sonando la tecla
    # lo calla: apretar "Windows" mientras habla un aviso tiene que silenciarlo,
    # no prender a Omar encima de la voz.
    if cut_speaking():
        return
    owner = external_mic_owner()
    if owner:
        # Alguien ya está hablando (STS): prender Omar le cortaría el micrófono.
        log(f"voice: no prendo Omar — el micrófono lo usa {owner}")
        return
    start_voice()


def builtin(cmd):
    parts = cmd[1:].split()
    if not parts:
        return
    if parts[0] == "arrow" and len(parts) >= 2 and parts[1] in ("prev", "next"):
        arrow(parts[1])
    elif parts[0] == "cancel":
        cancel_voice()
    elif parts[0] == "voice":
        toggle_voice()
    elif parts[0] == "enter":
        _spawn("ydotool", "key", "28:1", "28:0")
    else:
        log(f"acción interna desconocida: {cmd}")


# ── configuración ────────────────────────────────────────────────────────
def load_config(path=CONFIG_PATH):
    settings = dict(DEFAULT_SETTINGS)
    buttons = {}
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        log(f"sin config en {path}; no hay bindings")
        return settings, buttons
    except tomllib.TOMLDecodeError as e:
        log(f"config inválida ({path}): {e}")
        return settings, buttons

    for k, v in (data.get("settings") or {}).items():
        settings[k] = v

    for name, spec in (data.get("buttons") or {}).items():
        if not isinstance(spec, dict):
            continue
        table = {}
        for g in GESTURES:  # tap / double / triple / hold
            cmd = spec.get(g)
            if cmd is not None and str(cmd).strip():
                table[g] = str(cmd).strip()
        # Combo: este boton espera `combo_ms` por `combo_with`; si llega, corre
        # `combo`; si no, corre su gesto normal.
        if spec.get("combo_with") and spec.get("combo"):
            table["combo_with"] = str(spec["combo_with"]).strip()
            table["combo"] = str(spec["combo"]).strip()
        # Supresion: mientras este boton esta apretado, se ignoran los listados.
        sup = spec.get("suppress")
        if sup:
            table["suppress"] = [str(x).strip() for x in (sup if isinstance(sup, list) else [sup])]
        if table:
            buttons[name] = table
    return settings, buttons


# ── máquina de gestos ────────────────────────────────────────────────────
class Button:
    __slots__ = ("name", "pressed", "press_at", "hold_fired", "taps", "fire_at",
                 "max_taps", "suppress", "combo_with", "pending_at", "pending_gesture")

    def __init__(self, name, gestures):
        self.name = name
        self.pressed = False
        self.press_at = 0.0
        self.hold_fired = False
        self.taps = 0
        self.fire_at = None
        n = 1
        for i, g in TAP_GESTURE.items():
            if g in gestures:
                n = max(n, i)
        self.max_taps = n
        self.suppress = set(gestures.get("suppress") or [])
        self.combo_with = gestures.get("combo_with") or ""
        self.pending_at = None
        self.pending_gesture = "tap"


def _fire(button, gesture, gestures):
    cmd = gestures.get(gesture)
    if not cmd:
        log(f"{button.name} {gesture} (sin comando)")
        return
    log(f"{button.name} {gesture} -> {cmd}")
    if cmd.startswith("@"):
        builtin(cmd)
    else:
        _run_cmd(cmd)


def handle_event(out, buttons, settings, states):
    """Procesa una línea de keyd monitor. Devuelve False si se cerró el stream."""
    line = out.readline()
    if not line:
        return False
    parts = line.rstrip("\r\n").split("\t")
    if len(parts) < 3:
        return True
    key, _, state = parts[2].partition(" ")
    state = state.strip()
    if os.environ.get("PRESENT_DEBUG"):
        log(f"evt {key} {state}")

    if settings.get("cancel_key") and key == settings["cancel_key"] and state == "down":
        # Escape también calla un TTS suelto (aviso de otro agente) aunque Omar
        # no tenga la conversación abierta.
        if omar_active():
            cancel_voice()
        else:
            cut_speaking()
        return True

    # Supresion: si algun boton apretado suprime esta tecla, la ignoramos
    # (p. ej. el boton que manda Alt durante "mantener" suprime los Tab repetidos).
    for other in states.values():
        if other.pressed and key in other.suppress:
            return True

    b = states.get(key)
    if b is None:
        return True

    now = time.monotonic()
    if state == "down":
        if b.pressed:
            return True  # repetido al mantener: no reiniciar el gesto
        b.pressed = True
        b.press_at = now
        b.hold_fired = False
        b.fire_at = None  # un nuevo toque cancela el disparo pendiente
    elif state == "up":
        b.pressed = False
        if b.hold_fired:
            b.hold_fired = False
            b.taps = 0
            b.fire_at = None
        else:
            b.taps += 1
            if b.taps >= b.max_taps:
                fire_tap(b, TAP_GESTURE[b.taps], buttons, settings, states)
                b.taps = 0
                b.fire_at = None
            else:
                b.fire_at = now + settings["multi_gap_ms"] / 1000
    return True


def fire_tap(b, gesture, buttons, settings, states):
    """Dispara un toque, resolviendo combos (p. ej. doble+simple = triple)."""
    now = time.monotonic()
    combo_s = settings.get("combo_ms", 600) / 1000
    # ¿Esta pulsacion completa un combo que estaba esperando?
    for x in states.values():
        if (x.pending_at is not None and x.combo_with == b.name
                and now - x.pending_at <= combo_s):
            x.pending_at = None
            _fire(x, "combo", buttons[x.name])
            return
    # ¿Este boton inicia un combo? Se demora para ver si llega el otro.
    if b.combo_with:
        b.pending_at = now
        b.pending_gesture = gesture
        log(f"{b.name} {gesture} pendiente (combo con {b.combo_with})")
        return
    _fire(b, gesture, buttons[b.name])


def tick(buttons, settings, states):
    now = time.monotonic()
    hold_s = settings["hold_ms"] / 1000
    combo_s = settings.get("combo_ms", 600) / 1000
    for b in states.values():
        if b.pressed and not b.hold_fired and now - b.press_at >= hold_s:
            b.hold_fired = True
            _fire(b, "hold", buttons[b.name])
        if b.fire_at is not None and not b.pressed and now >= b.fire_at:
            fire_tap(b, TAP_GESTURE.get(b.taps, "tap"), buttons, settings, states)
            b.taps = 0
            b.fire_at = None
        if b.pending_at is not None and now - b.pending_at > combo_s:
            _fire(b, b.pending_gesture, buttons[b.name])
            b.pending_at = None
    # next deadline (informativo para el timeout del select)
    deadlines = []
    for b in states.values():
        if b.pressed and not b.hold_fired:
            deadlines.append(b.press_at + hold_s)
        if b.fire_at is not None:
            deadlines.append(b.fire_at)
        if b.pending_at is not None:
            deadlines.append(b.pending_at + combo_s)
    if not deadlines:
        return 0.05
    return max(0.0, min(0.05, min(deadlines) - now))


# ── modos de ejecución ───────────────────────────────────────────────────
def run_daemon(source="keyd"):
    settings, buttons = load_config()
    if not buttons:
        log("no hay bindings configurados; nada para hacer")
        return
    states = {name: Button(name, g) for name, g in buttons.items()}
    if source == "keyd":
        proc = subprocess.Popen(
            ["keyd", "monitor"], stdout=subprocess.PIPE, text=True, bufsize=1,
        )
        out = proc.stdout
    else:
        out = sys.stdin
    assert out is not None
    log(f"listo (hold={settings['hold_ms']}ms, gap={settings['multi_gap_ms']}ms, "
        f"botones={','.join(sorted(buttons))})")
    while True:
        timeout = tick(buttons, settings, states)
        r, _, _ = select.select([out], [], [], timeout)
        if r and not handle_event(out, buttons, settings, states):
            log("el stream de eventos terminó; salgo")
            break


def run_learn():
    proc = subprocess.Popen(["keyd", "monitor"], stdout=subprocess.PIPE, text=True, bufsize=1)
    out = proc.stdout
    assert out is not None
    log("--learn: mostrando eventos crudos (Ctrl-C para salir)")
    while True:
        line = out.readline()
        if not line:
            break
        parts = line.rstrip("\r\n").split("\t")
        if len(parts) >= 3:
            print(parts[2], flush=True)


def run_check():
    settings, buttons = load_config()
    print(f"config: {CONFIG_PATH}")
    print("settings:", {k: settings[k] for k in DEFAULT_SETTINGS if k in settings})
    if not buttons:
        print("buttons: (ninguno)")
        return 1
    for name in sorted(buttons):
        print(f"  {name}: {buttons[name]}")
    return 0


def main(argv):
    if len(argv) >= 2 and argv[1] in ("cancel", "arrow", "toggle", "voice"):
        if argv[1] in ("cancel", "toggle", "voice"):
            if argv[1] == "cancel":
                cancel_voice()
            else:
                toggle_voice()
        elif len(argv) >= 3 and argv[2] in ("prev", "next"):
            arrow(argv[2])
        return 0
    if len(argv) >= 2 and argv[1] == "--check":
        return run_check()
    if len(argv) >= 2 and argv[1] == "--learn":
        run_learn()
        return 0
    if len(argv) >= 2 and argv[1] == "--replay":
        run_daemon(source="stdin")
        return 0
    if os.environ.get("PRESENT_DISABLE") == "1":
        return 0
    run_daemon(source="keyd")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        pass
