#!/usr/bin/env bash
# codex-job — corre Codex como trabajo en segundo plano, con salida en vivo.
#
# Uso:  codex-job <<'BRIEF'  …  BRIEF
#       codex-job -f brief.md
#
# Imprime una línea por hecho mientras Codex trabaja (DICE / HACE / FIN), así la
# fila del job en la cabecera del hilo se puede abrir y ver el avance en el momento.
# No escribe archivos de estado: brief por stdin, salida por stdout.
#
# Variables: CODEX_BIN (default ~/.local/bin/codex), CODEX_MODEL (opcional),
#            CODEX_SANDBOX (workspace-write | read-only | danger-full-access),
#            CODEX_DIR (raíz de trabajo, default $PWD).
set -uo pipefail
CODEX="${CODEX_BIN:-$HOME/.local/bin/codex}"
[ -x "$CODEX" ] || { echo "codex-job: no encuentro $CODEX" >&2; exit 127; }

if [ "${1:-}" = "-f" ] && [ -n "${2:-}" ]; then
  brief=$(cat "$2")
else
  brief=$(cat)
fi
if [ "${#brief}" -lt 40 ]; then
  echo "codex-job: el brief es demasiado corto (${#brief} caracteres)" >&2
  exit 2
fi

sandbox="${CODEX_SANDBOX:-workspace-write}"
args=(exec --json --skip-git-repo-check -s "$sandbox" -C "${CODEX_DIR:-$PWD}")
[ -n "${CODEX_MODEL:-}" ] && args+=(-m "$CODEX_MODEL")
[ "$sandbox" = workspace-write ] && args+=(-c sandbox_workspace_write.network_access=true)

printf '%s' "$brief" | "$CODEX" "${args[@]}" - 2>&1 | python3 -u -c '
import json, sys
last = ""
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        event = json.loads(line)
    except Exception:
        print(line[:200], flush=True)
        continue
    kind = event.get("type")
    item = event.get("item") or {}
    itype = item.get("type")
    if kind == "item.completed" and itype == "agent_message":
        text = item.get("text", "").strip()
        if text:
            last = text
            print("DICE:", " ".join(text.split())[:400], flush=True)
    elif kind == "item.started" and itype == "command_execution":
        print("HACE: exec ->", " ".join(str(item.get("command", "")).split())[:160], flush=True)
    elif kind == "item.completed" and itype == "file_change":
        paths = [c.get("path", "") for c in (item.get("changes") or []) if isinstance(c, dict)]
        print("HACE: edita ->", " ".join(paths)[:160], flush=True)
    elif kind == "item.completed" and itype in ("mcp_tool_call", "web_search"):
        print("HACE:", itype, "->", str(item.get("query") or item.get("tool") or "")[:160], flush=True)
    elif kind == "item.completed" and itype == "reasoning":
        text = " ".join(str(item.get("text", "")).split())
        if text:
            print("DICE:", text[:400], flush=True)
    elif kind == "turn.completed":
        usage = event.get("usage") or {}
        print("FIN:", last[:1500] or "(sin mensaje final)", flush=True)
        print("USO:", "in", usage.get("input_tokens"), "out", usage.get("output_tokens"), flush=True)
    elif kind in ("turn.failed", "error"):
        print("FIN: ERROR:", str(event.get("error") or event.get("message") or event)[:800], flush=True)
'
