#!/usr/bin/env node
/**
 * ideas — la fábrica de ideas.
 *
 * Cada idea es un archivo Markdown con su conversación adentro. Se capturan
 * solas cuando el usuario pregunta "¿se podría…?", "¿y si…?", y quedan acá
 * hasta que se exploren, se promuevan a proyecto o se descarten con motivo.
 *
 * Datos: ~/.local/share/pi/ideas/  (PI_IDEAS_DIR lo cambia)
 *   index.md            tabla legible de todas las ideas
 *   IDEA-XXXX.md        una idea por archivo, con su conversación
 *
 * Uso:
 *   ideas                          lista las abiertas
 *   ideas listar [--todas]         lista (--todas incluye descartadas)
 *   ideas nueva "título" [-t texto] [-e etiquetas] [-d dudas]
 *   ideas ver IDEA-XXXX
 *   ideas anotar IDEA-XXXX "qué se conversó" [-t texto, -d dudas, -r riesgo]
 *   ideas estado IDEA-XXXX explorando|abierta
 *   ideas descartar IDEA-XXXX "motivo"
 *   ideas reabrir IDEA-XXXX
 *   ideas etiquetar IDEA-XXXX a,b
 *   ideas buscar "texto"
 *   ideas charlar IDEA-XXXX        abre una sesión de pi sobre esa idea
 *   ideas indice                   regenera index.md
 *
 * Sin dependencias: node + fs. La usa la tool `idea` de pi y el usuario.
 */

const fs = require("fs")
const path = require("path")
const os = require("os")
const { spawnSync } = require("child_process")

const DIR =
  process.env.PI_IDEAS_DIR || path.join(os.homedir(), ".local", "share", "pi", "ideas")
const AGENTE =
  (process.env.PI_RIG_AGENTE || process.env.PI_VOICE_AGENT || "agente").trim() || "agente"
const ESTADOS = ["abierta", "explorando", "promovida", "descartada"]

// ───────────────────────────────────────────────────────── utilidades

function ahora() {
  return new Date().toISOString()
}

function fechaCorta(iso) {
  return String(iso || "").slice(0, 16).replace("T", " ")
}

function asegurarDir() {
  fs.mkdirSync(DIR, { recursive: true })
}

function escaparYaml(v) {
  return String(v ?? "").replace(/\s+/g, " ").trim()
}

function nuevoId() {
  const abc = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
  for (let intento = 0; intento < 50; intento++) {
    let s = ""
    for (let i = 0; i < 4; i++) s += abc[Math.floor(Math.random() * abc.length)]
    const id = `IDEA-${s}`
    if (!fs.existsSync(path.join(DIR, `${id}.md`))) return id
  }
  return `IDEA-${Date.now().toString(36).toUpperCase().slice(-4)}`
}

function delta(argv) {
  const out = { _: [] }
  const alias = { t: "texto", e: "etiquetas", d: "dudas", r: "riesgo", m: "motivo" }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === "--todas" || a === "--todas-las-ideas") {
      out.todas = true
    } else if (a.startsWith("--")) {
      const clave = a.slice(2)
      out[clave] = argv[++i] ?? ""
    } else if (a.startsWith("-") && a.length === 2 && alias[a[1]]) {
      out[alias[a[1]]] = argv[++i] ?? ""
    } else {
      out._.push(a)
    }
  }
  return out
}

// ───────────────────────────────────────────────────── leer y escribir

const RE_FM = /^---\n([\s\S]*?)\n---\n?([\s\S]*)$/

function leerArchivo(ruta) {
  const crudo = fs.readFileSync(ruta, "utf8")
  const m = crudo.match(RE_FM)
  if (!m) return null
  const meta = {}
  for (const linea of m[1].split("\n")) {
    const i = linea.indexOf(":")
    if (i < 0) continue
    meta[linea.slice(0, i).trim()] = linea.slice(i + 1).trim()
  }
  return { meta, cuerpo: m[2].replace(/^\n/, ""), ruta }
}

function escribirArchivo(idea) {
  const meta = idea.meta
  const fm = [
    "---",
    `id: ${meta.id}`,
    `titulo: ${escaparYaml(meta.titulo)}`,
    `estado: ${meta.estado}`,
    `creada: ${meta.creada}`,
    `actualizada: ${meta.actualizada}`,
    `etiquetas: ${escaparYaml(meta.etiquetas || "")}`,
    `origen: ${escaparYaml(meta.origen || "")}`,
    "---",
    "",
  ].join("\n")
  fs.writeFileSync(idea.ruta, fm + idea.cuerpo.trimEnd() + "\n")
}

function todas() {
  asegurarDir()
  const items = []
  for (const f of fs.readdirSync(DIR)) {
    if (!/^IDEA-.*\.md$/.test(f)) continue
    try {
      const idea = leerArchivo(path.join(DIR, f))
      if (idea) items.push(idea)
    } catch {
      /* archivo roto: se ignora */
    }
  }
  return items.sort((a, b) =>
    String(b.meta.actualizada || "").localeCompare(String(a.meta.actualizada || "")),
  )
}

function buscarPorId(pedido) {
  const id = String(pedido || "").trim().toUpperCase()
  if (!id) return null
  const full = id.startsWith("IDEA-") ? id : `IDEA-${id}`
  const ruta = path.join(DIR, `${full}.md`)
  if (fs.existsSync(ruta)) return leerArchivo(ruta)
  const items = todas()
  return items.find((i) => i.meta.id === full) || items.find((i) => i.meta.id.endsWith(full)) || null
}

function tocar(idea) {
  idea.meta.actualizada = ahora()
  escribirArchivo(idea)
  indice()
}

// ───────────────────────────────────────────────────────────── índice

function indice() {
  asegurarDir()
  const items = todas()
  const abiertas = items.filter((i) => i.meta.estado !== "descartada")
  const descartadas = items.filter((i) => i.meta.estado === "descartada")
  const fila = (i) =>
    `| [${i.meta.id}](./${i.meta.id}.md) | ${i.meta.estado} | ${i.meta.etiquetas || "—"} | ${i.meta.titulo} | ${fechaCorta(i.meta.actualizada)} |`
  const lineas = [
    "# Fábrica de ideas",
    "",
    "Preguntas especulativas que el usuario tiró y quedaron capturadas. Cada idea",
    "tiene su archivo con la idea, las dudas y la conversación que se fue dando.",
    "",
    `Abiertas: **${abiertas.length}** · Descartadas: **${descartadas.length}**`,
    "",
  ]
  if (abiertas.length) {
    lineas.push(
      "| id | estado | etiquetas | idea | actualizada |",
      "| --- | --- | --- | --- | --- |",
      ...abiertas.map(fila),
      "",
    )
  } else {
    lineas.push("_Todavía no hay ideas abiertas._", "")
  }
  if (descartadas.length) {
    lineas.push(
      "## Descartadas",
      "",
      "| id | estado | etiquetas | idea | actualizada |",
      "| --- | --- | --- | --- | --- |",
      ...descartadas.map(fila),
      "",
    )
  }
  fs.writeFileSync(path.join(DIR, "index.md"), lineas.join("\n"))
  return items.length
}

// ───────────────────────────────────────────────────────── comandos

function cmdNueva(args) {
  const titulo = (args.titulo || args._.join(" ") || "").trim()
  if (!titulo) {
    salir('Falta el título. Ej: ideas nueva "teléfono viejo como nodo de cómputo"')
  }
  const id = nuevoId()
  const t = ahora()
  const cuerpo = [
    `# ${titulo}`,
    "",
    "## La idea",
    "",
    (args.texto || "").trim() || "_Sin desarrollar todavía._",
    "",
    "## Qué la haría funcionar",
    "",
    "_A completar cuando se explore._",
    "",
    "## Dudas y riesgos",
    "",
    (args.dudas || "").trim() || "_Sin dudas anotadas todavía._",
    "",
    "## Conversación",
    "",
  ].join("\n")
  const idea = {
    meta: {
      id,
      titulo,
      estado: "abierta",
      creada: t,
      actualizada: t,
      etiquetas: (args.etiquetas || "").trim(),
      origen: args.origen || AGENTE,
    },
    cuerpo,
    ruta: path.join(DIR, `${id}.md`),
  }
  tocar(idea)
  console.log(`Idea guardada: ${id} — ${titulo}`)
  console.log(`Archivo: ${idea.ruta}`)
}

function cmdListar(args) {
  const items = todas().filter((i) => args.todas || i.meta.estado !== "descartada")
  if (!items.length) {
    console.log("Todavía no hay ideas. Cuando el usuario pregunte \"¿se podría…?\", se captura sola.")
    return
  }
  const ancho = Math.max(...items.map((i) => i.meta.id.length))
  const etiqueta = (i) => (i.meta.etiquetas ? ` [${i.meta.etiquetas}]` : "")
  for (const i of items) {
    console.log(
      `${i.meta.id.padEnd(ancho)}  ${i.meta.estado.padEnd(10)}  ${i.meta.titulo}${etiqueta(i)}`,
    )
  }
  console.log(`\n${items.length} idea(s). Detalle: ideas ver IDEA-XXXX`)
}

function cmdVer(args) {
  const idea = buscarPorId(args._[0])
  if (!idea) salir(`No encontré la idea ${args._[0] || ""}. Probá: ideas listar`)
  console.log(`Estado: ${idea.meta.estado} · creada ${fechaCorta(idea.meta.creada)}`)
  if (idea.meta.etiquetas) console.log(`Etiquetas: ${idea.meta.etiquetas}`)
  console.log(`Archivo: ${idea.ruta}`)
  console.log("")
  console.log(idea.cuerpo.trimEnd())
}

function cmdAnotar(args) {
  const idea = buscarPorId(args._[0])
  if (!idea) salir(`No encontré la idea ${args._[0] || ""}. Probá: ideas listar`)
  const texto = (args.texto || args._.slice(1).join(" ") || "").trim()
  if (!texto) salir('Falta lo que se anota. Ej: ideas anotar IDEA-XXXX "medido: 3 W en reposo"')
  const partes = [`- ${texto}`]
  if (args.riesgo) partes.push(`- Riesgo: ${args.riesgo}`)
  if (args.dudas) partes.push(`- Duda: ${args.dudas}`)
  const entrada = [`### ${fechaCorta(ahora())} · ${AGENTE}`, "", ...partes, ""].join("\n")
  idea.cuerpo = idea.cuerpo.trimEnd() + "\n\n" + entrada
  if (idea.meta.estado === "descartada") idea.meta.estado = "explorando"
  tocar(idea)
  console.log(`Anotado en ${idea.meta.id}.`)
}

function cmdEstado(args) {
  const idea = buscarPorId(args._[0])
  if (!idea) salir(`No encontré la idea ${args._[0] || ""}.`)
  const estado = String(args._[1] || "").toLowerCase()
  if (!ESTADOS.includes(estado)) salir(`Estado inválido. Opciones: ${ESTADOS.join(", ")}`)
  idea.meta.estado = estado
  tocar(idea)
  console.log(`${idea.meta.id} → ${estado}`)
}

function cmdDescartar(args) {
  const idea = buscarPorId(args._[0])
  if (!idea) salir(`No encontré la idea ${args._[0] || ""}.`)
  const motivo = (args.motivo || args._.slice(1).join(" ") || "").trim()
  idea.meta.estado = "descartada"
  const entrada = [
    `### ${fechaCorta(ahora())} · ${AGENTE}`,
    "",
    `- Descartada${motivo ? `: ${motivo}` : "."}`,
    "",
  ].join("\n")
  idea.cuerpo = idea.cuerpo.trimEnd() + "\n\n" + entrada
  tocar(idea)
  console.log(`${idea.meta.id} descartada${motivo ? `: ${motivo}` : "."}`)
}

function cmdEtiquetar(args) {
  const idea = buscarPorId(args._[0])
  if (!idea) salir(`No encontré la idea ${args._[0] || ""}.`)
  idea.meta.etiquetas = (args._[1] || args.etiquetas || "").trim()
  tocar(idea)
  console.log(`${idea.meta.id} → etiquetas: ${idea.meta.etiquetas || "(ninguna)"}`)
}

function cmdBuscar(args) {
  const q = (args._.join(" ") || "").toLowerCase().trim()
  if (!q) salir("Falta el texto a buscar.")
  const hits = todas().filter(
    (i) => i.meta.titulo.toLowerCase().includes(q) || i.cuerpo.toLowerCase().includes(q),
  )
  if (!hits.length) {
    console.log(`Sin resultados para "${q}".`)
    return
  }
  for (const i of hits) console.log(`${i.meta.id}  ${i.meta.estado.padEnd(10)}  ${i.meta.titulo}`)
}

function cmdCharlar(args) {
  const idea = buscarPorId(args._[0])
  if (!idea) salir(`No encontré la idea ${args._[0] || ""}.`)
  const prompt =
    `Conversemos sobre la idea ${idea.meta.id} — ${idea.meta.titulo}. ` +
    `Leé @${idea.ruta} y seguimos desde donde quedó. ` +
    `Al cerrar, anotá la conclusión con la tool idea (accion anotar).`
  const bin = process.env.PI_BIN || "pi"
  const r = spawnSync(bin, [prompt], { stdio: "inherit" })
  if (r.error) salir(`No pude abrir pi: ${r.error.message}`)
  process.exit(r.status ?? 0)
}

function salir(msg) {
  console.error(msg)
  process.exit(1)
}

// ────────────────────────────────────────────────────────────── main

function main() {
  const argv = process.argv.slice(2)
  const cmd = argv[0] && !argv[0].startsWith("-") ? argv[0] : "listar"
  const args = delta(argv[0] && !argv[0].startsWith("-") ? argv.slice(1) : argv)
  asegurarDir()
  switch (cmd) {
    case "nueva":
    case "nuevo":
    case "add":
      return cmdNueva(args)
    case "listar":
    case "ls":
      return cmdListar(args)
    case "ver":
    case "show":
      return cmdVer(args)
    case "anotar":
    case "nota":
      return cmdAnotar(args)
    case "estado":
      return cmdEstado(args)
    case "descartar":
      return cmdDescartar(args)
    case "reabrir":
      return cmdEstado({ _: [args._[0], "abierta"] })
    case "etiquetar":
    case "tag":
      return cmdEtiquetar(args)
    case "buscar":
    case "grep":
      return cmdBuscar(args)
    case "charlar":
    case "abrir":
      return cmdCharlar(args)
    case "indice":
    case "index":
      console.log(`Índice regenerado: ${path.join(DIR, "index.md")} (${indice()} ideas)`)
      return
    case "ayuda":
    case "help":
    case "-h":
    case "--help":
      return ayuda()
    default:
      return salir(`No conozco "${cmd}". Probá: ideas ayuda`)
  }
}

function ayuda() {
  console.log(
    [
      "ideas — fábrica de ideas",
      "",
      "  ideas                          lista las abiertas",
      "  ideas listar [--todas]         lista (--todas incluye descartadas)",
      '  ideas nueva "título" [-t texto] [-e etiquetas] [-d dudas]',
      "  ideas ver IDEA-XXXX",
      '  ideas anotar IDEA-XXXX "conclusión" [-r riesgo] [-d duda]',
      "  ideas estado IDEA-XXXX explorando|abierta|promovida",
      '  ideas descartar IDEA-XXXX "motivo"',
      "  ideas reabrir IDEA-XXXX",
      "  ideas etiquetar IDEA-XXXX a,b",
      '  ideas buscar "texto"',
      "  ideas charlar IDEA-XXXX        abre pi sobre la idea",
      "  ideas indice                   regenera index.md",
      "",
      `Datos: ${DIR}`,
    ].join("\n"),
  )
}

main()
