#!/bin/bash

# Reemplaza a /usr/bin/omarchy-battery-low (va antes en PATH: ~/.local/bin).
#
# Por qué existe: el original manda la alerta con -u critical, y omarchy-shell
# traduce critical a duración 0 (Service.qml, durationFor), o sea un toast que
# NO expira nunca, que además se persiste y se vuelve a mostrar en cada arranque
# del shell. Con el cargador haciendo falso contacto eso deja una pared de
# "Time to recharge!" encima de todo hasta que la cierres a mano.
#
# Qué hace esta copia:
#   1. Texto propio en castellano neutro, dos líneas y el porcentaje en negrita.
#   2. Queda en pantalla un minuto largo (DURACION) para que dé tiempo a
#      conectarlo. El shell corta cualquier aviso automático a 30 s
#      (Service.qml, maxPopupDuration), así que va como critical —que dura 0, o
#      sea no expira— y lo cierra este mismo script: apenas entra corriente, o
#      cuando se cumple DURACION. Sin cuenta regresiva ni reapariciones.
#   3. Una alerta cada 10 minutos. El original ya avisa una vez por descarga,
#      pero ese latch se resetea cada vez que vuelve la corriente; con el cable
#      flojo (2026-11-26: 48 cambios de fuente en 10 minutos) avisaba por cada
#      parpadeo.
#
# El hook battery-low corre siempre y sin límite: 00-power-extreme.sh ya tiene
# su propia gracia y es lo que entra en ahorro extremo.

set -uo pipefail

TITULO="Conecta el cargador"
DURACION="${BATERIA_AVISO_SEGUNDOS:-70}"
FUENTES="${POWER_SUPPLY_DIR:-/sys/class/power_supply}"
SELF=$(readlink -f "$0")

cargando() {
  local p
  for p in "$FUENTES"/*/online; do
    [ -f "$p" ] || continue
    case "$p" in */BAT*) continue ;; esac
    [ "$(cat "$p" 2>/dev/null)" = "1" ] && return 0
  done
  return 1
}

cerrar() { omarchy-shell notifications dismiss "$TITULO" >/dev/null 2>&1 || true; }

# Modo interno: el que cierra el aviso. Corre suelto (setsid) para sobrevivir a
# la salida del avisador; si la laptop se apaga antes, el toast queda pero el
# próximo arranque del shell lo archiva.
if [[ ${1:-} == --cerrar ]]; then
  fin=$(($(date +%s) + DURACION))
  while :; do
    if cargando; then
      cerrar
      exit 0
    fi
    (($(date +%s) >= fin)) && break
    sleep 2
  done
  cerrar
  exit 0
fi

if (($# != 1)); then
  echo "Usage: omarchy-battery-low <percentage>" >&2
  exit 1
fi

level=$1
[[ $level =~ ^[0-9]+$ ]] || exit 0

omarchy-hook battery-low "$level" || true

STAMP="${XDG_RUNTIME_DIR:-/tmp}/omarchy-battery-low.stamp"
now=$(date +%s)
if [[ -f $STAMP ]]; then
  last=$(cat "$STAMP" 2>/dev/null || echo 0)
  if [[ $last =~ ^[0-9]+$ ]] && ((now - last < 600)); then
    exit 0
  fi
fi
# Si el sello no se puede escribir, se avisa igual: callar la alerta es peor
# que repetirla.
mkdir -p "$(dirname "$STAMP")" 2>/dev/null || true
{ printf '%s\n' "$now" >"$STAMP"; } 2>/dev/null || true

omarchy-notification-send -g 󱐋 -i battery-caution -u critical "$TITULO" \
  "Te queda <b>${level}%</b> de batería.<br/>Este aviso se va solo cuando lo conectes." \
  || exit 0

setsid -f "$SELF" --cerrar >/dev/null 2>&1 || true
