#!/usr/bin/env bash
# kokoro-read — lee un PDF/texto en voz alta con el Kokoro del sistema (voz
# local). Es un cliente fino (sólo stdlib): le pide el audio por socket a
# kokoro-tts.service, no carga ningún modelo.
# Uso: kokoro-read <archivo.pdf|archivo.txt> [--voice V] [--speed S] [--with-refs]
# Control: kokoro-ctl {pausa|siguiente|anterior|salir}
set -euo pipefail

SRC="${HOME}/dotfiles/linux/voice/reader/kokoro_read.py"

exec python3 "$SRC" "$@"
