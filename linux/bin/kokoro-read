#!/usr/bin/env bash
# kokoro-read — lee un PDF/texto en voz alta con Kokoro (voz local).
# Uso: kokoro-read <archivo.pdf|archivo.txt> [--voice V] [--speed S] [--with-refs]
# Control: kokoro-ctl {pausa|siguiente|anterior|salir}
set -euo pipefail

PY="${HOME}/.local/share/kokoro-venv/bin/python"
SRC="${HOME}/dotfiles/linux/voice/reader/kokoro_read.py"

if [[ ! -x "$PY" ]]; then
    echo "kokoro-read: falta el entorno (~/.local/share/kokoro-venv)" >&2
    echo "             corré: ~/dotfiles/scripts/setup-kokoro-reader.sh" >&2
    exit 1
fi

exec "$PY" "$SRC" "$@"
