#!/usr/bin/env bash
# dsh-web — abre la Web UI de DeepSeek Harness (dsh web).
#
# El servidor vive en el unit de usuario dsh-web.service (sobrevive a este
# script y se reusa entre lanzamientos). El token de acceso es por proceso:
# --serve trunca el log en cada arranque y deja ahí la URL vigente, que este
# script relee para abrir la UI.
#
# Uso:
#   dsh-web            levanta el servidor si hace falta y abre/focaliza la UI
#   dsh-web --url      imprime la URL con token (no abre nada)
#   dsh-web --status   estado del unit + URL vigente
#   dsh-web --stop     apaga el servidor
#   dsh-web --serve    corre el servidor en primer plano (lo usa el unit)
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-web"
LOG="$STATE/server.log"
UNIT=dsh-web.service

current_url() {
  grep -o 'http://[^[:space:]]*' "$LOG" 2>/dev/null | tail -1
}

alive_url() {
  local url code
  url=$(current_url)
  [[ -n $url ]] || return 1
  # Solo 2xx/3xx sirven: 000 es conexión rechazada y 401 es un token viejo de
  # un arranque anterior.
  code=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "$url" 2>/dev/null)
  [[ $code == [23]* ]] || return 1
  printf '%s\n' "$url"
}

wait_url() {
  local i
  for i in $(seq 1 120); do
    alive_url && return 0
    # Si el unit ya quedó en failed no tiene sentido seguir esperando.
    [[ $(systemctl --user is-failed "$UNIT" 2>/dev/null) == failed ]] && return 1
    sleep 0.5
  done
  return 1
}

ensure_server() {
  alive_url && return 0
  # systemd corta los arranques repetidos (start-limit-hit) y deja el unit en
  # failed: se limpia el contador y se reintenta una vez. Sin esto, abrir la
  # UI dos veces seguidas podía quedar bloqueado cinco minutos.
  if ! systemctl --user start "$UNIT" >/dev/null 2>&1; then
    systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
    systemctl --user start "$UNIT" >/dev/null 2>&1 || true
  fi
  wait_url
}

case "${1:-}" in
  --serve)
    # Bajo systemd (dsh-web.service): publica la URL en el log y el resto al
    # journal. pipefail propaga el fallo de dsh para que Restart actúe.
    mkdir -p "$STATE"
    : >"$LOG"
    set -o pipefail
    dsh web --no-open 2>&1 | tee -a "$LOG"
    exit "${PIPESTATUS[0]}"
    ;;
  --url)
    alive_url || ensure_server || exit 1
    exit 0
    ;;
  --stop)
    exec systemctl --user stop "$UNIT"
    ;;
  --status)
    systemctl --user status "$UNIT" --no-pager | head -20
    alive_url
    exit 0
    ;;
  -h | --help)
    # Todas las líneas de comentario de la cabecera, sin el shebang.
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"
    exit 0
    ;;
  "") ;;
  *)
    echo "dsh-web: opción desconocida '$1'" >&2
    exit 2
    ;;
esac

if ! url=$(alive_url); then
  if ! url=$(ensure_server); then
    echo "dsh-web: el servidor no respondió. Revisá: journalctl --user -u $UNIT" >&2
    command -v notify-send >/dev/null && notify-send -u critical "DeepSeek Harness" "El servidor no arrancó"
    exit 1
  fi
fi

# Si ya hay un panel abierto, enfocarlo; si no, abrirlo como web app en Brave.
# El patrón es la clase de la ventana de Brave para --app con host loopback
# (brave-127.0.0.1__-Default): el título no sirve porque "DeepSeek Harness"
# también aparece en pestañas comunes del navegador.
if command -v hyprctl >/dev/null && hyprctl clients -j >/dev/null 2>&1; then
  exec omarchy-launch-or-focus-webapp "brave-127.0.0.1__" "$url"
fi
exec omarchy-launch-webapp "$url"
