#!/usr/bin/env bash
# dsh-web — abre la Web UI de DeepSeek Harness (dsh web) y la publica en el celular.
#
# El servidor vive en el unit de usuario dsh-web.service (sobrevive a este
# script y se reusa entre lanzamientos). El token de acceso es por proceso:
# --serve trunca el log en cada arranque y deja ahí la URL vigente, que este
# script relee para abrir la UI.
#
# El celular entra por Tailscale: el servidor sigue escuchando solo en
# 127.0.0.1 y `tailscale serve` publica https://<nodo>:8446 (tailnet-only)
# hacia ese loopback. El puerto interno (3980) y el enlace de afuera son fijos,
# así que la cookie de sesión (30 días, atada a host:puerto) sobrevive a los
# reinicios del servidor. Por el proxy el header Host es el nombre del nodo, y
# el cerco de confianza de /api solo acepta loopback, la IP de bind o lo que se
# declare con --trusted-host: por eso --serve lo pasa.
#
# Uso:
#   dsh-web            levanta el servidor si hace falta y abre/focaliza la UI
#   dsh-web --restart  reinicia el servidor y reabre la UI (toma este script)
#   dsh-web --phone    imprime el enlace del celular (+ QR si hay terminal)
#   dsh-web --url      imprime la URL local con token (no abre nada)
#   dsh-web --status   estado del unit + URLs local y del celular
#   dsh-web --stop     apaga el servidor
#   dsh-web --serve    corre el servidor en primer plano (lo usa el unit)
set -uo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-web"
LOG="$STATE/server.log"
PHONE_FILE="$STATE/phone.url"
TS_HOST_FILE="$STATE/tshost"
TRUST_FILE="$STATE/trusted-host"
UNIT=dsh-web.service
# Puerto del enlace tailnet-only. 443 lo ocupa otra app y 8443-8445 también.
TS_PORT="${DSH_WEB_TS_PORT:-8446}"
# Puerto local fijo: no compite con el 3080 de un `dsh web` lanzado a mano, y
# como el origen no cambia entre arranques la cookie del navegador y la ventana
# abierta sobreviven a un reinicio del servidor. Si está ocupado se usa uno
# efímero (--port 0), como antes.
PORT="${DSH_WEB_PORT:-3980}"

current_url() {
  grep -o 'http://[^[:space:]]*' "$LOG" 2>/dev/null | tail -1
}

port_of() {
  local rest=${1#*//}
  rest=${rest%%/*}
  printf '%s\n' "${rest##*:}"
}

token_of() {
  [[ $1 == *"token="* ]] || return 0
  local rest=${1#*token=}
  printf '%s\n' "${rest%%&*}"
}

free_port() {
  local port=$1
  if command -v ss >/dev/null; then
    ss -ltnH "sport = :$port" 2>/dev/null | grep -q . && return 1
  fi
  return 0
}

# Nombre MagicDNS del nodo (sin el punto final). Se cachea porque tailscaled
# puede tardar en conectar al arrancar y el unit ya necesita el nombre para
# --trusted-host: el nombre del nodo no cambia entre arranques.
ts_host() {
  local host=""
  if command -v tailscale >/dev/null; then
    host=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // ""' 2>/dev/null | sed 's/\.$//')
  fi
  if [[ -n ${host:-} ]]; then
    printf '%s\n' "$host" >"$TS_HOST_FILE" 2>/dev/null
  else
    host=$(cat "$TS_HOST_FILE" 2>/dev/null)
  fi
  [[ -n ${host:-} ]] || return 1
  printf '%s\n' "$host"
}

wait_ts_host() {
  local tries=${1:-60} i host
  for i in $(seq 1 "$tries"); do
    host=$(ts_host) && { printf '%s\n' "$host"; return 0; }
    sleep 0.5
  done
  return 1
}

# El servidor vivo se arrancó con --trusted-host (marca de --serve). Sin eso el
# proxy recibe el index pero toda llamada a /api da 403: mejor no ofrecer enlace.
server_exposed() {
  local host ts
  [[ -f $TRUST_FILE ]] || return 1
  host=$(cat "$TRUST_FILE" 2>/dev/null)
  [[ -n $host ]] || return 1
  ts=$(ts_host 2>/dev/null) || ts=""
  [[ -z $ts || $ts == "$host" ]]
}

# Publica el loopback vivo en https://<nodo>:<TS_PORT> y devuelve el enlace con
# el token de este proceso. Idempotente: reaplicar el mapeo solo lo actualiza.
publish_phone() {
  local url=$1 host port token
  server_exposed || return 1
  host=$(ts_host) || return 1
  port=$(port_of "$url")
  token=$(token_of "$url")
  [[ -n $port && -n $token ]] || return 1
  tailscale serve --bg --https="$TS_PORT" "http://127.0.0.1:$port" >/dev/null 2>&1 || return 1
  printf 'https://%s:%s/?token=%s\n' "$host" "$TS_PORT" "$token"
}

# Enlace guardado, solo si su token es el del servidor vivo.
phone_url() {
  local stored token
  [[ -f $PHONE_FILE ]] || return 1
  stored=$(cat "$PHONE_FILE")
  token=$(token_of "$(current_url)")
  [[ -n $stored && -n $token && $stored == *"token=$token" ]] || return 1
  printf '%s\n' "$stored"
}

save_phone() {
  printf '%s\n' "$1" >"$PHONE_FILE"
}

# Corre dentro de --serve: espera la URL del log y publica el enlace para el
# celular. Reintenta porque tailscaled puede subir después que el harness.
announce_phone() {
  local parent=$$ url phone attempt
  for attempt in $(seq 1 120); do
    url=$(current_url)
    [[ -n ${url:-} ]] && break
    sleep 0.5
    kill -0 "$parent" 2>/dev/null || return 0
  done
  [[ -n ${url:-} ]] || return 0
  for attempt in $(seq 1 30); do
    if phone=$(publish_phone "$url"); then
      save_phone "$phone"
      printf 'dsh-web: celular: %s\n' "$phone"
      return 0
    fi
    kill -0 "$parent" 2>/dev/null || return 0
    sleep 10
  done
  printf 'dsh-web: tailscale no publicó el enlace del celular\n' >&2
}

# Aviso con el enlace; un clic lo copia al portapapeles.
announce_link() {
  local phone=$1
  [[ -n $phone ]] || return 0
  if command -v notify >/dev/null; then
    if command -v wl-copy >/dev/null; then
      notify -u normal -t 15000 --app-name "DeepSeek Harness" \
        "DeepSeek Harness en el celular" "$phone" --exec wl-copy "$phone"
    else
      notify -u normal -t 15000 --app-name "DeepSeek Harness" \
        "DeepSeek Harness en el celular" "$phone"
    fi
  elif command -v notify-send >/dev/null; then
    notify-send -a "DeepSeek Harness" "DeepSeek Harness en el celular" "$phone"
  fi
}

alive_url() {
  local url code
  url=$(current_url)
  [[ -n $url ]] || return 1
  # Solo 2xx/3xx sirven: 000 es conexión rechazada y 401 es un token viejo de
  # un arranque anterior.
  code=$(curl -s -o /dev/null -m 2 -w '%{http_code}' "$url" 2>/dev/null)
  [[ $code == [23]* ]] || return 1
  printf '%s\n' "$url"
}

wait_url() {
  local i
  for i in $(seq 1 120); do
    alive_url && return 0
    # Si el unit ya quedó en failed no tiene sentido seguir esperando.
    [[ $(systemctl --user is-failed "$UNIT" 2>/dev/null) == failed ]] && return 1
    sleep 0.5
  done
  return 1
}

ensure_unit() {
  # El unit vive en dotfiles; en una máquina nueva puede no estar enlazado y
  # entonces `systemctl --user start` falla sin decir por qué. Se enlaza acá
  # (mismo patrón que install-user-units.sh) para que abrir la app desde el
  # launcher funcione sin pasos manuales.
  local src="${HOME}/dotfiles/linux/system/systemd-user/$UNIT"
  local dst="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
  systemctl --user cat "$UNIT" >/dev/null 2>&1 && return 0
  [[ -f $src ]] || return 0
  mkdir -p "$(dirname "$dst")"
  ln -sfn "$src" "$dst"
  systemctl --user daemon-reload
}

ensure_server() {
  alive_url && return 0
  ensure_unit
  # El arranque en frío tarda ~20 s: sin aviso, el click en el launcher parece
  # no hacer nada.
  command -v notify-send >/dev/null \
    && notify-send -a "DeepSeek Harness" "Levantando el harness…" "La ventana se abre cuando el servidor responde"
  # systemd corta los arranques repetidos (start-limit-hit) y deja el unit en
  # failed: se limpia el contador y se reintenta una vez. Sin esto, abrir la
  # UI dos veces seguidas podía quedar bloqueado cinco minutos.
  if ! systemctl --user start "$UNIT" >/dev/null 2>&1; then
    systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
    systemctl --user start "$UNIT" >/dev/null 2>&1 || true
  fi
  wait_url
}

case "${1:-}" in
  --serve)
    # Bajo systemd (dsh-web.service): publica la URL en el log y el resto al
    # journal. pipefail propaga el fallo de dsh para que Restart actúe.
    mkdir -p "$STATE"
    : >"$LOG"
    rm -f "$PHONE_FILE" "$TRUST_FILE"
    set -o pipefail
    # Puerto fijo (o efímero si está ocupado): el servidor administrado no
    # pelea por el 3080 con un `dsh web` lanzado a mano en una terminal; el
    # puerto real sale en la URL del log.
    port=$PORT
    if ! free_port "$port"; then
      printf 'dsh-web: puerto %s ocupado; uso uno efímero\n' "$port" >&2
      port=0
    fi
    args=(web --no-open --port "$port")
    if host=$(wait_ts_host 60); then
      args+=(--trusted-host "$host")
      printf '%s\n' "$host" >"$TRUST_FILE"
    else
      printf 'dsh-web: tailscale no respondió; arranco sin enlace de celular\n' >&2
    fi
    announce_phone &
    dsh "${args[@]}" 2>&1 | tee -a "$LOG"
    exit "${PIPESTATUS[0]}"
    ;;
  --url)
    alive_url || ensure_server || exit 1
    exit 0
    ;;
  --phone)
    url=$(alive_url) || url=$(ensure_server) || exit 1
    if ! phone=$(phone_url); then
      phone=$(publish_phone "$url") || {
        echo "dsh-web: el servidor vivo no está publicado en Tailscale; corré: dsh-web --restart" >&2
        exit 1
      }
      save_phone "$phone"
    fi
    printf '%s\n' "$phone"
    # El enlace es largo para tipear: con terminal a la vista, QR para escanear
    # una vez y dejar la cookie de 30 días en el celular.
    if [[ -t 1 ]] && command -v qrencode >/dev/null; then
      qrencode -t ANSIUTF8 -m 1 "$phone"
    fi
    exit 0
    ;;
  --restart)
    # El token y el enlace del celular son por proceso: reiniciar es la forma
    # de tomar un script nuevo. Después sigue el camino normal (esperar,
    # publicar el enlace y abrir la ventana).
    systemctl --user stop "$UNIT" >/dev/null 2>&1
    systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
    ;;
  --stop)
    exec systemctl --user stop "$UNIT"
    ;;
  --status)
    systemctl --user status "$UNIT" --no-pager | head -20
    alive_url
    phone_url
    exit 0
    ;;
  -h | --help)
    # Todas las líneas de comentario de la cabecera, sin el shebang.
    awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"
    exit 0
    ;;
  "") ;;
  *)
    echo "dsh-web: opción desconocida '$1'" >&2
    exit 2
    ;;
esac

if ! url=$(alive_url); then
  if ! url=$(ensure_server); then
    echo "dsh-web: el servidor no respondió. Revisá: journalctl --user -u $UNIT" >&2
    command -v notify-send >/dev/null && notify-send -u critical "DeepSeek Harness" "El servidor no arrancó"
    exit 1
  fi
fi

# Enlace para el celular: el que anunció --serve, o publicado ahora si el
# servidor ya estaba arriba (arranque al login) sin tailscale disponible.
if ! phone=$(phone_url); then
  phone=$(publish_phone "$url") || phone=""
  [[ -n $phone ]] && save_phone "$phone"
fi

if [[ -n ${phone:-} ]]; then
  printf 'dsh-web: celular: %s\n' "$phone"
  announce_link "$phone"
else
  echo "dsh-web: sin enlace de celular (el servidor vivo no se publicó; corré: dsh-web --restart)" >&2
fi

# Si ya hay un panel abierto, enfocarlo; si no, abrirlo como web app en Brave.
# El patrón es la clase de la ventana de Brave para --app con host loopback
# (brave-127.0.0.1__-Default): el título no sirve porque "DeepSeek Harness"
# también aparece en pestañas comunes del navegador.
if command -v hyprctl >/dev/null && hyprctl clients -j >/dev/null 2>&1; then
  exec omarchy-launch-or-focus-webapp "brave-127.0.0.1__" "$url"
fi
exec omarchy-launch-webapp "$url"
