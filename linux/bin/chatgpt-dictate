#!/usr/bin/env python3
"""chatgpt-dictate — toca el botón de dictado de ChatGPT web sin robar el foco.

Brave corre con `--remote-debugging-port` (ver ~/.config/brave-flags.conf), el
mismo CDP que usa `dictado`. Por ahí se busca la pestaña de chatgpt.com que
tiene el botón `[data-dictation-button]` y se le hace `.click()` desde la
página: no se mueve el puntero ni se enfoca nada. Si hay varias pestañas con
el botón se prefiere la visible y con foco; si el empate persiste, no toca
ninguna (mejor no dictar en el chat equivocado).

Uso:
    chatgpt-dictate            alterna el dictado (si estaba grabando, lo corta)
    chatgpt-dictate --dry-run  muestra qué pestaña/botón usaría, sin tocarlo

Variables:
    CHATGPT_DICTATE_CDP  URL del endpoint CDP (default http://127.0.0.1:9222)
    CHATGPT_DICTATE_SEL  selector del botón (default [data-dictation-button])

Sale 1 si no encontró una pestaña inequívoca o el click falló; en ese caso
avisa con notify-send (salvo CHATGPT_DICTATE_NOTIFY=0).
"""
from __future__ import annotations

import base64
import json
import os
import socket
import struct
import sys
import time
import urllib.parse
import urllib.request

CDP = os.environ.get("CHATGPT_DICTATE_CDP", "http://127.0.0.1:9222")
SEL = os.environ.get("CHATGPT_DICTATE_SEL", "[data-dictation-button]")

# Devuelve todo lo que hace falta para elegir pestaña y no clickear a ciegas.
PROBE_JS = """(() => {
  const b = document.querySelector(%s);
  if (!b) return JSON.stringify({found: false});
  return JSON.stringify({
    found: true,
    visible: document.visibilityState,
    focused: document.hasFocus(),
    state: b.getAttribute('data-dictation-button'),
    label: b.getAttribute('aria-label') || '',
    busy: b.getAttribute('aria-busy'),
    disabled: !!b.disabled || b.getAttribute('aria-disabled') === 'true',
  });
})()""" % json.dumps(SEL)

CLICK_JS = """(() => {
  const b = document.querySelector(%s);
  if (!b) return JSON.stringify({ok: false, error: 'no hay botón de dictado'});
  if (b.disabled || b.getAttribute('aria-disabled') === 'true')
    return JSON.stringify({ok: false, error: 'el botón está deshabilitado'});
  const antes = b.getAttribute('data-dictation-button');
  b.click();
  return JSON.stringify({ok: true, antes: antes});
})()""" % json.dumps(SEL)


def avisar(msg: str) -> None:
    if os.environ.get("CHATGPT_DICTATE_NOTIFY", "1") == "0":
        return
    try:
        import subprocess
        subprocess.run(
            ["notify-send", "-a", "ChatGPT", "-u", "normal", "-t", "2500",
             "Dictado de ChatGPT", msg],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def paginas() -> list[dict]:
    """Pestañas con websocket CDP."""
    with urllib.request.urlopen(CDP + "/json/list", timeout=2) as r:
        tabs = json.load(r)
    return [t for t in tabs
            if t.get("type") == "page" and t.get("webSocketDebuggerUrl")]


def evaluar(url: str, js: str, espera: float = 2.0):
    """Runtime.evaluate por un websocket mínimo (sin dependencias).

    Mismo handshake que `dictado`; alcanza para respuestas chicas de Chromium.
    """
    destino = urllib.parse.urlparse(url)
    with socket.create_connection((destino.hostname, destino.port or 80),
                                  timeout=espera) as s:
        s.settimeout(espera)
        clave = base64.b64encode(os.urandom(16)).decode()
        s.sendall((f"GET {destino.path} HTTP/1.1\r\nHost: {destino.netloc}\r\n"
                   "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                   f"Sec-WebSocket-Key: {clave}\r\nSec-WebSocket-Version: 13\r\n\r\n"
                   ).encode())
        cabecera = b""
        while b"\r\n\r\n" not in cabecera:
            trozo = s.recv(4096)
            if not trozo:
                raise OSError("websocket cerrado en el handshake")
            cabecera += trozo
        resto = cabecera.split(b"\r\n\r\n", 1)[1]
        if b" 101 " not in cabecera.split(b"\r\n", 1)[0]:
            raise OSError("CDP rechazó el websocket")
        carga = json.dumps({"id": 1, "method": "Runtime.evaluate",
                            "params": {"expression": js, "returnByValue": True}}
                           ).encode()
        mascara = os.urandom(4)
        n = len(carga)
        trama = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else
                                 bytes([0x80 | 126]) + struct.pack(">H", n) if n < 65536 else
                                 bytes([0x80 | 127]) + struct.pack(">Q", n))
        s.sendall(trama + mascara + bytes(b ^ mascara[i % 4] for i, b in enumerate(carga)))
        buf = resto

        def leer(k: int) -> bytes:
            nonlocal buf
            while len(buf) < k:
                trozo = s.recv(65536)
                if not trozo:
                    raise OSError("websocket cerrado")
                buf += trozo
            dato, buf = buf[:k], buf[k:]
            return dato

        for _ in range(64):  # eventos sueltos antes de la respuesta
            b0, b1 = leer(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", leer(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", leer(8))[0]
            datos = leer(n)
            if b0 & 0x0F != 1:
                continue
            msg = json.loads(datos)
            if msg.get("id") == 1:
                resultado = msg.get("result", {}).get("result", {})
                valor = resultado.get("value")
                if valor is None:
                    raise OSError(str(msg.get("error") or resultado.get("description")
                                      or "sin resultado"))
                return valor
        raise OSError("CDP no contestó")


def pista(tab: dict, info: dict) -> str:
    estado = info.get("state") or "?"
    extra = []
    if info.get("busy") == "true":
        extra.append("busy")
    if info.get("disabled"):
        extra.append("deshabilitado")
    if info.get("visible") == "visible":
        extra.append("visible")
    if info.get("focused"):
        extra.append("foco")
    cola = f" ({', '.join(extra)})" if extra else ""
    return f"{tab.get('title') or '?'} [{estado}]{cola}"


def elegir():
    """Devuelve (tab, info) del botón, o None si no hay uno inequívoco."""
    cands = []
    for tab in paginas():
        try:
            info = json.loads(evaluar(tab["webSocketDebuggerUrl"], PROBE_JS) or "{}")
        except (OSError, ValueError) as exc:
            if os.environ.get("CHATGPT_DICTATE_DEBUG"):
                print(f"chatgpt-dictate: {tab.get('title')!r}: {exc}", file=sys.stderr)
            continue
        if info.get("found"):
            cands.append((tab, info))
    if not cands:
        return None, "no hay ninguna pestaña con el botón de dictado"
    # Preferir ChatGPT, luego la pestaña visible y con foco; si el empate
    # persiste (dos ventanas), no se toca ninguna.
    def rango(item):
        tab, info = item
        return ("chatgpt.com" in tab.get("url", ""),
                info.get("visible") == "visible", bool(info.get("focused")))
    cands.sort(key=rango, reverse=True)
    if len(cands) > 1 and rango(cands[0]) == rango(cands[1]):
        return None, "hay más de una pestaña con dictado y no sé cuál usar"
    return cands[0], ""


def main(argv: list[str]) -> int:
    if len(argv) > 1 and argv[1] not in ("--dry-run", "-n"):
        print("uso: chatgpt-dictate [--dry-run]", file=sys.stderr)
        return 2
    seco = len(argv) > 1
    try:
        elegido, error = elegir()
    except (OSError, ValueError) as exc:
        error = f"no pude hablar con Brave por CDP: {exc}"
        elegido = None
    if elegido is None:
        print(f"chatgpt-dictate: {error}", file=sys.stderr)
        avisar(error)
        return 1
    tab, info = elegido
    if seco:
        print(pista(tab, info))
        return 0
    try:
        resultado = json.loads(evaluar(tab["webSocketDebuggerUrl"], CLICK_JS) or "{}")
    except (OSError, ValueError) as exc:
        error = f"el click por CDP falló: {exc}"
        print(f"chatgpt-dictate: {error}", file=sys.stderr)
        avisar(error)
        return 1
    if not resultado.get("ok"):
        error = resultado.get("error") or "el click no se hizo"
        print(f"chatgpt-dictate: {error}", file=sys.stderr)
        avisar(error)
        return 1
    time.sleep(0.08)
    try:
        despues = json.loads(evaluar(tab["webSocketDebuggerUrl"], PROBE_JS) or "{}")
    except (OSError, ValueError):
        despues = {}
    if os.environ.get("CHATGPT_DICTATE_DEBUG"):
        print(f"chatgpt-dictate: {pista(tab, info)} -> "
              f"{pista(tab, despues) if despues else '?'}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
