#!/usr/bin/env python3
"""audio-ruta — a qué salida va cada aplicación (y que quede guardado).

Las apps se identifican por `application.name` de PipeWire. Mover un stream hace
que WirePlumber recuerde esa salida para la app (lo guarda en
`stream-properties`), así que la próxima vez que suene arranca ahí.

    audio-ruta listar                 JSON: salidas + apps con su salida actual
    audio-ruta mover <app> <salida>   la manda ahí ahora y lo deja guardado
    audio-ruta mover <app> auto       vuelve a la salida por defecto
    audio-ruta salidas                lista de salidas disponibles

`<app>` es el nombre de PipeWire (asistente, Voice TTS, Spotifast…) o su alias
corto (orion, tts, spotify). `<salida>` es el nombre del sink o su alias.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

ESTADO = Path.home() / ".local/state/wireplumber/stream-properties"

# Apps que interesan siempre, aunque no estén sonando en este momento.
CONOCIDAS = {
    "asistente": "Orión",
    "Voice TTS": "Voz del sistema (TTS)",
    "Spotifast": "Spotify",
    "Spotify": "Spotify",
    "brave": "Brave",
    "chromium": "Chromium",
}

ALIAS = {
    "orion": "asistente", "orión": "asistente", "asistente": "asistente",
    "tts": "Voice TTS", "voz": "Voice TTS", "voice tts": "Voice TTS",
    "spotify": "Spotifast", "spotifast": "Spotifast",
}

SALIDA_CORTA = {
    "analog-stereo": "parlantes",
    "bluez": "audífono",
    "hdmi": "HDMI",
    "usb": "USB",
}


def pactl(*args: str) -> str:
    try:
        return subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def salidas() -> list[dict]:
    default = pactl("get-default-sink").strip()
    lista = []
    for linea in pactl("list", "short", "sinks").splitlines():
        campos = linea.split("\t")
        if len(campos) < 2:
            continue
        nombre = campos[1]
        # Los sinks nulos (micrófonos puente) no son una salida donde mandar audio.
        if nombre.endswith("_sink") or nombre.startswith("phone_mic"):
            continue
        lista.append({
            "nombre": nombre,
            "etiqueta": etiqueta_salida(nombre),
            "defecto": nombre == default,
        })
    return lista


def etiqueta_salida(nombre: str) -> str:
    bajo = nombre.lower()
    for clave, corto in SALIDA_CORTA.items():
        if clave in bajo:
            return corto
    return nombre


def streams() -> list[dict]:
    """Streams de reproducción activos: app, índice de pactl y sink donde están."""
    crudo = pactl("-f", "json", "list", "sink-inputs")
    try:
        datos = json.loads(crudo or "[]")
    except ValueError:
        return []
    salida = []
    for s in datos:
        props = s.get("properties") or {}
        app = props.get("application.name") or props.get("application.process.binary") or "?"
        salida.append({"app": app, "index": s.get("index")})
    return salida


def sink_de_apps_guardadas() -> dict[str, str]:
    """Salida recordada por WirePlumber para cada app (sobrevive a que no suene)."""
    guardadas: dict[str, str] = {}
    try:
        texto = ESTADO.read_text(errors="replace")
    except OSError:
        return guardadas
    for linea in texto.splitlines():
        m = re.match(r"Output/Audio:application\.name:(.+?)=(\{.*\})\s*$", linea)
        if not m:
            continue
        try:
            props = json.loads(m.group(2))
        except ValueError:
            continue
        if props.get("target"):
            guardadas[m.group(1)] = props["target"]
    return guardadas


def apps() -> list[dict]:
    activas = streams()
    indexadas: dict[str, list[int]] = {}
    for s in activas:
        indexadas.setdefault(s["app"], []).append(s["index"])
    guardadas = sink_de_apps_guardadas()
    nombres = list(dict.fromkeys([*CONOCIDAS, *indexadas, *guardadas]))
    # La salida actual de un stream activo: la del primer índice.
    actual: dict[str, str] = dict(guardadas)
    for app, indices in indexadas.items():
        for linea in pactl("list", "short", "sink-inputs").splitlines():
            campos = linea.split("\t")
            if len(campos) >= 2 and int(campos[0]) in indices:
                for sink in pactl("list", "short", "sinks").splitlines():
                    if int(sink.split("\t")[0]) == int(campos[1]):
                        actual[app] = sink.split("\t")[1]
    salida, vistas = [], {}
    for app in nombres:
        etiqueta = CONOCIDAS.get(app, app)
        if etiqueta in vistas:  # "Spotifast" y "Spotify" son la misma cosa
            if app in indexadas and vistas[etiqueta]["app"] not in indexadas:
                vistas[etiqueta]["app"] = app
            continue
        fila = {"app": app, "etiqueta": etiqueta, "salida": actual.get(app, ""),
                "activa": app in indexadas}
        vistas[etiqueta] = fila
        salida.append(fila)
    return salida


def resolver_app(pedida: str) -> str:
    return ALIAS.get(pedida.strip().lower(), pedida.strip())


def resolver_salida(pedida: str) -> str:
    disponibles = salidas()
    if pedida in ("auto", "defecto", "default"):
        return ""
    for s in disponibles:
        if pedida in (s["nombre"], s["etiqueta"]):
            return s["nombre"]
    for s in disponibles:
        if pedida.lower() in s["nombre"].lower():
            return s["nombre"]
    raise SystemExit(f"audio-ruta: no conozco la salida «{pedida}». Opciones: "
                     + ", ".join(s["nombre"] for s in disponibles))


def mover_activas(app: str, sink: str) -> int:
    movidas = 0
    for s in streams():
        if s["app"] != app:
            continue
        if sink:
            pactl("move-sink-input", str(s["index"]), sink)
        else:
            pactl("move-sink-input", str(s["index"]), pactl("get-default-sink").strip())
        movidas += 1
    return movidas


def probar_y_guardar(app: str, sink: str) -> bool:
    """Deja guardada la salida de una app que no está sonando.

    Crea un stream de silencio con ese `application.name` y lo mueve a la salida
    elegida: WirePlumber aprende el destino y lo aplica la próxima vez.
    """
    destino = sink or pactl("get-default-sink").strip()
    if not destino:
        return False
    argv = [
        "pw-cat", "--playback", "--raw", "--format", "s16", "--rate", "48000",
        "--channels", "2", "-P", f'{{ application.name = "{app}" }}',
        "--target", destino, "-",
    ]
    try:
        p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        p.communicate(b"\0" * 19200, timeout=3)  # 100 ms de silencio
    except (OSError, subprocess.TimeoutExpired):
        try:
            p.kill()
        except Exception:
            pass
        return False
    # El movimiento explícito es lo que WirePlumber recuerda.
    for s in streams():
        if s["app"] == app:
            pactl("move-sink-input", str(s["index"]), destino)
    return True


def main() -> int:
    accion = sys.argv[1] if len(sys.argv) > 1 else "listar"
    if accion == "salidas":
        for s in salidas():
            print(f'{s["nombre"]}\t{s["etiqueta"]}{"  (por defecto)" if s["defecto"] else ""}')
        return 0
    if accion == "listar":
        print(json.dumps({"salidas": salidas(), "apps": apps()}, ensure_ascii=False))
        return 0
    if accion == "mover":
        if len(sys.argv) < 4:
            print("uso: audio-ruta mover <app> <salida|auto>", file=sys.stderr)
            return 2
        app = resolver_app(sys.argv[2])
        sink = resolver_salida(sys.argv[3])
        movidas = mover_activas(app, sink)
        if not movidas and sink:
            probar_y_guardar(app, sink)
        elif not movidas and not sink:
            return 0
        etiqueta = etiqueta_salida(sink) if sink else "la salida por defecto"
        print(f"{CONOCIDAS.get(app, app)} → {etiqueta}" + (" (ya sonando)" if movidas else " (guardado)"))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
