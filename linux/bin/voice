#!/usr/bin/env bash
# voice — CLI del sistema de voz local (TTS + STT + daemon).
#
# Uso:
#   voice status                         estado completo
#   voice speak "texto"                  TTS (via daemon si activo, si no directo)
#   voice say "texto"                    alias de speak
#   voice avisar [--source S] "texto"    mensaje al usuario (direct/mailbox/hybrid)
#   voice notify [--app A] [--title T] "texto"  notificacion sola (queda en el registro)
#   voice inbox [list|count|clear|play]   buzon de voz: mensajes pendientes de escuchar
#   voice dime [N]                       lee los pendientes: "<agente> dice: <mensaje>"
#   voice play-inbox [N|--all]           reproduce los pendientes y los marca escuchados
#   voice think "texto"                  cerebro Pi headless: entiende y actúa, y responde
#   voice ptt                            push-to-talk: habla y te responde (Pi, sin nube)
#   voice delivery [direct|mailbox|hybrid|bell|silent]  inmediato, buzon, aviso+pausa+voz, campana, o buzon sin sonido
#   voice modo [fluido|concentracion|campana]   ritmo de los agentes (entrega + comentarios)
#   voice messages [--json] [N]          registro unificado (voz + notificaciones)
#   voice repeat [N] | --index M         repetir los ultimos mensajes
#                                        (--restart: corta el que suena y reinicia)
#   voice profiles [--all] [--json]      listar voces por agente/proceso
#   voice profile show|set|remove|test   ver/cambiar/probar la voz de un agente
#   voice profile auto [on|off]          reparto automatico de voces
#   voice identity [nombre] [--json]     nombre, rol y color estable del agente
#   voice identity [nombre] --claim      color unico entre los agentes vivos
#   voice identity check                 colores repetidos entre agentes vivos
#   voice color [nombre] [--tint]        color (hex) del agente (o version oscura)
#   voice color <nombre> --set #hex      fijar el color de un agente
#   voice role <nombre> [rol]            ver/fijar el rol (main, audio, ...)
#   voice agents                         tabla de identidades fijadas
#   voice send --agent <nombre> --text "..." [--key K]   API por-agente (Hermes, opencode, ...)
#   voice test                           test TTS + STT
#   voice accelerator [auto|gpu|cpu]     ver/cambiar dispositivo STT Handy
#   voice gpu                            estado GPU NVIDIA
#   voice battery                        estado bateria/AC
#   voice tts [on|off|toggle]            activar/desactivar/toggle anuncios de opencode
#   voice voice [nombre]                 ver/cambiar voz (por-idioma segun lang)
#   voice voices                         listar voces piper instaladas
#   voice lang [es|en]                   ver/cambiar idioma (voz principal)
#   voice engine [chatterbox|kokoro|piper|espeak] [es|en]   motor TTS por idioma
#   voice mode [summary|full]            ver/cambiar modo de resumen
#   voice model list|set <id>            listar/cambiar modelo STT Handy
#   voice transcribe <wav>               STT sobre un archivo
#   voice synth <texto> [salida.wav] [--lang es] [--stdout]  TTS a archivo o stdout
#   voice benchmark                      benchmark TTS (kokoro/piper/espeak × es/en)
#   voice stop                           vaciar cola TTS + cortar playback
#   voice daemon start|stop|restart      control del servicio systemd user
#   voice volume [0.0-1.0|NN%]           ver/cambiar volumen relativo de la voz TTS
#   voice speed [factor]                 ver/cambiar velocidad de lectura del TTS (1.0 = normal)
#   voice history [--json] [N]           historial de la voz (mas reciente primero)
#   voice history play <N>               reproducir la entrada N del historial
#   voice play <archivo.wav>             reproducir un WAV del historial
#
# Opciones de voz (speak/say/avisar/send/synth): --profile P --voice V --engine E
#   --lang L --pitch N (semitonos) --speed N (factor). Un --source nombre usa el
#   perfil [tts.profiles.nombre]; si no existe, se le asigna una voz estable
#   automaticamente. --no-record no guarda; --force ignora tts off.
#
# Arquitectura de capas:
#   TTS  → linux/voice/daemon.py (cola, router kokoro/piper/espeak por-idioma)
#   STT  → dictado con Handy (F7) de forma independiente (desacoplado)
#   CLI  → este script (speak/send/status/toggle)
#   OpenCode → plugin linux/config/opencode/plugins/voice/plugin.js (solo voz)
#
# Toogles runtime → ~/.local/state/voice/state.json (por-maquina, no en repo).

set -uo pipefail

REPO="${VOICE_REPO:-$HOME/dotfiles}"
VOICE_DIR="$REPO/linux/voice"
CONFIG_DIR="$HOME/.config/voice"
CACHE_DIR="${VOICE_CACHE_DIR:-$HOME/.cache/voice}"
HISTORY_DIR="${VOICE_HISTORY_DIR:-$HOME/.local/share/voice/tts}"
HISTORY_RECORDINGS="$HISTORY_DIR/recordings"
STATE_FILE="$HOME/.local/state/voice/state.json"
FIFO="$CACHE_DIR/tts.fifo"
PID_FILE="$CACHE_DIR/daemon.pid"
LISTEN_PID="$CACHE_DIR/listen.pid"
OC_FILE="$CACHE_DIR/to-opencode.json"

PY="${PY:-python3}"

# ── helpers ─────────────────────────────────────────────────────────────
js_escape() { "$PY" -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

daemon_alive() {
  [ -f "$PID_FILE" ] || return 1
  local pid; pid=$(cat "$PID_FILE")
  kill -0 "$pid" 2>/dev/null
}

get_set() {  # get_set <sección> <clave> [valor]
  if [ "$#" -ge 3 ]; then
    "$PY" "$VOICE_DIR/engine.py" set "$1" "$2" "$3"
  else
    "$PY" - "$1" "$2" <<'PYEOF'
import json, os, sys
sec, key = sys.argv[1], sys.argv[2]
try:
    st = json.load(open(os.path.expanduser("~/.local/state/voice/state.json")))
    print(st.get(sec, {}).get(key, ""))
except Exception:
    print("")
PYEOF
  fi
}

config_val() {  # config_val <sección> <clave> — valor efectivo de config+state
  "$PY" - "$1" "$2" <<'PYEOF'
import json, os, sys
sec, key = sys.argv[1], sys.argv[2]
def parse_toml(path):
    cfg, section = {}, None
    try:
        for line in open(path):
            line = line.strip()
            if not line or line.startswith("#"): continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip(); cfg.setdefault(section, {})
            elif "=" in line and section:
                k, v = [x.strip() for x in line.split("=", 1)]
                v = v.split("#", 1)[0].strip()   # quitar comentario inline
                if v.lower() in ("true","false"): v = (v.lower()=="true")
                elif v.startswith('"') and v.endswith('"'): v = v[1:-1]
                cfg[section][k] = v
    except OSError: pass
    return cfg
cfg = parse_toml(os.path.expanduser("~/.config/voice/config.toml"))
try:
    st = json.load(open(os.path.expanduser("~/.local/state/voice/state.json")))
except Exception:
    st = {}
def emit(v):
    if v is True: print("true")
    elif v is False: print("false")
    else: print(v)
if sec in st and key in st[sec]:
    emit(st[sec][key])
elif sec in cfg and key in cfg[sec]:
    emit(cfg[sec][key])
else:
    print("")
PYEOF
}

# Volumen relativo del TTS (0.0-1.0) sobre el volumen general de salida.
# No es un volumen independiente: se multiplica por el general.
tts_volume() {
  local raw; raw=$(config_val tts volume); raw=${raw:-1.0}
  if [[ "$raw" == *% ]]; then
    awk "BEGIN{printf \"%.3f\", ${raw%\%}/100}"
  else
    awk "BEGIN{printf \"%.3f\", $raw}"
  fi
}

# Marca escuchado un mensaje por su id (o por ts en registros viejos).
marcar_escuchado() {
  local ident="$1"
  [ -n "$ident" ] || return 0
  case "$ident" in
    ts:*) "$PY" "$VOICE_DIR/engine.py" mark-heard --ts "${ident#ts:}" >/dev/null 2>&1 ;;
    *)    "$PY" "$VOICE_DIR/engine.py" mark-heard --id "$ident" >/dev/null 2>&1 ;;
  esac
}

# ── dictado: la voz nunca se le encima ──────────────────────────────────
# Mientras el usuario dicta, el TTS no habla: ni empieza ni sigue sonando.
# El turno lo publican `omar dictate` y handy-dictado; la pregunta vive en
# linux/voice/micguard.py para que el daemon use exactamente la misma regla.
# 0 = el micrófono está libre. Ojo: `micguard --busy` devuelve 1 cuando hay
# dictado (es la pregunta "¿está ocupado?"), por eso el nombre es `mic_libre`.
mic_libre() { "$PY" "$VOICE_DIR/micguard.py" --busy >/dev/null 2>&1; }

# Espera a que el micrófono quede libre (tope: 3 min). 0 = quedó libre.
wait_mic_free() {
  local tope=$(( $(date +%s) + 180 )) avisado=0
  while ! mic_libre; do
    if [ "$avisado" = 0 ]; then
      [ -t 2 ] && printf 'voice: dictado en curso, espero a que termine…\n' >&2
      avisado=1
    fi
    [ "$(date +%s)" -ge "$tope" ] && return 1
    sleep 0.5
  done
  return 0
}

# ── comandos ────────────────────────────────────────────────────────────
# Parser comun de opciones de sintesis. Deja el resultado en las variables
# P_* del llamador (scope dinamico de bash). Acepta ademas texto por stdin.
parse_speak_flags() {
  P_PROFILE=""; P_VOICE=""; P_ENGINE=""; P_LANG=""; P_SOURCE=""
  P_KEY=""; P_PITCH=""; P_SPEED=""; P_NO_RECORD=0; P_FORCE=0; P_TEXT=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) P_PROFILE="${2:?falta valor para --profile}"; shift 2 ;;
      --voice)   P_VOICE="${2:?falta valor para --voice}";   shift 2 ;;
      --engine)  P_ENGINE="${2:?falta valor para --engine}"; shift 2 ;;
      --lang)    P_LANG="${2:?falta valor para --lang}";     shift 2 ;;
      --source)  P_SOURCE="${2:?falta valor para --source}"; shift 2 ;;
      --key)     P_KEY="${2:?falta valor para --key}";       shift 2 ;;
      --pitch)   P_PITCH="${2:?falta valor para --pitch}";   shift 2 ;;
      --speed)   P_SPEED="${2:?falta valor para --speed}";   shift 2 ;;
      --no-record) P_NO_RECORD=1; shift ;;
      --force)   P_FORCE=1; shift ;;
      -) shift; P_TEXT="$(cat)"; break ;;
      --) shift; P_TEXT="$*"; break ;;
      -*) echo "voice: opcion desconocida: $1" >&2; return 2 ;;
      *) P_TEXT="$*"; break ;;
    esac
  done
  [ -n "$P_TEXT" ] || { [ -t 0 ] || P_TEXT="$(cat)"; }
}

# Resuelve motor/voz/idioma efectivos para un mensaje. Un `--source` sin
# `--profile` usa el perfil del mismo nombre, de modo que cada proceso pide su
# propia voz con solo identificarse (`voice say --source agents "..."`).
resolve_voice_flags() {  # resolve_voice_flags <profile> <voice> <engine> <lang>
  local out
  out=$("$PY" "$VOICE_DIR/engine.py" resolve \
      --profile "${1:-}" --voice "${2:-}" --engine "${3:-}" --lang "${4:-}" 2>/dev/null) \
    || out=""
  if [ -n "$out" ]; then
    IFS=$'\t' read -r V_ENGINE V_VOICE V_LANG V_PITCH V_SPEED <<<"$out"
  else
    V_LANG=$(config_val tts lang); V_LANG=${V_LANG:-es}
    V_VOICE=$(config_val tts "voice_$V_LANG"); V_ENGINE=$(config_val tts "engine_$V_LANG")
  fi
  V_PITCH=${V_PITCH:-0}; V_SPEED=${V_SPEED:-1.0}
}

# Frases de fallo: se muestran como subtítulo (glow/píldora) pero NO se dicen
# en voz alta. Así el usuario ve el "no pude" sin que le interrumpa el oído.
VOICE_FALLBACK_RE='^(No pude resolver eso\.|No entendí qué hacer\.|Me tardé demasiado en resolver eso\.)$'

# subtitle: publica un texto como subtítulo sin reproducir audio.
subtitle() {  # subtitle [--source S] <texto>
  local source="assistant"
  while [ "$#" -ge 1 ]; do
    case "$1" in
      --source) source="${2:?}"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  local text="$*"
  [ -n "$text" ] || return 0
  mkdir -p "$CACHE_DIR"
  local words ms f color role
  words=$(printf '%s' "$text" | wc -w)
  ms=$(( words * 420 + 900 )); [ "$ms" -lt 1500 ] && ms=1500
  f="$CACHE_DIR/speaking.json"
  color=$("$PY" "$VOICE_DIR/identity.py" color "$source" 2>/dev/null || echo "")
  role=$("$PY" "$VOICE_DIR/identity.py" role "$source" 2>/dev/null || echo "")
  printf '{"text":%s,"durationMs":%s,"startedAt":%s,"source":%s,"engine":"none","voice":"none","color":%s,"role":%s}\n' \
    "$(js_escape "$text")" "$ms" "$(( $(date +%s) * 1000 ))" \
    "$(js_escape "$source")" "$(js_escape "$color")" "$(js_escape "$role")" > "$f.$$" && mv "$f.$$" "$f"
}

speak() {  # speak [--profile P] [--voice V] [--engine E] [--lang L] [--source S] [--key K] [--pitch N] [--speed N] [--no-record] [--force] <texto>
  local P_PROFILE P_VOICE P_ENGINE P_LANG P_SOURCE P_KEY P_PITCH P_SPEED P_NO_RECORD P_FORCE P_TEXT
  local V_ENGINE V_VOICE V_LANG V_PITCH V_SPEED
  parse_speak_flags "$@" || return $?
  local text="$P_TEXT"
  [ -n "$text" ] || { echo "voice: sin texto" >&2; return 1; }
  # "No pude…": solo visible, nunca hablado.
  if [[ "$text" =~ $VOICE_FALLBACK_RE ]]; then subtitle --source "$P_SOURCE" "$text"; return 0; fi
  if [ "$P_FORCE" != 1 ] && [ "$(config_val tts enabled)" = "false" ]; then return 0; fi
  # Lo que suena por los parlantes queda anotado: cualquier proceso (Omar, Pi,
  # notificaciones) escribe acá y el oído de Omar usa esta lista para NO despertarse
  # con su propio eco. Sin esto, un mensaje hablado que dice "Omar" lo despierta.
  local _spoken="${XDG_RUNTIME_DIR:-/tmp}/omar/spoken.log"
  mkdir -p "${_spoken%/*}" 2>/dev/null || true
  printf '%s\t%s\n' "$(date +%s%3N)" "$(printf '%s' "$text" | tr '\n\t' '  ')" \
    >> "$_spoken" 2>/dev/null || true
  if [ "$(wc -l < "$_spoken" 2>/dev/null || echo 0)" -gt 200 ]; then
    tail -n 100 "$_spoken" > "$_spoken.tmp" 2>/dev/null && mv "$_spoken.tmp" "$_spoken" 2>/dev/null || true
  fi
  local profile="${P_PROFILE:-$P_SOURCE}"
  resolve_voice_flags "$profile" "$P_VOICE" "$P_ENGINE" "$P_LANG"
  [ -n "$P_PITCH" ] && V_PITCH="$P_PITCH"
  [ -n "$P_SPEED" ] && V_SPEED="$P_SPEED"
  local key="$P_KEY"
  if daemon_alive; then
    exec 9<>"$FIFO"
    local json="{\"text\":$(js_escape "$text"),\"voice\":$(js_escape "$V_VOICE"),\"engine\":$(js_escape "$V_ENGINE"),\"lang\":$(js_escape "$V_LANG"),\"pitch\":$V_PITCH,\"speed\":$V_SPEED"
    [ -n "$P_SOURCE" ] && json="$json,\"source\":$(js_escape "$P_SOURCE")"
    [ -n "$key" ] && json="$json,\"key\":$(js_escape "$key")"
    [ "$P_NO_RECORD" = 1 ] && json="$json,\"record\":false"
    json="$json}"
    printf '%s\n' "$json" >&9
    exec 9>&-
  else
    # daemon caido → sintesis directa en background (no bloquea al llamador)
    VOICE_OVERRIDE_ENGINE="$V_ENGINE" VOICE_OVERRIDE_VOICE="$V_VOICE" \
      VOICE_OVERRIDE_LANG="$V_LANG" \
      setsid nohup "$0" __speak_direct "$text" >/dev/null 2>&1 &
  fi
}

__speak_direct() {
  local text="$*"
  # Sin daemon también se respeta el dictado: si el micrófono está tomado, se
  # espera en vez de hablar encima (esto corre en background, no bloquea).
  wait_mic_free || return 0
  local voice engine lang
  lang="${VOICE_OVERRIDE_LANG:-$(config_val tts lang)}"; lang="${lang:-es}"
  voice="${VOICE_OVERRIDE_VOICE:-$(config_val tts "voice_$lang")}"
  engine="${VOICE_OVERRIDE_ENGINE:-$(config_val tts "engine_$lang")}"
  if [ "$engine" = "espeak" ]; then
    espeak-ng -v "$lang" -s 160 -p 50 "$text"
    return $?
  fi
  if [ "$engine" = "kokoro" ]; then
    local kokoro=voice-kokoro
    if command -v "$kokoro" >/dev/null 2>&1; then
      command -v "$kokoro" | xargs -I{} {} -t "$text" -l "$lang" -v "$voice" -o /tmp/voice-kokoro-direct.wav >/dev/null 2>&1 \
        && pw-play --volume="$(tts_volume)" /tmp/voice-kokoro-direct.wav >/dev/null 2>&1
      return $?
    fi
    engine=piper
  fi
  exec 9>"$CACHE_DIR/speak.lock"
  flock -n 9 || return 0
  if [ "$engine" = "piper" ]; then
    speak_core_piper "$voice" "$text"
  elif command -v "$HOME/.local/bin/speak" >/dev/null 2>&1; then
    "$HOME/.local/bin/speak" -v "$voice" "$text"
  else
    speak_core_piper "$voice" "$text"
  fi
}

speak_core_piper() { # speak_core_piper <voz> <texto> — sin flock, sin daemon
  local voice="$1"; shift
  local model json rate
  for d in "$HOME/.local/share/tts/piper/voices" \
           "/usr/share/piper-voices"; do
    if [ -f "$d/$voice/$voice.onnx" ]; then model="$d/$voice/$voice.onnx"; break; fi
  done
  [ -n "${model:-}" ] || { echo "voice: voz $voice no encontrada" >&2; return 1; }
  json="${model}.json"
  rate=$(jq -r '.audio.sample_rate // 22050' "$json" 2>/dev/null || echo 22050)
  piper --model "$model" --output-raw 2>/dev/null <<<"$*" |
    pw-play --volume="$(tts_volume)" --raw --format=s16 --rate "$rate" --channels=1 - >/dev/null 2>&1
}

# ── API para cualquier proceso ──────────────────────────────────────────
# say: igual que speak (alias legible).
say() { speak "$@"; }

# Pausa del modo hibrido entre el aviso sonoro y la voz, para que el usuario
# alcance a prestar atencion. Config: [tts] hybrid_pause (segundos).
hybrid_pause() {
  local p; p=$(config_val tts hybrid_pause); p=${p:-1.5}
  [[ "$p" =~ ^[0-9]+([.][0-9]+)?$ ]] || p=1.5
  printf '%s' "$p"
}

# Tono sutil de "llego un mensaje": corto, dos notas, a bajo volumen.
# Se genera una vez y se cachea. Config: [tts] chime.
# - Debounce: si ya sono hace poco, no vuelve a sonar (una rafaga de mensajes
#   es un solo aviso).
# - Nunca encima de un dictado: espera a que el microfono quede libre.
chime() {
  # --now: en primer plano y sin antirrebote. Es la señal explícita de "te voy a
  # leer": tiene que sonar sí o sí, justo antes de la voz (lo usa `dime`).
  local esperar=0
  [ "${1:-}" = "--now" ] && esperar=1
  [ "$(config_val tts chime)" = "false" ] && return 0
  local marca="$CACHE_DIR/chime.last"
  mkdir -p "$CACHE_DIR"
  if [ "$esperar" = 0 ] && [ -f "$marca" ]; then
    local hace; hace=$(( $(date +%s) - $(stat -c %Y "$marca" 2>/dev/null || echo 0) ))
    [ "$hace" -lt 8 ] && return 0
  fi
  : > "$marca" 2>/dev/null || true
  local f="$CACHE_DIR/chime.wav"
  if [ ! -f "$f" ]; then
    sox -n "$CACHE_DIR/chime1.wav" synth 0.12 sine 880  vol 0.30 fade 0.01 0.12 0.05 2>/dev/null || return 0
    sox -n "$CACHE_DIR/chime2.wav" synth 0.22 sine 1318 vol 0.26 fade 0.01 0.22 0.10 2>/dev/null || return 0
    sox "$CACHE_DIR/chime1.wav" "$CACHE_DIR/chime2.wav" "$f" 2>/dev/null || return 0
    rm -f "$CACHE_DIR/chime1.wav" "$CACHE_DIR/chime2.wav"
  fi
  [ -f "$f" ] || return 0
  if [ "$esperar" = 1 ]; then
    wait_mic_free && pw-play --volume="$(tts_volume)" "$f" >/dev/null 2>&1
  else
    ( wait_mic_free; pw-play --volume="$(tts_volume)" "$f" >/dev/null 2>&1 ) &
  fi
}

# avisar: entrega un mensaje al usuario. Segun `[tts] delivery`:
#   direct  → notificacion + voz + registro (inmediato)
#   silent  → lo deja PENDIENTE en el buzon, SIN sonido (modo concentracion)
#   mailbox → lo deja PENDIENTE en el buzon y suena un aviso sutil (no habla)
#   hybrid  → aviso sutil, pausa (para prestar atencion) y voz; si la voz esta
#             apagada cae al buzon para no perder el mensaje
# Es la interfaz que usan los agentes (Pi) y cualquier proceso; admite
# voz/motor/idioma/perfil por llamada.
avisar() {  # avisar [--source S] [--voice V] [--engine E] [--lang L] [--profile P] <texto>
  local args=("$@")
  local P_PROFILE P_VOICE P_ENGINE P_LANG P_SOURCE P_KEY P_PITCH P_SPEED P_NO_RECORD P_FORCE P_TEXT
  parse_speak_flags "${args[@]}" || return $?
  [ -n "$P_TEXT" ] || { echo "voice avisar: falta el texto" >&2; return 2; }
  local source="${P_SOURCE:-voice}" delivery
  delivery=$(config_val tts delivery); delivery=${delivery:-direct}
  case "$delivery" in
    bell|mailbox|silent)
      # El buzón es un buffer acotado: antes de sumar, se tira lo viejo/sobrante.
      local b_age b_keep
      b_age=$(config_val tts dime_max_age_min); b_age=${b_age:-30}
      b_keep=$(config_val tts dime_keep);       b_keep=${b_keep:-20}
      "$PY" "$VOICE_DIR/engine.py" prune-pending \
        --max-age-min "$b_age" --keep "$b_keep" >/dev/null 2>&1 || true
      "$PY" "$VOICE_DIR/engine.py" record-message --source "$source" \
        --text "$P_TEXT" --pending >/dev/null 2>&1 || true
      # `silent` es el buzón sin sonido (modo concentración): no suena nada,
      # el indicador de la barra muestra que hay pendientes.
      [ "$delivery" = "silent" ] || chime --now
      return 0
      ;;
    hybrid)
      if [ "$(config_val tts enabled)" = "false" ]; then
        # Sin voz no hay híbrido: al buzón para no perderlo.
        "$PY" "$VOICE_DIR/engine.py" record-message --source "$source" \
          --text "$P_TEXT" --pending >/dev/null 2>&1 || true
        chime --now
        return 0
      fi
      chime --now
      sleep "$(hybrid_pause)"
      speak "${args[@]}"
      return 0
      ;;
  esac
  # direct
  if [ "$(config_val tts enabled)" = "false" ]; then return 0; fi
  notify --app-name "$source" -i dialog-information -g "󰍬" "$source" "$P_TEXT" >/dev/null 2>&1 || true
  speak "${args[@]}"
}

# notify: notificacion de escritorio sin voz (para avisos que no merecen sonar).
# Queda en el registro, asi que `voice repeat` puede volver a leerla.
notify_cmd() {  # notify [--app A] [--title T] [--body B] [--source S] <texto>
  local app="voice" title="" body="" source=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --app)    app="${2:?}";    shift 2 ;;
      --title)  title="${2:?}";  shift 2 ;;
      --body)   body="${2:?}";   shift 2 ;;
      --source) source="${2:?}"; shift 2 ;;
      *) body="${body:+$body }$*"; break ;;
    esac
  done
  [ -n "$body" ] || { echo "voice notify: falta el texto" >&2; return 2; }
  [ -n "$title" ] || title="$app"
  notify --app-name "$app" -i dialog-information -g "󰍬" "$title" "$body" >/dev/null 2>&1 || true
  # Respaldo del registro por si el escritorio no esta capturando notificaciones.
  "$PY" "$VOICE_DIR/engine.py" record-notify --app "$app" --title "$title" --body "$body" >/dev/null 2>&1 || true
}

# ingest-notify: la llama swaync (scripts.exec) con la notificacion en el
# entorno (SWAYNC_*). Solo registra; nunca habla ni falla.
ingest_notify() { "$PY" "$VOICE_DIR/engine.py" notify-ingest >/dev/null 2>&1 || true; }

# messages: registro unificado (voz + notificaciones), mas reciente primero.
messages_cmd() { "$PY" "$VOICE_DIR/engine.py" messages "$@"; }

# profiles: lista los perfiles de voz (agentes/procesos) y su reparto.
profiles_cmd() { "$PY" "$VOICE_DIR/engine.py" profiles "$@"; }

# identity: nombre, rol y color del agente. Fuente única que usan los subtítulos,
# el fondo del panel y la barra. Delega en linux/voice/identity.py.
identity_cmd() { "$PY" "$VOICE_DIR/identity.py" "$@"; }

# profile: gestiona la voz de cada agente/proceso.
profile_cmd() {  # profile list|show|set|remove|test|auto
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|"") profiles_cmd "$@" ;;
    show)
      [ "$#" -ge 1 ] || { echo "uso: voice profile show <nombre>" >&2; return 2; }
      "$PY" "$VOICE_DIR/engine.py" profile-show "$1" ;;
    set)
      [ "$#" -ge 1 ] || { echo "uso: voice profile set <nombre> [--voice V --engine E --lang L --pitch N --speed N]" >&2; return 2; }
      "$PY" "$VOICE_DIR/engine.py" profile-set "$@" ;;
    remove|rm)
      [ "$#" -ge 1 ] || { echo "uso: voice profile remove <nombre>" >&2; return 2; }
      "$PY" "$VOICE_DIR/engine.py" profile-remove "$1" ;;
    test)
      [ "$#" -ge 1 ] || { echo "uso: voice profile test <nombre> [texto]" >&2; return 2; }
      local name="$1"; shift
      local sample="${*:-Hola, soy la voz de $name. Así me vas a reconocer.}"
      speak --force --no-record --source "$name" "$sample" ;;
    auto)
      case "${1:-}" in
        on|true|1)   "$PY" "$VOICE_DIR/engine.py" set tts auto_profiles true ;;
        off|false|0) "$PY" "$VOICE_DIR/engine.py" set tts auto_profiles false ;;
        *) echo "perfiles automaticos: $(config_val tts auto_profiles)" ;;
      esac ;;
    *)
      echo "uso: voice profile list|show|set|remove|test|auto" >&2; return 2 ;;
  esac
}

# dime: lee la cola de mensajes pendientes, en orden y con el autor de cada uno.
# Es lo que dispara la hotword "dime": los agentes dejan su mensaje en el buzon
# (suena la campana) y vos escuchas cuando querés. Formato: "<agente> dice: …".
#
# El buzon es un BUFFER, no un archivo: combina cantidad y tiempo.
#   - `[tts] dime_max_age_min` (30): lo más viejo se descarta solo (ese ticket
#     ya se cerró); no se lee.
#   - `[tts] dime_keep` (20): tope del buffer; si se llena, se tiran los más
#     viejos.
#   - `[tts] dime_max` (6): cuántos lee por vez un backlog viejo.
#   - Si TODO lo pendiente es fresco (`dime_fresh_min`, 15 min), el tope sube a
#     `dime_max_recent` (12): una ráfaga reciente se puede leer de una.
#
# Un reinicio corta el hilo: lo pendiente de antes de apagar queda guardado en
# el historial (`voice messages`) pero NO se lee. El corte es la hora de
# arranque del sistema (`/proc/stat` btime), no un estado que haya que limpiar:
# correr `dime` dos veces no cambia nada y lo que llega después del arranque se
# lee normal.
dime() {  # dime [--quiet-empty]
  local quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --quiet-empty) quiet=1; shift ;;
      *) shift ;;
    esac
  done
  local max maxr fresh age keep
  max=$(config_val tts dime_max);        max=${max:-6}
  maxr=$(config_val tts dime_max_recent); maxr=${maxr:-12}
  fresh=$(config_val tts dime_fresh_min); fresh=${fresh:-15}
  age=$(config_val tts dime_max_age_min); age=${age:-30}
  keep=$(config_val tts dime_keep);       keep=${keep:-20}

  # Primero se limpia: nada de leer mensajes de hace hora y media.
  local descartados de_antes total arranque
  arranque=$("$PY" "$VOICE_DIR/engine.py" boot-time 2>/dev/null || echo 0)
  de_antes=0
  if [ "${arranque:-0}" -gt 0 ]; then
    de_antes=$("$PY" "$VOICE_DIR/engine.py" prune-before \
      --ts "$arranque" --reason reboot 2>/dev/null || echo 0)
  fi
  descartados=$("$PY" "$VOICE_DIR/engine.py" prune-pending \
    --max-age-min "$age" --keep "$keep" 2>/dev/null || echo 0)

  # El aviso de viejos descartados suma los dos cortes: edad y reinicio.
  descartados=$(( ${descartados:-0} + ${de_antes:-0} ))

  total=$("$PY" "$VOICE_DIR/engine.py" pending-count 2>/dev/null || echo 0)

  if [ "${total:-0}" -eq 0 ]; then
    [ "$quiet" = 1 ] && return 0
    if [ "${de_antes:-0}" -gt 0 ]; then
      speak --source omar "No hay mensajes nuevos desde que prendiste. Los de antes quedaron guardados."
    elif [ "${descartados:-0}" -gt 0 ]; then
      speak --source omar "No hay mensajes recientes. Descarté $descartados viejos."
    else
      speak --source omar "No hay mensajes pendientes."
    fi
    return 0
  fi

  # Campana primero: la misma señal de "llegó algo", ahora de "te lo leo".
  chime --now || true

  # ¿Todo lo que queda es reciente? Entonces vale la pena leer más de una vez.
  local edad
  edad=$("$PY" - "$VOICE_DIR" <<'PYEOF'
import os, sys, time
sys.path.insert(0, os.path.abspath(sys.argv[1]))
from engine import pending_messages
recs = pending_messages()
if not recs:
    print(-1)
else:
    print(int((time.time() * 1000 - int(recs[0].get("ts", 0) or 0)) / 60000))
PYEOF
)
  local n="$max"
  if [ "${edad:--1}" -ge 0 ] && [ "${edad:--1}" -le "$fresh" ]; then n="$maxr"; fi

  local rows
  rows=$("$PY" - "$VOICE_DIR" "$n" "$age" <<'PYEOF'
import base64, os, sys
sys.path.insert(0, os.path.abspath(sys.argv[1]))
from engine import pending_messages
maxlargo = 420
for rec in pending_messages(int(sys.argv[2]), float(sys.argv[3])):
    txt = " ".join(str(rec.get("text", "")).split())
    if len(txt) > maxlargo:
        txt = txt[:maxlargo].rsplit(" ", 1)[0] + "…"
    fuente = rec.get("source") or rec.get("app") or "alguien"
    ident = rec.get("id") or ("ts:" + str(rec.get("ts", "")))
    print("%s\x1f%s\x1f%s" % (fuente, base64.b64encode(txt.encode()).decode(), ident))
PYEOF
)
  local leidos=0
  while IFS=$'\x1f' read -r fuente b64 ident; do
    [ -n "$b64" ] || continue
    local texto; texto=$(printf '%s' "$b64" | base64 -d)
    [ -n "$texto" ] || continue
    speak --source "$fuente" "$fuente dice: $texto"
    marcar_escuchado "$ident"
    leidos=$((leidos + 1))
  done <<<"$rows"
  local restan=$(( ${total:-0} - leidos ))
  [ "$restan" -gt 0 ] && speak --source omar "Quedan $restan mensajes más."
  return 0
}

# repeat: vuelve a leer los ultimos mensajes. Reutiliza el WAV si lo hay y, si
# no (notificaciones), lo sintetiza sin volver a registrarlo.
repeat() {  # repeat [N] | repeat --index M [--restart]
  local n=1 index="" restart=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --index) index="${2:?}"; shift 2 ;;
      --restart) restart=1; shift ;;
      *) n="$1"; shift ;;
    esac
  done
  if [ "$restart" = 1 ]; then
    # Si hay un mensaje sonando AHORA, reiniciar ESE (no el anterior): el
    # daemon publica el WAV en curso en speaking.json.
    local cur="" speaking="${VOICE_SPEAKING_FILE:-$CACHE_DIR/speaking.json}"
    if [ -f "$speaking" ]; then
      cur=$(python3 - "$speaking" <<'PY' 2>/dev/null || true
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
    w = d.get("wav") or ""
    if w and os.path.isfile(w):
        print(w)
except Exception:
    pass
PY
)
    fi
    # Vaciar la cola del daemon para que no arranque el siguiente mensaje
    # encima del replay. NO usamos "stop": su pkill global competía con
    # nuestra reproducción y a veces la mataba.
    if daemon_alive; then
      exec 9<>"$FIFO"; printf '{"cmd":"flush"}\n' >&9; exec 9>&-
    fi
    # Cortar SOLO lo que dice el daemon (su stream se llama "Voice TTS"),
    # así no matamos el replay que estamos por arrancar.
    pkill -f '^pw-play .*Voice TTS' 2>/dev/null || true
    sleep 0.15
    if [ -n "$cur" ] && [ -f "$cur" ]; then
      pw-play --volume="$(tts_volume)" "$cur" >/dev/null 2>&1
      return 0
    fi
  fi
  local rows=""
  if [ -n "$index" ]; then
    rows=$("$PY" - "$VOICE_DIR" "$index" <<'PYEOF'
import base64, os, sys
sys.path.insert(0, os.path.abspath(sys.argv[1]))
from engine import message_at
rec = message_at(int(sys.argv[2]))
if rec:
    print("%s\x1f%s\x1f%s" % (rec.get("file", ""),
                             rec.get("source") or rec.get("app", ""),
                             base64.b64encode(rec.get("text", "").encode()).decode()))
PYEOF
)
  else
    rows=$("$PY" - "$VOICE_DIR" "$n" <<'PYEOF'
import base64, os, sys
sys.path.insert(0, os.path.abspath(sys.argv[1]))
from engine import load_messages
for rec in reversed(load_messages(int(sys.argv[2]))):  # mas viejo primero
    print("%s\x1f%s\x1f%s" % (rec.get("file", ""),
                           rec.get("source") or rec.get("app", ""),
                           base64.b64encode(rec.get("text", "").encode()).decode()))
PYEOF
)
  fi
  [ -n "$rows" ] || { echo "voice: no hay mensajes que repetir" >&2; return 1; }
  while IFS=$'\x1f' read -r file source b64; do
    [ -n "$b64" ] || continue
    local text; text=$(printf '%s' "$b64" | base64 -d)
    if [ -n "$file" ] && [ -f "$file" ]; then
      wait_mic_free || return 0
      pw-play --volume="$(tts_volume)" "$file" >/dev/null 2>&1
      continue
    fi
    local wav; wav=$(mktemp /tmp/voice-repeat-XXXXXX.wav)
    if daemon_alive && synth --source "$source" "$text" "$wav" >/dev/null 2>&1 && [ -s "$wav" ]; then
      wait_mic_free || return 0
      pw-play --volume="$(tts_volume)" "$wav" >/dev/null 2>&1
    else
      __speak_direct "$text"
    fi
    rm -f "$wav"
  done <<<"$rows"
}

# play_inbox: reproduce los mensajes pendientes (mas antiguo primero), narrando
# de quien es cada uno, y los marca como escuchados al terminar cada uno.
play_inbox() {  # play_inbox [N|--all]
  local n=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) n=""; shift ;;
      *) n="$1"; shift ;;
    esac
  done
  local rows
  rows=$("$PY" - "$VOICE_DIR" "$n" <<'PYEOF'
import base64, os, sys
sys.path.insert(0, os.path.abspath(sys.argv[1]))
from engine import pending_messages
limit = int(sys.argv[2]) if sys.argv[2] else None
for rec in pending_messages(limit):
    print("%s\x1f%s\x1f%s\x1f%s" % (
        rec.get("file", ""),
        rec.get("source") or rec.get("app", ""),
        base64.b64encode(rec.get("text", "").encode()).decode(),
        rec.get("id") or ("ts:" + str(rec.get("ts", "")))))
PYEOF
)
  [ -n "$rows" ] || { echo "voice: no hay mensajes pendientes"; return 0; }
  while IFS=$'\x1f' read -r file source b64 ident; do
    [ -n "$b64" ] || continue
    local text; text=$(printf '%s' "$b64" | base64 -d)
    # Narracion: decir de quien es el mensaje (asi se identifica el autor).
    local spoken="$text"
    if [ -n "$source" ] && [ "$source" != "voice" ] && [ "$source" != "sistema" ]; then
      spoken="Mensaje de $source. $text"
    fi
    if [ -n "$file" ] && [ -f "$file" ]; then
      wait_mic_free || return 0
      pw-play --volume="$(tts_volume)" "$file" >/dev/null 2>&1
    else
      local wav; wav=$(mktemp /tmp/voice-inbox-XXXXXX.wav)
      if daemon_alive && synth --source "$source" "$spoken" "$wav" >/dev/null 2>&1 && [ -s "$wav" ]; then
        wait_mic_free || return 0
        pw-play --volume="$(tts_volume)" "$wav" >/dev/null 2>&1
      else
        __speak_direct "$spoken"
      fi
      rm -f "$wav"
    fi
    marcar_escuchado "$ident"
  done <<<"$rows"
}

inbox_cmd() {  # inbox [list|count|clear|play]
  local sub="${1:-list}"; shift || true
  case "$sub" in
    count) "$PY" "$VOICE_DIR/engine.py" pending-count ;;
    clear) "$PY" "$VOICE_DIR/engine.py" mark-heard >/dev/null; echo "buzon vaciado" ;;
    play) play_inbox "$@" ;;
    list|"") "$PY" "$VOICE_DIR/engine.py" pending "$@" ;;
    *) echo "uso: voice inbox [list|count|clear|play]" >&2; return 2 ;;
  esac
}

# think: manda el texto al cerebro headless (Hermes) y habla la respuesta con
# la voz del asistente. Es el fallback "no es un comando fijo".
think() {  # think <texto>
  local text="$*"
  [ -n "$text" ] || { [ -t 0 ] && return 2; text="$(cat)"; }
  [ -n "$text" ] || { echo "voice think: falta el texto" >&2; return 2; }
  local reply
  reply=$(VOICE_HERMES_TIMEOUT="${VOICE_HERMES_TIMEOUT:-60}" "$HOME/.local/bin/voice-hermes" "$text" 2>/dev/null)
  # Limpieza para oido: fuera codigo, HTML, markdown y saltos de linea.
  reply=$(printf '%s' "$reply" | "$PY" "$VOICE_DIR/spoken.py")
  [ -n "$reply" ] || reply="No pude resolver eso."
  speak --force --source assistant "$reply"
}

# ptt: push-to-talk. Graba una frase (VAD), la transcribe (Handy) y la manda al
# cerebro (pi). Para el modo "hablo y me responde" sin palabra clave.
ptt() {
  echo "Escuchando… (hablá; corta al silencio)" >&2
  local text
  text=$(listen 2>/dev/null | tail -n1)
  if [ -z "$text" ]; then
    speak --force --source assistant "No te entendí."
    return 1
  fi
  echo "→ $text" >&2
  think "$text"
}

listen() {
  command -v rec >/dev/null 2>&1 || { echo "voice: 'rec' (sox) no instalado" >&2; return 1; }
  local wav="$CACHE_DIR/listen.wav"
  mkdir -p "$CACHE_DIR"

  # toggle: segunda pulsacion corta la grabacion
  if [ -f "$LISTEN_PID" ]; then
    local pid; pid=$(cat "$LISTEN_PID")
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null
      rm -f "$LISTEN_PID"
      echo "voice: grabación detenida"
      return 0
    fi
    rm -f "$LISTEN_PID"
  fi

  # Señuelo visual: aviso de escritorio mientras dura la grabación.
  notify --app-name voice -g "󰍬" -t 4000 "Grabando…" \
    "Vuelve a Super+V para cortar o espera silencio" >/dev/null 2>&1 &
  echo "voice: grabando (silence auto-stop, max 15s)…" >&2

  rec -q "$wav" rate 16k channels 1 silence 1 0.3 0.8% 1 0.9 0.8% timeout 15 &
  local rpid=$!
  echo "$rpid" > "$LISTEN_PID"
  wait "$rpid" 2>/dev/null
  rm -f "$LISTEN_PID"

  [ -s "$wav" ] || { echo "voice: sin audio capturado" >&2; return 1; }
  local text; text=$(transcribe "$wav")
  [ -n "$text" ] || { echo "voice: no se entendio la frase" >&2; return 1; }
  echo "$text"
  command -v wl-copy >/dev/null 2>&1 && echo "$text" | wl-copy >/dev/null 2>&1 &

  # rutear a opencode si esta corriendo (lo levanta el plugin voice)
  if pgrep -u "$(id -u)" -f "opencode.*session" >/dev/null 2>&1 || pgrep -f "/bin/opencode" >/dev/null 2>&1; then
    local tmp="$CACHE_DIR/to-opencode.json.tmp"
    printf '{"text":%s,"ts":%s}\n' "$(js_escape "$text")" "$(date +%s)" > "$tmp"
    mv "$tmp" "$OC_FILE"
    echo "voice: enviado a opencode" >&2
  fi
}

transcribe() {
  local wav="$1"
  local model lang devarg
  model=$(config_val stt model)
  lang=$(config_val stt lang)
  devarg=$("$PY" - <<PYEOF
import sys; sys.path.insert(0, "$VOICE_DIR")
from engine import choose_handy_device, detect
print(choose_handy_device("$(config_val stt accelerator)" , detect())["index"])
PYEOF
)
  # ES la capa STT global (Handy): micrófono/voz → texto. Parámetro `--device`
  # solo si elegimos un dispositivo explícito (no "auto").
  if [ -n "$devarg" ] && [ "$devarg" != "None" ]; then
    "$PY" "$VOICE_DIR/stt.py" transcribe "$wav" --model "$model" --device "$devarg"
  else
    "$PY" "$VOICE_DIR/stt.py" transcribe "$wav" --model "$model"
  fi
}

synth() {  # synth [--source S|--profile P] [--voice V] [--engine E] [--lang L] [--pitch N] [--speed N] [--stdout] <texto> [salida.wav]
  local text="" out="" to_stdout=0
  local profile="" voice="" engine="" lang="" pitch="" speed=""
  while [ "$#" -ge 1 ]; do
    case "$1" in
      --profile|--source) profile="${2:-}"; shift 2 ;;
      --voice)   voice="${2:-}";  shift 2 ;;
      --engine)  engine="${2:-}"; shift 2 ;;
      --lang)    lang="${2:-}";   shift 2 ;;
      --pitch)   pitch="${2:-}";  shift 2 ;;
      --speed)   speed="${2:-}";  shift 2 ;;
      --stdout)  to_stdout=1; shift ;;
      *) if [ -z "$text" ]; then text="$1"; else out="$1"; fi; shift ;;
    esac
  done
  [ -n "$text" ] || { echo "uso: voice synth [opciones] <texto> [salida.wav]" >&2; return 2; }
  if [ "$to_stdout" = "1" ] && [ -z "$out" ]; then
    out="$(mktemp /tmp/voice-synth-XXXXXX.wav)"
  fi
  [ -n "$out" ] || { echo "uso: voice synth [opciones] <texto> [salida.wav]" >&2; return 2; }
  local V_ENGINE V_VOICE V_LANG V_PITCH V_SPEED
  resolve_voice_flags "$profile" "$voice" "$engine" "$lang"
  [ -n "$pitch" ] && V_PITCH="$pitch"
  [ -n "$speed" ] && V_SPEED="$speed"
  daemon_alive || { echo "voice: daemon no activo (voice daemon start)" >&2; return 1; }
  local got
  got=$("$PY" - "$CACHE_DIR/synth.sock" "$text" "$out" "$V_ENGINE" "$V_VOICE" "$V_LANG" "$V_PITCH" "$V_SPEED" <<'PYEOF'
import json, os, socket, sys
sock_path, text, out, engine, voice, lang, pitch, speed = sys.argv[1:9]
out = os.path.abspath(os.path.expanduser(out))
req = {"text": text, "output": out, "engine": engine, "voice": voice,
       "lang": lang, "pitch": float(pitch or 0), "speed": float(speed or 1.0)}
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(600)
try:
    s.connect(sock_path)
except OSError as e:
    print(f"voice: no se pudo conectar a {sock_path}: {e}", file=sys.stderr)
    sys.exit(1)
s.sendall(json.dumps(req).encode("utf-8") + b"\n")
buf = b""
while b"\n" not in buf:
    chunk = s.recv(65536)
    if not chunk:
        break
    buf += chunk
line = buf.split(b"\n", 1)[0].decode("utf-8", "replace").strip()
try:
    resp = json.loads(line)
except Exception:
    resp = {"ok": False, "error": f"respuesta invalida: {line[:200]}"}
if resp.get("ok"):
    print(out)
    sys.exit(0)
print(resp.get("error", "fallo la sintesis"), file=sys.stderr)
sys.exit(1)
PYEOF
) || { [ "$to_stdout" = "1" ] && rm -f "$out"; return 1; }
  if [ "$to_stdout" = "1" ]; then
    cat "$got"
    rm -f "$out"
  else
    echo "$got"
  fi
}

usage() { sed -n '2,/^# Arquitectura/p' "$0" | grep '^#'; }

send_agent() {  # send_agent --agent <nombre> --text "texto" [--key K] [--voice V] [--engine E] [--lang L] [--profile P]
  local agent="" text="" key="" extra=()
  while [ "$#" -ge 1 ]; do
    case "$1" in
      --agent) agent="${2:?falta nombre agente}"; shift 2 ;;
      --text)  text="${2:?falta texto}"; shift 2 ;;
      --key)   key="${2:?falta clave}"; shift 2 ;;
      --voice|--engine|--lang|--profile|--pitch|--speed) extra+=("$1" "$2"); shift 2 ;;
      *) break ;;
    esac
  done
  if [ -z "$text" ]; then echo "uso: voice send --agent <nombre> --text \"texto\" [--key K]" >&2; return 2; fi
  local args=(--source "${agent:-send}")
  # Sin --key no hay antirrebote: el llamador decide si quiere dedup. El bus de
  # agentes manda una clave única por mensaje para que nada se pierda.
  [ -n "$key" ] && args+=(--key "$key")
  speak "${args[@]}" "${extra[@]}" "$text"
}

# ── despacho ────────────────────────────────────────────────────────────
case "${1:-status}" in
  __speak_direct) shift; __speak_direct "$@" ;;
  status) "$PY" "$VOICE_DIR/engine.py" status ;;
  speak|say) shift; speak "$@" ;;
  avisar) shift; avisar "$@" ;;
  notify) shift; notify_cmd "$@" ;;
  ingest-notify) ingest_notify ;;
  messages) shift; messages_cmd "$@" ;;
  inbox) shift; inbox_cmd "$@" ;;
  think) shift; think "$@" ;;
  ptt) shift; ptt "$@" ;;
  play-inbox) shift; play_inbox "$@" ;;
  profiles) shift; profiles_cmd "$@" ;;
  identity|id) shift; identity_cmd identity "$@" ;;
  color) shift; identity_cmd color "$@" ;;
  role) shift; identity_cmd role "$@" ;;
  agents) shift; identity_cmd agents "$@" ;;
  check|duplicados) shift; identity_cmd check "$@" ;;
  identity-selftest|selftest-colores) shift; identity_cmd selftest "$@" ;;
  profile) shift; profile_cmd "$@" ;;
  repeat) shift; repeat "$@" ;;
  dime) shift; dime "$@" ;;
  resolve) shift; "$PY" "$VOICE_DIR/engine.py" resolve "$@" ;;
  synth) shift; synth "$@" ;;
  subtitle|show) shift; subtitle "$@" ;;
  listen) listen ;;
  test)
    speak "Hola. Esto es una prueba del sistema de voz local."
    sleep 1.5
    echo "— Ahora habla tras el pitido (STT)…"
    listen
    ;;
  stop)
    # Cualquier reproducción nuestra con esta marca se corta, aunque no la haya
    # encolado el daemon (p. ej. la voz que genera Omni con el modelo local).
    pkill -f '^pw-play .*Voice TTS' 2>/dev/null || true
    if daemon_alive; then
      exec 9<>"$FIFO"; printf '{"cmd":"stop"}\n' >&9; exec 9>&-
      echo "voice: cola vaciada"
    else
      pkill -f "pw-play" 2>/dev/null; echo "voice: sin daemon, playback detenido"
    fi
    ;;
  accelerator)
    if [ "$#" -ge 2 ]; then
      case "$2" in auto|gpu|cpu) get_set stt accelerator "$2"; echo "accelerator: $2" ;;
        *) echo "voice: accelerator auto|gpu|cpu" >&2; exit 2 ;; esac
    else
      echo "accelerator configurado: $(config_val stt accelerator) | efectivo: $("$PY" - <<PYEOF
import sys; sys.path.insert(0, "$VOICE_DIR")
from engine import choose_handy_device, detect
dev = choose_handy_device("$(config_val stt accelerator)", detect())
print(f"{dev['accelerator']} (device_index={dev['index']})")
PYEOF
)"
    fi
    ;;
  gpu)
    if [ -d /dev/nvidia0 ] || [ -e /dev/nvidia0 ]; then
      nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
    else
      echo "sin GPU NVIDIA"
    fi
    ;;
  battery)
    "$PY" "$VOICE_DIR/engine.py" detect | grep -E "battery|on_ac" || true
    [ -d /sys/class/power_supply ] && for b in /sys/class/power_supply/BAT*; do
      [ -e "$b/uevent" ] || continue
      echo "  $b: $(cat "$b/uevent" 2>/dev/null | tr '\n' ' ')"
    done
    ;;
  tts)
    if [ "$#" -ge 2 ]; then
      case "$2" in
        on|true|1) get_set tts enabled true; echo "voice: TTS ON" ;;
        off|false|0) get_set tts enabled false; echo "voice: TTS OFF" ;;
        toggle)
          if [ "$(config_val tts enabled)" = "false" ]; then
            get_set tts enabled true; echo "voice: TTS ON"
          else
            get_set tts enabled false; echo "voice: TTS OFF"
          fi ;;
        *) echo "voice: tts on|off|toggle" >&2; exit 2 ;;
      esac
    else echo "TTS: $(config_val tts enabled)"; fi
    ;;
  voice)
    if [ "$#" -ge 2 ]; then
      get_set tts "voice_$(config_val tts lang)" "$2"
      echo "voz: $2"
    else echo "voz actual: $(config_val tts "voice_$(config_val tts lang)")"; fi
    ;;
  voices) "$PY" "$VOICE_DIR/engine.py" voices || echo "(ninguna voz piper instalada)" ;;
  lang)
    if [ "$#" -ge 2 ]; then get_set tts lang "$2"; echo "idioma: $2"
    else echo "idioma: $(config_val tts lang)"; fi
    ;;
  mode)
    if [ "$#" -ge 2 ]; then get_set tts mode "$2"; echo "modo: $2 (summary|full)"
    else echo "modo: $(config_val tts mode)"; fi
    ;;
  modo)
    # Ritmo de los agentes en un solo gesto: entrega + cuánto comentan.
    #   fluido        -> habla al instante y puede narrar avances
    #   concentracion -> no suena: sólo puntos clave al buzon (lo oís con "dime")
    #   campana       -> no habla: campana + buzon (lo oís con "dime")
    if [ "$#" -ge 2 ]; then
      case "$2" in
        fluido)
          get_set tts delivery direct; get_set tts chatiness fluido
          echo "modo: fluido (habla al instante y comenta avances)" ;;
        concentracion|concentración|concentrado)
          get_set tts delivery silent; get_set tts chatiness concentracion
          echo "modo: concentracion (silencio: puntos clave al buzón)" ;;
        campana|bell|buzon|buzón)
          get_set tts delivery bell; get_set tts chatiness concentracion
          echo "modo: campana (campana + buzon; lo oís con dime)" ;;
        *) echo "voice: modo fluido|concentracion|campana" >&2; exit 2 ;;
      esac
    else
      echo "modo: $(config_val tts chatiness) · entrega: $(config_val tts delivery)"
    fi
    ;;
  delivery)
    # Como entrega `avisar`: direct (habla ya), mailbox (acumula en el buzon),
    # silent (buzon sin sonido) o hybrid (aviso + pausa + voz).
    if [ "$#" -ge 2 ]; then
      case "$2" in
        bell|mailbox|hybrid|direct|silent) get_set tts delivery "$2"; echo "entrega: $2" ;;
        *) echo "voice: delivery bell|mailbox|hybrid|direct|silent" >&2; exit 2 ;;
      esac
    else echo "entrega: $(config_val tts delivery)"; fi
    ;;
  volume)
    # Volumen relativo del TTS sobre el general: 0.0-1.0 o NN%.
    if [ "$#" -ge 2 ]; then
      v="$2"
      if [[ "$v" != *% ]] && awk "BEGIN{exit !($v>1)}"; then v="${v}%"; fi
      get_set tts volume "$v"
      echo "volumen TTS: $v (relativo al general)"
    else
      echo "volumen TTS: $(config_val tts volume)"
    fi
    ;;
  speed)
    # Velocidad de lectura del TTS: factor de tempo (1.0 = normal, >1 rapido).
    if [ "$#" -ge 2 ]; then
      get_set tts speed "$2"
      echo "velocidad TTS: $2x"
    else
      echo "velocidad TTS: $(config_val tts speed)x"
    fi
    ;;
  history)
    # Historial de la voz: `history [--json] [N]`, `history play <N>`, `history clear`.
    shift
    case "${1:-}" in
      play)
        n="${2:-1}"
        wav=$("$PY" "$VOICE_DIR/engine.py" history-wav "$n" 2>/dev/null) || {
          echo "voice: no existe la entrada $n del historial" >&2; exit 1; }
        wait_mic_free || exit 0
        pw-play --volume="$(tts_volume)" "$wav" >/dev/null 2>&1 &
        echo "voice: reproduciendo entrada $n"
        ;;
      clear)
        [ -d "$HISTORY_RECORDINGS" ] && \
          find "$HISTORY_RECORDINGS" -maxdepth 1 -name 'tts-*.wav' -delete 2>/dev/null
        mkdir -p "$HISTORY_DIR"; : > "$HISTORY_DIR/messages.jsonl"; : > "$HISTORY_DIR/history.jsonl"
        echo "voice: historial vaciado"
        ;;
      *) "$PY" "$VOICE_DIR/engine.py" history "$@" ;;
    esac
    ;;
  play)
    # Reproduce un WAV del historial (no cualquier archivo).
    [ "$#" -ge 2 ] || { echo "uso: voice play <archivo.wav>" >&2; exit 2; }
    _dir="$(readlink -f "$HISTORY_RECORDINGS" 2>/dev/null || echo "$HISTORY_RECORDINGS")"
    _want="$(readlink -f "$2" 2>/dev/null || echo "$2")"
    case "$_want" in
      "$_dir"/*) ;;
      *) echo "voice: solo reproduzco audios del historial ($_dir)" >&2; exit 2 ;;
    esac
    [ -f "$_want" ] || { echo "voice: no existe $_want" >&2; exit 1; }
    wait_mic_free || exit 0
    pw-play --volume="$(tts_volume)" "$_want" >/dev/null 2>&1 &
    echo "voice: reproduciendo $(basename "$_want")"
    ;;
  engine)
    if [ "$#" -ge 3 ]; then
      e_lang="${3:-$(config_val tts lang)}"
      get_set tts "engine_$e_lang" "$2"; echo "motor TTS [$e_lang]: $2"
    else
      echo "motor es: $(config_val tts engine_es) | en: $(config_val tts engine_en)"
    fi
    ;;
  model)
    if [ "$#" -ge 2 ] && [ "$2" = "list" ]; then
      "$PY" "$VOICE_DIR/stt.py" models
    elif [ "$#" -ge 3 ] && [ "$2" = "set" ]; then
      get_set stt model "$3"; echo "modelo STT: $3"
    elif [ "$#" -ge 2 ]; then
      get_set stt model "$2"; echo "modelo STT: $2"
    else echo "modelo STT: $(config_val stt model) — models instalados: $("$PY" "$VOICE_DIR/stt.py" models | wc -l)"; fi
    ;;
  benchmark) "$PY" "$VOICE_DIR/benchmark.py" "${@:2}" ;;
  send)
    # API de salida por agente: `voice send --agent <nombre> --text "..."`.
    # Habla el texto via el daemon TTS (igual que speak). El antirrebote solo
    # se aplica si el llamador pasa `--key K`: sin clave, cada mensaje suena.
    # Interfaz estable para integrar Hermes, opencode u otros agentes.
    shift
    send_agent "$@"
    ;;
  transcribe)
    [ "$#" -ge 2 ] || { echo "uso: voice transcribe <wav>" >&2; exit 2; }
    transcribe "$2"
    ;;
  summarize)
    # On-demand: lee la ultima notificacion del agente (o la ultima respuesta)
    # y la habla por Chatterbox.
    _mfile="$CACHE_DIR/last-message.txt"
    _rfile="$CACHE_DIR/last-response.txt"
    _text=""
    [ -s "$_mfile" ] && _text=$(cat "$_mfile")
    [ -n "$_text" ] || { [ -s "$_rfile" ] && _text=$(cat "$_rfile"); }
    if [ -z "$_text" ]; then
      echo "voice: no hay resumen disponible todavia" >&2
      speak "No hay resumen disponible todavia."
      exit 1
    fi
    speak "$_text"
    echo "voice: hablando resumen"
    ;;
  notify)
    # Notificaciones del agente opencode: on|off|status (default OFF).
    _nf="$HOME/.local/state/opencode/voice-notify"
    mkdir -p "$(dirname "$_nf")"
    _cur="0"; [ -s "$_nf" ] && _cur=$(cat "$_nf")
    case "${2:-status}" in
      on)     echo "1" > "$_nf"; echo "notificaciones: ON" ;;
      off)    echo "0" > "$_nf"; echo "notificaciones: OFF" ;;
      toggle)
        if [ "$_cur" = "1" ]; then echo "0" > "$_nf"; echo "notificaciones: OFF"
        else echo "1" > "$_nf"; echo "notificaciones: ON"; fi ;;
      status|*)
        [ "$_cur" = "1" ] && echo "notificaciones: ON" || echo "notificaciones: OFF" ;;
    esac
    ;;
  daemon)
    case "${2:-status}" in
      start) systemctl --user start voice-daemon ;;
      stop)  systemctl --user stop voice-daemon ;;
      restart) systemctl --user restart voice-daemon ;;
      status) systemctl --user is-active voice-daemon ;;
      *) cat <<EOU
use: voice daemon start|stop|restart|status
    (unit: voice-daemon.service, ver scripts/setup-omarchy.sh)
EOU
        ;;
    esac
    ;;
  -h|--help|help) usage ;;
  *) echo "voice: comando desconocido: $1" >&2; usage >&2; exit 2 ;;
esac