#!/usr/bin/env bash
# voice-pi — puente headless a Pi para el cerebro del asistente de voz.
#
#   voice-pi "¿en qué workspace estoy?"      # responde en stdout
#   echo "sube el volumen" | voice-pi
#
# Pi corre en un directorio propio con su AGENTS.md que le enseña a manejar el
# escritorio. Sin razonamiento, sin extensiones ni skills, sin sesión: lo más
# liviano y rápido posible. La respuesta final de Pi sale por stdout.
#
# Config: VOICE_PI_BRAIN_DIR, VOICE_PI_MODEL (vacío = default de Pi),
#         VOICE_PI_TOOLS, VOICE_PI_TIMEOUT (segundos).

set -uo pipefail

# Asegura las rutas propias aunque el servicio arranque con un PATH mínimo.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

BRAIN_DIR="${VOICE_PI_BRAIN_DIR:-$HOME/.local/share/voice/pi-brain}"
MODEL="${VOICE_PI_MODEL:-opencode-go/qwen3.8-flash}"
TOOLS="${VOICE_PI_TOOLS:-bash,read}"
TIMEOUT="${VOICE_PI_TIMEOUT:-60}"

prompt="$*"
if [ -z "$prompt" ] && [ ! -t 0 ]; then
  prompt="$(cat)"
fi
[ -n "$prompt" ] || { echo "voice-pi: falta el texto" >&2; exit 2; }
[ -d "$BRAIN_DIR" ] || { echo "voice-pi: no existe $BRAIN_DIR" >&2; exit 1; }

# Modo evaluación: decidir y responder sin ejecutar nada (lo usa el scorer).
if [ "${VOICE_PI_DRY:-0}" = "1" ]; then
  prompt="MODO EVALUACIÓN (no cambies nada): podés LEER estado (archivos, hyprctl, voice, omarchy), pero no ejecutes acciones que modifiquen el sistema ni crees/modifiques datos. Decidí qué harías y respondé en 1 o 2 frases lo que dirías, como si lo hubieras hecho. Sin markdown.

$prompt"
fi

args=(--print --no-session --no-extensions --no-skills --thinking off --tools "$TOOLS")
[ -n "$MODEL" ] && args+=(--model "$MODEL")

# Guardián: sólo dentro del cerebro, `omarchy`/`systemctl` destructivos pasan
# por confirmación hablada (no afecta a tu shell normal).
PATH="$BRAIN_DIR/guard:$PATH"
export PATH

cd "$BRAIN_DIR" || exit 1

# Pi a veces cierra sin texto final (sólo llamó herramientas). Reintentamos una
# vez pidiendo explícitamente una frase, para no dejar mudo al asistente.
out="$(timeout "$TIMEOUT" pi "${args[@]}" "$prompt")"
if [ -z "$out" ]; then
  out="$(timeout "$TIMEOUT" pi "${args[@]}" "$prompt

IMPORTANTE: terminá SIEMPRE con una frase hablada en español, aunque hayas usado herramientas.")"
fi
[ -n "$out" ] && printf '%s\n' "$out"
