#!/usr/bin/env bash
# rustxng-ensure — instala el binario de release de RustXNG si falta.
#
# RustXNG es el motor de búsqueda local que usa el provider `rustxng` del
# harness (plugin dsh-local-web-search-rustxng). El binario NO se versiona acá;
# este script lo baja, verifica el SHA-256 del release y lo deja en ~/.local/bin.
#
# Uso:
#   rustxng-ensure            instala si falta; si ya está, muestra la versión
#   rustxng-ensure --force    reinstala la versión fijada
#   RUSTXNG_VERSION=v0.31.2 rustxng-ensure
set -euo pipefail

VERSION="${RUSTXNG_VERSION:-v0.31.2}"
DEST="${HOME}/.local/bin/rustxng"
SHARE="${HOME}/.local/share/rustxng"
BASE="https://github.com/sahenjp/RustXNG/releases/download/${VERSION}"

if [ -x "$DEST" ] && [ "${1:-}" != "--force" ]; then
	"$DEST" --version
	exit 0
fi

case "$(uname -s)-$(uname -m)" in
	Linux-x86_64) TARGET="x86_64-unknown-linux-musl" ;;
	Linux-aarch64) TARGET="aarch64-unknown-linux-gnu" ;;
	*)
		echo "rustxng-ensure: plataforma sin binario de release: $(uname -s) $(uname -m)" >&2
		echo "rustxng-ensure: usá cargo install --git https://github.com/sahenjp/RustXNG.git --tag ${VERSION} --locked" >&2
		exit 1
		;;
esac

ASSET="rustxng-${VERSION}-${TARGET}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "rustxng-ensure: bajando ${ASSET} (${VERSION})"
curl -fsSL --retry 2 -o "${TMP}/${ASSET}" "${BASE}/${ASSET}"
curl -fsSL --retry 2 -o "${TMP}/${ASSET}.sha256" "${BASE}/${ASSET}.sha256"

(
	cd "$TMP"
	sha256sum --check --quiet "${ASSET}.sha256"
)
echo "rustxng-ensure: SHA-256 verificado"

mkdir -p "$(dirname "$DEST")" "$SHARE"
install -m755 "${TMP}/${ASSET}" "$DEST"
curl -fsSL --retry 2 -o "${SHARE}/LICENSE" "https://raw.githubusercontent.com/sahenjp/RustXNG/${VERSION}/LICENSE"
curl -fsSL --retry 2 -o "${SHARE}/NOTICE" "https://raw.githubusercontent.com/sahenjp/RustXNG/${VERSION}/NOTICE"

"$DEST" --version
echo "rustxng-ensure: instalado en ${DEST} (LICENSE y NOTICE en ${SHARE})"
