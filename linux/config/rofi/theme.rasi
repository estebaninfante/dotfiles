* {
    bg:          #0a0a0a;
    bg-alt:      #141414;
    fg:          #e0e0e0;
    fg-alt:      #9a9a9a;
    accent:      #b70001;
    border:      #2a0000;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    background-color: rgba(10, 10, 10, 0.70);
    border:           1px;
    border-color:     @border;
    border-radius:    10px;
    width:            500px;
    padding:          12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    6px;
    padding:          10px 14px;
    margin:           0 0 10px 0;
    children:         [prompt, entry];
}

prompt {
    text-color: @accent;
    font:       "Cinzel Decorative 13";
    margin:     0 8px 0 0;
}

entry {
    text-color: @fg;
    font:       "Cinzel Decorative 13";
}

listview {
    lines:         8;
    spacing:       4px;
    /* Launcher tipo spotlight: sin query todavía, lista oculta.
       Se muestra solo al empezar a escribir. */
    require-input: true;
}

element {
    border-radius: 6px;
    padding:       8px 12px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       #ffffff;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    size: 20px;
    background-color: transparent;
}
