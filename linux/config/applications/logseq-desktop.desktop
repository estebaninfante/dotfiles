[Desktop Entry]
Type=Application
Name=Notes and learning
GenericName=Notas y aprendizaje
Comment=Notas, diario e investigaciones en un grafo local (Logseq, vault ~/alicia)
Exec=logseq %u
Icon=logseq
Terminal=false
StartupNotify=true
StartupWMClass=Logseq
Categories=Office;Education;
