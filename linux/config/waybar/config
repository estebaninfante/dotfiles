// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",

    "height": 34,

    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,

    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/lid-inhibit",
        "pulseaudio",
        "custom/memory",
        "cpu",
        "battery"
    ],

    /* =========================
       WORKSPACES
       ========================= */

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "warp-on-scroll": false,
        "format": "{name}"
    },

    /* =========================
       CLOCK
       ========================= */

    "clock": {
        "format": "{:%H:%M}"
    },

    /* =========================
       CPU
       ========================= */

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },

    /* =========================
       MEMORY
       ========================= */

    "custom/memory": {
        "exec": "$HOME/.local/bin/waybar-ram-top",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },

    /* =========================
       BATTERY
       ========================= */

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },

        "format": "{capacity}%",

        "format-charging": "{capacity}%+",

        "format-plugged": "{capacity}% AC",

        "format-alt": "{time}",

        "tooltip": true,

        "tooltip-format": "{time} remaining"
    },

    /* =========================
       AUDIO
       ========================= */

	"pulseaudio": {
	    "scroll-step": 5,

	    "format": "VOL {volume}%",

	    "format-muted": "VOL MUTED",

	    "on-click": "pavucontrol"
	},

    /* =========================
       LID INHIBIT
       ========================= */

    "custom/lid-inhibit": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/lid-inhibit-waybar.sh",
        "on-click": "$HOME/.local/bin/toggle-lid.sh",
        "tooltip": true
    },
}
