// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",

    "height": 34,

    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,

    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/pomodoro",
        "custom/lid-inhibit",
        "custom/layout",
        "pulseaudio",
        "network",
        "custom/memory",
        "cpu",
        "custom/battery",
        "tray"
    ],

    /* =========================
       WORKSPACES
       ========================= */

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "warp-on-scroll": false,
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },

    /* =========================
       CLOCK
       ========================= */

    "clock": {
        "format": "{:%H:%M}"
    },

    /* =========================
       CPU
       ========================= */

    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },

    /* =========================
       MEMORY
       ========================= */

    "custom/memory": {
        "exec": "$HOME/.local/bin/waybar-ram-top",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },

    /* =========================
       BATTERY
       ========================= */

    "custom/battery": {
        "exec": "$HOME/.local/bin/waybar-battery-top",
        "return-type": "json",
        "interval": 10,
        "tooltip": true,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{}",
        "format-charging": "{}",
        "format-plugged": "{}"
    },

    /* =========================
       AUDIO
       ========================= */

	"pulseaudio": {
	    "scroll-step": 5,

	    "format": "VOL {volume}%",

	    "format-muted": "VOL MUTED",

	    "on-click": "pavucontrol"
	},

    /* =========================
       NETWORK
       ========================= */

    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "\uF0230 {ifname}",
        "format-disconnected": "\uF092D OFF",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\nSignal: {signalStrength}%\nFrequency: {frequency} MHz",
        "format-icons": ["\uF092F", "\uF091F", "\uF0922", "\uF0925", "\uF0928"],
        "on-click": "$HOME/.local/bin/wifi-reconnect.sh",
        "on-click-right": "nm-connection-editor",
        "interval": 5
    },

    /* =========================
       LID INHIBIT
       ========================= */

    "custom/lid-inhibit": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/lid-inhibit-waybar.sh",
        "on-click": "$HOME/.local/bin/toggle-lid.sh",
        "tooltip": true
    },

    /* =========================
       LAYOUT (teclado)
       ========================= */

    "custom/layout": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/keyboard-layout-waybar.sh",
        "on-click": "$HOME/.local/bin/keyboard-layout-waybar.sh toggle",
        "tooltip": true
    },

    /* =========================
       TRAY
       ========================= */

    "tray": {
        "icon-size": 20,
        "spacing": 6
    },

    /* =========================
       POMODORO
       ========================= */

    "custom/pomodoro": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/pomodoro-waybar.sh",
        "on-click": "$HOME/.local/bin/pomodoro-waybar.sh toggle",
        "tooltip": false
    },
}
