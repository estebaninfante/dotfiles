{
  "bar": {
    "centerAnchor": "eztvn.workspaces",
    "id": "eztvn.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "eztvn.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "eztvn.workspaces"
        },
        {
          "id": "eztvn.wave"
        },
        {
          "id": "eztvn.countdown",
          "target": "2027-01-25T00:00:00"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.keegan-sucks.flowstate",
          "shortBreakMinutes": 10,
          "workMinutes": 50
        }
      ],
      "left": [
        {
          "id": "eztvn.menu"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "vm.sysmem"
        }
      ],
      "right": [
        {
          "id": "eztvn.lanmouse"
        },
        {
          "id": "services",
          "type": "qml"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "eztvn.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "eztvn.menu"
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "tomv.battery-usage"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
