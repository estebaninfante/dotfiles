{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "eztvn.workspaces",
    "layout": {
      "left": [
        {
          "id": "eztvn.menu"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "vm.sysmem"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "eztvn.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "eztvn.workspaces"
        },
        {
          "id": "eztvn.wave"
        },
        {
          "id": "eztvn.countdown",
          "target": "2027-01-25T00:00:00"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.keegan-sucks.flowstate",
          "workMinutes": 50,
          "shortBreakMinutes": 10
        }
      ],
      "right": [
        {
          "id": "eztvn.grid"
        },
        {
          "id": "eztvn.animations"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "eztvn.power"
        },
        {
          "id": "local.opencode-go"
        },
        {
          "id": "eztvn.tmux"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "eztvn.hypr-remote"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "io.github.dragosol.better-displays-pro"
        },
        {
          "id": "services",
          "type": "qml"
        }
      ]
    },
    "id": "eztvn.bar"
  },
  "plugins": [],
  "disabledPlugins": [
    "omarchy.menu",
    "tomv.battery-usage"
  ],
  "cloneSourceRestores": [
    "eztvn.menu"
  ]
}
