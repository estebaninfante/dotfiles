{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // Dotfiles sync (scripts/dotfiles-sync.sh + timer systemd-user cada 5 min)
  "sync": {"icon":"󰓦","label":"Dotfiles sync"},
  "sync.now": {"icon":"󰐯","label":"Sincronizar ahora","description":"git pull --rebase --autostash","action":"~/dotfiles/scripts/dotfiles-sync.sh --force"},
  "sync.auto": {"icon":"󰔣","label":"Auto-sync","description":"Pull cada 5 min (timer systemd)","action":"~/dotfiles/scripts/dotfiles-sync.sh --toggle","checked":"test ! -f ~/.config/dotfiles-autosync.off"},

  // Ahorro extremo de batería (power-extreme.sh + docs/energia-laptop-82y5.md §8)
  "trigger.toggle.extreme-power": {"icon":"󰂄","label":"Ahorro extremo","aliases":["ahorro-extremo","extremo"],"description":"Batería: apaga IA local, KVM, streaming, agentes y timers; brillo 25%","when":"omarchy-battery-present","checked":"test -f ~/.local/state/power-extreme/on","action":"~/.local/bin/power-extreme.sh toggle"},

  // Modo Kindle: las flechas del control de presentaciones pasan página en KOReader
  // (kindle-mode + kindle-page; también se alterna manteniendo la flecha derecha)
  "trigger.toggle.kindle": {"icon":"󰂺","label":"Modo Kindle","aliases":["kindle","koreader"],"description":"Flechas del control = pasar página en el Kindle","checked":"test -f ~/.local/state/kindle-mode/on","action":"~/.local/bin/kindle-mode toggle"},

  // Weylus: la tablet por USB como tableta gráfica / touchpad
  // (weylus-toggle prende el servicio y el vigilante USB; sirve por WiFi y por USB)
  "trigger.toggle.weylus": {"icon":"","label":"Weylus (tablet)","aliases":["weylus","tablet","tableta"],"description":"Tablet como tableta gráfica: por WiFi (la IP aparece al activar) o por USB http://localhost:1701","checked":"test -f ~/.local/state/weylus/on","action":"~/.local/bin/weylus-toggle toggle"},

  // Toques de la tablet: dibuja en la compu los dedos/lápiz que apoyás en Weylus
  "trigger.toggle.weylus-toques": {"icon":"󰟸","label":"Toques de la tablet","aliases":["toques","weylus toques","dedos tablet"],"description":"Muestra en la compu dónde tocás la tablet (Weylus)","checked":"test -f ~/.local/state/weylus-toques/on","action":"~/.local/bin/weylus-toques toggle"},

  // Notas y aprendizaje (vault de Logseq en ~/alicia)
  "personal": {"icon":"󰎞","label":"Personal"},
  "personal.investigaciones": {"icon":"󰎞","label":"Investigaciones","description":"Notas de investigacion del vault (abre en Logseq)","action":"omarchy-launch-or-focus-tui \"~/.local/bin/investigaciones\""},
  "personal.logseq": {"icon":"󰎞","label":"Notes and learning","description":"Notas y aprendizaje: abrir Logseq (grafo alicia)","action":"uwsm-app -- logseq"},

  // Voz: escuchar lo que manda el micrófono (depurar el sonido y la calidad).
  // Apagado por defecto: sólo suena mientras alguien lo prende.
  "voz": {"icon":"󰍬","label":"Voz"},
  "voz.monitor": {"icon":"󰕾","label":"Escuchar el micrófono","aliases":["monitor","escuchar mic","mic monitor","escuchar microfono"],"description":"Oír por los parlantes lo que manda el micrófono (depuración). Apagalo con el mismo ítem.","checked":"test -f ~/.local/state/voice/monitor.json","action":"~/.local/bin/voice monitor toggle"},
  // Los paneles que antes vivían como íconos sueltos en la barra viven acá.
  "voz.tts": {"icon":"󰂞","label":"Voz y avisos (TTS)","aliases":["tts","voz","pi tts","campana","avisos","buzon"],"description":"Panel de voz: prender/apagar la voz, volumen, velocidad, entrega (campana, silencio, al instante) y el registro de mensajes","action":"omarchy-shell -q shell toggle eztvn.pi-tts"},
  "voz.audio": {"icon":"󰕾","label":"Audio y micrófono","aliases":["audio","volumen","parlantes","mic","microfono","mezclador"],"description":"Volumen general, salida, entrada del micrófono y mezclador por aplicación","action":"omarchy-shell -q shell toggle eztvn.audio"},
  "voz.omar": {"icon":"󰍬","label":"Omar (agente de voz)","aliases":["omar","agente de voz"],"description":"Estado del agente de voz: escuchando, pensando o actuando, con su configuración","action":"omarchy-shell -q shell toggle omar.status"},
  "voz.arreglar": {"icon":"󰓃","label":"Arreglar el micrófono","aliases":["arreglar audio","mic mudo","reiniciar mic","audio roto"],"description":"Si el audífono sigue conectado pero Orión y el dictado no te oyen: reinicia el transporte y deja todo escuchando (unos 15 s).","action":"~/.local/bin/arreglar-audio"}
}
