{
  "bar": {
    "centerAnchor": "eztvn.workspaces",
    "id": "eztvn.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "eztvn.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "eztvn.workspaces"
        },
        {
          "id": "eztvn.wave"
        },
        {
          "id": "eztvn.countdown",
          "target": "2027-01-25T00:00:00"
        },
        {
          "id": "io.github.keegan-sucks.flowstate",
          "shortBreakMinutes": 10,
          "workMinutes": 50
        },
        {
          "id": "omarchy.tray"
        }
      ],
      "left": [
        {
          "id": "eztvn.menu"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "vm.sysmem"
        },
        {
          "id": "eztvn.mic"
        },
        {
          "id": "eztvn.cpu-heatmap",
          "rows": 2
        }
      ],
      "right": [
        {
          "id": "eztvn.close-window"
        },
        {
          "id": "eztvn.lanmouse"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "services",
          "type": "qml"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "eztvn.pi-tts"
        },
        {
          "id": "eztvn.timer"
        },
        {
          "id": "local.opencode-go"
        },
        {
          "id": "eztvn.power"
        },
        null
      ]
    },
    "position": "left",
    "transparent": false
  },
  "cloneSourceRestores": [
    "eztvn.menu",
    "eztvn.osd",
    "eztvn.lock"
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "tomv.battery-usage",
    "omarchy.osd",
    "omarchy.lock"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "eztvn.hypr-outline"
    },
    {
      "id": "eztvn.hand-pointer"
    },
    {
      "id": "eztvn.osd"
    },
    {
      "id": "eztvn.capture-menu"
    },
    {
      "id": "eztvn.enlace"
    },
    {
      "id": "eztvn.lock"
    },
    {
      "id": "eztvn.fade"
    }
  ],
  "version": 1
}
