{
  // ── Tema (alineado con el tema global de kitty/nvim) ───────────
  "workbench.colorTheme": "One Dark Pro",
  "workbench.preferredDarkColorTheme": "Rosé Pine",
  "workbench.iconTheme": "vs-seti",
  "workbench.colorCustomizations": {
    "editor.background": "#161513",
    "editor.foreground": "#d4d2cb",
    "editorCursor.foreground": "#d4d2cbcc",
    "editor.lineHighlightBackground": "#1e1d1a",
    "editor.selectionBackground": "#6b563780",
    "editorLineNumber.foreground": "#55534c",
    "editorLineNumber.activeForeground": "#d4d2cb",
    "sideBar.background": "#161513",
    "sideBar.foreground": "#b5b2a8",
    "sideBar.border": "#161513",
    "sideBarSectionHeader.border": "#161513",
    "panel.background": "#161513",
    "panel.border": "#161513",
    "editorGroup.border": "#161513",
    "editorGroupHeader.tabsBackground": "#161513",
    "editorGroupHeader.noTabsBackground": "#161513",
    "tab.border": "#161513",
    "tab.activeBorder": "#d4d2cb",
    "statusBar.background": "#161513",
    "titleBar.activeBackground": "#161513",
    "titleBar.border": "#161513",
    "activityBar.border": "#161513",
    "focusBorder": "#161513",
    "widget.border": "#2a2824",
    "input.border": "#2a2824",
    "dropdown.border": "#2a2824",
    "scrollbar.shadow": "#161513",
    "editorWidget.border": "#2a2824"
  },

  // ── Interfaz minimalista (menos ruido visual) ──────────────────
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": false,
  "window.zoomLevel": 0,
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.editor.showTabs": "none",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.enableExperiments": false,
  "workbench.layoutControl.enabled": false,
  "workbench.list.smoothScrolling": false,
  "workbench.editor.enablePreview": false,
  "explorer.compactFolders": true,
  "explorer.openEditors.visible": 0,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "breadcrumbs.enabled": false,
  "outline.icons": false,
  "problems.decorations.enabled": false,
  "git.decorations.enabled": false,
  "scm.diffDecorations": "none",
  "scm.diffDecorationsGutterWidth": 0,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.codeLens": false,
  "editor.lightbulb.enabled": "off",
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": false,
  "editor.guides.bracketPairs": false,
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "line",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.matchBrackets": "never",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollBeyondLastLine": false,
  "editor.folding": false,
  "editor.glyphMargin": false,
  "editor.showFoldingControls": "never",
  "editor.hover.sticky": false,
  "editor.suggest.showStatusBar": false,
  "editor.parameterHints.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "editor.dragAndDrop": false,
  "editor.fontSize": 13,
  "editor.lineHeight": 1.6,
  "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
  "editor.fontLigatures": true,
  "editor.fontWeight": "normal",
  "editor.cursorStyle": "block",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.cursorSurroundingLines": 10,
  "editor.cursorWidth": 2,
  "editor.smoothScrolling": false,
  "editor.padding.top": 14,
  "editor.padding.bottom": 14,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.wordWrap": "off",
  "editor.tabCompletion": "on",
  "editor.rulers": [],

  // ── Snippets rápidos (less delay, snippets first) ─────────────
  "editor.snippetSuggestions": "top",
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.suggestSelection": "first",
  "editor.quickSuggestionsDelay": 0,
  "editor.suggest.preview": true,
  "editor.suggest.showStatusBar": false,
  "editor.suggest.filterGraceful": false,
  "editor.suggest.localityBonus": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.insertMode": "replace",
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,

  // ── Indentación blindada (HTML/CSS no se sale del nivel) ──────
  "editor.autoIndent": "full",
  "editor.formatOnType": true,
  "editor.formatOnPaste": true,

  // ── HTML format (indentación consistente) ─────────────────────
  "html.format.contentUnformatted": "pre,code,textarea",
  "html.format.wrapAttributes": "auto",
  "html.format.wrapLineLength": 0,
  "html.format.indentInnerHtml": true,
  "html.format.extraLiners": "head, body, /html",
  "html.format.enabled": true,
  "html.autoClosingTags": true,
  "html.autoCreateAttributes": true,

  // ── CSS format ────────────────────────────────────────────────
  "css.format.enable": true,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": false,
  "window.autoDetectColorScheme": false,
  "telemetry.telemetryLevel": "off",
  "update.showReleaseNotes": false,
  "update.mode": "default",
  "extensions.autoCheckUpdates": true,
  "workbench.preferredHighContrastColorTheme": "Rosé Pine",
  "workbench.preferredLightColorTheme": "Rosé Pine Dawn",

  // ── Indentación 2 espacios en web (igual que nvim) ─────────────
  "[html]": {
    "editor.tabSize": 2,
    "editor.autoIndent": "full",
    "editor.formatOnType": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "html.format.enable": true,
    "html.autoClosingTags": true,
    "html.autoCreateAttributes": true
  },
  "[css]": {
    "editor.tabSize": 2,
    "editor.autoIndent": "full",
    "editor.formatOnType": true,
    "css.format.enable": true
  },
  "[scss]": { "editor.tabSize": 2 },
  "[javascript]": { "editor.tabSize": 2 },
  "[javascriptreact]": { "editor.tabSize": 2 },
  "[typescript]": { "editor.tabSize": 2 },
  "[typescriptreact]": { "editor.tabSize": 2 },
  "[json]": { "editor.tabSize": 2 },
  "[jsonc]": { "editor.tabSize": 2 },
  "[vue]": { "editor.tabSize": 2 },

  // ── Auto-guardado ──────────────────────────────────────────────
  "files.autoSave": "off",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/__pycache__": true
  },

  // ── Vim (comportamiento estilo NeoVim) ─────────────────────────
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.visualstar": true,
  "vim.surround": true,
  "vim.sneak": false,
  "vim.easymotion": false,
  "vim.showcmd": false,
  "vim.showMarksInGutter": false,
  "vim.statusBarColorControl": false,
  "vim.substituteGlobalFlag": true,
  "vim.timeout": 300,
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.visual": "block",
  "vim.cursorStylePerMode.visualline": "line",
  "vim.cursorStylePerMode.visualblock": "block",
  "vim.cursorStylePerMode.replace": "underline",
  "vim.searchHighlightColor": "rgba(107, 86, 55, 0.6)",
  "vim.insertModeKeyBindingsNonRecursive": [
    { "before": ["u", "u"], "after": ["<Esc>"] },
    { "before": ["<C-v>"], "commands": ["editor.action.clipboardPasteAction"] }
  ],
  "vim.handleKeys": {
    "<C-h>": false,
    "<C-j>": false,
    "<C-k>": false,
    "<C-l>": false
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["<C-c>"], "after": ["y"] },
    { "before": ["<C-v>"], "after": ["p"] },
    { "before": ["<C-x>"], "after": ["d"] },
    { "before": ["ñ"], "after": ["o", "<Esc>"] },
    { "before": ["<leader>", "w"], "commands": ["workbench.action.files.save"] },
    { "before": ["<leader>", "s"], "commands": ["workbench.action.files.save"] },
    { "before": ["<leader>", "e"], "commands": ["workbench.action.toggleSidebarVisibility"] },
    { "before": ["<leader>", "f", "f"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "f", "t"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "p"], "commands": ["workbench.action.openRecent"] },
    { "before": ["<leader>", "b", "d"], "commands": ["workbench.action.closeActiveEditor"] },
    { "before": ["<leader>", "l", "o"], "commands": ["extension.liveServer.goOnline"] },
    { "before": ["<leader>", "l", "x"], "commands": ["extension.liveServer.goOffline"] },
    { "before": ["<leader>", "l", "p"], "commands": ["livePreview.start.preview.atFile"] },
    { "before": ["<leader>", "l", "b"], "commands": ["livePreview.start.externalPreview.atFile"] },
    { "before": ["<leader>", "u", "a"], "commands": ["workbench.action.files.toggleAutoSave"] },
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["H"], "commands": ["workbench.action.previousEditor"] },
    { "before": ["L"], "commands": ["workbench.action.nextEditor"] }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["<C-c>"], "after": ["y"] },
    { "before": ["<C-v>"], "after": ["p"] },
    { "before": ["<C-x>"], "after": ["d"] }
  ],

  // ── Live Server (preview web, recarga en navegador) ────────────
  "liveServer.settings.port": 8455,
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.CustomBrowser": "default",
  "liveServer.settings.NoBrowser": false,

  // ── Live Preview (preview DENTRO del editor, de Microsoft) ─────
  "livePreview.portNumber": 8456,
  "livePreview.openPreviewTarget": "Embedded Preview",
  "livePreview.autoRefreshPreview": "On All Changes in Editor",
  "livePreview.showServerStatusNotifications": false,
  "livePreview.defaultPreviewPath": "/index.html",
  "simpleBrowser.focusLockIndicator.enabled": false,
  "chat.viewSessions.orientation": "stacked"
}
