// Atajos nativos de VS Code. Los keymaps VIM viven en settings.json
// (vim.normalModeKeyBindingsNonRecursive) para que solo actúen en modo normal.
[
  // Navegación entre paneles/splits con Ctrl + hjkl (modo normal vim)
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusLeftGroup",
    "when": "vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.focusBelowGroup",
    "when": "vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusAboveGroup",
    "when": "vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusRightGroup",
    "when": "vim.mode == 'Normal'"
  },
  // Navegación de paneles también fuera de vim (terminal, etc.)
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusLeftGroup",
    "when": "!vim.active"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusRightGroup",
    "when": "!vim.active"
  },

  // Redimensionar splits (equivalente a C-w < y C-w > de nvim)
  {
    "key": "ctrl+shift+h",
    "command": "workbench.action.decreaseViewWidth",
    "when": "!editorTextFocus"
  },
  {
    "key": "ctrl+shift+l",
    "command": "workbench.action.increaseViewWidth",
    "when": "!editorTextFocus"
  },

  // Cerrar editor activo rápido
  {
    "key": "ctrl+w",
    "command": "workbench.action.closeActiveEditor",
    "when": "vim.mode == 'Normal'"
  }
]
