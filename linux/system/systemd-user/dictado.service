[Unit]
Description=Dictado STT local (faster-whisper; servidor de /usr/bin/dictado)
Documentation=file://%h/dotfiles/linux/dictado/servidor.py
After=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/dictado-servidor
Restart=always
RestartSec=3
# El modelo se carga en el primer dictado (no en reposo): sin VRAM tomada
# hasta que se usa. La primera transcripción tras arrancar tarda unos segundos.
Nice=-5

[Install]
WantedBy=default.target
