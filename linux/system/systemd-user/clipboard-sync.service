[Unit]
Description=Portapapeles compartido con el otro equipo (clipboard-sync)
Documentation=file://%h/dotfiles/linux/bin/clipboard-sync
After=graphical-session.target network-online.target
Wants=network-online.target
# A diferencia de lan-mouse NO lleva PartOf: el target de sesión se reinicia
# entero cada pocos minutos en el desktop y se llevaba el demonio puesto (30 s
# sin vigilancia). Acá el propio bucle relanza `wl-paste --watch` si el
# compositor cambia, así que sobrevivir al ciclo es mejor que reiniciar.

[Service]
Type=simple
ExecStart=%h/.local/bin/clipboard-sync watch
Restart=always
RestartSec=5
# El demonio sabe buscar el socket si falta, pero arrancar con el entorno de la
# sesión evita el primer ciclo de reintentos.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=WAYLAND_DISPLAY=wayland-1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

[Install]
WantedBy=graphical-session.target
