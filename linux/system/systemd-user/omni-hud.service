[Unit]
Description=Omni: superficie en pantalla (escuchando / pensando / respondiendo)
After=graphical-session.target omarchy-shell.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/quickshell --no-duplicate -p %h/dotfiles/linux/config/omni/omni-hud.qml
Restart=on-failure
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=graphical-session.target
