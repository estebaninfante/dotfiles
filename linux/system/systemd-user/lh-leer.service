[Unit]
Description=RETIRADO — lee en voz alta las respuestas del tutor de LearnHarness (la app ya lo hace sola)
Documentation=https://github.com/amosblomqvist/learnharness
After=graphical-session.target voice-daemon.service
Wants=voice-daemon.service
PartOf=graphical-session.target

# RETIRADO el 2026-11-18: LearnHarness tiene lector propio (lee desde el DOM
# mientras escribe, resalta el bloque, controles de pausa/velocidad/salto y dice
# las fórmulas en palabras). Este puente leía el chat recién al cerrar el turno,
# sin resaltado ni menú, y con el LaTeX en crudo. No habilitar de nuevo; queda
# el archivo solo como registro histórico.

[Service]
Type=simple
ExecStart=%h/.local/bin/lh-leer
Restart=on-failure
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XDG_SESSION_TYPE=wayland
# La app no expone API para esto: se lee el chat que guarda en disco al cerrar
# cada turno (el puente y sus reglas están en linux/bin/lh-leer).
Nice=10

[Install]
WantedBy=graphical-session.target
