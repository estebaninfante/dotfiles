[Unit]
Description=DeepSeek Harness Web UI (dsh web)
Documentation=https://deepseek-harness.github.io/deepseek-harness/
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# dsh se instala con npm bajo mise: el login shell arma el PATH.
# El log se trunca en cada arranque porque lleva la URL con token del proceso,
# y dsh-web la relee para abrir la UI (ver ~/.local/bin/dsh-web).
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/dsh-web
ExecStartPre=/usr/bin/truncate -s 0 %h/.local/state/dsh-web/server.log
ExecStart=/usr/bin/bash -lc 'exec dsh web --no-open'
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.local/state/dsh-web/server.log
StandardError=append:%h/.local/state/dsh-web/server.log

[Install]
WantedBy=default.target
