[Unit]
Description=DeepSeek Harness Web UI (dsh web)
Documentation=https://deepseek-harness.github.io/deepseek-harness/
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# El wrapper --serve arma el PATH de dsh (npm bajo mise), escribe la URL con
# token en $XDG_STATE_HOME/dsh-web/server.log y replica la salida al journal.
# El token es por proceso: dsh-web la relee para abrir la UI.
ExecStart=%h/.local/bin/dsh-web --serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
