[Unit]
Description=LAN-Mouse KVM daemon
After=graphical-session.target network-online.target
Wants=network-online.target
# El daemon se queda con las conexiones Wayland viejas si Hyprland reinicia
# (log: "input capture exited ... Broken pipe", "emulation ... Broken pipe" y
# queda con emulación deshabilitada para siempre, aunque el proceso siga vivo).
# Con la sesión como PartOf, cada reinicio del compositor lo levanta de cero.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'sleep 5'
ExecStartPre=/home/eztvn/.local/bin/lan-mouse-wait-keymap
ExecStart=/usr/bin/lan-mouse --capture-backend layer-shell daemon
Restart=on-failure
RestartSec=120
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=graphical-session.target
