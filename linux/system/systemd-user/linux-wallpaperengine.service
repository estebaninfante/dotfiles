[Unit]
Description=Linux Wallpaper Engine (animated wallpaper)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/pkill -x hyprpaper
ExecStart=%h/.local/bin/wallpaper-daemon.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
