[Unit]
Description=Overlay del dictado (subtítulos en vivo al pie)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/quickshell --no-duplicate -p %h/dotfiles/linux/config/quickshell/dictado-overlay.qml
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XDG_CURRENT_DESKTOP=Hyprland
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
