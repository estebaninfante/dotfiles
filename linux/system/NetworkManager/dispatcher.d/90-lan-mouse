#!/bin/sh
# NetworkManager dispatcher para LAN-Mouse KVM.
# - Mantiene la IP KVM flotante (laptop .240 / desktop .241) SOLO en la
#   interfaz preferida: el ethernet de casa si esta conectado, si no el WiFi
#   de casa. Asi lan-mouse va por el cable cuando hay cable, sin depender del
#   nombre del device (el dock USB ethernet se re-enumera como
#   enp5s0f3u1 / enp5s0f3u2).
# - Instala la ruta simetrica `PEER_IP/32 dev IFACE src KVM_IP`: las respuestas
#   al peer salen con la IP KVM (aunque sea secundaria) y por la misma
#   interfaz, evitando el routing asimetrico que rompe el handshake DTLS.
# - Delega esa logica en kvm-ensure.sh (fuente unica; la comparte el timer
#   systemd kvm-ensure.timer como red de seguridad).
# - NO baja el WiFi cuando hay ethernet: se dejan las dos interfaces arriba
#   (redundancia si el dock se reenumera; el cable queda dedicado al KVM).
# - Detecta conflicto de la IP estatica LAN y avisa por ntfy.
#
# IPs estaticas (fuera del pool DHCP): laptop 192.168.1.240, desktop 192.168.1.241.

IFACE="$1"
ACTION="$2"

# kvm-ensure.sh instalado en /etc/NetworkManager; fallback a la copia del repo
# (tests manuales).
ENSURE="/etc/NetworkManager/kvm-ensure.sh"
[ -r "$ENSURE" ] || ENSURE="$(cd "$(dirname "$0")/.." && pwd)/kvm-ensure.sh"
# shellcheck source=/dev/null
. "$ENSURE"

NTFY_TOPIC=""
case "$(hostname)" in
    laptop) NTFY_TOPIC="opencode-laptop" ;;
    desktop) NTFY_TOPIC="opencode-desktop" ;;
    *) exit 0 ;;
esac

is_home_network() {
    local conn
    conn=$(nmcli -t -f NAME,DEVICE connection show --active \
        | awk -F: -v d="$IFACE" '$2 == d {print $1}')
    for home in "${HOME_SSIDS[@]}"; do
        if [ "$conn" = "$home" ]; then
            return 0
        fi
    done
    return 1
}

is_ethernet() {
    [ "$(nmcli -g GENERAL.TYPE device show "$IFACE" 2>/dev/null)" = "ethernet" ]
}

notify_ntfy() {
    curl -sf -m 10 -H "Title: $1" -H "Priority: high" \
        --data-binary "$2" "https://ntfy.sh/$NTFY_TOPIC" >/dev/null 2>&1 &
}

check_ip_conflict() {
    sleep 8

    # La interfaz puede ya no existir (ej. cable desconectado)
    [ -d "/sys/class/net/$IFACE" ] || return

    # IP configurada? Si no, probablemente hay conflicto (NM la rechaza).
    if ! ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q "$LAN_IP/"; then
        notify_ntfy "Red: IP no configurada en $(hostname)" \
            "$LAN_IP no se pudo configurar en $IFACE tras conectar. Probable conflicto de IP."
        return
    fi

    # Alguien más responde por nuestra IP?
    local my_mac other_mac
    my_mac=$(cat "/sys/class/net/$IFACE/address")
    other_mac=$(arping -c 2 -W 1 -I "$IFACE" "$LAN_IP" 2>/dev/null \
        | grep -oiP 'reply from \K[0-9a-f:]+' \
        | grep -v "^$my_mac$" | sort -u | head -1)
    if [ -n "$other_mac" ]; then
        notify_ntfy "Conflicto de IP en $(hostname)" \
            "Otro equipo ($other_mac) responde por $LAN_IP. lan-mouse/syncthing pueden fallar."
    fi
}

# ¿El evento toca una red/interfaz de casa (ethernet o WiFi de casa)?
# Sirve para reiniciar lan-mouse en transiciones que no movieron la IP KVM
# (p.ej. reconexion del WiFi) y para ignorar eventos ajenos (tethering, tun).
is_home_context() {
    is_ethernet || is_home_network || [ "$IFACE" = "$WIFI_IF" ]
}

case "$ACTION" in
    up|down|dhcp4-change)
        ensure_kvm
        # ensure_kvm: 0 = sin cambios, 1 = movio IP/ruta (conviene reconectar).
        if [ "$?" -eq 1 ] || is_home_context; then
            restart_lan_mouse
        fi
        if [ "$ACTION" = "up" ]; then
            check_ip_conflict &
        fi
        ;;
esac

exit 0
