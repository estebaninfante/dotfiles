+    applyEffectiveKeyboardMode();
+
+    const std::string LABEL =
+        g_keyboardLock == EKeyboardLock::Auto       ? "auto" :
+        g_keyboardLock == EKeyboardLock::ForceSpace ? "space" : "window";
+
+    notify(
+        "[hypr3d] keyboard: " + LABEL,
+        CHyprColor{0.2f, 0.8f, 0.4f, 1.0f}
+    );
+}
+
+static void toggleSpaceWindow() {
+    g_keyboardLock =
+        g_keyboardMode == EKeyboardMode::Space ?
+            EKeyboardLock::ForceWindow :
+            EKeyboardLock::ForceSpace;
+
+    applyEffectiveKeyboardMode();
+
+    notify(
+        g_keyboardMode == EKeyboardMode::Space ?
+            "[hypr3d] keyboard: space" :
+            "[hypr3d] keyboard: window",
+        CHyprColor{0.2f, 0.8f, 0.4f, 1.0f}
+    );
+}
