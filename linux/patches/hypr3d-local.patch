+++ w/tests/test_logic.cpp
@@ -0,0 +1,173 @@
+#include "Input/AimFocus.hpp"
+#include "Input/LauncherDelegate.hpp"
+#include "Input/MovementKeys.hpp"
+
+#include <xkbcommon/xkbcommon.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace {
+
+int g_failures = 0;
+
+void expect(bool condition, const char* label) {
+    if (condition)
+        return;
+
+    std::fprintf(stderr, "FAIL: %s\n", label);
+    ++g_failures;
+}
+
+void expectAxis(xkb_keysym_t sym, H3D::MovementKeys::Axis expected,
+                const char* label) {
+    expect(H3D::MovementKeys::axisFor(sym) == expected, label);
+}
+
+void testMovementKeys() {
+    expectAxis(XKB_KEY_o, H3D::MovementKeys::Axis::Left, "o -> left");
+    expectAxis(XKB_KEY_u, H3D::MovementKeys::Axis::Right, "u -> right");
+    expectAxis(XKB_KEY_ntilde, H3D::MovementKeys::Axis::Forward,
+               "ntilde -> forward");
+    expectAxis(XKB_KEY_e, H3D::MovementKeys::Axis::Back, "e -> back");
+    expectAxis(XKB_KEY_w, H3D::MovementKeys::Axis::Forward, "w -> forward");
+    expectAxis(XKB_KEY_s, H3D::MovementKeys::Axis::Back, "s -> back");
+    expectAxis(XKB_KEY_a, H3D::MovementKeys::Axis::Left, "a -> left");
+    expectAxis(XKB_KEY_d, H3D::MovementKeys::Axis::Right, "d -> right");
+    expectAxis(XKB_KEY_space, H3D::MovementKeys::Axis::Up, "space -> up");
+    expectAxis(XKB_KEY_Shift_L, H3D::MovementKeys::Axis::Down, "lshift -> down");
+    expectAxis(XKB_KEY_Shift_R, H3D::MovementKeys::Axis::Down, "rshift -> down");
+    expectAxis(XKB_KEY_Control_L, H3D::MovementKeys::Axis::Sprint,
+               "lctrl -> sprint");
+    expectAxis(XKB_KEY_Control_R, H3D::MovementKeys::Axis::Sprint,
+               "rctrl -> sprint");
+    expectAxis(XKB_KEY_p, H3D::MovementKeys::Axis::None, "p -> none");
+    expectAxis(XKB_KEY_f, H3D::MovementKeys::Axis::None, "f -> none");
+
+    expect(H3D::MovementKeys::isConsumed(XKB_KEY_o), "o consumed");
+    expect(H3D::MovementKeys::isConsumed(XKB_KEY_Super_L), "lsuper consumed");
+    expect(H3D::MovementKeys::isConsumed(XKB_KEY_Super_R), "rsuper consumed");
+    expect(!H3D::MovementKeys::isConsumed(XKB_KEY_p), "p not consumed");
+    expect(!H3D::MovementKeys::isConsumed(XKB_KEY_f), "f not consumed");
+}
+
+void testAimFocusDwell() {
+    H3D::AimFocus aim;
+
+    expect(aim.update(5, 0.1f, true) == 0, "no focus before dwell");
+    expect(aim.update(5, 0.3f, true) == 5, "focus after dwell");
+    expect(aim.current() == 5, "current is 5");
+}
+
+void testAimFocusStillRequired() {
+    H3D::AimFocus aim;
+
+    expect(aim.update(5, 5.0f, false) == 0, "moving never acquires");
+    expect(aim.current() == 0, "no focus while moving");
+}
+
+void testAimFocusLostGrace() {
+    H3D::AimFocus aim;
+
+    aim.update(5, 0.4f, true);
+    expect(aim.current() == 5, "focused 5");
+
+    expect(aim.update(0, 0.05f, true) == 5, "grace keeps focus");
+    expect(aim.update(0, 0.05f, true) == 0, "grace expires");
+}
+
+void testAimFocusCandidateReset() {
+    H3D::AimFocus aim;
+
+    expect(aim.update(5, 0.3f, true) == 0, "candidate 5 not yet");
+    expect(aim.update(6, 0.3f, true) == 0, "switch resets dwell");
+    expect(aim.update(6, 0.3f, true) == 6, "candidate 6 adopted");
+}
+
+void testAimFocusRelease() {
+    H3D::AimFocus aim;
+
+    aim.update(5, 0.4f, true);
+    aim.release();
+    expect(aim.current() == 0, "release drops focus");
+}
+
+void testAimFocusInstant() {
+    H3D::AimFocus aim;
+
+    expect(aim.update(7, 0.016f, false, true) == 7,
+           "instant acquires without dwell or stillness");
+    expect(aim.current() == 7, "instant current is 7");
+
+    H3D::AimFocus idle;
+    expect(idle.update(0, 0.016f, false, true) == 0,
+           "instant never invents focus on empty aim");
+}
+
+void expectAction(bool pressed, bool super, bool focused, bool delegated,
+                  H3D::LauncherDelegate::EAction expected, const char* label) {
+    expect(H3D::LauncherDelegate::actionFor(
+               pressed, super, focused, delegated) == expected,
+           label);
+}
+
+void testLauncherDelegate() {
+    using H3D::LauncherDelegate::EAction;
+
+    expectAction(true, true, false, false, EAction::Delegate,
+                 "press super no-focus not-delegated delegates");
+    expectAction(true, true, false, true, EAction::Delegate,
+                 "press super no-focus delegated keeps delegating");
+    expectAction(true, true, true, false, EAction::Handle,
+                 "press super focused not-delegated handled");
+    expectAction(true, true, true, true, EAction::Handle,
+                 "press super focused delegated handled");
+    expectAction(true, false, false, false, EAction::Handle,
+                 "press no-super no-focus not-delegated handled");
+    expectAction(true, false, false, true, EAction::Handle,
+                 "press no-super no-focus delegated handled");
+    expectAction(true, false, true, false, EAction::Handle,
+                 "press no-super focused not-delegated handled");
+    expectAction(true, false, true, true, EAction::Handle,
+                 "press no-super focused delegated handled");
+
+    expectAction(false, true, false, true, EAction::FinishDelegation,
+                 "release super no-focus delegated finishes");
+    expectAction(false, true, true, true, EAction::FinishDelegation,
+                 "release super focused delegated finishes");
+    expectAction(false, false, false, true, EAction::FinishDelegation,
+                 "release no-super no-focus delegated finishes");
+    expectAction(false, false, true, true, EAction::FinishDelegation,
+                 "release no-super focused delegated finishes");
+    expectAction(false, true, false, false, EAction::Handle,
+                 "release super no-focus not-delegated handled");
+    expectAction(false, true, true, false, EAction::Handle,
+                 "release super focused not-delegated handled");
+    expectAction(false, false, false, false, EAction::Handle,
+                 "release no-super no-focus not-delegated handled");
+    expectAction(false, false, true, false, EAction::Handle,
+                 "release no-super focused not-delegated handled");
+}
+
+}
+
+int main() {
+    testMovementKeys();
+    testAimFocusDwell();
+    testAimFocusStillRequired();
+    testAimFocusLostGrace();
+    testAimFocusCandidateReset();
+    testAimFocusRelease();
+    testAimFocusInstant();
+    testLauncherDelegate();
+
+    if (g_failures != 0) {
+        std::fprintf(stderr, "%d check(s) failed\n", g_failures);
+        return EXIT_FAILURE;
+    }
+
+    std::printf("all hypr3d logic checks passed\n");
+    return EXIT_SUCCESS;
+}
