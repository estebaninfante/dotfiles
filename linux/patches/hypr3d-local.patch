diff --git c/src/Input/LauncherDelegate.hpp w/src/Input/LauncherDelegate.hpp
new file mode 100644
index 0000000..db82ced
--- /dev/null
+++ w/src/Input/LauncherDelegate.hpp
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <cstdint>
+
+namespace H3D::LauncherDelegate {
+
+enum class EAction : std::uint8_t {
+    Handle,
+    Delegate,
+    FinishDelegation,
+};
+
+constexpr EAction actionFor(
+    bool pressed,
+    bool superHeld,
+    bool windowFocused,
+    bool delegated
+) {
+    if (pressed)
+        return superHeld && !windowFocused ? EAction::Delegate : EAction::Handle;
+
+    return delegated ? EAction::FinishDelegation : EAction::Handle;
+}
+
+}
diff --git c/src/Input/MovementKeys.hpp w/src/Input/MovementKeys.hpp
new file mode 100644
index 0000000..9f15bcf
--- /dev/null
+++ w/src/Input/MovementKeys.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <xkbcommon/xkbcommon.h>
+
+#include <cstdint>
+
+namespace H3D::MovementKeys {
+
+enum class Axis : std::uint8_t {
+    None,
+    Forward,
+    Back,
+    Left,
+    Right,
+    Up,
+    Down,
+    Sprint,
+};
+
+constexpr Axis axisFor(xkb_keysym_t sym) {
+    switch (sym) {
+        case XKB_KEY_ntilde:
+        case XKB_KEY_w: return Axis::Forward;
+        case XKB_KEY_e:
+        case XKB_KEY_s: return Axis::Back;
+        case XKB_KEY_o:
+        case XKB_KEY_a: return Axis::Left;
+        case XKB_KEY_u:
+        case XKB_KEY_d: return Axis::Right;
+        case XKB_KEY_space: return Axis::Up;
+        case XKB_KEY_Shift_L:
+        case XKB_KEY_Shift_R: return Axis::Down;
+        case XKB_KEY_Control_L:
+        case XKB_KEY_Control_R: return Axis::Sprint;
+        default: return Axis::None;
+    }
+}
+
+constexpr bool isConsumed(xkb_keysym_t sym) {
+    return axisFor(sym) != Axis::None ||
+        sym == XKB_KEY_Super_L ||
+        sym == XKB_KEY_Super_R;
+}
+
+}
