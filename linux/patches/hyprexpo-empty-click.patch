+// Primer hueco libre del set de espacios de este monitor. El set lo declara la
+// config del plugin: `workspace_method "<salida> first N"` da el ancla
+// (gridStartID) y `columns x rows` cuantos slots tiene (9: 1..9 en la interna,
+// 28..36 en la externa). Se busca DENTRO del set y no "el proximo id libre de
+// Hyprland" a proposito: el 10 es el espacio de leia y 11..20 los del asiento,
+// IDs que este clic no tiene por que ocupar.
+WORKSPACEID COverview::firstFreeSlotID() const {
+    if (gridStartID == WORKSPACE_INVALID || gridSlots <= 0)
+        return WORKSPACE_INVALID;
+
+    const auto workspaces = State::workspaceState()->workspacesCopy();
+    for (int offset = 0; offset < gridSlots; ++offset) {
+        const WORKSPACEID id = gridStartID + offset;
+
+        // Ocupado = existe y tiene ventanas. Un espacio vacio del set tambien
+        // sirve: no se ve en la grilla dinamica, asi que para el usuario es
+        // igual de nuevo, y evita crear IDs sueltos cada vez que se hace clic.
+        bool tieneVentanas = false;
+        for (const auto& ws : workspaces) {
+            if (!ws || ws->m_id != id)
+                continue;
+            tieneVentanas = ws->getWindowCount() > 0;
+            break;
+        }
+        if (!tieneVentanas)
+            return id;
+    }
+
+    return WORKSPACE_INVALID;
+}
+
+// Clic en el fondo de la grilla (area en blanco, ningun tile debajo del
+// puntero): cerrar el overview y entrar a un espacio NUEVO de este monitor.
+// Sin tile destino no hay morph al que apuntar, asi que el espacio se cambia
+// primero y el cierre va detras: un solo gesto, sin zoom a un tile inexistente.
+void COverview::closeSelectingNewWorkspace() {
+    const auto MON = pMonitor.lock();
+    if (!MON || closing)
+        return;
+
+    const WORKSPACEID NEWID = firstFreeSlotID();
+    if (NEWID == WORKSPACE_INVALID) {
+        // Set lleno: no hay donde abrir uno nuevo, se cierra como antes.
+        close(false);
+        return;
+    }
+
+    PHLWORKSPACE NEWWS = State::workspaceState()->query().id(NEWID).run();
+    if (!NEWWS)
+        NEWWS = State::workspaceState()->create(NEWID, MON->m_id, std::to_string(NEWID), false);
+
+    const auto CHANGE = Config::Actions::changeWorkspace(NEWWS);
+    if (!CHANGE)
+        Log::logger->log(Log::ERR, "[hyprexpo] empty click: failed to change workspace: {}", CHANGE.error().message);
+
+    close(false);
+}
