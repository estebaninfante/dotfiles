+using namespace Hyprutils::Math;
+
+namespace Hyprexpo3D {
+
+    static GLuint g_prog    = 0;
+    static GLuint g_vao     = 0;
+    static GLuint g_vbo     = 0;
+    static GLint  g_uH3     = -1;
+    static GLint  g_uTex    = -1;
+    static GLint  g_uAlpha  = -1;
+    static GLint  g_uRadius = -1;
+    static GLint  g_uRPow   = -1;
+    static GLint  g_uFlipV  = -1;
+    static GLint  g_uMode   = -1;
+    static GLint  g_uColor  = -1;
+    static GLint  g_uThick  = -1;
+    static GLint  g_uFisheye = -1;
+    static GLint  g_uFishPow = -1;
+    static GLint  g_uAspect  = -1;
+    static GLint  g_uGlow    = -1;
+    static GLint  g_uGlowUV  = -1;
+    static GLint  g_uFogNear = -1;
+    static GLint  g_uFogFar  = -1;
+    static GLint  g_uFogStr  = -1;
+    static GLint  g_uScreen  = -1;
+    static GLint  g_uVignette = -1;
+    static int    g_vertCount = 0;
+    static bool   g_ok      = false;
+    static bool   g_inited  = false;
+
+    // Per-frame lens state, applied uniformly to every warped quad (tiles,
+    // borders, fills). k = 0 disables the distortion entirely.
+    static float g_fisheye = 0.f;
+    static float g_fishPow = 2.f;
+    static float g_aspectX = 1.f;
+
+    // Per-frame depth fog (camera-space depth range near..far, strength 0..1).
+    static float g_fogNear = 0.f;
+    static float g_fogFar  = 0.f;
+    static float g_fogStr  = 0.f;
+
+    // Per-frame screen-space vignette (strength 0..1) and the monitor size it
+    // is measured against.
+    static float g_vignette = 0.f;
+    static float g_screenX  = 1.f;
+    static float g_screenY  = 1.f;
+
+    static const char* VERT_SRC = R"#(#version 300 es
+precision highp float;
+uniform mat3  uH3;
+uniform float uFisheye;   // barrel strength (0 = off)
+uniform float uFishPow;   // radial falloff exponent
+uniform float uAspect;    // width/height, keeps the lens circular
+in vec2 pos;
+in vec2 texcoord;
+out vec2 v_texcoord;
+out float v_depth;
+void main() {
+    vec3 q = uH3 * vec3(pos, 1.0);
+    vec2 ndc = q.xy / q.z;
+    // Radial lens distortion in screen space: bends the grid toward/away from
+    // the centre like a fisheye, leaving the (separately drawn) background flat.
+    // A real fisheye COMPRESSES the periphery (pulls it inward) instead of
+    // magnifying it. The old +k*r^2 form expanded the edges, so the grid
+    // overflowed the frame at rest. Normalise by the corner radius and subtract
+    // so f is bound to [1-k, 1] (never >1), keeping the grid inside the frame
+    // while still curving it like a lens.
+    float r    = length(vec2(ndc.x * uAspect, ndc.y));
+    float rMax = length(vec2(uAspect, 1.0));
+    float rn   = r / max(rMax, 0.0001);
+    float f    = 1.0 - uFisheye * pow(clamp(rn, 0.0, 1.0), uFishPow);
+    ndc *= clamp(f, 0.2, 1.0);
+    gl_Position = vec4(ndc * q.z, 0.0, q.z);
+    v_texcoord = texcoord;
+    // Homogeneous camera depth (the vertex shader's w): used by the fragment
+    // stage for depth fog. Native Hyprland quads can't do this (they force w=1).
+    v_depth = q.z;
+}
+)#";
+
+    static const char* FRAG_SRC = R"#(#version 300 es
+precision highp float;
+uniform sampler2D uTex;
+uniform float uAlpha;
+uniform float uRadius;
+uniform float uRPow;
+uniform float uFlipV;
+uniform int   uMode;   // 0 = texture, 1 = border ring, 2 = solid fill
+uniform vec4  uColor;  // rgba for border/solid
+uniform float uThick;  // border thickness in unit-square fractions
+uniform float uGlow;   // outer neon bloom strength (0 = off)
+uniform float uGlowUV; // bloom falloff width in unit-square fractions
+uniform float uFogNear;   // camera-space depth where fog starts
+uniform float uFogFar;    // camera-space depth where fog is full
+uniform float uFogStrength; // 0 = no fog
+uniform vec2  uScreen;      // monitor size in px (for the screen-space vignette)
+uniform float uVignette;    // 0 = off; darkens the screen corners
+in vec2 v_texcoord;
+in float v_depth;
+out vec4 fragColor;
+void main() {
+    vec2 uv = v_texcoord;
+
+    float fogMul = 1.0;
+    if (uFogStrength > 0.0) {
+        float fog = clamp((v_depth - uFogNear) / max(1.0, uFogFar - uFogNear), 0.0, 1.0) * uFogStrength;
+        fogMul = 1.0 - fog;
+    }
+    // Screen-space vignette: a pure function of gl_FragCoord, so every quad
+    // (tiles, borders, backdrop) darkens by the same amount and the corners meet
+    // seamlessly. Focuses the eye and adds a lens-like depth falloff.
+    if (uVignette > 0.0) {
+        vec2  vc = gl_FragCoord.xy / max(uScreen, vec2(1.0));
+        vec2  vd = vc * 2.0 - 1.0;
+        float vr = length(vd) * 0.70710678;
+        fogMul *= 1.0 - uVignette * smoothstep(0.25, 1.0, vr);
+    }
+
+    if (uMode == 1) {
+        // Border ring: keep only a band near the quad's UV edges. Warps with
+        // the tile so the outline follows the perspective correctly. A glow
+        // spreads an additive bloom outward from the ring.
+        vec2  e    = min(uv, vec2(1.0) - uv);
+        float edge = min(e.x, e.y);
+        if (edge > uThick + uGlowUV)
+            discard;
+        float ring = 1.0 - smoothstep(uThick * 0.55, uThick, edge);
+        float halo = 1.0 - smoothstep(uThick, uThick + max(uGlowUV, 0.0001), edge);
+        float a    = uColor.a * uAlpha * ring;
+        float g    = uColor.a * uAlpha * halo * uGlow;
+        vec3  rgb  = uColor.rgb * (a + g * 1.6);
+        fragColor  = vec4(rgb * fogMul, a + g);
+        return;
+    }
+
+    if (uMode == 2) {
+        vec4 c = uColor;
+        if (uRadius > 0.0) {
+            vec2  r = vec2(uRadius);
+            vec2  q = abs(uv - vec2(0.5)) - (vec2(0.5) - r);
+            float d = length(max(q, vec2(0.0))) - r.x;
+            c.a *= 1.0 - smoothstep(0.0, max(fwidth(d), 0.0001), d);
+        }
+        c.a *= uAlpha;
+        c.rgb *= c.a;
+        c.rgb *= fogMul;
+        fragColor = c;
+        return;
+    }
+
+    if (uFlipV > 0.5)
+        uv.y = 1.0 - uv.y;
+    vec4 c = texture(uTex, uv);
+    float cov = 1.0;
+    if (uRadius > 0.0) {
+        vec2  r = vec2(uRadius);
+        vec2  q = abs(uv - vec2(0.5)) - (vec2(0.5) - r);
+        float d = length(max(q, vec2(0.0))) - r.x;
+        cov = 1.0 - smoothstep(0.0, max(fwidth(d), 0.0001), d);
+    }
+    // Outer neon bloom: a soft halo living just outside the rounded tile. Layered
+    // under the tile so it reads as light spilling around a glass surface.
+    float glow = 0.0;
+    if (uGlow > 0.0 && uGlowUV > 0.0) {
+        vec2  r2 = vec2(uRadius + uGlowUV);
+        vec2  q2 = abs(uv - vec2(0.5)) - (vec2(0.5) - r2);
+        float d2 = length(max(q2, vec2(0.0))) - r2.x;
+        glow = (1.0 - smoothstep(0.0, uGlowUV, d2)) * uGlow;
+    }
+    vec3 lit = c.rgb * c.a + c.rgb * glow * 1.5;
+    float outA = clamp(c.a * cov * uAlpha + glow * 0.85, 0.0, 1.0);
+    fragColor  = vec4(lit * uAlpha * fogMul, outA);
+}
+)#";
+
+    static GLuint compile(GLenum type, const char* src) {
+        GLuint s = glCreateShader(type);
+        glShaderSource(s, 1, &src, nullptr);
+        glCompileShader(s);
+        GLint ok = 0;
+        glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+        if (!ok) {
+            char log[2048] = {0};
+            glGetShaderInfoLog(s, sizeof(log) - 1, nullptr, log);
+            Log::logger->log(Log::ERR, "[hyprexpo:3d] shader compile failed: {}", log);
+            glDeleteShader(s);
+            return 0;
+        }
+        return s;
+    }
+
+    bool ensureInit() {
+        if (g_inited)
+            return g_ok;
+        g_inited = true;
+
+        GLuint vs = compile(GL_VERTEX_SHADER, VERT_SRC);
+        GLuint fs = compile(GL_FRAGMENT_SHADER, FRAG_SRC);
+        if (!vs || !fs) {
+            g_ok = false;
+            return false;
+        }
+
+        GLuint prog = glCreateProgram();
+        glAttachShader(prog, vs);
+        glAttachShader(prog, fs);
+        glBindAttribLocation(prog, 0, "pos");
+        glBindAttribLocation(prog, 1, "texcoord");
+        glLinkProgram(prog);
+        glDeleteShader(vs);
+        glDeleteShader(fs);
+
+        GLint linked = 0;
+        glGetProgramiv(prog, GL_LINK_STATUS, &linked);
+        if (!linked) {
+            char log[2048] = {0};
+            glGetProgramInfoLog(prog, sizeof(log) - 1, nullptr, log);
+            Log::logger->log(Log::ERR, "[hyprexpo:3d] program link failed: {}", log);
+            glDeleteProgram(prog);
+            g_ok = false;
+            return false;
+        }
+
+        g_prog    = prog;
+        g_uH3     = glGetUniformLocation(prog, "uH3");
+        g_uTex    = glGetUniformLocation(prog, "uTex");
+        g_uAlpha  = glGetUniformLocation(prog, "uAlpha");
+        g_uRadius = glGetUniformLocation(prog, "uRadius");
+        g_uRPow   = glGetUniformLocation(prog, "uRPow");
+        g_uFlipV  = glGetUniformLocation(prog, "uFlipV");
+        g_uMode   = glGetUniformLocation(prog, "uMode");
+        g_uColor  = glGetUniformLocation(prog, "uColor");
+        g_uThick  = glGetUniformLocation(prog, "uThick");
+        g_uFisheye = glGetUniformLocation(prog, "uFisheye");
+        g_uFishPow = glGetUniformLocation(prog, "uFishPow");
+        g_uAspect  = glGetUniformLocation(prog, "uAspect");
+        g_uGlow    = glGetUniformLocation(prog, "uGlow");
+        g_uGlowUV  = glGetUniformLocation(prog, "uGlowUV");
+        g_uFogNear = glGetUniformLocation(prog, "uFogNear");
+        g_uFogFar  = glGetUniformLocation(prog, "uFogFar");
+        g_uFogStr  = glGetUniformLocation(prog, "uFogStrength");
+        g_uScreen  = glGetUniformLocation(prog, "uScreen");
+        g_uVignette = glGetUniformLocation(prog, "uVignette");
+
+        glGenVertexArrays(1, &g_vao);
+        glGenBuffers(1, &g_vbo);
+        glBindVertexArray(g_vao);
+        glBindBuffer(GL_ARRAY_BUFFER, g_vbo);
+
+        // Subdivided unit-square mesh (N x N quads -> two triangles each). A dense
+        // mesh lets the fisheye/perspective warp curve smoothly instead of only
+        // displacing the four corners.
+        constexpr int        N = 24;
+        std::vector<float>   verts;
+        verts.reserve((size_t)N * N * 6 * 4);
+        auto put = [&](float px, float py) {
+            verts.push_back(px);
+            verts.push_back(py);
+            verts.push_back(px);
+            verts.push_back(py);
+        };
+        for (int j = 0; j < N; ++j) {
+            for (int i = 0; i < N; ++i) {
+                const float x0 = (float)i / N, x1 = (float)(i + 1) / N;
+                const float y0 = (float)j / N, y1 = (float)(j + 1) / N;
+                put(x0, y0);
+                put(x1, y0);
+                put(x0, y1);
+                put(x1, y0);
+                put(x1, y1);
+                put(x0, y1);
+            }
+        }
+        g_vertCount = (int)(verts.size() / 4);
+        glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)(verts.size() * sizeof(float)), verts.data(), GL_STATIC_DRAW);
+        glEnableVertexAttribArray(0);
+        glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void*)0);
+        glEnableVertexAttribArray(1);
+        glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void*)(2 * sizeof(float)));
+        glBindVertexArray(0);
+        glBindBuffer(GL_ARRAY_BUFFER, 0);
+
+        g_ok = true;
+        Log::logger->log(Log::WARN, "[hyprexpo:3d] perspective shader ready");
+        return true;
+    }
+
+    void teardown() {
+        if (g_vbo)
+            glDeleteBuffers(1, &g_vbo);
+        if (g_vao)
+            glDeleteVertexArrays(1, &g_vao);
+        if (g_prog)
+            glDeleteProgram(g_prog);
+        g_vbo = g_vao = g_prog = 0;
+        g_ok = g_inited = false;
+    }
+
+    static std::array<float, 9> matMul(const std::array<float, 9>& A, const std::array<float, 9>& B) {
+        std::array<float, 9> R{};
+        for (int i = 0; i < 3; ++i)
+            for (int j = 0; j < 3; ++j) {
+                float s = 0.f;
+                for (int k = 0; k < 3; ++k)
+                    s += A[i * 3 + k] * B[k * 3 + j];
+                R[i * 3 + j] = s;
+            }
+        return R;
+    }
+
+    std::array<float, 9> buildTileH3(const Vector2D& monSize, const std::array<float, 9>& proj, float bx, float by, float bw, float bh,
+                                     const SWarpParams& p) {
+        // Pivot/camera defaults: the monitor centre and a camera distance in
+        // monitor heights. A caller can override both (centerX/Y + gridHeight)
+        // so the whole animated grid keeps one stable perspective even while it
+        // is many monitors wide during the open/close zoom.
+        const bool  useGrid = p.centerX >= 0.f && p.centerY >= 0.f && p.gridHeight > 0.f;
+        const float Mx  = useGrid ? p.centerX : (float)monSize.x * 0.5f;
+        const float My  = useGrid ? p.centerY : (float)monSize.y * 0.5f;
+        const float cam = std::max(1.0f, p.distance * (float)(useGrid ? p.gridHeight : monSize.y));
+        // A soft near plane (5% of the camera distance) instead of a hard clamp
+        // at 1px: geometry that would cross the camera is pushed just in front
+        // of it, so the projection stays finite and self-similar under zoom.
+        const float nearPlane = std::max(1.0f, cam * 0.05f);
+
+        const float th = p.tiltDeg * (float)M_PI / 180.f;
+        const float ph = p.yawDeg * (float)M_PI / 180.f;
+        const float ct = std::cos(th), st = std::sin(th);
+        const float cp = std::cos(ph), sp = std::sin(ph);
+
+        // Vertical recentring: with a tilt the near half of the grid is scaled up
+        // more than the far half is scaled down (D = cam - z), so the projected
+        // bounding box drifts toward the viewer and the top/bottom margins come
+        // out asymmetric (the grid hugs one edge). Compute the projected top and
+        // bottom of the grid's centre column and shift every vertex so their
+        // midpoint lands on the pivot My again. Depends only on the tilt/camera
+        // so all tiles receive the same offset and the grid stays coherent.
+        const float halfG = (useGrid ? p.gridHeight : (float)monSize.y) * 0.5f;
+        float       Dtop  = cam - (-halfG * st);
+        float       Dbot  = cam - (halfG * st);
+        if (Dtop < nearPlane)
+            Dtop = nearPlane;
+        if (Dbot < nearPlane)
+            Dbot = nearPlane;
+        const float sTop    = -halfG * ct * (cam / Dtop);
+        const float sBot    = halfG * ct * (cam / Dbot);
+        const float vOffset = -0.5f * (sTop + sBot);
+
+        auto world = [&](float px, float py, float& X, float& Y, float& W) {
+            const float dx = px - Mx, dy = py - My;
+            const float x1 = dx, y1 = dy * ct, z1 = dy * st;
+            const float x2 = x1 * cp + z1 * sp;
+            const float y2 = y1;
+            const float z2 = -x1 * sp + z1 * cp;
+            float       D  = cam - z2;
+            if (D < nearPlane)
+                D = nearPlane;
+            const float scale = cam / D;
+            const float sx    = Mx + x2 * scale;
+            const float sy    = My + y2 * scale + vOffset;
+            X = sx * D;
+            Y = sy * D;
+            W = D;
+        };
+
+        float X0, Y0, W0, Xx, Yx, Wx, Xy, Yy, Wy;
+        world(0.f, 0.f, X0, Y0, W0);
+        world(1.f, 0.f, Xx, Yx, Wx);
+        world(0.f, 1.f, Xy, Yy, Wy);
+
+        const float dXx = Xx - X0, dXy = Xy - X0;
+        const float dYx = Yx - Y0, dYy = Yy - Y0;
+        const float dWx = Wx - W0, dWy = Wy - W0;
+
+        const std::array<float, 9> G = {
+            dXx * bw, dXy * bh, X0 + dXx * bx + dXy * by, //
+            dYx * bw, dYy * bh, Y0 + dYx * bx + dYy * by, //
+            dWx * bw, dWy * bh, W0 + dWx * bx + dWy * by, //
+        };
+
+        return matMul(proj, G);
+    }
+
+    void renderQuad(const SP<Render::ITexture>& tex, const SQuadDraw& d) {
+        if (!ensureInit())
+            return;
+
+        GLint prevProg = 0, prevVAO = 0, prevActive = 0, prevTex = 0;
+        glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+        glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVAO);
+        glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+        const GLboolean prevBlend = glIsEnabled(GL_BLEND);
+
+        glUseProgram(g_prog);
+        glUniformMatrix3fv(g_uH3, 1, GL_TRUE, d.h3.data());
+        glUniform1f(g_uAlpha, d.alpha);
+        glUniform1f(g_uRadius, d.radiusUV);
+        glUniform1f(g_uRPow, d.roundPow);
+        glUniform1f(g_uFlipV, d.flipV ? 1.f : 0.f);
+        glUniform1i(g_uMode, (int)d.mode);
+        glUniform4f(g_uColor, d.color[0], d.color[1], d.color[2], d.color[3]);
+        glUniform1f(g_uThick, d.thickUV);
+        glUniform1f(g_uFisheye, g_fisheye);
+        glUniform1f(g_uFishPow, g_fishPow);
+        glUniform1f(g_uAspect, g_aspectX);
+        glUniform1f(g_uGlow, d.glow);
+        glUniform1f(g_uGlowUV, d.glowUV);
+        glUniform1f(g_uFogNear, g_fogNear);
+        glUniform1f(g_uFogFar, g_fogFar);
+        glUniform1f(g_uFogStr, g_fogStr);
+        glUniform2f(g_uScreen, g_screenX, g_screenY);
+        glUniform1f(g_uVignette, g_vignette);
+
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, tex ? tex->m_texID : 0);
+        glUniform1i(g_uTex, 0);
+
+        glEnable(GL_BLEND);
+        glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+
+        glBindVertexArray(g_vao);
+        glDrawArrays(GL_TRIANGLES, 0, g_vertCount);
+        glBindVertexArray(prevVAO);
+        glBindBuffer(GL_ARRAY_BUFFER, 0);
+
+        glActiveTexture((GLenum)prevActive);
+        glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+        glUseProgram((GLuint)prevProg);
+        if (!prevBlend)
+            glDisable(GL_BLEND);
+    }
+
+    void setLens(float fisheye, float fishPow, float aspect) {
+        g_fisheye = fisheye;
+        g_fishPow = fishPow < 0.5f ? 0.5f : fishPow;
+        g_aspectX = aspect <= 0.f ? 1.f : aspect;
+    }
+
+    void setFog(float depthNear, float depthFar, float strength) {
+        g_fogStr = std::clamp(strength, 0.0f, 1.0f);
+        if (g_fogStr <= 0.0f) {
+            g_fogNear = g_fogFar = 0.f;
+            return;
+        }
+        if (depthFar <= depthNear)
+            depthFar = depthNear + 1.f;
+        g_fogNear = depthNear;
+        g_fogFar  = depthFar;
+    }
+
+    void setVignette(float strength, float screenW, float screenH) {
+        g_vignette = std::clamp(strength, 0.0f, 1.0f);
+        g_screenX  = screenW > 0.f ? screenW : 1.f;
+        g_screenY  = screenH > 0.f ? screenH : 1.f;
+    }
+
+    void renderWarped(const SP<Render::ITexture>& tex, const std::array<float, 9>& h3RowMajor, float alpha, float radiusUV, float roundPow, bool flipV, float glow) {        SQuadDraw d;        d.h3       = h3RowMajor;
+        d.alpha    = alpha;
+        d.radiusUV = radiusUV;
+        d.roundPow = roundPow;
+        d.flipV    = flipV;
+        d.mode     = EMode::Texture;
+        d.glow     = glow;
+        renderQuad(tex, d);
+    }
+
+    void renderBorder(const std::array<float, 9>& h3RowMajor, float r, float g, float b, float a, float thicknessUV, float glow) {
+        SQuadDraw d;
+        d.h3      = h3RowMajor;
+        d.mode    = EMode::Border;
+        d.color[0] = r;
+        d.color[1] = g;
+        d.color[2] = b;
+        d.color[3] = a;
+        d.thickUV = thicknessUV;
+        d.glow    = glow;
+        renderQuad(nullptr, d);
+    }
+
+    void renderSolid(const std::array<float, 9>& h3RowMajor, float r, float g, float b, float a, float radiusUV, float roundPow) {
+        SQuadDraw d;
+        d.h3       = h3RowMajor;
+        d.mode     = EMode::Solid;
+        d.color[0] = r;
+        d.color[1] = g;
+        d.color[2] = b;
+        d.color[3] = a;
+        d.radiusUV = radiusUV;
+        d.roundPow = roundPow;
+        renderQuad(nullptr, d);
+    }
+
+} // namespace Hyprexpo3D
