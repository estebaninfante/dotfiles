@@ -0,0 +1,133 @@
+#!/usr/bin/env bash
+# verify-3d.sh - automated visual check of the hyprexpo 3D grid.
+#
+# Launches a nested Hyprland (never the live session), opens the overview,
+# screenshots the nested window and prints a compact SUMMARY plus the PNG path.
+# The caller (a human or an agent) can then just look at the PNG.
+#
+# Env knobs:
+#   HYPREXPO_DEV_MODE   nested output mode (default 900x600@60)
+#   HYPREXPO_DEV_3D     enable 3D (default 1)
+#   HYPREXPO_DEV_3D_TILT / _YAW / _DIST / _RADIUS / _FLIPV  warp params
+#   HYPREXPO_VERIFY_OUT output dir (default /tmp/opencode/hyprexpo-3d)
+set -uo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+
+OUT="${HYPREXPO_VERIFY_OUT:-/tmp/opencode/hyprexpo-3d}"
+LOG="$OUT/nested.log"
+PNG="$OUT/overview3d.png"
+MODE="${HYPREXPO_DEV_MODE:-900x600@60}"
+RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
+# The ambient HYPRLAND_INSTANCE_SIGNATURE can be stale (e.g. inside tmux after a
+# compositor restart), which makes bare `hyprctl` fail. Resolve the LIVE host
+# instance explicitly from `hyprctl instances` and use it for all host calls.
+SIG_HOST="$(hyprctl instances 2>/dev/null | sed -n 's/^instance \(.*\):$/\1/p' | head -1)"
+[ -n "$SIG_HOST" ] || SIG_HOST="${HYPRLAND_INSTANCE_SIGNATURE:-}"
+HYPR_DIR="$RT/hypr"
+SETTLE_MS="${HYPREXPO_VERIFY_SETTLE_MS:-1400}"
+
+mkdir -p "$OUT"
+
+# Prebuild so the nested launch is fast: a cold build is ~60s, longer than the
+# IPC wait below, which would otherwise fail with no-nested-ipc.
+echo "[verify-3d] prebuilding plugin (dev target)..."
+make -C "$REPO_ROOT" dev-build >/dev/null 2>&1 || { echo "SUMMARY: FAIL build"; exit 1; }
+
+nested_pid=""
+cleanup() {
+    [ -n "$nested_pid" ] && kill "$nested_pid" >/dev/null 2>&1 || true
+    pkill -f 'hyprexpo-dev.conf' >/dev/null 2>&1 || true
+}
+trap cleanup EXIT INT TERM
+cleanup
+sleep 0.3
+
+echo "[verify-3d] launching nested (mode=$MODE, 3D=${HYPREXPO_DEV_3D:-1})"
+HYPREXPO_DEV_3D="${HYPREXPO_DEV_3D:-1}" HYPREXPO_DEV_MODE="$MODE" \
+    setsid "$REPO_ROOT/scripts/run-nested.sh" >"$LOG" 2>&1 </dev/null &
+nested_pid=$!
+
+# --- wait for the nested IPC socket (confirmed by a version query) ----------
+SIG=""
+for _ in $(seq 1 240); do
+    for d in $(ls -t "$HYPR_DIR" 2>/dev/null); do
+        [ "$d" = "$SIG_HOST" ] && continue
+        if HYPRLAND_INSTANCE_SIGNATURE="$d" hyprctl -j version >/dev/null 2>&1; then
+            SIG="$d"; break
+        fi
+    done
+    [ -n "$SIG" ] && break
+    sleep 0.25
+done
+if [ -z "$SIG" ]; then
+    echo "SUMMARY: FAIL no-nested-ipc"
+    exit 1
+fi
+nested() { HYPRLAND_INSTANCE_SIGNATURE="$SIG" hyprctl "$@"; }
+host() { HYPRLAND_INSTANCE_SIGNATURE="$SIG_HOST" hyprctl "$@"; }
+
+plugin_line="$(nested -j plugin list 2>/dev/null | jq -r '.[0] | "\(.name) \(.version) loaded=\(.error)"' 2>/dev/null)"
+plugin_count="$(nested -j plugin list 2>/dev/null | jq 'length' 2>/dev/null)"
+opt3d="$(nested getoption plugin:hyprexpo:threed_enable 2>/dev/null | tr -d '\n')"
+opttilt="$(nested getoption plugin:hyprexpo:threed_tilt 2>/dev/null | tr -d '\n')"
+
+# --- wait for the host window that renders the nested compositor ------------
+addr=""; geom=""
+for _ in $(seq 1 240); do
+    addr=$(host -j clients | jq -r '[.[] | select((.class // "") | test("aquamarine|Hyprland"; "i"))][0].address' 2>/dev/null)
+    if [ -n "$addr" ] && [ "$addr" != "null" ]; then
+        geom=$(host -j clients | jq -r --arg a "$addr" '[.[] | select(.address==$a)][0] | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"')
+        break
+    fi
+    sleep 0.25
+done
+if [ -z "$addr" ] || [ "$addr" = "null" ]; then
+    echo "SUMMARY: FAIL no-host-window host_sig=$SIG_HOST clients=$(host -j clients 2>/dev/null | jq -r '[.[].class] | join(",")' 2>/dev/null)"
+    exit 1
+fi
+
+# Float + place it on screen so the capture is fully visible (best effort).
+host dispatch togglefloating "address:$addr" >/dev/null 2>&1 || true
+host dispatch resizewindowpixel "exact 880 560,address:$addr" >/dev/null 2>&1 || true
+host dispatch movewindowpixel  "exact 20 20,address:$addr"    >/dev/null 2>&1 || true
+sleep 0.4
+geom=$(host -j clients | jq -r --arg a "$addr" '[.[] | select(.address==$a)][0] | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"')
+read -r wx wy ww wh <<<"$geom"
+
+# --- open the overview and settle ------------------------------------------
+# HYPREXPO_VERIFY_PEEK=<scale> opens with the "peek" fly-through (subtle zoom)
+# instead of the full grid, e.g. HYPREXPO_VERIFY_PEEK=1.08.
+if [ -n "${HYPREXPO_VERIFY_PEEK:-}" ]; then
+    nested dispatch hyprexpo:peek "${HYPREXPO_VERIFY_PEEK}" >/dev/null 2>&1 || true
+else
+    nested dispatch hyprexpo:expo toggle >/dev/null 2>&1 || true
+fi
+sleep "$(awk -v ms="$SETTLE_MS" 'BEGIN{printf "%.2f", ms/1000}')"
+
+if ! grim -g "$wx,$wy ${ww}x${wh}" "$PNG" 2>"$OUT/grim.err"; then
+    echo "SUMMARY: FAIL grim: $(cat "$OUT/grim.err")"
+    exit 1
+fi
+
+# Optional: trigger a selection and capture the grid mid close-morph to inspect
+# the directional slide. Enable with HYPREXPO_VERIFY_SLIDE=1.
+slide_line=""
+if [ "${HYPREXPO_VERIFY_SLIDE:-0}" = "1" ]; then
+    PNG_SLIDE="$OUT/overview3d-slide.png"
+    MS="${HYPREXPO_VERIFY_SLIDE_MS:-120}"
+    nested dispatch "hyprexpo:kb_selectn" "${HYPREXPO_VERIFY_SLIDE_TARGET:-5}" >/dev/null 2>&1 || true
+    sleep "$(awk -v ms="$MS" 'BEGIN{printf "%.3f", ms/1000}')"
+    grim -g "$wx,$wy ${ww}x${wh}" "$PNG_SLIDE" 2>"$OUT/grim-slide.err" || true
+    slide_line="slide_png=$PNG_SLIDE"
+fi
+
+shader_ready="no"; grep -aq '\[hyprexpo:3d\] perspective shader ready' "$LOG" && shader_ready="yes"
+shader_errors="$(grep -ac '\[hyprexpo:3d\].*failed' "$LOG" 2>/dev/null || true)"; shader_errors="${shader_errors:-0}"
+alive="no"; kill -0 "$nested_pid" >/dev/null 2>&1 && alive="yes"
+
+echo "SUMMARY: nested_alive=$alive plugins=$plugin_count shader_ready=$shader_ready shader_errors=$shader_errors window=[$geom] png=$PNG $slide_line"
+[ -n "$plugin_line" ] && echo "PLUGIN: $plugin_line"
+echo "OPT3D: enable=[$opt3d] tilt=[$opttilt]"
+exit 0
