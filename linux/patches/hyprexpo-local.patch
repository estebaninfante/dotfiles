+static SDispatchResult onPeekDispatcher(std::string arg) {
+    arg = trimString(arg);
+
+    float scale = 1.0F;
+    if (!arg.empty()) {
+        try {
+            size_t used = 0;
+            scale       = std::stof(arg, &used);
+            if (used != arg.size())
+                return {.success = false, .error = "invalid scale"};
+        } catch (...) { return {.success = false, .error = "invalid scale"}; }
+    }
+
+    if (!overviewOpen()) {
+        g_peekScale = scale;
+        return openOverviews(false);
+    }
+
+    g_peekScale = 1.0f;
+    return {};
+}
