+#pragma once
+
+#include <hyprland/src/render/Texture.hpp>
+#include <hyprland/src/helpers/math/Math.hpp>
+#include <array>
+#include <vector>
+
+// Optional true-perspective warping of the overview grid.
+//
+// The native Hyprland vertex shader forces gl_Position.w = 1.0, so it can only
+// ever produce 2D affine transforms (no perspective divide). To get real 3D we
+// render each tile ourselves with a small custom GL program whose vertex shader
+// keeps w = depth, so the GPU does a genuine perspective-correct divide.
+//
+// Every tile is mapped by a 3x3 homography (row-major) from its unit square
+// (u, v) to clip-space homogeneous (x, y, w). The homography is the composition
+// of the monitor projection with the plane->screen map of the tilted grid.
+namespace Hyprexpo3D {
+
+    struct SWarpParams {
+        float tiltDeg  = 0.0f; // pitch about the horizontal axis (top recedes when > 0)
+        float yawDeg   = 0.0f; // yaw about the vertical axis
+        float distance = 1.6f; // camera distance in monitor heights
+        // Optional pivot override: when gridHeight > 0 the perspective pivots on
+        // (centerX, centerY) with a camera distance of distance*gridHeight,
+        // instead of the monitor centre/height. The animated grid can be several
+        // monitors wide during open/close, so anchoring the camera to the grid
+        // itself (not the monitor) keeps the perspective self-similar instead of
+        // exploding at the near plane.
+        float centerX    = -1.0f;
+        float centerY    = -1.0f;
+        float gridHeight = 0.0f;
+    };
+
+    // What the warped quad draws: a texture, a solid fill, or a border ring.
+    enum class EMode : int {
+        Texture = 0,
+        Border  = 1,
+        Solid   = 2,
+    };
+
+    // Everything needed to draw one warped quad.
+    struct SQuadDraw {
+        std::array<float, 9> h3{};         // row-major homography (unit square -> clip xy + w)
+        float                alpha    = 1.f;
+        float                radiusUV = 0.f; // corner radius in unit-square fractions (texture/solid)
+        float                roundPow = 2.f;
+        bool                 flipV    = false;
+        EMode                mode     = EMode::Texture;
+        float                color[4] = {1.f, 1.f, 1.f, 1.f}; // rgba (border/solid)
+        float                thickUV  = 0.02f;                 // border thickness in unit-square fractions
+        float                glow     = 0.f;                   // outer neon bloom strength (0 = off)
+        float                glowUV   = 0.06f;                 // bloom falloff width in unit-square fractions
+    };
+
+    // Build the per-tile homography. `proj` is the monitor projection matrix in
+    // row-major order (Mat3x3::outputProjection(...).getMatrix()). The tile rect
+    // (bx, by, bw, bh) must be in the same (transformed) pixel space the
+    // projection expects.
+    std::array<float, 9> buildTileH3(const Vector2D& monSize, const std::array<float, 9>& proj, float bx, float by, float bw, float bh,
+                                     const SWarpParams& params);
+
+    // Draw a warped quad. `tex` may be null for Border/Solid modes.
+    void renderQuad(const SP<Render::ITexture>& tex, const SQuadDraw& d);
+
+    // Set the per-frame lens distortion applied to every warped quad. `fisheye`
+    // is the barrel strength (0 disables it), `fishPow` the radial falloff
+    // exponent, and `aspect` the monitor width/height so the lens stays round.
+    void setLens(float fisheye, float fishPow, float aspect);
+
+    // Depth fog: darkens quads as they recede toward the far plane, giving the
+    // tilted grid a sense of depth instead of a flat sheet of tiles. `depthNear`
+    // and `depthFar` are in the shader's camera-depth units (see buildTileH3);
+    // `strength` 0 disables it.
+    void setFog(float depthNear, float depthFar, float strength);
+
+    // Screen-space vignette (strength 0..1) applied uniformly to every warped
+    // quad, so the corners meet seamlessly. Darkens the screen edges to focus
+    // the view. Pass the monitor size in px it is measured against.
