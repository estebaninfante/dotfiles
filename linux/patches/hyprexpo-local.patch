+// Loads a user-chosen background image (any format hyprgraphics can read:
+// png/jpeg/webp/...) and caches the resulting GL texture per path, so reopening
+// the overview doesn't re-decode.
+SP<Render::ITexture> loadBackgroundImage(const std::string& path) {
+    static std::string          cachedPath;
+    static SP<Render::ITexture> cachedTex;
+    static std::string          failedPath;
+
+    if (path.empty())
+        return nullptr;
+    if (path == cachedPath && cachedTex)
+        return cachedTex;
+    if (path == failedPath)
+        return nullptr; // already reported; don't spam the log every frame
+
+    Hyprgraphics::CImage image(path);
+    const auto           SURFACE = image.success() ? image.cairoSurface() : nullptr;
+    if (!SURFACE || SURFACE->status() != CAIRO_STATUS_SUCCESS) {
+        Log::logger->log(Log::ERR, "[hyprexpo] could not load background_image: {} ({})", path, image.getError());
+        failedPath = path;
+        cachedPath.clear();
+        cachedTex = nullptr;
+        return nullptr;
+    }
+
+    auto tex = g_pHyprRenderer->createTexture(SURFACE->cairo());
+
+    if (tex) {
+        tex->setTexParameter(GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        tex->setTexParameter(GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        Log::logger->log(Log::WARN, "[hyprexpo] background_image loaded: {} ({}x{})", path, (int)tex->m_size.x, (int)tex->m_size.y);
+    }
+
+    cachedTex  = tex;
+    cachedPath = path;
+    failedPath.clear();
+    return cachedTex;
+}
