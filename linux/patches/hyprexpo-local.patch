+// Open the overview in "peek" mode: scale >= 1.0 makes the grid open slightly
+// larger than the monitor (subtle zoom-out of the current desktop). Used by the
+// fly-through so ~near~ workspace changes get a slide + a touch of zoom.
+static int luaPeek(lua_State* L) {
+    const float scale = (float)luaL_optnumber(L, 1, 1.0);
+    // Only arm the peek scale when we are actually about to open. Setting it
+    // while an overview is already open (including one still closing) used to
+    // leak the scale into the next real open, making the grid open in peek mode
+    // and appear stuck unexpanded.
+    if (!overviewOpen()) {
+        g_peekScale = scale;
+        return luaDispatchResult(L, "hyprexpo.peek", openOverviews(false));
+    }
+    g_peekScale = 1.0f;
+    return luaDispatchResult(L, "hyprexpo.peek", {});
+}
+
 static int luaKbFocus(lua_State* L) {
