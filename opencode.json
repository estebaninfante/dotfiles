{
  "$schema": "https://opencode.ai/config.json",
  "model": "explabs/gpt-5.6-luna",
  "permission": {
    "external_directory": "allow"
  },
  "provider": {
    "explabs": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Experiential Labs",
      "options": {
        "baseURL": "https://api.experientiallabs.ai/v1",
        "apiKey": "{env:EXPLABS_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": { "context": 1050000, "output": 128000 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  },
  "agent": {
    "dotfiles": {
      "description": "Agente de dotfiles NixOS. Crea scripts, edita configs, rebuild, gestiona symlinks, llama subagentes. Auto-mejora: actualiza su config, crea skills, evoluciona.",
      "mode": "primary",
      "model": "explabs/gpt-5.6-luna",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "external_directory": {
          "~/.config/opencode/**": "allow",
          "~/dotfiles/**": "allow"
        }
      }
    },
    "computer-use": {
      "description": "Computer use. Handy STT + Hyprland + mouse/teclado. Uso headless: Traduce voz a acciones de escritorio. Auto-mejora.",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow"
      }
    },
    "quickshell": {
      "description": "Subagente para modificaciones de quickshell QML. Services, components, overlays, menus, bars.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow"
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  }
}
